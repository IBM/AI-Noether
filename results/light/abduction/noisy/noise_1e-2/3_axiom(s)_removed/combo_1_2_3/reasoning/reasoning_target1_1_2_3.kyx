ArchiveEntry "light_target1_combo1_2_3"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real S;
  Real ap;
  Real sintheta;
  Real dA;
  Real dtheta;
  Real r;
  Real P;
  Real qc;
  Real x0;
  Real w;
  Real c1_1;
  Real c1_2;
  Real c2_3;
  Real c2_4;
  Real c3_5;
  Real c3_6;
  Real c1_7;
  Real c1_8;
  Real c2_9;
  Real c2_10;
  Real c3_11;
  Real c3_12;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c2_3 \exists c2_4 \exists c3_5 \exists c3_6 \exists c1_7 \exists c1_8 \exists c2_9 \exists c2_10 \exists c3_11 \exists c3_12 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c2_3 > 0 & c2_4 > 0 & c3_5 > 0 & c3_6 > 0 & c1_7 > 0 & c1_8 > 0 & c2_9 > 0 & c2_10 > 0 & c3_11 > 0 & c3_12 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall S \forall ap \forall sintheta \forall dA \forall dtheta \forall r \forall P \forall qc \forall x0 \forall w
        (
          (
            (S > 0 & ap > 0 & sintheta > 0 & dA > 0 & dtheta > 0 & r > 0 & P > 0 & qc > 0 & x0 > 0 & w > 0) &
            & ( 4/3 - sintheta^3 * dtheta = 0 )
            & ( ap^2 - (1/2)*w^4 * x0^2 = 0 )
            & ( ( c1_1 * S*r^2 ) + ( c1_2 * ap^2*sintheta^2*qc^2 ) = 0 )
            & ( ( c2_3 * sintheta*dtheta*r^2 ) + ( c2_4 * dA ) = 0 )
            & ( ( c3_5 * S*dA ) + ( c3_6 * P ) = 0 )
            & ( ( c1_7 * S*r^2 ) + ( c1_8 * ap^2*sintheta^2*qc^2 ) = 0 )
            & ( ( c2_9 * sintheta*dtheta*r^2 ) + ( c2_10 * dA ) = 0 )
            & ( ( c3_11 * S*dA ) + ( c3_12 * P ) = 0 )
          )
          ->
          (
            ( d1 * P ) + ( d2 * qc^2*x0^2*w^4 ) = 0
          )
        )
      )
    )
  )
End.

End.
