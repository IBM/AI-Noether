ArchiveEntry "light_target1_combo4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real S;
  Real ap;
  Real sintheta;
  Real dA;
  Real dtheta;
  Real r;
  Real P;
  Real qc;
  Real x0;
  Real w;
  Real c4_1;
  Real c4_2;
  Real c5_3;
  Real c5_4;
  Real c4_5;
  Real c4_6;
  Real c5_7;
  Real c5_8;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c5_3 \exists c5_4 \exists c4_5 \exists c4_6 \exists c5_7 \exists c5_8 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c5_3 > 0 & c5_4 > 0 & c4_5 > 0 & c4_6 > 0 & c5_7 > 0 & c5_8 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall S \forall ap \forall sintheta \forall dA \forall dtheta \forall r \forall P \forall qc \forall x0 \forall w
        (
          (
            (S > 0 & ap > 0 & sintheta > 0 & dA > 0 & dtheta > 0 & r > 0 & P > 0 & qc > 0 & x0 > 0 & w > 0) &
            & ( S * r^2 - qc^2 * ap^2 * sintheta^2 = 0 )
            & ( dA - 2*(314/100)*r^2*sintheta*dtheta = 0 )
            & ( P - S * dA = 0 )
            & ( ( c4_1 * sintheta^3*dtheta ) + ( c4_2 * 1 ) = 0 )
            & ( ( c5_3 * ap^2 ) + ( c5_4 * x0^2*w^4 ) = 0 )
            & ( ( c4_5 * sintheta^3*dtheta ) + ( c4_6 * 1 ) = 0 )
            & ( ( c5_7 * ap^2 ) + ( c5_8 * x0^2*w^4 ) = 0 )
          )
          ->
          (
            ( d1 * P ) + ( d2 * qc^2*x0^2*w^4 ) = 0
          )
        )
      )
    )
  )
End.

End.
