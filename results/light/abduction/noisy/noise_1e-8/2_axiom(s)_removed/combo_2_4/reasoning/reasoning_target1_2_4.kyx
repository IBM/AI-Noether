ArchiveEntry "light_target1_combo2_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real S;
  Real ap;
  Real sintheta;
  Real dA;
  Real dtheta;
  Real r;
  Real P;
  Real qc;
  Real x0;
  Real w;
  Real c2_1;
  Real c2_2;
  Real c4_3;
  Real c4_4;
  Real c2_5;
  Real c2_6;
  Real c2_7;
  Real c2_8;
  Real c2_9;
  Real c2_10;
  Real c2_11;
  Real c2_12;
  Real c4_13;
  Real c4_14;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c4_3 \exists c4_4 \exists c2_5 \exists c2_6 \exists c2_7 \exists c2_8 \exists c2_9 \exists c2_10 \exists c2_11 \exists c2_12 \exists c4_13 \exists c4_14 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c4_3 > 0 & c4_4 > 0 & c2_5 > 0 & c2_6 > 0 & c2_7 > 0 & c2_8 > 0 & c2_9 > 0 & c2_10 > 0 & c2_11 > 0 & c2_12 > 0 & c4_13 > 0 & c4_14 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall S \forall ap \forall sintheta \forall dA \forall dtheta \forall r \forall P \forall qc \forall x0 \forall w
        (
          (
            (S > 0 & ap > 0 & sintheta > 0 & dA > 0 & dtheta > 0 & r > 0 & P > 0 & qc > 0 & x0 > 0 & w > 0) &
            & ( S * r^2 - qc^2 * ap^2 * sintheta^2 = 0 )
            & ( P - S * dA = 0 )
            & ( ap^2 - (1/2)*w^4 * x0^2 = 0 )
            & ( ( c2_1 * sintheta*dtheta*r^2 ) + ( c2_2 * dA ) = 0 )
            & ( ( c4_3 * sintheta^3*dtheta ) + ( c4_4 * 1 ) = 0 )
            & ( ( c2_5 * sintheta*dtheta*r^2 ) + ( c2_6 * dA ) = 0 )
            & ( ( c2_7 * sintheta*dtheta*r^2 ) + ( c2_8 * dA ) = 0 )
            & ( ( c2_9 * sintheta*dtheta*r^2 ) + ( c2_10 * dA ) = 0 )
            & ( ( c2_11 * sintheta*dtheta*r^2 ) + ( c2_12 * dA ) = 0 )
            & ( ( c4_13 * sintheta^3*dtheta ) + ( c4_14 * 1 ) = 0 )
          )
          ->
          (
            ( d1 * P ) + ( d2 * qc^2*x0^2*w^4 ) = 0
          )
        )
      )
    )
  )
End.

End.
