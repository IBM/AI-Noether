ArchiveEntry "light_target1_combo1_4_5_ax1c1_ax4c1_ax5c1"

ProgramVariables
  Real S;
  Real ap;
  Real sintheta;
  Real dA;
  Real dtheta;
  Real r;
  Real P;
  Real qc;
  Real x0;
  Real w;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    \exists c9
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0 & c9>0
      &
      (
      \forall S
      \forall ap
      \forall sintheta
      \forall dA
      \forall dtheta
      \forall r
      \forall P
      \forall qc
      \forall x0
      \forall w
          (
          (
            S>0 & ap>0 & sintheta>0 & dA>0 & dtheta>0 & r>0 & P>0 & qc>0 & x0>0 & w>0
            & ( 100*dA - 2*(314)*(r^2)*sintheta*dtheta = 0 )
            & ( P - S * dA = 0 )
            & ( c1 * S*r^2 ) = ( c2 * 2.58183e ) + ( c3 * ap^2*sintheta^2*qc^2 )
            & ( c4 * sintheta^3*dtheta ) = ( c5 * 1 )
            & ( c6 * ap^2 ) = ( c7 * x0^2*w^4 )
            )
        ->
          (
            ( c8 * P ) = ( c9 * 314*qc^2*w^4*x0^2 )
          )
          )
      )
    )
  )
End.

End.