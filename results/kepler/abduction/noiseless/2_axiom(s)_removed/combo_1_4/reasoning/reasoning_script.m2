-- AI-Noether: Reasoning Template (Noiseless)
-- Tests if candidate axiom sets, when added to remaining axioms, prove targets

needsPackage("PrimaryDecomposition", Reload => true)

-- Ring definition
R = QQ[Fc, Fg, w, m1, d1, m2, d2, p, MonomialOrder => Lex];

-- Input data
remainingAxioms = toList([Fg*(d1+d2)^2 - m1*m2, Fc - m2*d2*w^2, w*p - 1]);
qList = toList([m1*m2*p^2-m1*d1*d2^2-m2*d1^2*d2-2*m2*d1*d2^2]);
k = #qList;

-- Per-target variable partitions
measuredPerTarget = {{m1, d1, m2, d2, p}};
nonMeasuredPerTarget = {{Fc, Fg, w}};

-- Candidate axiom sets to test (list of lists)
candidateSets = {{}, {w*p-1}, {Fc*p^2-m2*d2}, {w*m2*d2-Fc*p}, {Fg*d1^2+2*Fg*d1*d2+Fg*d2^2-m1*m2}, {d1^2*m2*d2+m1*d1*d2^2+2*d1*m2*d2^2-m1*m2*p^2}, {Fc*d1^2*m2+Fc*m1*d1*d2+2*Fc*d1*m2*d2-m1*m2^2}, {w*m1*d1*d2^2+Fc*d1^2*p+2*Fc*d1*d2*p-m1*m2*p}, {Fg*m1*d1*d2^2-Fg*m2*d2^3-Fg*m1*m2*p^2+m1*m2^2*d2}, {Fc*Fg*m1*d1*d2-Fc*Fg*m2*d2^2+Fc*m1*m2^2-Fg*m1*m2^2}, {Fg*d1*m2*d2^3+Fg*m1*d2^4+2*Fg*m2*d2^4+Fg*m1*d1*m2*p^2+2*Fg*m1*m2*d2*p^2-m1*d1*m2^2*d2-m1^2*m2*d2^2-2*m1*m2^2*d2^2}, {Fc*Fg*d1*m2*d2^2+Fc*Fg*m1*d2^3+2*Fc*Fg*m2*d2^3-Fc*m1*d1*m2^2+Fg*m1*d1*m2^2-Fc*m1^2*m2*d2-2*Fc*m1*m2^2*d2+2*Fg*m1*m2^2*d2}, {Fc*w*m1*m2^3-Fg*w*m1*m2^3+Fc^2*Fg*m1*d1*p-Fc^2*Fg*m2*d2*p}, {Fg*m1^2*d2^4+2*Fg*m1*m2*d2^4+Fg*m2^2*d2^4+Fg*m1^2*d1*m2*p^2+2*Fg*m1^2*m2*d2*p^2+Fg*m1*m2^2*d2*p^2-m1^2*d1*m2^2*d2-m1^3*m2*d2^2-2*m1^2*m2^2*d2^2-m1*m2^3*d2^2}, {Fg*w*m1*d2^4+Fc*Fg*d1*d2^2*p+2*Fc*Fg*d2^3*p-Fc*m1*d1*m2*p+Fg*m1*d1*m2*p-Fc*m1^2*d2*p-2*Fc*m1*m2*d2*p+2*Fg*m1*m2*d2*p}, {Fc*Fg*m1^2*d2^3+2*Fc*Fg*m1*m2*d2^3+Fc*Fg*m2^2*d2^3-Fc*m1^2*d1*m2^2+Fg*m1^2*d1*m2^2-Fc*m1^3*m2*d2-2*Fc*m1^2*m2^2*d2+2*Fg*m1^2*m2^2*d2-Fc*m1*m2^3*d2+Fg*m1*m2^3*d2}, {Fc*Fg*w*m1*d2^3-Fc*w*m1*d1*m2^2+Fg*w*m1*d1*m2^2+Fc^2*Fg*d1*d2*p+2*Fc^2*Fg*d2^2*p-Fc^2*m1^2*p-2*Fc^2*m1*m2*p+2*Fc*Fg*m1*m2*p}, {w*p-1, Fc*p^2-m2*d2}, {w*p-1, w*m2*d2-Fc*p}, {w*p-1, Fg*d1^2+2*Fg*d1*d2+Fg*d2^2-m1*m2}, {w*p-1, d1^2*m2*d2+m1*d1*d2^2+2*d1*m2*d2^2-m1*m2*p^2}, {w*p-1, Fc*d1^2*m2+Fc*m1*d1*d2+2*Fc*d1*m2*d2-m1*m2^2}, {w*p-1, w*m1*d1*d2^2+Fc*d1^2*p+2*Fc*d1*d2*p-m1*m2*p}, {w*p-1, Fg*m1*d1*d2^2-Fg*m2*d2^3-Fg*m1*m2*p^2+m1*m2^2*d2}, {w*p-1, Fc*Fg*m1*d1*d2-Fc*Fg*m2*d2^2+Fc*m1*m2^2-Fg*m1*m2^2}, {w*p-1, Fg*d1*m2*d2^3+Fg*m1*d2^4+2*Fg*m2*d2^4+Fg*m1*d1*m2*p^2+2*Fg*m1*m2*d2*p^2-m1*d1*m2^2*d2-m1^2*m2*d2^2-2*m1*m2^2*d2^2}, {w*p-1, Fc*Fg*d1*m2*d2^2+Fc*Fg*m1*d2^3+2*Fc*Fg*m2*d2^3-Fc*m1*d1*m2^2+Fg*m1*d1*m2^2-Fc*m1^2*m2*d2-2*Fc*m1*m2^2*d2+2*Fg*m1*m2^2*d2}, {w*p-1, Fc*w*m1*m2^3-Fg*w*m1*m2^3+Fc^2*Fg*m1*d1*p-Fc^2*Fg*m2*d2*p}, {w*p-1, Fg*m1^2*d2^4+2*Fg*m1*m2*d2^4+Fg*m2^2*d2^4+Fg*m1^2*d1*m2*p^2+2*Fg*m1^2*m2*d2*