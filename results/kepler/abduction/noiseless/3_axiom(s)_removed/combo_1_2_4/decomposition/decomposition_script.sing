// AI-Noether: Primary Decomposition Template (Singular)
// Computes minimal associated primes of ideal(remaining_axioms + targets)

LIB "primdec.lib";

// Ring definition - characteristic 0, variables, degree reverse lex ordering
ring r = 0, (Fc, Fg, w, m1, d1, m2, d2, p), dp;

// Define remaining axioms as polynomials
poly ax1 = Fc - m2*d2*w^2;
poly ax2 = w*p - 1;

// Define the ideal from remaining axioms
ideal ii = ax1, ax2;

// Define targets as polynomials
poly targ1 = m1*m2*p^2-m1*d1*d2^2-m2*d1^2*d2-2*m2*d1*d2^2;

// Define the ideal generated by the targets
ideal targ = targ1;

// Compute minimal associated primes of the combined ideal
list M1 = minAss(ii + targ);

// Output the result
// The output format will be parsed by Python:
// [component_index]:
//    _[generator_index]=polynomial
print("=== SINGULAR_DECOMPOSITION_OUTPUT ===");
M1;
print("=== END_SINGULAR_DECOMPOSITION_OUTPUT ===");

quit;
