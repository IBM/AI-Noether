ArchiveEntry "kepler_target1_combo3_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fc;
  Real Fg;
  Real w;
  Real m1;
  Real d1;
  Real m2;
  Real d2;
  Real p;
  Real c3_1;
  Real c3_2;
  Real c3_3;
  Real c3_4;
  Real c4_5;
  Real c4_6;
  Real c5_7;
  Real c5_8;
  Real c3_9;
  Real c3_10;
  Real c4_11;
  Real c4_12;
  Real c3_13;
  Real c3_14;
  Real c4_15;
  Real c4_16;
  Real c5_17;
  Real c5_18;
  Real c3_19;
  Real c3_20;
  Real c4_21;
  Real c4_22;
  Real c3_23;
  Real c3_24;
  Real c4_25;
  Real c4_26;
  Real c3_27;
  Real c3_28;
  Real c4_29;
  Real c4_30;
  Real c5_31;
  Real c5_32;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c3_3 \exists c3_4 \exists c4_5 \exists c4_6 \exists c5_7 \exists c5_8 \exists c3_9 \exists c3_10 \exists c4_11 \exists c4_12 \exists c3_13 \exists c3_14 \exists c4_15 \exists c4_16 \exists c5_17 \exists c5_18 \exists c3_19 \exists c3_20 \exists c4_21 \exists c4_22 \exists c3_23 \exists c3_24 \exists c4_25 \exists c4_26 \exists c3_27 \exists c3_28 \exists c4_29 \exists c4_30 \exists c5_31 \exists c5_32 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c3_1 > 0 & c3_2 > 0 & c3_3 > 0 & c3_4 > 0 & c4_5 > 0 & c4_6 > 0 & c5_7 > 0 & c5_8 > 0 & c3_9 > 0 & c3_10 > 0 & c4_11 > 0 & c4_12 > 0 & c3_13 > 0 & c3_14 > 0 & c4_15 > 0 & c4_16 > 0 & c5_17 > 0 & c5_18 > 0 & c3_19 > 0 & c3_20 > 0 & c4_21 > 0 & c4_22 > 0 & c3_23 > 0 & c3_24 > 0 & c4_25 > 0 & c4_26 > 0 & c3_27 > 0 & c3_28 > 0 & c4_29 > 0 & c4_30 > 0 & c5_31 > 0 & c5_32 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall Fc \forall Fg \forall w \forall m1 \forall d1 \forall m2 \forall d2 \forall p
        (
          (
            (Fc > 0 & Fg > 0 & w > 0 & m1 > 0 & d1 > 0 & m2 > 0 & d2 > 0 & p > 0) &
            & ( m1*d1-m2*d2 = 0 )
            & ( Fg*(d1+d2)^2 - m1*m2 = 0 )
            & ( ( c3_1 * Fc ) + ( c3_2 * w^2*m2*d2 ) = 0 )
            & ( ( c3_3 * Fc ) + ( c3_4 * w^2*m2*d2 ) = 0 )
            & ( ( c4_5 * Fc ) + ( c4_6 * Fg ) = 0 )
            & ( ( c5_7 * w*p ) + ( c5_8 * 1 ) = 0 )
            & ( ( c3_9 * Fc ) + ( c3_10 * w^2*m2*d2 ) = 0 )
            & ( ( c4_11 * Fc ) + ( c4_12 * Fg ) = 0 )
            & ( ( c3_13 * Fc ) + ( c3_14 * w^2*m2*d2 ) = 0 )
            & ( ( c4_15 * Fc ) + ( c4_16 * Fg ) = 0 )
            & ( ( c5_17 * w*p ) + ( c5_18 * 1 ) = 0 )
            & ( ( c3_19 * Fc ) + ( c3_20 * w^2*m2*d2 ) = 0 )
            & ( ( c4_21 * Fc ) + ( c4_22 * Fg ) = 0 )
            & ( ( c3_23 * Fc ) + ( c3_24 * w^2*m2*d2 ) = 0 )
            & ( ( c4_25 * Fc ) + ( c4_26 * Fg ) = 0 )
            & ( ( c3_27 * Fc ) + ( c3_28 * w^2*m2*d2 ) = 0 )
            & ( ( c4_29 * Fc ) + ( c4_30 * Fg ) = 0 )
            & ( ( c5_31 * w*p ) + ( c5_32 * 1 ) = 0 )
          )
          ->
          (
            ( d1 * m1*d1*d2^2 ) + ( d2 * m1*m2*p^2 ) + ( d3 * d1^2*m2*d2 ) + ( d4 * d1*m2*d2^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
