ArchiveEntry "kepler_target1_combo4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fc;
  Real Fg;
  Real w;
  Real m1;
  Real d1;
  Real m2;
  Real d2;
  Real p;
  Real c4_1;
  Real c4_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c4_6;
  Real c5_7;
  Real c5_8;
  Real c4_9;
  Real c4_10;
  Real c5_11;
  Real c5_12;
  Real c4_13;
  Real c4_14;
  Real c5_15;
  Real c5_16;
  Real c4_17;
  Real c4_18;
  Real c5_19;
  Real c5_20;
  Real c4_21;
  Real c4_22;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c4_6 \exists c5_7 \exists c5_8 \exists c4_9 \exists c4_10 \exists c5_11 \exists c5_12 \exists c4_13 \exists c4_14 \exists c5_15 \exists c5_16 \exists c4_17 \exists c4_18 \exists c5_19 \exists c5_20 \exists c4_21 \exists c4_22 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c4_1 > 0 & c4_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c4_6 > 0 & c5_7 > 0 & c5_8 > 0 & c4_9 > 0 & c4_10 > 0 & c5_11 > 0 & c5_12 > 0 & c4_13 > 0 & c4_14 > 0 & c5_15 > 0 & c5_16 > 0 & c4_17 > 0 & c4_18 > 0 & c5_19 > 0 & c5_20 > 0 & c4_21 > 0 & c4_22 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall Fc \forall Fg \forall w \forall m1 \forall d1 \forall m2 \forall d2 \forall p
        (
          (
            (Fc > 0 & Fg > 0 & w > 0 & m1 > 0 & d1 > 0 & m2 > 0 & d2 > 0 & p > 0) &
            & ( m1*d1-m2*d2 = 0 )
            & ( Fg*(d1+d2)^2 - m1*m2 = 0 )
            & ( Fc - m2*d2*w^2 = 0 )
            & ( ( c4_1 * Fc ) + ( c4_2 * Fg ) = 0 )
            & ( ( c4_3 * Fc ) + ( c4_4 * Fg ) = 0 )
            & ( ( c4_5 * Fc ) + ( c4_6 * Fg ) = 0 )
            & ( ( c5_7 * w*p ) + ( c5_8 * 1 ) = 0 )
            & ( ( c4_9 * Fc ) + ( c4_10 * Fg ) = 0 )
            & ( ( c5_11 * w*p ) + ( c5_12 * 1 ) = 0 )
            & ( ( c4_13 * Fc ) + ( c4_14 * Fg ) = 0 )
            & ( ( c5_15 * w*p ) + ( c5_16 * 1 ) = 0 )
            & ( ( c4_17 * Fc ) + ( c4_18 * Fg ) = 0 )
            & ( ( c5_19 * w*p ) + ( c5_20 * 1 ) = 0 )
            & ( ( c4_21 * Fc ) + ( c4_22 * Fg ) = 0 )
          )
          ->
          (
            ( d1 * m1*d1*d2^2 ) + ( d2 * m1*m2*p^2 ) + ( d3 * d1^2*m2*d2 ) + ( d4 * d1*m2*d2^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
