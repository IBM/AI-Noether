ArchiveEntry "kepler_target1_combo3_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fc;
  Real Fg;
  Real w;
  Real m1;
  Real d1;
  Real m2;
  Real d2;
  Real p;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c3_5;
  Real c3_6;
  Real c4_7;
  Real c4_8;
  Real c5_9;
  Real c5_10;
  Real c3_11;
  Real c3_12;
  Real c4_13;
  Real c4_14;
  Real c3_15;
  Real c3_16;
  Real c4_17;
  Real c4_18;
  Real c5_19;
  Real c5_20;
  Real c3_21;
  Real c3_22;
  Real c4_23;
  Real c4_24;
  Real c3_25;
  Real c3_26;
  Real c4_27;
  Real c4_28;
  Real c5_29;
  Real c5_30;
  Real c3_31;
  Real c3_32;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c3_5 \exists c3_6 \exists c4_7 \exists c4_8 \exists c5_9 \exists c5_10 \exists c3_11 \exists c3_12 \exists c4_13 \exists c4_14 \exists c3_15 \exists c3_16 \exists c4_17 \exists c4_18 \exists c5_19 \exists c5_20 \exists c3_21 \exists c3_22 \exists c4_23 \exists c4_24 \exists c3_25 \exists c3_26 \exists c4_27 \exists c4_28 \exists c5_29 \exists c5_30 \exists c3_31 \exists c3_32 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c3_5 > 0 & c3_6 > 0 & c4_7 > 0 & c4_8 > 0 & c5_9 > 0 & c5_10 > 0 & c3_11 > 0 & c3_12 > 0 & c4_13 > 0 & c4_14 > 0 & c3_15 > 0 & c3_16 > 0 & c4_17 > 0 & c4_18 > 0 & c5_19 > 0 & c5_20 > 0 & c3_21 > 0 & c3_22 > 0 & c4_23 > 0 & c4_24 > 0 & c3_25 > 0 & c3_26 > 0 & c4_27 > 0 & c4_28 > 0 & c5_29 > 0 & c5_30 > 0 & c3_31 > 0 & c3_32 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall Fc \forall Fg \forall w \forall m1 \forall d1 \forall m2 \forall d2 \forall p
        (
          (
            (Fc > 0 & Fg > 0 & w > 0 & m1 > 0 & d1 > 0 & m2 > 0 & d2 > 0 & p > 0) &
            & ( m1*d1-m2*d2 = 0 )
            & ( Fg*(d1+d2)^2 - m1*m2 = 0 )
            & ( ( c3_1 * Fc ) + ( c3_2 * w^2*m2*d2 ) = 0 )
            & ( ( c4_3 * Fc ) + ( c4_4 * Fg ) = 0 )
            & ( ( c3_5 * Fc ) + ( c3_6 * w^2*m2*d2 ) = 0 )
            & ( ( c4_7 * Fc ) + ( c4_8 * Fg ) = 0 )
            & ( ( c5_9 * w*p ) + ( c5_10 * 1 ) = 0 )
            & ( ( c3_11 * Fc ) + ( c3_12 * w^2*m2*d2 ) = 0 )
            & ( ( c4_13 * Fc ) + ( c4_14 * Fg ) = 0 )
            & ( ( c3_15 * Fc ) + ( c3_16 * w^2*m2*d2 ) = 0 )
            & ( ( c4_17 * Fc ) + ( c4_18 * Fg ) = 0 )
            & ( ( c5_19 * w*p ) + ( c5_20 * 1 ) = 0 )
            & ( ( c3_21 * Fc ) + ( c3_22 * w^2*m2*d2 ) = 0 )
            & ( ( c4_23 * Fc ) + ( c4_24 * Fg ) = 0 )
            & ( ( c3_25 * Fc ) + ( c3_26 * w^2*m2*d2 ) = 0 )
            & ( ( c4_27 * Fc ) + ( c4_28 * Fg ) = 0 )
            & ( ( c5_29 * w*p ) + ( c5_30 * 1 ) = 0 )
            & ( ( c3_31 * Fc ) + ( c3_32 * w^2*m2*d2 ) = 0 )
          )
          ->
          (
            ( d1 * m1*d1*d2^2 ) + ( d2 * m1*m2*p^2 ) + ( d3 * d1^2*m2*d2 ) + ( d4 * d1*m2*d2^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
