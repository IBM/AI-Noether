ArchiveEntry "kepler_target1_combo3_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fc;
  Real Fg;
  Real w;
  Real m1;
  Real d1;
  Real m2;
  Real d2;
  Real p;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c5_5;
  Real c5_6;
  Real c3_7;
  Real c3_8;
  Real c4_9;
  Real c4_10;
  Real c5_11;
  Real c5_12;
  Real c3_13;
  Real c3_14;
  Real c5_15;
  Real c5_16;
  Real c3_17;
  Real c3_18;
  Real c4_19;
  Real c4_20;
  Real c5_21;
  Real c5_22;
  Real c3_23;
  Real c3_24;
  Real c4_25;
  Real c4_26;
  Real c5_27;
  Real c5_28;
  Real c3_29;
  Real c3_30;
  Real c3_31;
  Real c3_32;
  Real c4_33;
  Real c4_34;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c5_5 \exists c5_6 \exists c3_7 \exists c3_8 \exists c4_9 \exists c4_10 \exists c5_11 \exists c5_12 \exists c3_13 \exists c3_14 \exists c5_15 \exists c5_16 \exists c3_17 \exists c3_18 \exists c4_19 \exists c4_20 \exists c5_21 \exists c5_22 \exists c3_23 \exists c3_24 \exists c4_25 \exists c4_26 \exists c5_27 \exists c5_28 \exists c3_29 \exists c3_30 \exists c3_31 \exists c3_32 \exists c4_33 \exists c4_34 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c5_5 > 0 & c5_6 > 0 & c3_7 > 0 & c3_8 > 0 & c4_9 > 0 & c4_10 > 0 & c5_11 > 0 & c5_12 > 0 & c3_13 > 0 & c3_14 > 0 & c5_15 > 0 & c5_16 > 0 & c3_17 > 0 & c3_18 > 0 & c4_19 > 0 & c4_20 > 0 & c5_21 > 0 & c5_22 > 0 & c3_23 > 0 & c3_24 > 0 & c4_25 > 0 & c4_26 > 0 & c5_27 > 0 & c5_28 > 0 & c3_29 > 0 & c3_30 > 0 & c3_31 > 0 & c3_32 > 0 & c4_33 > 0 & c4_34 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall Fc \forall Fg \forall w \forall m1 \forall d1 \forall m2 \forall d2 \forall p
        (
          (
            (Fc > 0 & Fg > 0 & w > 0 & m1 > 0 & d1 > 0 & m2 > 0 & d2 > 0 & p > 0) &
            & ( m1*d1-m2*d2 = 0 )
            & ( Fg*(d1+d2)^2 - m1*m2 = 0 )
            & ( ( c3_1 * Fc ) + ( c3_2 * w^2*m2*d2 ) = 0 )
            & ( ( c4_3 * Fc ) + ( c4_4 * Fg ) = 0 )
            & ( ( c5_5 * w*p ) + ( c5_6 * 1 ) = 0 )
            & ( ( c3_7 * Fc ) + ( c3_8 * w^2*m2*d2 ) = 0 )
            & ( ( c4_9 * Fc ) + ( c4_10 * Fg ) = 0 )
            & ( ( c5_11 * w*p ) + ( c5_12 * 1 ) = 0 )
            & ( ( c3_13 * Fc ) + ( c3_14 * w^2*m2*d2 ) = 0 )
            & ( ( c5_15 * w*p ) + ( c5_16 * 1 ) = 0 )
            & ( ( c3_17 * Fc ) + ( c3_18 * w^2*m2*d2 ) = 0 )
            & ( ( c4_19 * Fc ) + ( c4_20 * Fg ) = 0 )
            & ( ( c5_21 * w*p ) + ( c5_22 * 1 ) = 0 )
            & ( ( c3_23 * Fc ) + ( c3_24 * w^2*m2*d2 ) = 0 )
            & ( ( c4_25 * Fc ) + ( c4_26 * Fg ) = 0 )
            & ( ( c5_27 * w*p ) + ( c5_28 * 1 ) = 0 )
            & ( ( c3_29 * Fc ) + ( c3_30 * w^2*m2*d2 ) = 0 )
            & ( ( c3_31 * Fc ) + ( c3_32 * w^2*m2*d2 ) = 0 )
            & ( ( c4_33 * Fc ) + ( c4_34 * Fg ) = 0 )
          )
          ->
          (
            ( d1 * m1*d1*d2^2 ) + ( d2 * m1*m2*p^2 ) + ( d3 * d1^2*m2*d2 ) + ( d4 * d1*m2*d2^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
