ArchiveEntry "compton_target1_combo9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real f1;
  Real f2;
  Real Eph1;
  Real Eph2;
  Real Eel1;
  Real Eel2;
  Real p1;
  Real p2;
  Real pel2;
  Real lambda1;
  Real lambda2;
  Real h;
  Real mel;
  Real c;
  Real cosTh;
  Real c9_1;
  Real c9_2;
  Real c9_3;
  Real c9_4;
  Real c9_5;
  Real c9_6;
  Real c9_7;
  Real c9_8;
  Real c9_9;
  Real c9_10;
  Real c9_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c9_15;
  Real c9_16;
  Real c9_17;
  Real c9_18;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c9_1 \exists c9_2 \exists c9_3 \exists c9_4 \exists c9_5 \exists c9_6 \exists c9_7 \exists c9_8 \exists c9_9 \exists c9_10 \exists c9_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c9_15 \exists c9_16 \exists c9_17 \exists c9_18 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c9_1 > 0 & c9_2 > 0 & c9_3 > 0 & c9_4 > 0 & c9_5 > 0 & c9_6 > 0 & c9_7 > 0 & c9_8 > 0 & c9_9 > 0 & c9_10 > 0 & c9_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c9_15 > 0 & c9_16 > 0 & c9_17 > 0 & c9_18 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall f1 \forall f2 \forall Eph1 \forall Eph2 \forall Eel1 \forall Eel2 \forall p1 \forall p2 \forall pel2 \forall lambda1 \forall lambda2 \forall h \forall mel \forall c \forall cosTh
        (
          (
            (f1 > 0 & f2 > 0 & Eph1 > 0 & Eph2 > 0 & Eel1 > 0 & Eel2 > 0 & p1 > 0 & p2 > 0 & pel2 > 0 & lambda1 > 0 & lambda2 > 0 & h > 0 & mel > 0 & c > 0 & cosTh > 0) &
            & ( Eph1 + Eel1 - Eph2- Eel2 = 0 )
            & ( Eph1 - h*f1 = 0 )
            & ( Eph2- h*f2 = 0 )
            & ( p1*c - h*f1 = 0 )
            & ( p2*c - h*f2 = 0 )
            & ( lambda1*f1 - c = 0 )
            & ( lambda2*f2 - c = 0 )
            & ( Eel1 - mel*c^2 = 0 )
            & ( pel2^2 - p1^2 - p2^2 + 2*p1*p2*cosTh = 0 )
            & ( ( c9_1 * Eel2^2 ) + ( c9_2 * pel2^2*c^2 ) + ( c9_3 * mel^2*c^4 ) = 0 )
            & ( ( c9_4 * Eel2^2 ) + ( c9_5 * pel2^2*c^2 ) + ( c9_6 * mel^2*c^4 ) = 0 )
            & ( ( c9_7 * Eel2^2 ) + ( c9_8 * pel2^2*c^2 ) + ( c9_9 * mel^2*c^4 ) = 0 )
            & ( ( c9_10 * Eel2^2 ) + ( c9_11 * pel2^2*c^2 ) + ( c9_12 * mel^2*c^4 ) = 0 )
            & ( ( c9_13 * Eel2^2 ) + ( c9_14 * pel2^2*c^2 ) + ( c9_15 * mel^2*c^4 ) = 0 )
            & ( ( c9_16 * Eel2^2 ) + ( c9_17 * pel2^2*c^2 ) + ( c9_18 * mel^2*c^4 ) = 0 )
          )
          ->
          (
            ( d1 * lambda1*mel*c ) + ( d2 * lambda2*mel*c ) + ( d3 * h*cosTh ) + ( d4 * h ) = 0
          )
        )
      )
    )
  )
End.

End.
