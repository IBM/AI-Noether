ArchiveEntry "compton_target1_combo2_7_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real f1;
  Real f2;
  Real Eph1;
  Real Eph2;
  Real Eel1;
  Real Eel2;
  Real p1;
  Real p2;
  Real pel2;
  Real lambda1;
  Real lambda2;
  Real h;
  Real mel;
  Real c;
  Real cosTh;
  Real c2_1;
  Real c2_2;
  Real c7_3;
  Real c7_4;
  Real c9_5;
  Real c9_6;
  Real c9_7;
  Real c2_8;
  Real c2_9;
  Real c7_10;
  Real c7_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c2_15;
  Real c2_16;
  Real c7_17;
  Real c7_18;
  Real c9_19;
  Real c9_20;
  Real c9_21;
  Real c2_22;
  Real c2_23;
  Real c7_24;
  Real c7_25;
  Real c9_26;
  Real c9_27;
  Real c9_28;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c7_3 \exists c7_4 \exists c9_5 \exists c9_6 \exists c9_7 \exists c2_8 \exists c2_9 \exists c7_10 \exists c7_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c2_15 \exists c2_16 \exists c7_17 \exists c7_18 \exists c9_19 \exists c9_20 \exists c9_21 \exists c2_22 \exists c2_23 \exists c7_24 \exists c7_25 \exists c9_26 \exists c9_27 \exists c9_28 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c2_1 > 0 & c2_2 > 0 & c7_3 > 0 & c7_4 > 0 & c9_5 > 0 & c9_6 > 0 & c9_7 > 0 & c2_8 > 0 & c2_9 > 0 & c7_10 > 0 & c7_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c2_15 > 0 & c2_16 > 0 & c7_17 > 0 & c7_18 > 0 & c9_19 > 0 & c9_20 > 0 & c9_21 > 0 & c2_22 > 0 & c2_23 > 0 & c7_24 > 0 & c7_25 > 0 & c9_26 > 0 & c9_27 > 0 & c9_28 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall f1 \forall f2 \forall Eph1 \forall Eph2 \forall Eel1 \forall Eel2 \forall p1 \forall p2 \forall pel2 \forall lambda1 \forall lambda2 \forall h \forall mel \forall c \forall cosTh
        (
          (
            (f1 > 0 & f2 > 0 & Eph1 > 0 & Eph2 > 0 & Eel1 > 0 & Eel2 > 0 & p1 > 0 & p2 > 0 & pel2 > 0 & lambda1 > 0 & lambda2 > 0 & h > 0 & mel > 0 & c > 0 & cosTh > 0) &
            & ( Eph1 + Eel1 - Eph2- Eel2 = 0 )
            & ( Eph2- h*f2 = 0 )
            & ( p1*c - h*f1 = 0 )
            & ( p2*c - h*f2 = 0 )
            & ( lambda1*f1 - c = 0 )
            & ( Eel1 - mel*c^2 = 0 )
            & ( pel2^2 - p1^2 - p2^2 + 2*p1*p2*cosTh = 0 )
            & ( ( c2_1 * f1*h ) + ( c2_2 * Eph1 ) = 0 )
            & ( ( c7_3 * f2*lambda2 ) + ( c7_4 * c ) = 0 )
            & ( ( c9_5 * Eel2^2 ) + ( c9_6 * pel2^2*c^2 ) + ( c9_7 * mel^2*c^4 ) = 0 )
            & ( ( c2_8 * f1*h ) + ( c2_9 * Eph1 ) = 0 )
            & ( ( c7_10 * f2*lambda2 ) + ( c7_11 * c ) = 0 )
            & ( ( c9_12 * Eel2^2 ) + ( c9_13 * pel2^2*c^2 ) + ( c9_14 * mel^2*c^4 ) = 0 )
            & ( ( c2_15 * f1*h ) + ( c2_16 * Eph1 ) = 0 )
            & ( ( c7_17 * f2*lambda2 ) + ( c7_18 * c ) = 0 )
            & ( ( c9_19 * Eel2^2 ) + ( c9_20 * pel2^2*c^2 ) + ( c9_21 * mel^2*c^4 ) = 0 )
            & ( ( c2_22 * f1*h ) + ( c2_23 * Eph1 ) = 0 )
            & ( ( c7_24 * f2*lambda2 ) + ( c7_25 * c ) = 0 )
            & ( ( c9_26 * Eel2^2 ) + ( c9_27 * pel2^2*c^2 ) + ( c9_28 * mel^2*c^4 ) = 0 )
          )
          ->
          (
            ( d1 * lambda1*mel*c ) + ( d2 * lambda2*mel*c ) + ( d3 * h*cosTh ) + ( d4 * h ) = 0
          )
        )
      )
    )
  )
End.

End.
