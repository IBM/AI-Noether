  Real c8_37;
  Real c8_38;
  Real c9_39;
  Real c9_40;
  Real c9_41;
  Real c10_42;
  Real c10_43;
  Real c10_44;
  Real c10_45;
  Real c8_46;
  Real c8_47;
  Real c9_48;
  Real c9_49;
  Real c9_50;
  Real c10_51;
  Real c10_52;
  Real c10_53;
  Real c10_54;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c8_1 \exists c8_2 \exists c9_3 \exists c9_4 \exists c9_5 \exists c10_6 \exists c10_7 \exists c10_8 \exists c10_9 \exists c8_10 \exists c8_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c10_15 \exists c10_16 \exists c10_17 \exists c10_18 \exists c8_19 \exists c8_20 \exists c9_21 \exists c9_22 \exists c9_23 \exists c10_24 \exists c10_25 \exists c10_26 \exists c10_27 \exists c8_28 \exists c8_29 \exists c9_30 \exists c9_31 \exists c9_32 \exists c10_33 \exists c10_34 \exists c10_35 \exists c10_36 \exists c8_37 \exists c8_38 \exists c9_39 \exists c9_40 \exists c9_41 \exists c10_42 \exists c10_43 \exists c10_44 \exists c10_45 \exists c8_46 \exists c8_47 \exists c9_48 \exists c9_49 \exists c9_50 \exists c10_51 \exists c10_52 \exists c10_53 \exists c10_54 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c8_1 > 0 & c8_2 > 0 & c9_3 > 0 & c9_4 > 0 & c9_5 > 0 & c10_6 > 0 & c10_7 > 0 & c10_8 > 0 & c10_9 > 0 & c8_10 > 0 & c8_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c10_15 > 0 & c10_16 > 0 & c10_17 > 0 & c10_18 > 0 & c8_19 > 0 & c8_20 > 0 & c9_21 > 0 & c9_22 > 0 & c9_23 > 0 & c10_24 > 0 & c10_25 > 0 & c10_26 > 0 & c10_27 > 0 & c8_28 > 0 & c8_29 > 0 & c9_30 > 0 & c9_31 > 0 & c9_32 > 0 & c10_33 > 0 & c10_34 > 0 & c10_35 > 0 & c10_36 > 0 & c8_37 > 0 & c8_38 > 0 & c9_39 > 0 & c9_40 > 0 & c9_41 > 0 & c10_42 > 0 & c10_43 > 0 & c10_44 > 0 & c10_45 > 0 & c8_46 > 0 & c8_47 > 0 & c9_48 > 0 & c9_49 > 0 & c9_50 > 0 & c10_51 > 0 & c10_52 > 0 & c10_53 > 0 & c10_54 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall f1 \forall f2 \forall Eph1 \forall Eph2 \forall Eel1 \forall Eel2 \forall p1 \forall p2 \forall pel2 \forall lam1 \forall lam2 \forall hbar \forall mel \forall cVar \forall cosTh
        (
          (
            (f1 > 0 & f2 > 0 & Eph1 > 0 & Eph2 > 0 & Eel1 > 0 & Eel2 > 0 & p1 > 0 & p2 > 0 & pel2 > 0 & lam1 > 0 & lam2 > 0 & hbar > 0 & mel > 0 & cVar > 0 & cosTh > 0) &
            & ( Eph1 + Eel1 - Eph2- Eel2 = 0 )
            & ( Eph1 - hbar*f1 = 0 )
            & ( Eph2 - hbar*f2 = 0 )
            & ( p1*cVar - hbar*f1 = 0 )
            & ( p2*cVar - hbar*f2 = 0 )
            & ( lam1*f1 - cVar = 0 )
            & ( lam2*f2 - cVar = 0 )
            & ( ( c8_1 * Eel1 ) + ( c8_2 * mel*cVar^2 ) = 0 )
            & ( ( c9_3 * Eel2^2 ) + ( c9_4 * pel2^2*cVar^2 ) + ( c9_5 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_6 * p1^2 ) + ( c10_7 * p1*p2*cosTh ) + ( c10_8 * p2^2 ) + ( c10_9 * pel2^2 ) = 0 )
            & ( ( c8_10 * Eel1 ) + ( c8_11 * mel*cVar^2 ) = 0 )
            & ( ( c9_12 * Eel2^2 ) + ( c9_13 * pel2^2*cVar^2 ) + ( c9_14 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_15 * p1^2 ) + ( c10_16 * p1*p2*cosTh ) + ( c10_17 * p2^2 ) + ( c10_18 * pel2^2 ) = 0 )
            & ( ( c8_19 * Eel1 ) + ( c8_20 * mel*cVar^2 ) = 0 )
            & ( ( c9_21 * Eel2^2 ) + ( c9_22 * pel2^2*cVar^2 ) + ( c9_23 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_24 * p1^2 ) + ( c10_25 * p1*p2*cosTh ) + ( c10_26 * p2^2 ) + ( c10_27 * pel2^2 ) = 0 )
            & ( ( c8_28 * Eel1 ) + ( c8_29 * mel*cVar^2 ) = 0 )
            & ( ( c9_30 * Eel2^2 ) + ( c9_31 * pel2^2*cVar^2 ) + ( c9_32 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_33 * p1^2 ) + ( c10_34 * p1*p2*cosTh ) + ( c10_35 * p2^2 ) + ( c10_36 * pel2^2 ) = 0 )
            & ( ( c8_37 * Eel1 ) + ( c8_38 * mel*cVar^2 ) = 0 )
            & ( ( c9_39 * Eel2^2 ) + ( c9_40 * pel2^2*cVar^2 ) + ( c9_41 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_42 * p1^2 ) + ( c10_43 * p1*p2*cosTh ) + ( c10_44 * p2^2 ) + ( c10_45 * pel2^2 ) = 0 )
            & ( ( c8_46 * Eel1 ) + ( c8_47 * mel*cVar^2 ) = 0 )
            & ( ( c9_48 * Eel2^2 ) + ( c9_49 * pel2^2*cVar^2 ) + ( c9_50 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_51 * p1^2 ) + ( c10_52 * p1*p2*cosTh ) + ( c10_53 * p2^2 ) + ( c10_54 * pel2^2 ) = 0 )
          )
          ->
          (
            ( d1 * lam1*mel*cVar ) + ( d2 * lam2*mel*cVar ) + ( d3 * hbar*cosTh ) + ( d4 * hbar ) = 0
          )
        )
      )
    )
  )
End.

End.
