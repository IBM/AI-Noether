ArchiveEntry "compton_target1_combo3_7_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real f1;
  Real f2;
  Real Eph1;
  Real Eph2;
  Real Eel1;
  Real Eel2;
  Real p1;
  Real p2;
  Real pel2;
  Real lam1;
  Real lam2;
  Real hbar;
  Real mel;
  Real cVar;
  Real cosTh;
  Real c3_1;
  Real c3_2;
  Real c7_3;
  Real c7_4;
  Real c9_5;
  Real c9_6;
  Real c9_7;
  Real c3_8;
  Real c3_9;
  Real c7_10;
  Real c7_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c3_15;
  Real c3_16;
  Real c7_17;
  Real c7_18;
  Real c9_19;
  Real c9_20;
  Real c9_21;
  Real c3_22;
  Real c3_23;
  Real c7_24;
  Real c7_25;
  Real c9_26;
  Real c9_27;
  Real c9_28;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c7_3 \exists c7_4 \exists c9_5 \exists c9_6 \exists c9_7 \exists c3_8 \exists c3_9 \exists c7_10 \exists c7_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c3_15 \exists c3_16 \exists c7_17 \exists c7_18 \exists c9_19 \exists c9_20 \exists c9_21 \exists c3_22 \exists c3_23 \exists c7_24 \exists c7_25 \exists c9_26 \exists c9_27 \exists c9_28 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c3_1 > 0 & c3_2 > 0 & c7_3 > 0 & c7_4 > 0 & c9_5 > 0 & c9_6 > 0 & c9_7 > 0 & c3_8 > 0 & c3_9 > 0 & c7_10 > 0 & c7_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c3_15 > 0 & c3_16 > 0 & c7_17 > 0 & c7_18 > 0 & c9_19 > 0 & c9_20 > 0 & c9_21 > 0 & c3_22 > 0 & c3_23 > 0 & c7_24 > 0 & c7_25 > 0 & c9_26 > 0 & c9_27 > 0 & c9_28 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall f1 \forall f2 \forall Eph1 \forall Eph2 \forall Eel1 \forall Eel2 \forall p1 \forall p2 \forall pel2 \forall lam1 \forall lam2 \forall hbar \forall mel \forall cVar \forall cosTh
        (
          (
            (f1 > 0 & f2 > 0 & Eph1 > 0 & Eph2 > 0 & Eel1 > 0 & Eel2 > 0 & p1 > 0 & p2 > 0 & pel2 > 0 & lam1 > 0 & lam2 > 0 & hbar > 0 & mel > 0 & cVar > 0 & cosTh > 0) &
            & ( Eph1 + Eel1 - Eph2- Eel2 = 0 )
            & ( Eph1 - hbar*f1 = 0 )
            & ( p1*cVar - hbar*f1 = 0 )
            & ( p2*cVar - hbar*f2 = 0 )
            & ( lam1*f1 - cVar = 0 )
            & ( Eel1 - mel*cVar^2 = 0 )
            & ( pel2^2 - p1^2 - p2^2 + 2*p1*p2*cosTh = 0 )
            & ( ( c3_1 * f2*hbar ) + ( c3_2 * Eph2 ) = 0 )
            & ( ( c7_3 * f2*lam2 ) + ( c7_4 * cVar ) = 0 )
            & ( ( c9_5 * Eel2^2 ) + ( c9_6 * pel2^2*cVar^2 ) + ( c9_7 * mel^2*cVar^4 ) = 0 )
            & ( ( c3_8 * f2*hbar ) + ( c3_9 * Eph2 ) = 0 )
            & ( ( c7_10 * f2*lam2 ) + ( c7_11 * cVar ) = 0 )
            & ( ( c9_12 * Eel2^2 ) + ( c9_13 * pel2^2*cVar^2 ) + ( c9_14 * mel^2*cVar^4 ) = 0 )
            & ( ( c3_15 * f2*hbar ) + ( c3_16 * Eph2 ) = 0 )
            & ( ( c7_17 * f2*lam2 ) + ( c7_18 * cVar ) = 0 )
            & ( ( c9_19 * Eel2^2 ) + ( c9_20 * pel2^2*cVar^2 ) + ( c9_21 * mel^2*cVar^4 ) = 0 )
            & ( ( c3_22 * f2*hbar ) + ( c3_23 * Eph2 ) = 0 )
            & ( ( c7_24 * f2*lam2 ) + ( c7_25 * cVar ) = 0 )
            & ( ( c9_26 * Eel2^2 ) + ( c9_27 * pel2^2*cVar^2 ) + ( c9_28 * mel^2*cVar^4 ) = 0 )
          )
          ->
          (
            ( d1 * lam1*mel*cVar ) + ( d2 * lam2*mel*cVar ) + ( d3 * hbar*cosTh ) + ( d4 * hbar ) = 0
          )
        )
      )
    )
  )
End.

End.
