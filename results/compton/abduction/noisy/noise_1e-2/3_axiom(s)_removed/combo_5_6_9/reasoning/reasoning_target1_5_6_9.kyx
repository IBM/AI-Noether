ArchiveEntry "compton_target1_combo5_6_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real f1;
  Real f2;
  Real Eph1;
  Real Eph2;
  Real Eel1;
  Real Eel2;
  Real p1;
  Real p2;
  Real pel2;
  Real lam1;
  Real lam2;
  Real hbar;
  Real mel;
  Real cVar;
  Real cosTh;
  Real c5_1;
  Real c5_2;
  Real c6_3;
  Real c6_4;
  Real c9_5;
  Real c9_6;
  Real c9_7;
  Real c5_8;
  Real c5_9;
  Real c6_10;
  Real c6_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c5_15;
  Real c5_16;
  Real c6_17;
  Real c6_18;
  Real c9_19;
  Real c9_20;
  Real c9_21;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c6_3 \exists c6_4 \exists c9_5 \exists c9_6 \exists c9_7 \exists c5_8 \exists c5_9 \exists c6_10 \exists c6_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c5_15 \exists c5_16 \exists c6_17 \exists c6_18 \exists c9_19 \exists c9_20 \exists c9_21 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c5_1 > 0 & c5_2 > 0 & c6_3 > 0 & c6_4 > 0 & c9_5 > 0 & c9_6 > 0 & c9_7 > 0 & c5_8 > 0 & c5_9 > 0 & c6_10 > 0 & c6_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c5_15 > 0 & c5_16 > 0 & c6_17 > 0 & c6_18 > 0 & c9_19 > 0 & c9_20 > 0 & c9_21 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall f1 \forall f2 \forall Eph1 \forall Eph2 \forall Eel1 \forall Eel2 \forall p1 \forall p2 \forall pel2 \forall lam1 \forall lam2 \forall hbar \forall mel \forall cVar \forall cosTh
        (
          (
            (f1 > 0 & f2 > 0 & Eph1 > 0 & Eph2 > 0 & Eel1 > 0 & Eel2 > 0 & p1 > 0 & p2 > 0 & pel2 > 0 & lam1 > 0 & lam2 > 0 & hbar > 0 & mel > 0 & cVar > 0 & cosTh > 0) &
            & ( Eph1 + Eel1 - Eph2- Eel2 = 0 )
            & ( Eph1 - hbar*f1 = 0 )
            & ( Eph2 - hbar*f2 = 0 )
            & ( p1*cVar - hbar*f1 = 0 )
            & ( lam2*f2 - cVar = 0 )
            & ( Eel1 - mel*cVar^2 = 0 )
            & ( pel2^2 - p1^2 - p2^2 + 2*p1*p2*cosTh = 0 )
            & ( ( c5_1 * f2*hbar ) + ( c5_2 * p2*cVar ) = 0 )
            & ( ( c6_3 * f1*lam1 ) + ( c6_4 * cVar ) = 0 )
            & ( ( c9_5 * Eel2^2 ) + ( c9_6 * pel2^2*cVar^2 ) + ( c9_7 * mel^2*cVar^4 ) = 0 )
            & ( ( c5_8 * f2*hbar ) + ( c5_9 * p2*cVar ) = 0 )
            & ( ( c6_10 * f1*lam1 ) + ( c6_11 * cVar ) = 0 )
            & ( ( c9_12 * Eel2^2 ) + ( c9_13 * pel2^2*cVar^2 ) + ( c9_14 * mel^2*cVar^4 ) = 0 )
            & ( ( c5_15 * f2*hbar ) + ( c5_16 * p2*cVar ) = 0 )
            & ( ( c6_17 * f1*lam1 ) + ( c6_18 * cVar ) = 0 )
            & ( ( c9_19 * Eel2^2 ) + ( c9_20 * pel2^2*cVar^2 ) + ( c9_21 * mel^2*cVar^4 ) = 0 )
          )
          ->
          (
            ( d1 * lam1*mel*cVar ) + ( d2 * lam2*mel*cVar ) + ( d3 * hbar*cosTh ) + ( d4 * hbar ) = 0
          )
        )
      )
    )
  )
End.

End.
