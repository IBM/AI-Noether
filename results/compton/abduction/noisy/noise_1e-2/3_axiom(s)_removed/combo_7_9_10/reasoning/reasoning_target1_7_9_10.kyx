ArchiveEntry "compton_target1_combo7_9_10"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real f1;
  Real f2;
  Real Eph1;
  Real Eph2;
  Real Eel1;
  Real Eel2;
  Real p1;
  Real p2;
  Real pel2;
  Real lam1;
  Real lam2;
  Real hbar;
  Real mel;
  Real cVar;
  Real cosTh;
  Real c7_1;
  Real c7_2;
  Real c9_3;
  Real c9_4;
  Real c9_5;
  Real c10_6;
  Real c10_7;
  Real c10_8;
  Real c10_9;
  Real c7_10;
  Real c7_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c10_15;
  Real c10_16;
  Real c10_17;
  Real c10_18;
  Real c7_19;
  Real c7_20;
  Real c9_21;
  Real c9_22;
  Real c9_23;
  Real c10_24;
  Real c10_25;
  Real c10_26;
  Real c10_27;
  Real c7_28;
  Real c7_29;
  Real c9_30;
  Real c9_31;
  Real c9_32;
  Real c10_33;
  Real c10_34;
  Real c10_35;
  Real c10_36;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
End.

Problem
  (
    \exists c7_1 \exists c7_2 \exists c9_3 \exists c9_4 \exists c9_5 \exists c10_6 \exists c10_7 \exists c10_8 \exists c10_9 \exists c7_10 \exists c7_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c10_15 \exists c10_16 \exists c10_17 \exists c10_18 \exists c7_19 \exists c7_20 \exists c9_21 \exists c9_22 \exists c9_23 \exists c10_24 \exists c10_25 \exists c10_26 \exists c10_27 \exists c7_28 \exists c7_29 \exists c9_30 \exists c9_31 \exists c9_32 \exists c10_33 \exists c10_34 \exists c10_35 \exists c10_36 \exists d1 \exists d2 \exists d3 \exists d4
    (
      c7_1 > 0 & c7_2 > 0 & c9_3 > 0 & c9_4 > 0 & c9_5 > 0 & c10_6 > 0 & c10_7 > 0 & c10_8 > 0 & c10_9 > 0 & c7_10 > 0 & c7_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c10_15 > 0 & c10_16 > 0 & c10_17 > 0 & c10_18 > 0 & c7_19 > 0 & c7_20 > 0 & c9_21 > 0 & c9_22 > 0 & c9_23 > 0 & c10_24 > 0 & c10_25 > 0 & c10_26 > 0 & c10_27 > 0 & c7_28 > 0 & c7_29 > 0 & c9_30 > 0 & c9_31 > 0 & c9_32 > 0 & c10_33 > 0 & c10_34 > 0 & c10_35 > 0 & c10_36 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0
      &
      (
        \forall f1 \forall f2 \forall Eph1 \forall Eph2 \forall Eel1 \forall Eel2 \forall p1 \forall p2 \forall pel2 \forall lam1 \forall lam2 \forall hbar \forall mel \forall cVar \forall cosTh
        (
          (
            (f1 > 0 & f2 > 0 & Eph1 > 0 & Eph2 > 0 & Eel1 > 0 & Eel2 > 0 & p1 > 0 & p2 > 0 & pel2 > 0 & lam1 > 0 & lam2 > 0 & hbar > 0 & mel > 0 & cVar > 0 & cosTh > 0) &
            & ( Eph1 + Eel1 - Eph2- Eel2 = 0 )
            & ( Eph1 - hbar*f1 = 0 )
            & ( Eph2 - hbar*f2 = 0 )
            & ( p1*cVar - hbar*f1 = 0 )
            & ( p2*cVar - hbar*f2 = 0 )
            & ( lam1*f1 - cVar = 0 )
            & ( Eel1 - mel*cVar^2 = 0 )
            & ( ( c7_1 * f2*lam2 ) + ( c7_2 * cVar ) = 0 )
            & ( ( c9_3 * Eel2^2 ) + ( c9_4 * pel2^2*cVar^2 ) + ( c9_5 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_6 * p1^2 ) + ( c10_7 * p1*p2*cosTh ) + ( c10_8 * p2^2 ) + ( c10_9 * pel2^2 ) = 0 )
            & ( ( c7_10 * f2*lam2 ) + ( c7_11 * cVar ) = 0 )
            & ( ( c9_12 * Eel2^2 ) + ( c9_13 * pel2^2*cVar^2 ) + ( c9_14 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_15 * p1^2 ) + ( c10_16 * p1*p2*cosTh ) + ( c10_17 * p2^2 ) + ( c10_18 * pel2^2 ) = 0 )
            & ( ( c7_19 * f2*lam2 ) + ( c7_20 * cVar ) = 0 )
            & ( ( c9_21 * Eel2^2 ) + ( c9_22 * pel2^2*cVar^2 ) + ( c9_23 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_24 * p1^2 ) + ( c10_25 * p1*p2*cosTh ) + ( c10_26 * p2^2 ) + ( c10_27 * pel2^2 ) = 0 )
            & ( ( c7_28 * f2*lam2 ) + ( c7_29 * cVar ) = 0 )
            & ( ( c9_30 * Eel2^2 ) + ( c9_31 * pel2^2*cVar^2 ) + ( c9_32 * mel^2*cVar^4 ) = 0 )
            & ( ( c10_33 * p1^2 ) + ( c10_34 * p1*p2*cosTh ) + ( c10_35 * p2^2 ) + ( c10_36 * pel2^2 ) = 0 )
          )
          ->
          (
            ( d1 * lam1*mel*cVar ) + ( d2 * lam2*mel*cVar ) + ( d3 * hbar*cosTh ) + ( d4 * hbar ) = 0
          )
        )
      )
    )
  )
End.

End.
