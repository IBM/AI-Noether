            & ( ( c9_34 * Eel2^2 ) + ( c9_35 * pel2^2*c^2 ) + ( c9_36 * mel^2*c^4 ) = 0 )
            & ( ( c1_37 * Eph1 ) + ( c1_38 * Eph2 ) + ( c1_39 * Eel1 ) + ( c1_40 * Eel2 ) = 0 )
            & ( ( c5_41 * f2*h ) + ( c5_42 * p2*c ) = 0 )
            & ( ( c9_43 * Eel2^2 ) + ( c9_44 * pel2^2*c^2 ) + ( c9_45 * mel^2*c^4 ) = 0 )
            & ( ( c1_46 * Eph1 ) + ( c1_47 * Eph2 ) + ( c1_48 * Eel1 ) + ( c1_49 * Eel2 ) = 0 )
            & ( ( c5_50 * f2*h ) + ( c5_51 * p2*c ) = 0 )
            & ( ( c9_52 * Eel2^2 ) + ( c9_53 * pel2^2*c^2 ) + ( c9_54 * mel^2*c^4 ) = 0 )
