ArchiveEntry "decay_target1_combo2_5_ax2c1_ax5c1"

ProgramVariables
  Real pp;
  Real pmu;
  Real Ev;
  Real Emu;
  Real Ep;
  Real pv;
  Real mp;
  Real mmu;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0
      &
      (
      \forall pp
      \forall pmu
      \forall Ev
      \forall Emu
      \forall Ep
      \forall pv
      \forall mp
      \forall mmu
          (
          (
            pp>0 & pmu>0 & Ev>0 & Emu>0 & Ep>0 & pv>0 & mp>0 & mmu>0
            & ( pv - pmu = 0 )
            & ( Ev - pv = 0 )
            & ( Ep - Emu - Ev = 0 )
            & ( c1 * Ep ) = ( c2 * mp )
            & ( c3 * pmu^2 ) = ( c4 * Emu^2 ) + ( c5 * mmu^2 )
            )
        ->
          (
            ( c6 * pv*mp ) = ( c7 * mp^2 ) + ( c8 * mmu^2 )
          )
          )
      )
    )
  )
End.

End.