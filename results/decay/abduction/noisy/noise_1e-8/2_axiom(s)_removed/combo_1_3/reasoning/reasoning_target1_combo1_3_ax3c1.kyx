ArchiveEntry "decay_target1_combo1_3_ax3c1"

ProgramVariables
  Real pp;
  Real pmu;
  Real Ev;
  Real Emu;
  Real Ep;
  Real pv;
  Real mp;
  Real mmu;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0
      &
      (
      \forall pp
      \forall pmu
      \forall Ev
      \forall Emu
      \forall Ep
      \forall pv
      \forall mp
      \forall mmu
          (
          (
            pp>0 & pmu>0 & Ev>0 & Emu>0 & Ep>0 & pv>0 & mp>0 & mmu>0
            & ( Ep - mp = 0 )
            & ( Ep - Emu - Ev = 0 )
            & ( Emu^2 - pmu^2 - mmu^2 = 0 )
            & ( c1 * Ev ) = ( c2 * pv )
            )
        ->
          (
            ( c3 * pv*mp ) = ( c4 * mp^2 ) + ( c5 * mmu^2 )
          )
          )
      )
    )
  )
End.

End.