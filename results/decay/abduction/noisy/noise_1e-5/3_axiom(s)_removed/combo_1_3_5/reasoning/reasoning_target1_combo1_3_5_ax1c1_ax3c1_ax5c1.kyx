ArchiveEntry "decay_target1_combo1_3_5_ax1c1_ax3c1_ax5c1"

ProgramVariables
  Real pp;
  Real pmu;
  Real Ev;
  Real Emu;
  Real Ep;
  Real pv;
  Real mp;
  Real mmu;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    \exists c9
    \exists c10
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0 & c9>0 & c10>0
      &
      (
      \forall pp
      \forall pmu
      \forall Ev
      \forall Emu
      \forall Ep
      \forall pv
      \forall mp
      \forall mmu
          (
          (
            pp>0 & pmu>0 & Ev>0 & Emu>0 & Ep>0 & pv>0 & mp>0 & mmu>0
            & ( Ep - mp = 0 )
            & ( Ep - Emu - Ev = 0 )
            & ( c1 * pmu ) = ( c2 * pv )
            & ( c3 * Ev ) = ( c4 * pv )
            & ( c5 * pmu^2 ) = ( c6 * Emu^2 ) + ( c7 * mmu^2 )
            )
        ->
          (
            ( c8 * pv*mp ) = ( c9 * mp^2 ) + ( c10 * mmu^2 )
          )
          )
      )
    )
  )
End.

End.