ArchiveEntry "time_dilation_target1_combo1_ax1c1"

ProgramVariables
  Real d;
  Real dt;
  Real dt0;
  Real L;
  Real c;
  Real F0;
  Real F;
  Real v;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0
      &
      (
      \forall d
      \forall dt
      \forall dt0
      \forall L
      \forall c
      \forall F0
      \forall F
      \forall v
          (
          (
            d>0 & dt>0 & dt0>0 & L>0 & c>0 & F0>0 & F>0 & v>0
            & ( 4*L^2 - 4*d^2 - v^2*dt^2 = 0 )
            & ( F0*dt0 - 1 = 0 )
            & ( F*dt - 1 = 0 )
            & ( c*dt - 2*L = 0 )
            & ( c1 * d ) = ( c2 * dt0*c )
            )
        ->
          (
            ( c3 * c^2*F0^2 ) = ( c4 * c^2*F^2 ) + ( c5 * F0^2*v^2 )
          )
          )
      )
    )
  )
End.

End.