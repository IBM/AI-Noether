ArchiveEntry "hall_target1_combo1_4_7_ax1c2_ax4c1_ax7c2"

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    \exists c9
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0 & c9>0
      &
      (
      \forall Fm
      \forall d
      \forall v
      \forall Fe
      \forall E
      \forall dt
      \forall Q
      \forall N
      \forall V
      \forall i
      \forall n
      \forall qe
      \forall B
      \forall h
      \forall L
      \forall UH
          (
          (
            Fm>0 & d>0 & v>0 & Fe>0 & E>0 & dt>0 & Q>0 & N>0 & V>0 & i>0 & n>0 & qe>0 & B>0 & h>0 & L>0 & UH>0
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( c1 * Fm ) = ( c2 * v*qe*B )
            & ( c3 * E*h ) = ( c4 * UH )
            & ( c5 * 3.44416e ) = ( c6 * Q ) + ( c7 * N*qe )
            )
        ->
          (
            ( c8 * N*qe*UH ) = ( c9 * i*B*h*L )
          )
          )
      )
    )
  )
End.

End.