ArchiveEntry "hall_target1_combo1_4_7"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c4_3;
  Real c4_4;
  Real c7_5;
  Real c7_6;
  Real c1_7;
  Real c1_8;
  Real c7_9;
  Real c7_10;
  Real c1_11;
  Real c1_12;
  Real c4_13;
  Real c4_14;
  Real c7_15;
  Real c7_16;
  Real c1_17;
  Real c1_18;
  Real c4_19;
  Real c4_20;
  Real c7_21;
  Real c7_22;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c4_3 \exists c4_4 \exists c7_5 \exists c7_6 \exists c1_7 \exists c1_8 \exists c7_9 \exists c7_10 \exists c1_11 \exists c1_12 \exists c4_13 \exists c4_14 \exists c7_15 \exists c7_16 \exists c1_17 \exists c1_18 \exists c4_19 \exists c4_20 \exists c7_21 \exists c7_22 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c4_3 > 0 & c4_4 > 0 & c7_5 > 0 & c7_6 > 0 & c1_7 > 0 & c1_8 > 0 & c7_9 > 0 & c7_10 > 0 & c1_11 > 0 & c1_12 > 0 & c4_13 > 0 & c4_14 > 0 & c7_15 > 0 & c7_16 > 0 & c1_17 > 0 & c1_18 > 0 & c4_19 > 0 & c4_20 > 0 & c7_21 > 0 & c7_22 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c4_3 * E*h ) + ( c4_4 * UH ) = 0 )
            & ( ( c7_5 * Q ) + ( c7_6 * N*qe ) = 0 )
            & ( ( c1_7 * Fm ) + ( c1_8 * v*qe*B ) = 0 )
            & ( ( c7_9 * Q ) + ( c7_10 * N*qe ) = 0 )
            & ( ( c1_11 * Fm ) + ( c1_12 * v*qe*B ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c7_15 * Q ) + ( c7_16 * N*qe ) = 0 )
            & ( ( c1_17 * Fm ) + ( c1_18 * v*qe*B ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c7_21 * Q ) + ( c7_22 * N*qe ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
