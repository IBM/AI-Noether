ArchiveEntry "hall_target1_combo5_7_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c5_1;
  Real c5_2;
  Real c7_3;
  Real c7_4;
  Real c8_5;
  Real c8_6;
  Real c5_7;
  Real c5_8;
  Real c7_9;
  Real c7_10;
  Real c8_11;
  Real c8_12;
  Real c5_13;
  Real c5_14;
  Real c7_15;
  Real c7_16;
  Real c8_17;
  Real c8_18;
  Real c5_19;
  Real c5_20;
  Real c7_21;
  Real c7_22;
  Real c8_23;
  Real c8_24;
  Real c5_25;
  Real c5_26;
  Real c7_27;
  Real c7_28;
  Real c8_29;
  Real c8_30;
  Real c5_31;
  Real c5_32;
  Real c7_33;
  Real c7_34;
  Real c8_35;
  Real c8_36;
  Real c5_37;
  Real c5_38;
  Real c7_39;
  Real c7_40;
  Real c8_41;
  Real c8_42;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c7_3 \exists c7_4 \exists c8_5 \exists c8_6 \exists c5_7 \exists c5_8 \exists c7_9 \exists c7_10 \exists c8_11 \exists c8_12 \exists c5_13 \exists c5_14 \exists c7_15 \exists c7_16 \exists c8_17 \exists c8_18 \exists c5_19 \exists c5_20 \exists c7_21 \exists c7_22 \exists c8_23 \exists c8_24 \exists c5_25 \exists c5_26 \exists c7_27 \exists c7_28 \exists c8_29 \exists c8_30 \exists c5_31 \exists c5_32 \exists c7_33 \exists c7_34 \exists c8_35 \exists c8_36 \exists c5_37 \exists c5_38 \exists c7_39 \exists c7_40 \exists c8_41 \exists c8_42 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c7_3 > 0 & c7_4 > 0 & c8_5 > 0 & c8_6 > 0 & c5_7 > 0 & c5_8 > 0 & c7_9 > 0 & c7_10 > 0 & c8_11 > 0 & c8_12 > 0 & c5_13 > 0 & c5_14 > 0 & c7_15 > 0 & c7_16 > 0 & c8_17 > 0 & c8_18 > 0 & c5_19 > 0 & c5_20 > 0 & c7_21 > 0 & c7_22 > 0 & c8_23 > 0 & c8_24 > 0 & c5_25 > 0 & c5_26 > 0 & c7_27 > 0 & c7_28 > 0 & c8_29 > 0 & c8_30 > 0 & c5_31 > 0 & c5_32 > 0 & c7_33 > 0 & c7_34 > 0 & c8_35 > 0 & c8_36 > 0 & c5_37 > 0 & c5_38 > 0 & c7_39 > 0 & c7_40 > 0 & c8_41 > 0 & c8_42 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c5_1 * v*dt ) + ( c5_2 * L ) = 0 )
            & ( ( c7_3 * Q ) + ( c7_4 * N*qe ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c7_9 * Q ) + ( c7_10 * N*qe ) = 0 )
            & ( ( c8_11 * N ) + ( c8_12 * V*n ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c7_15 * Q ) + ( c7_16 * N*qe ) = 0 )
            & ( ( c8_17 * N ) + ( c8_18 * V*n ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c7_21 * Q ) + ( c7_22 * N*qe ) = 0 )
            & ( ( c8_23 * N ) + ( c8_24 * V*n ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c7_27 * Q ) + ( c7_28 * N*qe ) = 0 )
            & ( ( c8_29 * N ) + ( c8_30 * V*n ) = 0 )
            & ( ( c5_31 * v*dt ) + ( c5_32 * L ) = 0 )
            & ( ( c7_33 * Q ) + ( c7_34 * N*qe ) = 0 )
            & ( ( c8_35 * N ) + ( c8_36 * V*n ) = 0 )
            & ( ( c5_37 * v*dt ) + ( c5_38 * L ) = 0 )
            & ( ( c7_39 * Q ) + ( c7_40 * N*qe ) = 0 )
            & ( ( c8_41 * N ) + ( c8_42 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
