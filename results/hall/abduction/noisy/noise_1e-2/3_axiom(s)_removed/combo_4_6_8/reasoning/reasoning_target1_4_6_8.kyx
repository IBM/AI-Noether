ArchiveEntry "hall_target1_combo4_6_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c6_3;
  Real c6_4;
  Real c8_5;
  Real c8_6;
  Real c6_7;
  Real c6_8;
  Real c8_9;
  Real c8_10;
  Real c4_11;
  Real c4_12;
  Real c6_13;
  Real c6_14;
  Real c8_15;
  Real c8_16;
  Real c4_17;
  Real c4_18;
  Real c6_19;
  Real c6_20;
  Real c8_21;
  Real c8_22;
  Real c4_23;
  Real c4_24;
  Real c6_25;
  Real c6_26;
  Real c8_27;
  Real c8_28;
  Real c4_29;
  Real c4_30;
  Real c6_31;
  Real c6_32;
  Real c8_33;
  Real c8_34;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c6_3 \exists c6_4 \exists c8_5 \exists c8_6 \exists c6_7 \exists c6_8 \exists c8_9 \exists c8_10 \exists c4_11 \exists c4_12 \exists c6_13 \exists c6_14 \exists c8_15 \exists c8_16 \exists c4_17 \exists c4_18 \exists c6_19 \exists c6_20 \exists c8_21 \exists c8_22 \exists c4_23 \exists c4_24 \exists c6_25 \exists c6_26 \exists c8_27 \exists c8_28 \exists c4_29 \exists c4_30 \exists c6_31 \exists c6_32 \exists c8_33 \exists c8_34 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c6_3 > 0 & c6_4 > 0 & c8_5 > 0 & c8_6 > 0 & c6_7 > 0 & c6_8 > 0 & c8_9 > 0 & c8_10 > 0 & c4_11 > 0 & c4_12 > 0 & c6_13 > 0 & c6_14 > 0 & c8_15 > 0 & c8_16 > 0 & c4_17 > 0 & c4_18 > 0 & c6_19 > 0 & c6_20 > 0 & c8_21 > 0 & c8_22 > 0 & c4_23 > 0 & c4_24 > 0 & c6_25 > 0 & c6_26 > 0 & c8_27 > 0 & c8_28 > 0 & c4_29 > 0 & c4_30 > 0 & c6_31 > 0 & c6_32 > 0 & c8_33 > 0 & c8_34 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c6_3 * dt*i ) + ( c6_4 * Q ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c6_7 * dt*i ) + ( c6_8 * Q ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c4_11 * E*h ) + ( c4_12 * UH ) = 0 )
            & ( ( c6_13 * dt*i ) + ( c6_14 * Q ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c4_17 * E*h ) + ( c4_18 * UH ) = 0 )
            & ( ( c6_19 * dt*i ) + ( c6_20 * Q ) = 0 )
            & ( ( c8_21 * N ) + ( c8_22 * V*n ) = 0 )
            & ( ( c4_23 * E*h ) + ( c4_24 * UH ) = 0 )
            & ( ( c6_25 * dt*i ) + ( c6_26 * Q ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c6_31 * dt*i ) + ( c6_32 * Q ) = 0 )
            & ( ( c8_33 * N ) + ( c8_34 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
