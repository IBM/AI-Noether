ArchiveEntry "hall_target1_combo3_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c5_5;
  Real c5_6;
  Real c4_7;
  Real c4_8;
  Real c3_9;
  Real c3_10;
  Real c4_11;
  Real c4_12;
  Real c5_13;
  Real c5_14;
  Real c3_15;
  Real c3_16;
  Real c4_17;
  Real c4_18;
  Real c5_19;
  Real c5_20;
  Real c3_21;
  Real c3_22;
  Real c4_23;
  Real c4_24;
  Real c5_25;
  Real c5_26;
  Real c4_27;
  Real c4_28;
  Real c5_29;
  Real c5_30;
  Real c3_31;
  Real c3_32;
  Real c5_33;
  Real c5_34;
  Real c4_35;
  Real c4_36;
  Real c5_37;
  Real c5_38;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c5_5 \exists c5_6 \exists c4_7 \exists c4_8 \exists c3_9 \exists c3_10 \exists c4_11 \exists c4_12 \exists c5_13 \exists c5_14 \exists c3_15 \exists c3_16 \exists c4_17 \exists c4_18 \exists c5_19 \exists c5_20 \exists c3_21 \exists c3_22 \exists c4_23 \exists c4_24 \exists c5_25 \exists c5_26 \exists c4_27 \exists c4_28 \exists c5_29 \exists c5_30 \exists c3_31 \exists c3_32 \exists c5_33 \exists c5_34 \exists c4_35 \exists c4_36 \exists c5_37 \exists c5_38 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c5_5 > 0 & c5_6 > 0 & c4_7 > 0 & c4_8 > 0 & c3_9 > 0 & c3_10 > 0 & c4_11 > 0 & c4_12 > 0 & c5_13 > 0 & c5_14 > 0 & c3_15 > 0 & c3_16 > 0 & c4_17 > 0 & c4_18 > 0 & c5_19 > 0 & c5_20 > 0 & c3_21 > 0 & c3_22 > 0 & c4_23 > 0 & c4_24 > 0 & c5_25 > 0 & c5_26 > 0 & c4_27 > 0 & c4_28 > 0 & c5_29 > 0 & c5_30 > 0 & c3_31 > 0 & c3_32 > 0 & c5_33 > 0 & c5_34 > 0 & c4_35 > 0 & c4_36 > 0 & c5_37 > 0 & c5_38 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c3_1 * Fm ) + ( c3_2 * Fe ) = 0 )
            & ( ( c4_3 * E*h ) + ( c4_4 * UH ) = 0 )
            & ( ( c5_5 * v*dt ) + ( c5_6 * L ) = 0 )
            & ( ( c4_7 * E*h ) + ( c4_8 * UH ) = 0 )
            & ( ( c3_9 * Fm ) + ( c3_10 * Fe ) = 0 )
            & ( ( c4_11 * E*h ) + ( c4_12 * UH ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c3_15 * Fm ) + ( c3_16 * Fe ) = 0 )
            & ( ( c4_17 * E*h ) + ( c4_18 * UH ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c3_21 * Fm ) + ( c3_22 * Fe ) = 0 )
            & ( ( c4_23 * E*h ) + ( c4_24 * UH ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c4_27 * E*h ) + ( c4_28 * UH ) = 0 )
            & ( ( c5_29 * v*dt ) + ( c5_30 * L ) = 0 )
            & ( ( c3_31 * Fm ) + ( c3_32 * Fe ) = 0 )
            & ( ( c5_33 * v*dt ) + ( c5_34 * L ) = 0 )
            & ( ( c4_35 * E*h ) + ( c4_36 * UH ) = 0 )
            & ( ( c5_37 * v*dt ) + ( c5_38 * L ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
