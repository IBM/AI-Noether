ArchiveEntry "hall_target1_combo1_3_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c8_3;
  Real c8_4;
  Real c1_5;
  Real c1_6;
  Real c8_7;
  Real c8_8;
  Real c1_9;
  Real c1_10;
  Real c3_11;
  Real c3_12;
  Real c8_13;
  Real c8_14;
  Real c1_15;
  Real c1_16;
  Real c3_17;
  Real c3_18;
  Real c8_19;
  Real c8_20;
  Real c1_21;
  Real c1_22;
  Real c3_23;
  Real c3_24;
  Real c8_25;
  Real c8_26;
  Real c1_27;
  Real c1_28;
  Real c3_29;
  Real c3_30;
  Real c8_31;
  Real c8_32;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c8_3 \exists c8_4 \exists c1_5 \exists c1_6 \exists c8_7 \exists c8_8 \exists c1_9 \exists c1_10 \exists c3_11 \exists c3_12 \exists c8_13 \exists c8_14 \exists c1_15 \exists c1_16 \exists c3_17 \exists c3_18 \exists c8_19 \exists c8_20 \exists c1_21 \exists c1_22 \exists c3_23 \exists c3_24 \exists c8_25 \exists c8_26 \exists c1_27 \exists c1_28 \exists c3_29 \exists c3_30 \exists c8_31 \exists c8_32 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c8_3 > 0 & c8_4 > 0 & c1_5 > 0 & c1_6 > 0 & c8_7 > 0 & c8_8 > 0 & c1_9 > 0 & c1_10 > 0 & c3_11 > 0 & c3_12 > 0 & c8_13 > 0 & c8_14 > 0 & c1_15 > 0 & c1_16 > 0 & c3_17 > 0 & c3_18 > 0 & c8_19 > 0 & c8_20 > 0 & c1_21 > 0 & c1_22 > 0 & c3_23 > 0 & c3_24 > 0 & c8_25 > 0 & c8_26 > 0 & c1_27 > 0 & c1_28 > 0 & c3_29 > 0 & c3_30 > 0 & c8_31 > 0 & c8_32 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fe - qe*E = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c1_5 * Fm ) + ( c1_6 * v*qe*B ) = 0 )
            & ( ( c8_7 * N ) + ( c8_8 * V*n ) = 0 )
            & ( ( c1_9 * Fm ) + ( c1_10 * v*qe*B ) = 0 )
            & ( ( c3_11 * Fm ) + ( c3_12 * Fe ) = 0 )
            & ( ( c8_13 * N ) + ( c8_14 * V*n ) = 0 )
            & ( ( c1_15 * Fm ) + ( c1_16 * v*qe*B ) = 0 )
            & ( ( c3_17 * Fm ) + ( c3_18 * Fe ) = 0 )
            & ( ( c8_19 * N ) + ( c8_20 * V*n ) = 0 )
            & ( ( c1_21 * Fm ) + ( c1_22 * v*qe*B ) = 0 )
            & ( ( c3_23 * Fm ) + ( c3_24 * Fe ) = 0 )
            & ( ( c8_25 * N ) + ( c8_26 * V*n ) = 0 )
            & ( ( c1_27 * Fm ) + ( c1_28 * v*qe*B ) = 0 )
            & ( ( c3_29 * Fm ) + ( c3_30 * Fe ) = 0 )
            & ( ( c8_31 * N ) + ( c8_32 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
