  Real c8_48;
  Real c6_49;
  Real c6_50;
  Real c7_51;
  Real c7_52;
  Real c8_53;
  Real c8_54;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c6_1 \exists c6_2 \exists c7_3 \exists c7_4 \exists c8_5 \exists c8_6 \exists c6_7 \exists c6_8 \exists c7_9 \exists c7_10 \exists c8_11 \exists c8_12 \exists c6_13 \exists c6_14 \exists c7_15 \exists c7_16 \exists c8_17 \exists c8_18 \exists c6_19 \exists c6_20 \exists c7_21 \exists c7_22 \exists c8_23 \exists c8_24 \exists c6_25 \exists c6_26 \exists c7_27 \exists c7_28 \exists c8_29 \exists c8_30 \exists c6_31 \exists c6_32 \exists c7_33 \exists c7_34 \exists c8_35 \exists c8_36 \exists c6_37 \exists c6_38 \exists c7_39 \exists c7_40 \exists c8_41 \exists c8_42 \exists c6_43 \exists c6_44 \exists c7_45 \exists c7_46 \exists c8_47 \exists c8_48 \exists c6_49 \exists c6_50 \exists c7_51 \exists c7_52 \exists c8_53 \exists c8_54 \exists d1 \exists d2
    (
      c6_1 > 0 & c6_2 > 0 & c7_3 > 0 & c7_4 > 0 & c8_5 > 0 & c8_6 > 0 & c6_7 > 0 & c6_8 > 0 & c7_9 > 0 & c7_10 > 0 & c8_11 > 0 & c8_12 > 0 & c6_13 > 0 & c6_14 > 0 & c7_15 > 0 & c7_16 > 0 & c8_17 > 0 & c8_18 > 0 & c6_19 > 0 & c6_20 > 0 & c7_21 > 0 & c7_22 > 0 & c8_23 > 0 & c8_24 > 0 & c6_25 > 0 & c6_26 > 0 & c7_27 > 0 & c7_28 > 0 & c8_29 > 0 & c8_30 > 0 & c6_31 > 0 & c6_32 > 0 & c7_33 > 0 & c7_34 > 0 & c8_35 > 0 & c8_36 > 0 & c6_37 > 0 & c6_38 > 0 & c7_39 > 0 & c7_40 > 0 & c8_41 > 0 & c8_42 > 0 & c6_43 > 0 & c6_44 > 0 & c7_45 > 0 & c7_46 > 0 & c8_47 > 0 & c8_48 > 0 & c6_49 > 0 & c6_50 > 0 & c7_51 > 0 & c7_52 > 0 & c8_53 > 0 & c8_54 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c6_1 * dt*i ) + ( c6_2 * Q ) = 0 )
            & ( ( c7_3 * Q ) + ( c7_4 * N*qe ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c6_7 * dt*i ) + ( c6_8 * Q ) = 0 )
            & ( ( c7_9 * Q ) + ( c7_10 * N*qe ) = 0 )
            & ( ( c8_11 * N ) + ( c8_12 * V*n ) = 0 )
            & ( ( c6_13 * dt*i ) + ( c6_14 * Q ) = 0 )
            & ( ( c7_15 * Q ) + ( c7_16 * N*qe ) = 0 )
            & ( ( c8_17 * N ) + ( c8_18 * V*n ) = 0 )
            & ( ( c6_19 * dt*i ) + ( c6_20 * Q ) = 0 )
            & ( ( c7_21 * Q ) + ( c7_22 * N*qe ) = 0 )
            & ( ( c8_23 * N ) + ( c8_24 * V*n ) = 0 )
            & ( ( c6_25 * dt*i ) + ( c6_26 * Q ) = 0 )
            & ( ( c7_27 * Q ) + ( c7_28 * N*qe ) = 0 )
            & ( ( c8_29 * N ) + ( c8_30 * V*n ) = 0 )
            & ( ( c6_31 * dt*i ) + ( c6_32 * Q ) = 0 )
            & ( ( c7_33 * Q ) + ( c7_34 * N*qe ) = 0 )
            & ( ( c8_35 * N ) + ( c8_36 * V*n ) = 0 )
            & ( ( c6_37 * dt*i ) + ( c6_38 * Q ) = 0 )
            & ( ( c7_39 * Q ) + ( c7_40 * N*qe ) = 0 )
            & ( ( c8_41 * N ) + ( c8_42 * V*n ) = 0 )
            & ( ( c6_43 * dt*i ) + ( c6_44 * Q ) = 0 )
            & ( ( c7_45 * Q ) + ( c7_46 * N*qe ) = 0 )
            & ( ( c8_47 * N ) + ( c8_48 * V*n ) = 0 )
            & ( ( c6_49 * dt*i ) + ( c6_50 * Q ) = 0 )
            & ( ( c7_51 * Q ) + ( c7_52 * N*qe ) = 0 )
            & ( ( c8_53 * N ) + ( c8_54 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
