ArchiveEntry "hall_target1_combo5_6_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c6_1;
  Real c6_2;
  Real c9_3;
  Real c9_4;
  Real c5_5;
  Real c5_6;
  Real c6_7;
  Real c6_8;
  Real c9_9;
  Real c9_10;
  Real c6_11;
  Real c6_12;
  Real c9_13;
  Real c9_14;
  Real c5_15;
  Real c5_16;
  Real c6_17;
  Real c6_18;
  Real c9_19;
  Real c9_20;
  Real c6_21;
  Real c6_22;
  Real c9_23;
  Real c9_24;
  Real c5_25;
  Real c5_26;
  Real c6_27;
  Real c6_28;
  Real c9_29;
  Real c9_30;
  Real c6_31;
  Real c6_32;
  Real c9_33;
  Real c9_34;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c6_1 \exists c6_2 \exists c9_3 \exists c9_4 \exists c5_5 \exists c5_6 \exists c6_7 \exists c6_8 \exists c9_9 \exists c9_10 \exists c6_11 \exists c6_12 \exists c9_13 \exists c9_14 \exists c5_15 \exists c5_16 \exists c6_17 \exists c6_18 \exists c9_19 \exists c9_20 \exists c6_21 \exists c6_22 \exists c9_23 \exists c9_24 \exists c5_25 \exists c5_26 \exists c6_27 \exists c6_28 \exists c9_29 \exists c9_30 \exists c6_31 \exists c6_32 \exists c9_33 \exists c9_34 \exists d1 \exists d2
    (
      c6_1 > 0 & c6_2 > 0 & c9_3 > 0 & c9_4 > 0 & c5_5 > 0 & c5_6 > 0 & c6_7 > 0 & c6_8 > 0 & c9_9 > 0 & c9_10 > 0 & c6_11 > 0 & c6_12 > 0 & c9_13 > 0 & c9_14 > 0 & c5_15 > 0 & c5_16 > 0 & c6_17 > 0 & c6_18 > 0 & c9_19 > 0 & c9_20 > 0 & c6_21 > 0 & c6_22 > 0 & c9_23 > 0 & c9_24 > 0 & c5_25 > 0 & c5_26 > 0 & c6_27 > 0 & c6_28 > 0 & c9_29 > 0 & c9_30 > 0 & c6_31 > 0 & c6_32 > 0 & c9_33 > 0 & c9_34 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( ( c6_1 * dt*i ) + ( c6_2 * Q ) = 0 )
            & ( ( c9_3 * d*h*L ) + ( c9_4 * V ) = 0 )
            & ( ( c5_5 * v*dt ) + ( c5_6 * L ) = 0 )
            & ( ( c6_7 * dt*i ) + ( c6_8 * Q ) = 0 )
            & ( ( c9_9 * d*h*L ) + ( c9_10 * V ) = 0 )
            & ( ( c6_11 * dt*i ) + ( c6_12 * Q ) = 0 )
            & ( ( c9_13 * d*h*L ) + ( c9_14 * V ) = 0 )
            & ( ( c5_15 * v*dt ) + ( c5_16 * L ) = 0 )
            & ( ( c6_17 * dt*i ) + ( c6_18 * Q ) = 0 )
            & ( ( c9_19 * d*h*L ) + ( c9_20 * V ) = 0 )
            & ( ( c6_21 * dt*i ) + ( c6_22 * Q ) = 0 )
            & ( ( c9_23 * d*h*L ) + ( c9_24 * V ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c6_27 * dt*i ) + ( c6_28 * Q ) = 0 )
            & ( ( c9_29 * d*h*L ) + ( c9_30 * V ) = 0 )
            & ( ( c6_31 * dt*i ) + ( c6_32 * Q ) = 0 )
            & ( ( c9_33 * d*h*L ) + ( c9_34 * V ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
