ArchiveEntry "hall_target1_combo5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c5_1;
  Real c5_2;
  Real c5_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c5_7;
  Real c5_8;
  Real c5_9;
  Real c5_10;
  Real c5_11;
  Real c5_12;
  Real c5_13;
  Real c5_14;
  Real c5_15;
  Real c5_16;
  Real c5_17;
  Real c5_18;
  Real c5_19;
  Real c5_20;
  Real c5_21;
  Real c5_22;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c5_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c5_7 \exists c5_8 \exists c5_9 \exists c5_10 \exists c5_11 \exists c5_12 \exists c5_13 \exists c5_14 \exists c5_15 \exists c5_16 \exists c5_17 \exists c5_18 \exists c5_19 \exists c5_20 \exists c5_21 \exists c5_22 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c5_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c5_7 > 0 & c5_8 > 0 & c5_9 > 0 & c5_10 > 0 & c5_11 > 0 & c5_12 > 0 & c5_13 > 0 & c5_14 > 0 & c5_15 > 0 & c5_16 > 0 & c5_17 > 0 & c5_18 > 0 & c5_19 > 0 & c5_20 > 0 & c5_21 > 0 & c5_22 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c5_1 * v*dt ) + ( c5_2 * L ) = 0 )
            & ( ( c5_3 * v*dt ) + ( c5_4 * L ) = 0 )
            & ( ( c5_5 * v*dt ) + ( c5_6 * L ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c5_9 * v*dt ) + ( c5_10 * L ) = 0 )
            & ( ( c5_11 * v*dt ) + ( c5_12 * L ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c5_15 * v*dt ) + ( c5_16 * L ) = 0 )
            & ( ( c5_17 * v*dt ) + ( c5_18 * L ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c5_21 * v*dt ) + ( c5_22 * L ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
