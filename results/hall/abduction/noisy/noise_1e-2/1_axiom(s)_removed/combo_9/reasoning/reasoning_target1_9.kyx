ArchiveEntry "hall_target1_combo9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c9_1;
  Real c9_2;
  Real c9_3;
  Real c9_4;
  Real c9_5;
  Real c9_6;
  Real c9_7;
  Real c9_8;
  Real c9_9;
  Real c9_10;
  Real c9_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c9_15;
  Real c9_16;
  Real c9_17;
  Real c9_18;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c9_1 \exists c9_2 \exists c9_3 \exists c9_4 \exists c9_5 \exists c9_6 \exists c9_7 \exists c9_8 \exists c9_9 \exists c9_10 \exists c9_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c9_15 \exists c9_16 \exists c9_17 \exists c9_18 \exists d1 \exists d2
    (
      c9_1 > 0 & c9_2 > 0 & c9_3 > 0 & c9_4 > 0 & c9_5 > 0 & c9_6 > 0 & c9_7 > 0 & c9_8 > 0 & c9_9 > 0 & c9_10 > 0 & c9_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c9_15 > 0 & c9_16 > 0 & c9_17 > 0 & c9_18 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( ( c9_1 * d*h*L ) + ( c9_2 * V ) = 0 )
            & ( ( c9_3 * d*h*L ) + ( c9_4 * V ) = 0 )
            & ( ( c9_5 * d*h*L ) + ( c9_6 * V ) = 0 )
            & ( ( c9_7 * d*h*L ) + ( c9_8 * V ) = 0 )
            & ( ( c9_9 * d*h*L ) + ( c9_10 * V ) = 0 )
            & ( ( c9_11 * d*h*L ) + ( c9_12 * V ) = 0 )
            & ( ( c9_13 * d*h*L ) + ( c9_14 * V ) = 0 )
            & ( ( c9_15 * d*h*L ) + ( c9_16 * V ) = 0 )
            & ( ( c9_17 * d*h*L ) + ( c9_18 * V ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
