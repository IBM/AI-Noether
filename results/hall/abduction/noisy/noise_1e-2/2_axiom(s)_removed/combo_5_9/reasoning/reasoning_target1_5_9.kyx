ArchiveEntry "hall_target1_combo5_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c5_1;
  Real c5_2;
  Real c9_3;
  Real c9_4;
  Real c5_5;
  Real c5_6;
  Real c9_7;
  Real c9_8;
  Real c5_9;
  Real c5_10;
  Real c9_11;
  Real c9_12;
  Real c5_13;
  Real c5_14;
  Real c9_15;
  Real c9_16;
  Real c5_17;
  Real c5_18;
  Real c9_19;
  Real c9_20;
  Real c5_21;
  Real c5_22;
  Real c9_23;
  Real c9_24;
  Real c5_25;
  Real c5_26;
  Real c9_27;
  Real c9_28;
  Real c5_29;
  Real c5_30;
  Real c9_31;
  Real c9_32;
  Real c5_33;
  Real c5_34;
  Real c9_35;
  Real c9_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c9_3 \exists c9_4 \exists c5_5 \exists c5_6 \exists c9_7 \exists c9_8 \exists c5_9 \exists c5_10 \exists c9_11 \exists c9_12 \exists c5_13 \exists c5_14 \exists c9_15 \exists c9_16 \exists c5_17 \exists c5_18 \exists c9_19 \exists c9_20 \exists c5_21 \exists c5_22 \exists c9_23 \exists c9_24 \exists c5_25 \exists c5_26 \exists c9_27 \exists c9_28 \exists c5_29 \exists c5_30 \exists c9_31 \exists c9_32 \exists c5_33 \exists c5_34 \exists c9_35 \exists c9_36 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c9_3 > 0 & c9_4 > 0 & c5_5 > 0 & c5_6 > 0 & c9_7 > 0 & c9_8 > 0 & c5_9 > 0 & c5_10 > 0 & c9_11 > 0 & c9_12 > 0 & c5_13 > 0 & c5_14 > 0 & c9_15 > 0 & c9_16 > 0 & c5_17 > 0 & c5_18 > 0 & c9_19 > 0 & c9_20 > 0 & c5_21 > 0 & c5_22 > 0 & c9_23 > 0 & c9_24 > 0 & c5_25 > 0 & c5_26 > 0 & c9_27 > 0 & c9_28 > 0 & c5_29 > 0 & c5_30 > 0 & c9_31 > 0 & c9_32 > 0 & c5_33 > 0 & c5_34 > 0 & c9_35 > 0 & c9_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( ( c5_1 * v*dt ) + ( c5_2 * L ) = 0 )
            & ( ( c9_3 * d*h*L ) + ( c9_4 * V ) = 0 )
            & ( ( c5_5 * v*dt ) + ( c5_6 * L ) = 0 )
            & ( ( c9_7 * d*h*L ) + ( c9_8 * V ) = 0 )
            & ( ( c5_9 * v*dt ) + ( c5_10 * L ) = 0 )
            & ( ( c9_11 * d*h*L ) + ( c9_12 * V ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c9_15 * d*h*L ) + ( c9_16 * V ) = 0 )
            & ( ( c5_17 * v*dt ) + ( c5_18 * L ) = 0 )
            & ( ( c9_19 * d*h*L ) + ( c9_20 * V ) = 0 )
            & ( ( c5_21 * v*dt ) + ( c5_22 * L ) = 0 )
            & ( ( c9_23 * d*h*L ) + ( c9_24 * V ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c9_27 * d*h*L ) + ( c9_28 * V ) = 0 )
            & ( ( c5_29 * v*dt ) + ( c5_30 * L ) = 0 )
            & ( ( c9_31 * d*h*L ) + ( c9_32 * V ) = 0 )
            & ( ( c5_33 * v*dt ) + ( c5_34 * L ) = 0 )
            & ( ( c9_35 * d*h*L ) + ( c9_36 * V ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
