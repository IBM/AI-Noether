ArchiveEntry "hall_target1_combo4_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c9_3;
  Real c9_4;
  Real c4_5;
  Real c4_6;
  Real c9_7;
  Real c9_8;
  Real c4_9;
  Real c4_10;
  Real c9_11;
  Real c9_12;
  Real c4_13;
  Real c4_14;
  Real c9_15;
  Real c9_16;
  Real c4_17;
  Real c4_18;
  Real c9_19;
  Real c9_20;
  Real c9_21;
  Real c9_22;
  Real c4_23;
  Real c4_24;
  Real c9_25;
  Real c9_26;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c9_3 \exists c9_4 \exists c4_5 \exists c4_6 \exists c9_7 \exists c9_8 \exists c4_9 \exists c4_10 \exists c9_11 \exists c9_12 \exists c4_13 \exists c4_14 \exists c9_15 \exists c9_16 \exists c4_17 \exists c4_18 \exists c9_19 \exists c9_20 \exists c9_21 \exists c9_22 \exists c4_23 \exists c4_24 \exists c9_25 \exists c9_26 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c9_3 > 0 & c9_4 > 0 & c4_5 > 0 & c4_6 > 0 & c9_7 > 0 & c9_8 > 0 & c4_9 > 0 & c4_10 > 0 & c9_11 > 0 & c9_12 > 0 & c4_13 > 0 & c4_14 > 0 & c9_15 > 0 & c9_16 > 0 & c4_17 > 0 & c4_18 > 0 & c9_19 > 0 & c9_20 > 0 & c9_21 > 0 & c9_22 > 0 & c4_23 > 0 & c4_24 > 0 & c9_25 > 0 & c9_26 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c9_3 * d*h*L ) + ( c9_4 * V ) = 0 )
            & ( ( c4_5 * E*h ) + ( c4_6 * UH ) = 0 )
            & ( ( c9_7 * d*h*L ) + ( c9_8 * V ) = 0 )
            & ( ( c4_9 * E*h ) + ( c4_10 * UH ) = 0 )
            & ( ( c9_11 * d*h*L ) + ( c9_12 * V ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c9_15 * d*h*L ) + ( c9_16 * V ) = 0 )
            & ( ( c4_17 * E*h ) + ( c4_18 * UH ) = 0 )
            & ( ( c9_19 * d*h*L ) + ( c9_20 * V ) = 0 )
            & ( ( c9_21 * d*h*L ) + ( c9_22 * V ) = 0 )
            & ( ( c4_23 * E*h ) + ( c4_24 * UH ) = 0 )
            & ( ( c9_25 * d*h*L ) + ( c9_26 * V ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
