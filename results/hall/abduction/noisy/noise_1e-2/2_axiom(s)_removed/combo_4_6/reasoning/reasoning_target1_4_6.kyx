ArchiveEntry "hall_target1_combo4_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c6_3;
  Real c6_4;
  Real c6_5;
  Real c6_6;
  Real c4_7;
  Real c4_8;
  Real c6_9;
  Real c6_10;
  Real c4_11;
  Real c4_12;
  Real c6_13;
  Real c6_14;
  Real c4_15;
  Real c4_16;
  Real c6_17;
  Real c6_18;
  Real c4_19;
  Real c4_20;
  Real c6_21;
  Real c6_22;
  Real c4_23;
  Real c4_24;
  Real c6_25;
  Real c6_26;
  Real c4_27;
  Real c4_28;
  Real c6_29;
  Real c6_30;
  Real c4_31;
  Real c4_32;
  Real c6_33;
  Real c6_34;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c6_3 \exists c6_4 \exists c6_5 \exists c6_6 \exists c4_7 \exists c4_8 \exists c6_9 \exists c6_10 \exists c4_11 \exists c4_12 \exists c6_13 \exists c6_14 \exists c4_15 \exists c4_16 \exists c6_17 \exists c6_18 \exists c4_19 \exists c4_20 \exists c6_21 \exists c6_22 \exists c4_23 \exists c4_24 \exists c6_25 \exists c6_26 \exists c4_27 \exists c4_28 \exists c6_29 \exists c6_30 \exists c4_31 \exists c4_32 \exists c6_33 \exists c6_34 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c6_3 > 0 & c6_4 > 0 & c6_5 > 0 & c6_6 > 0 & c4_7 > 0 & c4_8 > 0 & c6_9 > 0 & c6_10 > 0 & c4_11 > 0 & c4_12 > 0 & c6_13 > 0 & c6_14 > 0 & c4_15 > 0 & c4_16 > 0 & c6_17 > 0 & c6_18 > 0 & c4_19 > 0 & c4_20 > 0 & c6_21 > 0 & c6_22 > 0 & c4_23 > 0 & c4_24 > 0 & c6_25 > 0 & c6_26 > 0 & c4_27 > 0 & c4_28 > 0 & c6_29 > 0 & c6_30 > 0 & c4_31 > 0 & c4_32 > 0 & c6_33 > 0 & c6_34 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c6_3 * dt*i ) + ( c6_4 * Q ) = 0 )
            & ( ( c6_5 * dt*i ) + ( c6_6 * Q ) = 0 )
            & ( ( c4_7 * E*h ) + ( c4_8 * UH ) = 0 )
            & ( ( c6_9 * dt*i ) + ( c6_10 * Q ) = 0 )
            & ( ( c4_11 * E*h ) + ( c4_12 * UH ) = 0 )
            & ( ( c6_13 * dt*i ) + ( c6_14 * Q ) = 0 )
            & ( ( c4_15 * E*h ) + ( c4_16 * UH ) = 0 )
            & ( ( c6_17 * dt*i ) + ( c6_18 * Q ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c6_21 * dt*i ) + ( c6_22 * Q ) = 0 )
            & ( ( c4_23 * E*h ) + ( c4_24 * UH ) = 0 )
            & ( ( c6_25 * dt*i ) + ( c6_26 * Q ) = 0 )
            & ( ( c4_27 * E*h ) + ( c4_28 * UH ) = 0 )
            & ( ( c6_29 * dt*i ) + ( c6_30 * Q ) = 0 )
            & ( ( c4_31 * E*h ) + ( c4_32 * UH ) = 0 )
            & ( ( c6_33 * dt*i ) + ( c6_34 * Q ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
