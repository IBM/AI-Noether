ArchiveEntry "hall_target1_combo6_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c8_1;
  Real c8_2;
  Real c6_3;
  Real c6_4;
  Real c8_5;
  Real c8_6;
  Real c6_7;
  Real c6_8;
  Real c8_9;
  Real c8_10;
  Real c6_11;
  Real c6_12;
  Real c8_13;
  Real c8_14;
  Real c6_15;
  Real c6_16;
  Real c8_17;
  Real c8_18;
  Real c6_19;
  Real c6_20;
  Real c6_21;
  Real c6_22;
  Real c8_23;
  Real c8_24;
  Real c6_25;
  Real c6_26;
  Real c8_27;
  Real c8_28;
  Real c6_29;
  Real c6_30;
  Real c8_31;
  Real c8_32;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c8_1 \exists c8_2 \exists c6_3 \exists c6_4 \exists c8_5 \exists c8_6 \exists c6_7 \exists c6_8 \exists c8_9 \exists c8_10 \exists c6_11 \exists c6_12 \exists c8_13 \exists c8_14 \exists c6_15 \exists c6_16 \exists c8_17 \exists c8_18 \exists c6_19 \exists c6_20 \exists c6_21 \exists c6_22 \exists c8_23 \exists c8_24 \exists c6_25 \exists c6_26 \exists c8_27 \exists c8_28 \exists c6_29 \exists c6_30 \exists c8_31 \exists c8_32 \exists d1 \exists d2
    (
      c8_1 > 0 & c8_2 > 0 & c6_3 > 0 & c6_4 > 0 & c8_5 > 0 & c8_6 > 0 & c6_7 > 0 & c6_8 > 0 & c8_9 > 0 & c8_10 > 0 & c6_11 > 0 & c6_12 > 0 & c8_13 > 0 & c8_14 > 0 & c6_15 > 0 & c6_16 > 0 & c8_17 > 0 & c8_18 > 0 & c6_19 > 0 & c6_20 > 0 & c6_21 > 0 & c6_22 > 0 & c8_23 > 0 & c8_24 > 0 & c6_25 > 0 & c6_26 > 0 & c8_27 > 0 & c8_28 > 0 & c6_29 > 0 & c6_30 > 0 & c8_31 > 0 & c8_32 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c8_1 * N ) + ( c8_2 * V*n ) = 0 )
            & ( ( c6_3 * dt*i ) + ( c6_4 * Q ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c6_7 * dt*i ) + ( c6_8 * Q ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c6_11 * dt*i ) + ( c6_12 * Q ) = 0 )
            & ( ( c8_13 * N ) + ( c8_14 * V*n ) = 0 )
            & ( ( c6_15 * dt*i ) + ( c6_16 * Q ) = 0 )
            & ( ( c8_17 * N ) + ( c8_18 * V*n ) = 0 )
            & ( ( c6_19 * dt*i ) + ( c6_20 * Q ) = 0 )
            & ( ( c6_21 * dt*i ) + ( c6_22 * Q ) = 0 )
            & ( ( c8_23 * N ) + ( c8_24 * V*n ) = 0 )
            & ( ( c6_25 * dt*i ) + ( c6_26 * Q ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
            & ( ( c6_29 * dt*i ) + ( c6_30 * Q ) = 0 )
            & ( ( c8_31 * N ) + ( c8_32 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
