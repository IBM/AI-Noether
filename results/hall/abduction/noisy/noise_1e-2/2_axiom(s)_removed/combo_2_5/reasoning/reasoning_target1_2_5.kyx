ArchiveEntry "hall_target1_combo2_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c2_1;
  Real c2_2;
  Real c5_3;
  Real c5_4;
  Real c2_5;
  Real c2_6;
  Real c5_7;
  Real c5_8;
  Real c2_9;
  Real c2_10;
  Real c5_11;
  Real c5_12;
  Real c2_13;
  Real c2_14;
  Real c5_15;
  Real c5_16;
  Real c2_17;
  Real c2_18;
  Real c5_19;
  Real c5_20;
  Real c2_21;
  Real c2_22;
  Real c5_23;
  Real c5_24;
  Real c2_25;
  Real c2_26;
  Real c5_27;
  Real c5_28;
  Real c2_29;
  Real c2_30;
  Real c5_31;
  Real c5_32;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c5_3 \exists c5_4 \exists c2_5 \exists c2_6 \exists c5_7 \exists c5_8 \exists c2_9 \exists c2_10 \exists c5_11 \exists c5_12 \exists c2_13 \exists c2_14 \exists c5_15 \exists c5_16 \exists c2_17 \exists c2_18 \exists c5_19 \exists c5_20 \exists c2_21 \exists c2_22 \exists c5_23 \exists c5_24 \exists c2_25 \exists c2_26 \exists c5_27 \exists c5_28 \exists c2_29 \exists c2_30 \exists c5_31 \exists c5_32 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c5_3 > 0 & c5_4 > 0 & c2_5 > 0 & c2_6 > 0 & c5_7 > 0 & c5_8 > 0 & c2_9 > 0 & c2_10 > 0 & c5_11 > 0 & c5_12 > 0 & c2_13 > 0 & c2_14 > 0 & c5_15 > 0 & c5_16 > 0 & c2_17 > 0 & c2_18 > 0 & c5_19 > 0 & c5_20 > 0 & c2_21 > 0 & c2_22 > 0 & c5_23 > 0 & c5_24 > 0 & c2_25 > 0 & c2_26 > 0 & c5_27 > 0 & c5_28 > 0 & c2_29 > 0 & c2_30 > 0 & c5_31 > 0 & c5_32 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c2_1 * Fe ) + ( c2_2 * E*qe ) = 0 )
            & ( ( c5_3 * v*dt ) + ( c5_4 * L ) = 0 )
            & ( ( c2_5 * Fe ) + ( c2_6 * E*qe ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c2_9 * Fe ) + ( c2_10 * E*qe ) = 0 )
            & ( ( c5_11 * v*dt ) + ( c5_12 * L ) = 0 )
            & ( ( c2_13 * Fe ) + ( c2_14 * E*qe ) = 0 )
            & ( ( c5_15 * v*dt ) + ( c5_16 * L ) = 0 )
            & ( ( c2_17 * Fe ) + ( c2_18 * E*qe ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c2_21 * Fe ) + ( c2_22 * E*qe ) = 0 )
            & ( ( c5_23 * v*dt ) + ( c5_24 * L ) = 0 )
            & ( ( c2_25 * Fe ) + ( c2_26 * E*qe ) = 0 )
            & ( ( c5_27 * v*dt ) + ( c5_28 * L ) = 0 )
            & ( ( c2_29 * Fe ) + ( c2_30 * E*qe ) = 0 )
            & ( ( c5_31 * v*dt ) + ( c5_32 * L ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
