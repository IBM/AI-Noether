ArchiveEntry "hall_target1_combo4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c5_3;
  Real c5_4;
  Real c4_5;
  Real c4_6;
  Real c5_7;
  Real c5_8;
  Real c5_9;
  Real c5_10;
  Real c4_11;
  Real c4_12;
  Real c5_13;
  Real c5_14;
  Real c4_15;
  Real c4_16;
  Real c5_17;
  Real c5_18;
  Real c4_19;
  Real c4_20;
  Real c5_21;
  Real c5_22;
  Real c4_23;
  Real c4_24;
  Real c5_25;
  Real c5_26;
  Real c4_27;
  Real c4_28;
  Real c5_29;
  Real c5_30;
  Real c4_31;
  Real c4_32;
  Real c5_33;
  Real c5_34;
  Real c4_35;
  Real c4_36;
  Real c5_37;
  Real c5_38;
  Real c4_39;
  Real c4_40;
  Real c5_41;
  Real c5_42;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c5_3 \exists c5_4 \exists c4_5 \exists c4_6 \exists c5_7 \exists c5_8 \exists c5_9 \exists c5_10 \exists c4_11 \exists c4_12 \exists c5_13 \exists c5_14 \exists c4_15 \exists c4_16 \exists c5_17 \exists c5_18 \exists c4_19 \exists c4_20 \exists c5_21 \exists c5_22 \exists c4_23 \exists c4_24 \exists c5_25 \exists c5_26 \exists c4_27 \exists c4_28 \exists c5_29 \exists c5_30 \exists c4_31 \exists c4_32 \exists c5_33 \exists c5_34 \exists c4_35 \exists c4_36 \exists c5_37 \exists c5_38 \exists c4_39 \exists c4_40 \exists c5_41 \exists c5_42 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c5_3 > 0 & c5_4 > 0 & c4_5 > 0 & c4_6 > 0 & c5_7 > 0 & c5_8 > 0 & c5_9 > 0 & c5_10 > 0 & c4_11 > 0 & c4_12 > 0 & c5_13 > 0 & c5_14 > 0 & c4_15 > 0 & c4_16 > 0 & c5_17 > 0 & c5_18 > 0 & c4_19 > 0 & c4_20 > 0 & c5_21 > 0 & c5_22 > 0 & c4_23 > 0 & c4_24 > 0 & c5_25 > 0 & c5_26 > 0 & c4_27 > 0 & c4_28 > 0 & c5_29 > 0 & c5_30 > 0 & c4_31 > 0 & c4_32 > 0 & c5_33 > 0 & c5_34 > 0 & c4_35 > 0 & c4_36 > 0 & c5_37 > 0 & c5_38 > 0 & c4_39 > 0 & c4_40 > 0 & c5_41 > 0 & c5_42 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c5_3 * v*dt ) + ( c5_4 * L ) = 0 )
            & ( ( c4_5 * E*h ) + ( c4_6 * UH ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c5_9 * v*dt ) + ( c5_10 * L ) = 0 )
            & ( ( c4_11 * E*h ) + ( c4_12 * UH ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c4_15 * E*h ) + ( c4_16 * UH ) = 0 )
            & ( ( c5_17 * v*dt ) + ( c5_18 * L ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c5_21 * v*dt ) + ( c5_22 * L ) = 0 )
            & ( ( c4_23 * E*h ) + ( c4_24 * UH ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c4_27 * E*h ) + ( c4_28 * UH ) = 0 )
            & ( ( c5_29 * v*dt ) + ( c5_30 * L ) = 0 )
            & ( ( c4_31 * E*h ) + ( c4_32 * UH ) = 0 )
            & ( ( c5_33 * v*dt ) + ( c5_34 * L ) = 0 )
            & ( ( c4_35 * E*h ) + ( c4_36 * UH ) = 0 )
            & ( ( c5_37 * v*dt ) + ( c5_38 * L ) = 0 )
            & ( ( c4_39 * E*h ) + ( c4_40 * UH ) = 0 )
            & ( ( c5_41 * v*dt ) + ( c5_42 * L ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
