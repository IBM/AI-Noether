ArchiveEntry "hall_target1_combo1_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c5_3;
  Real c5_4;
  Real c1_5;
  Real c1_6;
  Real c5_7;
  Real c5_8;
  Real c1_9;
  Real c1_10;
  Real c5_11;
  Real c5_12;
  Real c1_13;
  Real c1_14;
  Real c5_15;
  Real c5_16;
  Real c1_17;
  Real c1_18;
  Real c5_19;
  Real c5_20;
  Real c1_21;
  Real c1_22;
  Real c5_23;
  Real c5_24;
  Real c1_25;
  Real c1_26;
  Real c5_27;
  Real c5_28;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c5_3 \exists c5_4 \exists c1_5 \exists c1_6 \exists c5_7 \exists c5_8 \exists c1_9 \exists c1_10 \exists c5_11 \exists c5_12 \exists c1_13 \exists c1_14 \exists c5_15 \exists c5_16 \exists c1_17 \exists c1_18 \exists c5_19 \exists c5_20 \exists c1_21 \exists c1_22 \exists c5_23 \exists c5_24 \exists c1_25 \exists c1_26 \exists c5_27 \exists c5_28 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c5_3 > 0 & c5_4 > 0 & c1_5 > 0 & c1_6 > 0 & c5_7 > 0 & c5_8 > 0 & c1_9 > 0 & c1_10 > 0 & c5_11 > 0 & c5_12 > 0 & c1_13 > 0 & c1_14 > 0 & c5_15 > 0 & c5_16 > 0 & c1_17 > 0 & c1_18 > 0 & c5_19 > 0 & c5_20 > 0 & c1_21 > 0 & c1_22 > 0 & c5_23 > 0 & c5_24 > 0 & c1_25 > 0 & c1_26 > 0 & c5_27 > 0 & c5_28 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c5_3 * v*dt ) + ( c5_4 * L ) = 0 )
            & ( ( c1_5 * Fm ) + ( c1_6 * v*qe*B ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c1_9 * Fm ) + ( c1_10 * v*qe*B ) = 0 )
            & ( ( c5_11 * v*dt ) + ( c5_12 * L ) = 0 )
            & ( ( c1_13 * Fm ) + ( c1_14 * v*qe*B ) = 0 )
            & ( ( c5_15 * v*dt ) + ( c5_16 * L ) = 0 )
            & ( ( c1_17 * Fm ) + ( c1_18 * v*qe*B ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c1_21 * Fm ) + ( c1_22 * v*qe*B ) = 0 )
            & ( ( c5_23 * v*dt ) + ( c5_24 * L ) = 0 )
            & ( ( c1_25 * Fm ) + ( c1_26 * v*qe*B ) = 0 )
            & ( ( c5_27 * v*dt ) + ( c5_28 * L ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
