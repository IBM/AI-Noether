ArchiveEntry "hall_target1_combo2_3_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c2_1;
  Real c2_2;
  Real c3_3;
  Real c3_4;
  Real c8_5;
  Real c8_6;
  Real c3_7;
  Real c3_8;
  Real c8_9;
  Real c8_10;
  Real c2_11;
  Real c2_12;
  Real c8_13;
  Real c8_14;
  Real c2_15;
  Real c2_16;
  Real c8_17;
  Real c8_18;
  Real c2_19;
  Real c2_20;
  Real c3_21;
  Real c3_22;
  Real c2_23;
  Real c2_24;
  Real c3_25;
  Real c3_26;
  Real c8_27;
  Real c8_28;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c3_3 \exists c3_4 \exists c8_5 \exists c8_6 \exists c3_7 \exists c3_8 \exists c8_9 \exists c8_10 \exists c2_11 \exists c2_12 \exists c8_13 \exists c8_14 \exists c2_15 \exists c2_16 \exists c8_17 \exists c8_18 \exists c2_19 \exists c2_20 \exists c3_21 \exists c3_22 \exists c2_23 \exists c2_24 \exists c3_25 \exists c3_26 \exists c8_27 \exists c8_28 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c3_3 > 0 & c3_4 > 0 & c8_5 > 0 & c8_6 > 0 & c3_7 > 0 & c3_8 > 0 & c8_9 > 0 & c8_10 > 0 & c2_11 > 0 & c2_12 > 0 & c8_13 > 0 & c8_14 > 0 & c2_15 > 0 & c2_16 > 0 & c8_17 > 0 & c8_18 > 0 & c2_19 > 0 & c2_20 > 0 & c3_21 > 0 & c3_22 > 0 & c2_23 > 0 & c2_24 > 0 & c3_25 > 0 & c3_26 > 0 & c8_27 > 0 & c8_28 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c2_1 * Fe ) + ( c2_2 * E*qe ) = 0 )
            & ( ( c3_3 * Fm ) + ( c3_4 * Fe ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c3_7 * Fm ) + ( c3_8 * Fe ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c2_11 * Fe ) + ( c2_12 * E*qe ) = 0 )
            & ( ( c8_13 * N ) + ( c8_14 * V*n ) = 0 )
            & ( ( c2_15 * Fe ) + ( c2_16 * E*qe ) = 0 )
            & ( ( c8_17 * N ) + ( c8_18 * V*n ) = 0 )
            & ( ( c2_19 * Fe ) + ( c2_20 * E*qe ) = 0 )
            & ( ( c3_21 * Fm ) + ( c3_22 * Fe ) = 0 )
            & ( ( c2_23 * Fe ) + ( c2_24 * E*qe ) = 0 )
            & ( ( c3_25 * Fm ) + ( c3_26 * Fe ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
