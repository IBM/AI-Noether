            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( Q - N*qe = 0 )
            & ( ( c8_1 * N ) + ( c8_2 * V*n ) = 0 )
            & ( ( c9_3 * d*h*L ) + ( c9_4 * V ) = 0 )
            & ( ( c6_5 * dt*i ) + ( c6_6 * Q ) = 0 )
            & ( ( c8_7 * N ) + ( c8_8 * V*n ) = 0 )
            & ( ( c9_9 * d*h*L ) + ( c9_10 * V ) = 0 )
            & ( ( c6_11 * dt*i ) + ( c6_12 * Q ) = 0 )
            & ( ( c8_13 * N ) + ( c8_14 * V*n ) = 0 )
            & ( ( c9_15 * d*h*L ) + ( c9_16 * V ) = 0 )
            & ( ( c6_17 * dt*i ) + ( c6_18 * Q ) = 0 )
            & ( ( c8_19 * N ) + ( c8_20 * V*n ) = 0 )
            & ( ( c9_21 * d*h*L ) + ( c9_22 * V ) = 0 )
            & ( ( c6_23 * dt*i ) + ( c6_24 * Q ) = 0 )
            & ( ( c8_25 * N ) + ( c8_26 * V*n ) = 0 )
            & ( ( c9_27 * d*h*L ) + ( c9_28 * V ) = 0 )
            & ( ( c6_29 * dt*i ) + ( c6_30 * Q ) = 0 )
            & ( ( c8_31 * N ) + ( c8_32 * V*n ) = 0 )
            & ( ( c9_33 * d*h*L ) + ( c9_34 * V ) = 0 )
            & ( ( c6_35 * dt*i ) + ( c6_36 * Q ) = 0 )
            & ( ( c8_37 * N ) + ( c8_38 * V*n ) = 0 )
            & ( ( c9_39 * d*h*L ) + ( c9_40 * V ) = 0 )
            & ( ( c6_41 * dt*i ) + ( c6_42 * Q ) = 0 )
            & ( ( c8_43 * N ) + ( c8_44 * V*n ) = 0 )
            & ( ( c9_45 * d*h*L ) + ( c9_46 * V ) = 0 )
            & ( ( c6_47 * dt*i ) + ( c6_48 * Q ) = 0 )
            & ( ( c8_49 * N ) + ( c8_50 * V*n ) = 0 )
            & ( ( c9_51 * d*h*L ) + ( c9_52 * V ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
