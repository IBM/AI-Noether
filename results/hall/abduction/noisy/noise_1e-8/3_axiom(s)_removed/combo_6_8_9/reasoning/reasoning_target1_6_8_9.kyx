End.

Problem
  (
    \exists c8_1 \exists c8_2 \exists c9_3 \exists c9_4 \exists c6_5 \exists c6_6 \exists c8_7 \exists c8_8 \exists c9_9 \exists c9_10 \exists c6_11 \exists c6_12 \exists c8_13 \exists c8_14 \exists c9_15 \exists c9_16 \exists c6_17 \exists c6_18 \exists c8_19 \exists c8_20 \exists c9_21 \exists c9_22 \exists c6_23 \exists c6_24 \exists c8_25 \exists c8_26 \exists c9_27 \exists c9_28 \exists c6_29 \exists c6_30 \exists c8_31 \exists c8_32 \exists c9_33 \exists c9_34 \exists c6_35 \exists c6_36 \exists c8_37 \exists c8_38 \exists c9_39 \exists c9_40 \exists c6_41 \exists c6_42 \exists c8_43 \exists c8_44 \exists c9_45 \exists c9_46 \exists c6_47 \exists c6_48 \exists c8_49 \exists c8_50 \exists c9_51 \exists c9_52 \exists d1 \exists d2
    (
      c8_1 > 0 & c8_2 > 0 & c9_3 > 0 & c9_4 > 0 & c6_5 > 0 & c6_6 > 0 & c8_7 > 0 & c8_8 > 0 & c9_9 > 0 & c9_10 > 0 & c6_11 > 0 & c6_12 > 0 & c8_13 > 0 & c8_14 > 0 & c9_15 > 0 & c9_16 > 0 & c6_17 > 0 & c6_18 > 0 & c8_19 > 0 & c8_20 > 0 & c9_21 > 0 & c9_22 > 0 & c6_23 > 0 & c6_24 > 0 & c8_25 > 0 & c8_26 > 0 & c9_27 > 0 & c9_28 > 0 & c6_29 > 0 & c6_30 > 0 & c8_31 > 0 & c8_32 > 0 & c9_33 > 0 & c9_34 > 0 & c6_35 > 0 & c6_36 > 0 & c8_37 > 0 & c8_38 > 0 & c9_39 > 0 & c9_40 > 0 & c6_41 > 0 & c6_42 > 0 & c8_43 > 0 & c8_44 > 0 & c9_45 > 0 & c9_46 > 0 & c6_47 > 0 & c6_48 > 0 & c8_49 > 0 & c8_50 > 0 & c9_51 > 0 & c9_52 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
