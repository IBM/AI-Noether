ArchiveEntry "hall_target1_combo5_6_7"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c6_1;
  Real c6_2;
  Real c7_3;
  Real c7_4;
  Real c5_5;
  Real c5_6;
  Real c6_7;
  Real c6_8;
  Real c7_9;
  Real c7_10;
  Real c5_11;
  Real c5_12;
  Real c6_13;
  Real c6_14;
  Real c7_15;
  Real c7_16;
  Real c5_17;
  Real c5_18;
  Real c6_19;
  Real c6_20;
  Real c7_21;
  Real c7_22;
  Real c5_23;
  Real c5_24;
  Real c6_25;
  Real c6_26;
  Real c7_27;
  Real c7_28;
  Real c5_29;
  Real c5_30;
  Real c6_31;
  Real c6_32;
  Real c7_33;
  Real c7_34;
  Real c5_35;
  Real c5_36;
  Real c6_37;
  Real c6_38;
  Real c7_39;
  Real c7_40;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c6_1 \exists c6_2 \exists c7_3 \exists c7_4 \exists c5_5 \exists c5_6 \exists c6_7 \exists c6_8 \exists c7_9 \exists c7_10 \exists c5_11 \exists c5_12 \exists c6_13 \exists c6_14 \exists c7_15 \exists c7_16 \exists c5_17 \exists c5_18 \exists c6_19 \exists c6_20 \exists c7_21 \exists c7_22 \exists c5_23 \exists c5_24 \exists c6_25 \exists c6_26 \exists c7_27 \exists c7_28 \exists c5_29 \exists c5_30 \exists c6_31 \exists c6_32 \exists c7_33 \exists c7_34 \exists c5_35 \exists c5_36 \exists c6_37 \exists c6_38 \exists c7_39 \exists c7_40 \exists d1 \exists d2
    (
      c6_1 > 0 & c6_2 > 0 & c7_3 > 0 & c7_4 > 0 & c5_5 > 0 & c5_6 > 0 & c6_7 > 0 & c6_8 > 0 & c7_9 > 0 & c7_10 > 0 & c5_11 > 0 & c5_12 > 0 & c6_13 > 0 & c6_14 > 0 & c7_15 > 0 & c7_16 > 0 & c5_17 > 0 & c5_18 > 0 & c6_19 > 0 & c6_20 > 0 & c7_21 > 0 & c7_22 > 0 & c5_23 > 0 & c5_24 > 0 & c6_25 > 0 & c6_26 > 0 & c7_27 > 0 & c7_28 > 0 & c5_29 > 0 & c5_30 > 0 & c6_31 > 0 & c6_32 > 0 & c7_33 > 0 & c7_34 > 0 & c5_35 > 0 & c5_36 > 0 & c6_37 > 0 & c6_38 > 0 & c7_39 > 0 & c7_40 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c6_1 * dt*i ) + ( c6_2 * Q ) = 0 )
            & ( ( c7_3 * Q ) + ( c7_4 * N*qe ) = 0 )
            & ( ( c5_5 * v*dt ) + ( c5_6 * L ) = 0 )
            & ( ( c6_7 * dt*i ) + ( c6_8 * Q ) = 0 )
            & ( ( c7_9 * Q ) + ( c7_10 * N*qe ) = 0 )
            & ( ( c5_11 * v*dt ) + ( c5_12 * L ) = 0 )
            & ( ( c6_13 * dt*i ) + ( c6_14 * Q ) = 0 )
            & ( ( c7_15 * Q ) + ( c7_16 * N*qe ) = 0 )
            & ( ( c5_17 * v*dt ) + ( c5_18 * L ) = 0 )
            & ( ( c6_19 * dt*i ) + ( c6_20 * Q ) = 0 )
            & ( ( c7_21 * Q ) + ( c7_22 * N*qe ) = 0 )
            & ( ( c5_23 * v*dt ) + ( c5_24 * L ) = 0 )
            & ( ( c6_25 * dt*i ) + ( c6_26 * Q ) = 0 )
            & ( ( c7_27 * Q ) + ( c7_28 * N*qe ) = 0 )
            & ( ( c5_29 * v*dt ) + ( c5_30 * L ) = 0 )
            & ( ( c6_31 * dt*i ) + ( c6_32 * Q ) = 0 )
            & ( ( c7_33 * Q ) + ( c7_34 * N*qe ) = 0 )
            & ( ( c5_35 * v*dt ) + ( c5_36 * L ) = 0 )
            & ( ( c6_37 * dt*i ) + ( c6_38 * Q ) = 0 )
            & ( ( c7_39 * Q ) + ( c7_40 * N*qe ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
