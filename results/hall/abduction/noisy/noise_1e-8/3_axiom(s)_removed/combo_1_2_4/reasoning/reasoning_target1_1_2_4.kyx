ArchiveEntry "hall_target1_combo1_2_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c2_3;
  Real c2_4;
  Real c4_5;
  Real c4_6;
  Real c1_7;
  Real c1_8;
  Real c2_9;
  Real c2_10;
  Real c4_11;
  Real c4_12;
  Real c1_13;
  Real c1_14;
  Real c2_15;
  Real c2_16;
  Real c4_17;
  Real c4_18;
  Real c1_19;
  Real c1_20;
  Real c2_21;
  Real c2_22;
  Real c4_23;
  Real c4_24;
  Real c1_25;
  Real c1_26;
  Real c2_27;
  Real c2_28;
  Real c4_29;
  Real c4_30;
  Real c1_31;
  Real c1_32;
  Real c2_33;
  Real c2_34;
  Real c4_35;
  Real c4_36;
  Real c1_37;
  Real c1_38;
  Real c2_39;
  Real c2_40;
  Real c4_41;
  Real c4_42;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c2_3 \exists c2_4 \exists c4_5 \exists c4_6 \exists c1_7 \exists c1_8 \exists c2_9 \exists c2_10 \exists c4_11 \exists c4_12 \exists c1_13 \exists c1_14 \exists c2_15 \exists c2_16 \exists c4_17 \exists c4_18 \exists c1_19 \exists c1_20 \exists c2_21 \exists c2_22 \exists c4_23 \exists c4_24 \exists c1_25 \exists c1_26 \exists c2_27 \exists c2_28 \exists c4_29 \exists c4_30 \exists c1_31 \exists c1_32 \exists c2_33 \exists c2_34 \exists c4_35 \exists c4_36 \exists c1_37 \exists c1_38 \exists c2_39 \exists c2_40 \exists c4_41 \exists c4_42 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c2_3 > 0 & c2_4 > 0 & c4_5 > 0 & c4_6 > 0 & c1_7 > 0 & c1_8 > 0 & c2_9 > 0 & c2_10 > 0 & c4_11 > 0 & c4_12 > 0 & c1_13 > 0 & c1_14 > 0 & c2_15 > 0 & c2_16 > 0 & c4_17 > 0 & c4_18 > 0 & c1_19 > 0 & c1_20 > 0 & c2_21 > 0 & c2_22 > 0 & c4_23 > 0 & c4_24 > 0 & c1_25 > 0 & c1_26 > 0 & c2_27 > 0 & c2_28 > 0 & c4_29 > 0 & c4_30 > 0 & c1_31 > 0 & c1_32 > 0 & c2_33 > 0 & c2_34 > 0 & c4_35 > 0 & c4_36 > 0 & c1_37 > 0 & c1_38 > 0 & c2_39 > 0 & c2_40 > 0 & c4_41 > 0 & c4_42 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c2_3 * Fe ) + ( c2_4 * E*qe ) = 0 )
            & ( ( c4_5 * E*h ) + ( c4_6 * UH ) = 0 )
            & ( ( c1_7 * Fm ) + ( c1_8 * v*qe*B ) = 0 )
            & ( ( c2_9 * Fe ) + ( c2_10 * E*qe ) = 0 )
            & ( ( c4_11 * E*h ) + ( c4_12 * UH ) = 0 )
            & ( ( c1_13 * Fm ) + ( c1_14 * v*qe*B ) = 0 )
            & ( ( c2_15 * Fe ) + ( c2_16 * E*qe ) = 0 )
            & ( ( c4_17 * E*h ) + ( c4_18 * UH ) = 0 )
            & ( ( c1_19 * Fm ) + ( c1_20 * v*qe*B ) = 0 )
            & ( ( c2_21 * Fe ) + ( c2_22 * E*qe ) = 0 )
            & ( ( c4_23 * E*h ) + ( c4_24 * UH ) = 0 )
            & ( ( c1_25 * Fm ) + ( c1_26 * v*qe*B ) = 0 )
            & ( ( c2_27 * Fe ) + ( c2_28 * E*qe ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c1_31 * Fm ) + ( c1_32 * v*qe*B ) = 0 )
            & ( ( c2_33 * Fe ) + ( c2_34 * E*qe ) = 0 )
            & ( ( c4_35 * E*h ) + ( c4_36 * UH ) = 0 )
            & ( ( c1_37 * Fm ) + ( c1_38 * v*qe*B ) = 0 )
            & ( ( c2_39 * Fe ) + ( c2_40 * E*qe ) = 0 )
            & ( ( c4_41 * E*h ) + ( c4_42 * UH ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
