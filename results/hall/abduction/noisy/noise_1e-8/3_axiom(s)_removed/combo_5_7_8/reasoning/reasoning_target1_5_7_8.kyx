ArchiveEntry "hall_target1_combo5_7_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c5_1;
  Real c5_2;
  Real c7_3;
  Real c7_4;
  Real c8_5;
  Real c8_6;
  Real c7_7;
  Real c7_8;
  Real c8_9;
  Real c8_10;
  Real c7_11;
  Real c7_12;
  Real c8_13;
  Real c8_14;
  Real c5_15;
  Real c5_16;
  Real c7_17;
  Real c7_18;
  Real c5_19;
  Real c5_20;
  Real c7_21;
  Real c7_22;
  Real c5_23;
  Real c5_24;
  Real c7_25;
  Real c7_26;
  Real c8_27;
  Real c8_28;
  Real c5_29;
  Real c5_30;
  Real c7_31;
  Real c7_32;
  Real c8_33;
  Real c8_34;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c7_3 \exists c7_4 \exists c8_5 \exists c8_6 \exists c7_7 \exists c7_8 \exists c8_9 \exists c8_10 \exists c7_11 \exists c7_12 \exists c8_13 \exists c8_14 \exists c5_15 \exists c5_16 \exists c7_17 \exists c7_18 \exists c5_19 \exists c5_20 \exists c7_21 \exists c7_22 \exists c5_23 \exists c5_24 \exists c7_25 \exists c7_26 \exists c8_27 \exists c8_28 \exists c5_29 \exists c5_30 \exists c7_31 \exists c7_32 \exists c8_33 \exists c8_34 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c7_3 > 0 & c7_4 > 0 & c8_5 > 0 & c8_6 > 0 & c7_7 > 0 & c7_8 > 0 & c8_9 > 0 & c8_10 > 0 & c7_11 > 0 & c7_12 > 0 & c8_13 > 0 & c8_14 > 0 & c5_15 > 0 & c5_16 > 0 & c7_17 > 0 & c7_18 > 0 & c5_19 > 0 & c5_20 > 0 & c7_21 > 0 & c7_22 > 0 & c5_23 > 0 & c5_24 > 0 & c7_25 > 0 & c7_26 > 0 & c8_27 > 0 & c8_28 > 0 & c5_29 > 0 & c5_30 > 0 & c7_31 > 0 & c7_32 > 0 & c8_33 > 0 & c8_34 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c5_1 * v*dt ) + ( c5_2 * L ) = 0 )
            & ( ( c7_3 * Q ) + ( c7_4 * N*qe ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c7_7 * Q ) + ( c7_8 * N*qe ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c7_11 * Q ) + ( c7_12 * N*qe ) = 0 )
            & ( ( c8_13 * N ) + ( c8_14 * V*n ) = 0 )
            & ( ( c5_15 * v*dt ) + ( c5_16 * L ) = 0 )
            & ( ( c7_17 * Q ) + ( c7_18 * N*qe ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c7_21 * Q ) + ( c7_22 * N*qe ) = 0 )
            & ( ( c5_23 * v*dt ) + ( c5_24 * L ) = 0 )
            & ( ( c7_25 * Q ) + ( c7_26 * N*qe ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
            & ( ( c5_29 * v*dt ) + ( c5_30 * L ) = 0 )
            & ( ( c7_31 * Q ) + ( c7_32 * N*qe ) = 0 )
            & ( ( c8_33 * N ) + ( c8_34 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
