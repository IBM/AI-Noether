End.

Problem
  (
    \exists c6_1 \exists c6_2 \exists c7_3 \exists c7_4 \exists c9_5 \exists c9_6 \exists c6_7 \exists c6_8 \exists c7_9 \exists c7_10 \exists c9_11 \exists c9_12 \exists c6_13 \exists c6_14 \exists c7_15 \exists c7_16 \exists c9_17 \exists c9_18 \exists c6_19 \exists c6_20 \exists c7_21 \exists c7_22 \exists c9_23 \exists c9_24 \exists c6_25 \exists c6_26 \exists c7_27 \exists c7_28 \exists c9_29 \exists c9_30 \exists c6_31 \exists c6_32 \exists c7_33 \exists c7_34 \exists c9_35 \exists c9_36 \exists c6_37 \exists c6_38 \exists c7_39 \exists c7_40 \exists c9_41 \exists c9_42 \exists c6_43 \exists c6_44 \exists c7_45 \exists c7_46 \exists c9_47 \exists c9_48 \exists c6_49 \exists c6_50 \exists c7_51 \exists c7_52 \exists c9_53 \exists c9_54 \exists d1 \exists d2
    (
      c6_1 > 0 & c6_2 > 0 & c7_3 > 0 & c7_4 > 0 & c9_5 > 0 & c9_6 > 0 & c6_7 > 0 & c6_8 > 0 & c7_9 > 0 & c7_10 > 0 & c9_11 > 0 & c9_12 > 0 & c6_13 > 0 & c6_14 > 0 & c7_15 > 0 & c7_16 > 0 & c9_17 > 0 & c9_18 > 0 & c6_19 > 0 & c6_20 > 0 & c7_21 > 0 & c7_22 > 0 & c9_23 > 0 & c9_24 > 0 & c6_25 > 0 & c6_26 > 0 & c7_27 > 0 & c7_28 > 0 & c9_29 > 0 & c9_30 > 0 & c6_31 > 0 & c6_32 > 0 & c7_33 > 0 & c7_34 > 0 & c9_35 > 0 & c9_36 > 0 & c6_37 > 0 & c6_38 > 0 & c7_39 > 0 & c7_40 > 0 & c9_41 > 0 & c9_42 > 0 & c6_43 > 0 & c6_44 > 0 & c7_45 > 0 & c7_46 > 0 & c9_47 > 0 & c9_48 > 0 & c6_49 > 0 & c6_50 > 0 & c7_51 > 0 & c7_52 > 0 & c9_53 > 0 & c9_54 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
