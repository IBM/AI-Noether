ArchiveEntry "hall_target1_combo4_6_7"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c6_3;
  Real c6_4;
  Real c7_5;
  Real c7_6;
  Real c4_7;
  Real c4_8;
  Real c6_9;
  Real c6_10;
  Real c7_11;
  Real c7_12;
  Real c4_13;
  Real c4_14;
  Real c6_15;
  Real c6_16;
  Real c7_17;
  Real c7_18;
  Real c4_19;
  Real c4_20;
  Real c6_21;
  Real c6_22;
  Real c7_23;
  Real c7_24;
  Real c6_25;
  Real c6_26;
  Real c7_27;
  Real c7_28;
  Real c4_29;
  Real c4_30;
  Real c6_31;
  Real c6_32;
  Real c7_33;
  Real c7_34;
  Real c4_35;
  Real c4_36;
  Real c6_37;
  Real c6_38;
  Real c7_39;
  Real c7_40;
  Real c4_41;
  Real c4_42;
  Real c7_43;
  Real c7_44;
  Real c4_45;
  Real c4_46;
  Real c7_47;
  Real c7_48;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c6_3 \exists c6_4 \exists c7_5 \exists c7_6 \exists c4_7 \exists c4_8 \exists c6_9 \exists c6_10 \exists c7_11 \exists c7_12 \exists c4_13 \exists c4_14 \exists c6_15 \exists c6_16 \exists c7_17 \exists c7_18 \exists c4_19 \exists c4_20 \exists c6_21 \exists c6_22 \exists c7_23 \exists c7_24 \exists c6_25 \exists c6_26 \exists c7_27 \exists c7_28 \exists c4_29 \exists c4_30 \exists c6_31 \exists c6_32 \exists c7_33 \exists c7_34 \exists c4_35 \exists c4_36 \exists c6_37 \exists c6_38 \exists c7_39 \exists c7_40 \exists c4_41 \exists c4_42 \exists c7_43 \exists c7_44 \exists c4_45 \exists c4_46 \exists c7_47 \exists c7_48 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c6_3 > 0 & c6_4 > 0 & c7_5 > 0 & c7_6 > 0 & c4_7 > 0 & c4_8 > 0 & c6_9 > 0 & c6_10 > 0 & c7_11 > 0 & c7_12 > 0 & c4_13 > 0 & c4_14 > 0 & c6_15 > 0 & c6_16 > 0 & c7_17 > 0 & c7_18 > 0 & c4_19 > 0 & c4_20 > 0 & c6_21 > 0 & c6_22 > 0 & c7_23 > 0 & c7_24 > 0 & c6_25 > 0 & c6_26 > 0 & c7_27 > 0 & c7_28 > 0 & c4_29 > 0 & c4_30 > 0 & c6_31 > 0 & c6_32 > 0 & c7_33 > 0 & c7_34 > 0 & c4_35 > 0 & c4_36 > 0 & c6_37 > 0 & c6_38 > 0 & c7_39 > 0 & c7_40 > 0 & c4_41 > 0 & c4_42 > 0 & c7_43 > 0 & c7_44 > 0 & c4_45 > 0 & c4_46 > 0 & c7_47 > 0 & c7_48 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c6_3 * dt*i ) + ( c6_4 * Q ) = 0 )
            & ( ( c7_5 * Q ) + ( c7_6 * N*qe ) = 0 )
            & ( ( c4_7 * E*h ) + ( c4_8 * UH ) = 0 )
            & ( ( c6_9 * dt*i ) + ( c6_10 * Q ) = 0 )
            & ( ( c7_11 * Q ) + ( c7_12 * N*qe ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c6_15 * dt*i ) + ( c6_16 * Q ) = 0 )
            & ( ( c7_17 * Q ) + ( c7_18 * N*qe ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c6_21 * dt*i ) + ( c6_22 * Q ) = 0 )
            & ( ( c7_23 * Q ) + ( c7_24 * N*qe ) = 0 )
            & ( ( c6_25 * dt*i ) + ( c6_26 * Q ) = 0 )
            & ( ( c7_27 * Q ) + ( c7_28 * N*qe ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c6_31 * dt*i ) + ( c6_32 * Q ) = 0 )
            & ( ( c7_33 * Q ) + ( c7_34 * N*qe ) = 0 )
            & ( ( c4_35 * E*h ) + ( c4_36 * UH ) = 0 )
            & ( ( c6_37 * dt*i ) + ( c6_38 * Q ) = 0 )
            & ( ( c7_39 * Q ) + ( c7_40 * N*qe ) = 0 )
            & ( ( c4_41 * E*h ) + ( c4_42 * UH ) = 0 )
            & ( ( c7_43 * Q ) + ( c7_44 * N*qe ) = 0 )
            & ( ( c4_45 * E*h ) + ( c4_46 * UH ) = 0 )
            & ( ( c7_47 * Q ) + ( c7_48 * N*qe ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
