ArchiveEntry "hall_target1_combo1_3_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c3_3;
  Real c3_4;
  Real c9_5;
  Real c9_6;
  Real c1_7;
  Real c1_8;
  Real c9_9;
  Real c9_10;
  Real c1_11;
  Real c1_12;
  Real c9_13;
  Real c9_14;
  Real c1_15;
  Real c1_16;
  Real c9_17;
  Real c9_18;
  Real c1_19;
  Real c1_20;
  Real c3_21;
  Real c3_22;
  Real c9_23;
  Real c9_24;
  Real c1_25;
  Real c1_26;
  Real c3_27;
  Real c3_28;
  Real c9_29;
  Real c9_30;
  Real c1_31;
  Real c1_32;
  Real c3_33;
  Real c3_34;
  Real c9_35;
  Real c9_36;
  Real c1_37;
  Real c1_38;
  Real c9_39;
  Real c9_40;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c3_3 \exists c3_4 \exists c9_5 \exists c9_6 \exists c1_7 \exists c1_8 \exists c9_9 \exists c9_10 \exists c1_11 \exists c1_12 \exists c9_13 \exists c9_14 \exists c1_15 \exists c1_16 \exists c9_17 \exists c9_18 \exists c1_19 \exists c1_20 \exists c3_21 \exists c3_22 \exists c9_23 \exists c9_24 \exists c1_25 \exists c1_26 \exists c3_27 \exists c3_28 \exists c9_29 \exists c9_30 \exists c1_31 \exists c1_32 \exists c3_33 \exists c3_34 \exists c9_35 \exists c9_36 \exists c1_37 \exists c1_38 \exists c9_39 \exists c9_40 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c3_3 > 0 & c3_4 > 0 & c9_5 > 0 & c9_6 > 0 & c1_7 > 0 & c1_8 > 0 & c9_9 > 0 & c9_10 > 0 & c1_11 > 0 & c1_12 > 0 & c9_13 > 0 & c9_14 > 0 & c1_15 > 0 & c1_16 > 0 & c9_17 > 0 & c9_18 > 0 & c1_19 > 0 & c1_20 > 0 & c3_21 > 0 & c3_22 > 0 & c9_23 > 0 & c9_24 > 0 & c1_25 > 0 & c1_26 > 0 & c3_27 > 0 & c3_28 > 0 & c9_29 > 0 & c9_30 > 0 & c1_31 > 0 & c1_32 > 0 & c3_33 > 0 & c3_34 > 0 & c9_35 > 0 & c9_36 > 0 & c1_37 > 0 & c1_38 > 0 & c9_39 > 0 & c9_40 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fe - qe*E = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c3_3 * Fm ) + ( c3_4 * Fe ) = 0 )
            & ( ( c9_5 * d*h*L ) + ( c9_6 * V ) = 0 )
            & ( ( c1_7 * Fm ) + ( c1_8 * v*qe*B ) = 0 )
            & ( ( c9_9 * d*h*L ) + ( c9_10 * V ) = 0 )
            & ( ( c1_11 * Fm ) + ( c1_12 * v*qe*B ) = 0 )
            & ( ( c9_13 * d*h*L ) + ( c9_14 * V ) = 0 )
            & ( ( c1_15 * Fm ) + ( c1_16 * v*qe*B ) = 0 )
            & ( ( c9_17 * d*h*L ) + ( c9_18 * V ) = 0 )
            & ( ( c1_19 * Fm ) + ( c1_20 * v*qe*B ) = 0 )
            & ( ( c3_21 * Fm ) + ( c3_22 * Fe ) = 0 )
            & ( ( c9_23 * d*h*L ) + ( c9_24 * V ) = 0 )
            & ( ( c1_25 * Fm ) + ( c1_26 * v*qe*B ) = 0 )
            & ( ( c3_27 * Fm ) + ( c3_28 * Fe ) = 0 )
            & ( ( c9_29 * d*h*L ) + ( c9_30 * V ) = 0 )
            & ( ( c1_31 * Fm ) + ( c1_32 * v*qe*B ) = 0 )
            & ( ( c3_33 * Fm ) + ( c3_34 * Fe ) = 0 )
            & ( ( c9_35 * d*h*L ) + ( c9_36 * V ) = 0 )
            & ( ( c1_37 * Fm ) + ( c1_38 * v*qe*B ) = 0 )
            & ( ( c9_39 * d*h*L ) + ( c9_40 * V ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
