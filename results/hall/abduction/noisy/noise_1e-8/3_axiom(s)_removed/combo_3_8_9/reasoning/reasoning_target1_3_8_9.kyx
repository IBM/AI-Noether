ArchiveEntry "hall_target1_combo3_8_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c3_1;
  Real c3_2;
  Real c8_3;
  Real c8_4;
  Real c9_5;
  Real c9_6;
  Real c3_7;
  Real c3_8;
  Real c8_9;
  Real c8_10;
  Real c9_11;
  Real c9_12;
  Real c3_13;
  Real c3_14;
  Real c8_15;
  Real c8_16;
  Real c9_17;
  Real c9_18;
  Real c3_19;
  Real c3_20;
  Real c8_21;
  Real c8_22;
  Real c9_23;
  Real c9_24;
  Real c8_25;
  Real c8_26;
  Real c9_27;
  Real c9_28;
  Real c3_29;
  Real c3_30;
  Real c8_31;
  Real c8_32;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c8_3 \exists c8_4 \exists c9_5 \exists c9_6 \exists c3_7 \exists c3_8 \exists c8_9 \exists c8_10 \exists c9_11 \exists c9_12 \exists c3_13 \exists c3_14 \exists c8_15 \exists c8_16 \exists c9_17 \exists c9_18 \exists c3_19 \exists c3_20 \exists c8_21 \exists c8_22 \exists c9_23 \exists c9_24 \exists c8_25 \exists c8_26 \exists c9_27 \exists c9_28 \exists c3_29 \exists c3_30 \exists c8_31 \exists c8_32 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c8_3 > 0 & c8_4 > 0 & c9_5 > 0 & c9_6 > 0 & c3_7 > 0 & c3_8 > 0 & c8_9 > 0 & c8_10 > 0 & c9_11 > 0 & c9_12 > 0 & c3_13 > 0 & c3_14 > 0 & c8_15 > 0 & c8_16 > 0 & c9_17 > 0 & c9_18 > 0 & c3_19 > 0 & c3_20 > 0 & c8_21 > 0 & c8_22 > 0 & c9_23 > 0 & c9_24 > 0 & c8_25 > 0 & c8_26 > 0 & c9_27 > 0 & c9_28 > 0 & c3_29 > 0 & c3_30 > 0 & c8_31 > 0 & c8_32 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( ( c3_1 * Fm ) + ( c3_2 * Fe ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c9_5 * d*h*L ) + ( c9_6 * V ) = 0 )
            & ( ( c3_7 * Fm ) + ( c3_8 * Fe ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c9_11 * d*h*L ) + ( c9_12 * V ) = 0 )
            & ( ( c3_13 * Fm ) + ( c3_14 * Fe ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c9_17 * d*h*L ) + ( c9_18 * V ) = 0 )
            & ( ( c3_19 * Fm ) + ( c3_20 * Fe ) = 0 )
            & ( ( c8_21 * N ) + ( c8_22 * V*n ) = 0 )
            & ( ( c9_23 * d*h*L ) + ( c9_24 * V ) = 0 )
            & ( ( c8_25 * N ) + ( c8_26 * V*n ) = 0 )
            & ( ( c9_27 * d*h*L ) + ( c9_28 * V ) = 0 )
            & ( ( c3_29 * Fm ) + ( c3_30 * Fe ) = 0 )
            & ( ( c8_31 * N ) + ( c8_32 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
