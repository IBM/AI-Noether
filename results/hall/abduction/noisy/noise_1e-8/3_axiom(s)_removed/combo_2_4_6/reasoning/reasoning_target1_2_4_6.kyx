ArchiveEntry "hall_target1_combo2_4_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c2_1;
  Real c2_2;
  Real c4_3;
  Real c4_4;
  Real c6_5;
  Real c6_6;
  Real c2_7;
  Real c2_8;
  Real c4_9;
  Real c4_10;
  Real c6_11;
  Real c6_12;
  Real c4_13;
  Real c4_14;
  Real c6_15;
  Real c6_16;
  Real c2_17;
  Real c2_18;
  Real c4_19;
  Real c4_20;
  Real c6_21;
  Real c6_22;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c4_3 \exists c4_4 \exists c6_5 \exists c6_6 \exists c2_7 \exists c2_8 \exists c4_9 \exists c4_10 \exists c6_11 \exists c6_12 \exists c4_13 \exists c4_14 \exists c6_15 \exists c6_16 \exists c2_17 \exists c2_18 \exists c4_19 \exists c4_20 \exists c6_21 \exists c6_22 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c4_3 > 0 & c4_4 > 0 & c6_5 > 0 & c6_6 > 0 & c2_7 > 0 & c2_8 > 0 & c4_9 > 0 & c4_10 > 0 & c6_11 > 0 & c6_12 > 0 & c4_13 > 0 & c4_14 > 0 & c6_15 > 0 & c6_16 > 0 & c2_17 > 0 & c2_18 > 0 & c4_19 > 0 & c4_20 > 0 & c6_21 > 0 & c6_22 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c2_1 * Fe ) + ( c2_2 * E*qe ) = 0 )
            & ( ( c4_3 * E*h ) + ( c4_4 * UH ) = 0 )
            & ( ( c6_5 * dt*i ) + ( c6_6 * Q ) = 0 )
            & ( ( c2_7 * Fe ) + ( c2_8 * E*qe ) = 0 )
            & ( ( c4_9 * E*h ) + ( c4_10 * UH ) = 0 )
            & ( ( c6_11 * dt*i ) + ( c6_12 * Q ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c6_15 * dt*i ) + ( c6_16 * Q ) = 0 )
            & ( ( c2_17 * Fe ) + ( c2_18 * E*qe ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c6_21 * dt*i ) + ( c6_22 * Q ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
