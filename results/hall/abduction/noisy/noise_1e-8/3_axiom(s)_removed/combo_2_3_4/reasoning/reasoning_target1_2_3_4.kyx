ArchiveEntry "hall_target1_combo2_3_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c2_1;
  Real c2_2;
  Real c3_3;
  Real c3_4;
  Real c4_5;
  Real c4_6;
  Real c3_7;
  Real c3_8;
  Real c4_9;
  Real c4_10;
  Real c2_11;
  Real c2_12;
  Real c4_13;
  Real c4_14;
  Real c2_15;
  Real c2_16;
  Real c3_17;
  Real c3_18;
  Real c4_19;
  Real c4_20;
  Real c2_21;
  Real c2_22;
  Real c3_23;
  Real c3_24;
  Real c2_25;
  Real c2_26;
  Real c3_27;
  Real c3_28;
  Real c4_29;
  Real c4_30;
  Real c2_31;
  Real c2_32;
  Real c4_33;
  Real c4_34;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c3_3 \exists c3_4 \exists c4_5 \exists c4_6 \exists c3_7 \exists c3_8 \exists c4_9 \exists c4_10 \exists c2_11 \exists c2_12 \exists c4_13 \exists c4_14 \exists c2_15 \exists c2_16 \exists c3_17 \exists c3_18 \exists c4_19 \exists c4_20 \exists c2_21 \exists c2_22 \exists c3_23 \exists c3_24 \exists c2_25 \exists c2_26 \exists c3_27 \exists c3_28 \exists c4_29 \exists c4_30 \exists c2_31 \exists c2_32 \exists c4_33 \exists c4_34 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c3_3 > 0 & c3_4 > 0 & c4_5 > 0 & c4_6 > 0 & c3_7 > 0 & c3_8 > 0 & c4_9 > 0 & c4_10 > 0 & c2_11 > 0 & c2_12 > 0 & c4_13 > 0 & c4_14 > 0 & c2_15 > 0 & c2_16 > 0 & c3_17 > 0 & c3_18 > 0 & c4_19 > 0 & c4_20 > 0 & c2_21 > 0 & c2_22 > 0 & c3_23 > 0 & c3_24 > 0 & c2_25 > 0 & c2_26 > 0 & c3_27 > 0 & c3_28 > 0 & c4_29 > 0 & c4_30 > 0 & c2_31 > 0 & c2_32 > 0 & c4_33 > 0 & c4_34 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c2_1 * Fe ) + ( c2_2 * E*qe ) = 0 )
            & ( ( c3_3 * Fm ) + ( c3_4 * Fe ) = 0 )
            & ( ( c4_5 * E*h ) + ( c4_6 * UH ) = 0 )
            & ( ( c3_7 * Fm ) + ( c3_8 * Fe ) = 0 )
            & ( ( c4_9 * E*h ) + ( c4_10 * UH ) = 0 )
            & ( ( c2_11 * Fe ) + ( c2_12 * E*qe ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c2_15 * Fe ) + ( c2_16 * E*qe ) = 0 )
            & ( ( c3_17 * Fm ) + ( c3_18 * Fe ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c2_21 * Fe ) + ( c2_22 * E*qe ) = 0 )
            & ( ( c3_23 * Fm ) + ( c3_24 * Fe ) = 0 )
            & ( ( c2_25 * Fe ) + ( c2_26 * E*qe ) = 0 )
            & ( ( c3_27 * Fm ) + ( c3_28 * Fe ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c2_31 * Fe ) + ( c2_32 * E*qe ) = 0 )
            & ( ( c4_33 * E*h ) + ( c4_34 * UH ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
