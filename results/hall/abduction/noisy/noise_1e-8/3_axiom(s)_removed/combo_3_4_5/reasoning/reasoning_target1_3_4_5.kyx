ArchiveEntry "hall_target1_combo3_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c5_3;
  Real c5_4;
  Real c3_5;
  Real c3_6;
  Real c4_7;
  Real c4_8;
  Real c5_9;
  Real c5_10;
  Real c3_11;
  Real c3_12;
  Real c4_13;
  Real c4_14;
  Real c5_15;
  Real c5_16;
  Real c3_17;
  Real c3_18;
  Real c4_19;
  Real c4_20;
  Real c5_21;
  Real c5_22;
  Real c3_23;
  Real c3_24;
  Real c4_25;
  Real c4_26;
  Real c3_27;
  Real c3_28;
  Real c4_29;
  Real c4_30;
  Real c5_31;
  Real c5_32;
  Real c3_33;
  Real c3_34;
  Real c4_35;
  Real c4_36;
  Real c5_37;
  Real c5_38;
  Real c3_39;
  Real c3_40;
  Real c4_41;
  Real c4_42;
  Real c5_43;
  Real c5_44;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c5_3 \exists c5_4 \exists c3_5 \exists c3_6 \exists c4_7 \exists c4_8 \exists c5_9 \exists c5_10 \exists c3_11 \exists c3_12 \exists c4_13 \exists c4_14 \exists c5_15 \exists c5_16 \exists c3_17 \exists c3_18 \exists c4_19 \exists c4_20 \exists c5_21 \exists c5_22 \exists c3_23 \exists c3_24 \exists c4_25 \exists c4_26 \exists c3_27 \exists c3_28 \exists c4_29 \exists c4_30 \exists c5_31 \exists c5_32 \exists c3_33 \exists c3_34 \exists c4_35 \exists c4_36 \exists c5_37 \exists c5_38 \exists c3_39 \exists c3_40 \exists c4_41 \exists c4_42 \exists c5_43 \exists c5_44 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c5_3 > 0 & c5_4 > 0 & c3_5 > 0 & c3_6 > 0 & c4_7 > 0 & c4_8 > 0 & c5_9 > 0 & c5_10 > 0 & c3_11 > 0 & c3_12 > 0 & c4_13 > 0 & c4_14 > 0 & c5_15 > 0 & c5_16 > 0 & c3_17 > 0 & c3_18 > 0 & c4_19 > 0 & c4_20 > 0 & c5_21 > 0 & c5_22 > 0 & c3_23 > 0 & c3_24 > 0 & c4_25 > 0 & c4_26 > 0 & c3_27 > 0 & c3_28 > 0 & c4_29 > 0 & c4_30 > 0 & c5_31 > 0 & c5_32 > 0 & c3_33 > 0 & c3_34 > 0 & c4_35 > 0 & c4_36 > 0 & c5_37 > 0 & c5_38 > 0 & c3_39 > 0 & c3_40 > 0 & c4_41 > 0 & c4_42 > 0 & c5_43 > 0 & c5_44 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c5_3 * v*dt ) + ( c5_4 * L ) = 0 )
            & ( ( c3_5 * Fm ) + ( c3_6 * Fe ) = 0 )
            & ( ( c4_7 * E*h ) + ( c4_8 * UH ) = 0 )
            & ( ( c5_9 * v*dt ) + ( c5_10 * L ) = 0 )
            & ( ( c3_11 * Fm ) + ( c3_12 * Fe ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c5_15 * v*dt ) + ( c5_16 * L ) = 0 )
            & ( ( c3_17 * Fm ) + ( c3_18 * Fe ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c5_21 * v*dt ) + ( c5_22 * L ) = 0 )
            & ( ( c3_23 * Fm ) + ( c3_24 * Fe ) = 0 )
            & ( ( c4_25 * E*h ) + ( c4_26 * UH ) = 0 )
            & ( ( c3_27 * Fm ) + ( c3_28 * Fe ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c5_31 * v*dt ) + ( c5_32 * L ) = 0 )
            & ( ( c3_33 * Fm ) + ( c3_34 * Fe ) = 0 )
            & ( ( c4_35 * E*h ) + ( c4_36 * UH ) = 0 )
            & ( ( c5_37 * v*dt ) + ( c5_38 * L ) = 0 )
            & ( ( c3_39 * Fm ) + ( c3_40 * Fe ) = 0 )
            & ( ( c4_41 * E*h ) + ( c4_42 * UH ) = 0 )
            & ( ( c5_43 * v*dt ) + ( c5_44 * L ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
