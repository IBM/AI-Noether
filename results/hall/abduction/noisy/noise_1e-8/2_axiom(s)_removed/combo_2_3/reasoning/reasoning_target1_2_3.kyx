ArchiveEntry "hall_target1_combo2_3"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c2_1;
  Real c2_2;
  Real c3_3;
  Real c3_4;
  Real c3_5;
  Real c3_6;
  Real c2_7;
  Real c2_8;
  Real c3_9;
  Real c3_10;
  Real c2_11;
  Real c2_12;
  Real c2_13;
  Real c2_14;
  Real c3_15;
  Real c3_16;
  Real c2_17;
  Real c2_18;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c3_3 \exists c3_4 \exists c3_5 \exists c3_6 \exists c2_7 \exists c2_8 \exists c3_9 \exists c3_10 \exists c2_11 \exists c2_12 \exists c2_13 \exists c2_14 \exists c3_15 \exists c3_16 \exists c2_17 \exists c2_18 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c3_3 > 0 & c3_4 > 0 & c3_5 > 0 & c3_6 > 0 & c2_7 > 0 & c2_8 > 0 & c3_9 > 0 & c3_10 > 0 & c2_11 > 0 & c2_12 > 0 & c2_13 > 0 & c2_14 > 0 & c3_15 > 0 & c3_16 > 0 & c2_17 > 0 & c2_18 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c2_1 * Fe ) + ( c2_2 * E*qe ) = 0 )
            & ( ( c3_3 * Fm ) + ( c3_4 * Fe ) = 0 )
            & ( ( c3_5 * Fm ) + ( c3_6 * Fe ) = 0 )
            & ( ( c2_7 * Fe ) + ( c2_8 * E*qe ) = 0 )
            & ( ( c3_9 * Fm ) + ( c3_10 * Fe ) = 0 )
            & ( ( c2_11 * Fe ) + ( c2_12 * E*qe ) = 0 )
            & ( ( c2_13 * Fe ) + ( c2_14 * E*qe ) = 0 )
            & ( ( c3_15 * Fm ) + ( c3_16 * Fe ) = 0 )
            & ( ( c2_17 * Fe ) + ( c2_18 * E*qe ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
