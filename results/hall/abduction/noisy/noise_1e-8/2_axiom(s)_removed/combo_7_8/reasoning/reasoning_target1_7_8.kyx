ArchiveEntry "hall_target1_combo7_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c7_1;
  Real c7_2;
  Real c8_3;
  Real c8_4;
  Real c7_5;
  Real c7_6;
  Real c8_7;
  Real c8_8;
  Real c7_9;
  Real c7_10;
  Real c8_11;
  Real c8_12;
  Real c7_13;
  Real c7_14;
  Real c8_15;
  Real c8_16;
  Real c7_17;
  Real c7_18;
  Real c8_19;
  Real c8_20;
  Real c7_21;
  Real c7_22;
  Real c8_23;
  Real c8_24;
  Real c7_25;
  Real c7_26;
  Real c8_27;
  Real c8_28;
  Real c7_29;
  Real c7_30;
  Real c8_31;
  Real c8_32;
  Real c7_33;
  Real c7_34;
  Real c8_35;
  Real c8_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c7_1 \exists c7_2 \exists c8_3 \exists c8_4 \exists c7_5 \exists c7_6 \exists c8_7 \exists c8_8 \exists c7_9 \exists c7_10 \exists c8_11 \exists c8_12 \exists c7_13 \exists c7_14 \exists c8_15 \exists c8_16 \exists c7_17 \exists c7_18 \exists c8_19 \exists c8_20 \exists c7_21 \exists c7_22 \exists c8_23 \exists c8_24 \exists c7_25 \exists c7_26 \exists c8_27 \exists c8_28 \exists c7_29 \exists c7_30 \exists c8_31 \exists c8_32 \exists c7_33 \exists c7_34 \exists c8_35 \exists c8_36 \exists d1 \exists d2
    (
      c7_1 > 0 & c7_2 > 0 & c8_3 > 0 & c8_4 > 0 & c7_5 > 0 & c7_6 > 0 & c8_7 > 0 & c8_8 > 0 & c7_9 > 0 & c7_10 > 0 & c8_11 > 0 & c8_12 > 0 & c7_13 > 0 & c7_14 > 0 & c8_15 > 0 & c8_16 > 0 & c7_17 > 0 & c7_18 > 0 & c8_19 > 0 & c8_20 > 0 & c7_21 > 0 & c7_22 > 0 & c8_23 > 0 & c8_24 > 0 & c7_25 > 0 & c7_26 > 0 & c8_27 > 0 & c8_28 > 0 & c7_29 > 0 & c7_30 > 0 & c8_31 > 0 & c8_32 > 0 & c7_33 > 0 & c7_34 > 0 & c8_35 > 0 & c8_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c7_1 * Q ) + ( c7_2 * N*qe ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c7_5 * Q ) + ( c7_6 * N*qe ) = 0 )
            & ( ( c8_7 * N ) + ( c8_8 * V*n ) = 0 )
            & ( ( c7_9 * Q ) + ( c7_10 * N*qe ) = 0 )
            & ( ( c8_11 * N ) + ( c8_12 * V*n ) = 0 )
            & ( ( c7_13 * Q ) + ( c7_14 * N*qe ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c7_17 * Q ) + ( c7_18 * N*qe ) = 0 )
            & ( ( c8_19 * N ) + ( c8_20 * V*n ) = 0 )
            & ( ( c7_21 * Q ) + ( c7_22 * N*qe ) = 0 )
            & ( ( c8_23 * N ) + ( c8_24 * V*n ) = 0 )
            & ( ( c7_25 * Q ) + ( c7_26 * N*qe ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
            & ( ( c7_29 * Q ) + ( c7_30 * N*qe ) = 0 )
            & ( ( c8_31 * N ) + ( c8_32 * V*n ) = 0 )
            & ( ( c7_33 * Q ) + ( c7_34 * N*qe ) = 0 )
            & ( ( c8_35 * N ) + ( c8_36 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
