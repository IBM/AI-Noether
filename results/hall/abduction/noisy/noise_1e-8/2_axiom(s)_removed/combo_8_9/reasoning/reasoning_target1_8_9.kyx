ArchiveEntry "hall_target1_combo8_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c8_1;
  Real c8_2;
  Real c9_3;
  Real c9_4;
  Real c8_5;
  Real c8_6;
  Real c9_7;
  Real c9_8;
  Real c8_9;
  Real c8_10;
  Real c9_11;
  Real c9_12;
  Real c8_13;
  Real c8_14;
  Real c9_15;
  Real c9_16;
  Real c8_17;
  Real c8_18;
  Real c9_19;
  Real c9_20;
  Real c8_21;
  Real c8_22;
  Real c9_23;
  Real c9_24;
  Real c8_25;
  Real c8_26;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c8_1 \exists c8_2 \exists c9_3 \exists c9_4 \exists c8_5 \exists c8_6 \exists c9_7 \exists c9_8 \exists c8_9 \exists c8_10 \exists c9_11 \exists c9_12 \exists c8_13 \exists c8_14 \exists c9_15 \exists c9_16 \exists c8_17 \exists c8_18 \exists c9_19 \exists c9_20 \exists c8_21 \exists c8_22 \exists c9_23 \exists c9_24 \exists c8_25 \exists c8_26 \exists d1 \exists d2
    (
      c8_1 > 0 & c8_2 > 0 & c9_3 > 0 & c9_4 > 0 & c8_5 > 0 & c8_6 > 0 & c9_7 > 0 & c9_8 > 0 & c8_9 > 0 & c8_10 > 0 & c9_11 > 0 & c9_12 > 0 & c8_13 > 0 & c8_14 > 0 & c9_15 > 0 & c9_16 > 0 & c8_17 > 0 & c8_18 > 0 & c9_19 > 0 & c9_20 > 0 & c8_21 > 0 & c8_22 > 0 & c9_23 > 0 & c9_24 > 0 & c8_25 > 0 & c8_26 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( ( c8_1 * N ) + ( c8_2 * V*n ) = 0 )
            & ( ( c9_3 * d*h*L ) + ( c9_4 * V ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c9_7 * d*h*L ) + ( c9_8 * V ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c9_11 * d*h*L ) + ( c9_12 * V ) = 0 )
            & ( ( c8_13 * N ) + ( c8_14 * V*n ) = 0 )
            & ( ( c9_15 * d*h*L ) + ( c9_16 * V ) = 0 )
            & ( ( c8_17 * N ) + ( c8_18 * V*n ) = 0 )
            & ( ( c9_19 * d*h*L ) + ( c9_20 * V ) = 0 )
            & ( ( c8_21 * N ) + ( c8_22 * V*n ) = 0 )
            & ( ( c9_23 * d*h*L ) + ( c9_24 * V ) = 0 )
            & ( ( c8_25 * N ) + ( c8_26 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
