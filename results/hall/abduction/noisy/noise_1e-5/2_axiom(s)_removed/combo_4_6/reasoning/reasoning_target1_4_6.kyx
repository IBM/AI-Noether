ArchiveEntry "hall_target1_combo4_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c6_3;
  Real c6_4;
  Real c4_5;
  Real c4_6;
  Real c6_7;
  Real c6_8;
  Real c4_9;
  Real c4_10;
  Real c6_11;
  Real c6_12;
  Real c4_13;
  Real c4_14;
  Real c6_15;
  Real c6_16;
  Real c4_17;
  Real c4_18;
  Real c6_19;
  Real c6_20;
  Real c4_21;
  Real c4_22;
  Real c6_23;
  Real c6_24;
  Real c4_25;
  Real c4_26;
  Real c6_27;
  Real c6_28;
  Real c4_29;
  Real c4_30;
  Real c6_31;
  Real c6_32;
  Real c4_33;
  Real c4_34;
  Real c6_35;
  Real c6_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c6_3 \exists c6_4 \exists c4_5 \exists c4_6 \exists c6_7 \exists c6_8 \exists c4_9 \exists c4_10 \exists c6_11 \exists c6_12 \exists c4_13 \exists c4_14 \exists c6_15 \exists c6_16 \exists c4_17 \exists c4_18 \exists c6_19 \exists c6_20 \exists c4_21 \exists c4_22 \exists c6_23 \exists c6_24 \exists c4_25 \exists c4_26 \exists c6_27 \exists c6_28 \exists c4_29 \exists c4_30 \exists c6_31 \exists c6_32 \exists c4_33 \exists c4_34 \exists c6_35 \exists c6_36 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c6_3 > 0 & c6_4 > 0 & c4_5 > 0 & c4_6 > 0 & c6_7 > 0 & c6_8 > 0 & c4_9 > 0 & c4_10 > 0 & c6_11 > 0 & c6_12 > 0 & c4_13 > 0 & c4_14 > 0 & c6_15 > 0 & c6_16 > 0 & c4_17 > 0 & c4_18 > 0 & c6_19 > 0 & c6_20 > 0 & c4_21 > 0 & c4_22 > 0 & c6_23 > 0 & c6_24 > 0 & c4_25 > 0 & c4_26 > 0 & c6_27 > 0 & c6_28 > 0 & c4_29 > 0 & c4_30 > 0 & c6_31 > 0 & c6_32 > 0 & c4_33 > 0 & c4_34 > 0 & c6_35 > 0 & c6_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c6_3 * dt*i ) + ( c6_4 * Q ) = 0 )
            & ( ( c4_5 * E*h ) + ( c4_6 * UH ) = 0 )
            & ( ( c6_7 * dt*i ) + ( c6_8 * Q ) = 0 )
            & ( ( c4_9 * E*h ) + ( c4_10 * UH ) = 0 )
            & ( ( c6_11 * dt*i ) + ( c6_12 * Q ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c6_15 * dt*i ) + ( c6_16 * Q ) = 0 )
            & ( ( c4_17 * E*h ) + ( c4_18 * UH ) = 0 )
            & ( ( c6_19 * dt*i ) + ( c6_20 * Q ) = 0 )
            & ( ( c4_21 * E*h ) + ( c4_22 * UH ) = 0 )
            & ( ( c6_23 * dt*i ) + ( c6_24 * Q ) = 0 )
            & ( ( c4_25 * E*h ) + ( c4_26 * UH ) = 0 )
            & ( ( c6_27 * dt*i ) + ( c6_28 * Q ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c6_31 * dt*i ) + ( c6_32 * Q ) = 0 )
            & ( ( c4_33 * E*h ) + ( c4_34 * UH ) = 0 )
            & ( ( c6_35 * dt*i ) + ( c6_36 * Q ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
