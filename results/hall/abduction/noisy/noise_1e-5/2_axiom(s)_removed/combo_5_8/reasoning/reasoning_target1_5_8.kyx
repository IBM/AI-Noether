ArchiveEntry "hall_target1_combo5_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c5_1;
  Real c5_2;
  Real c8_3;
  Real c8_4;
  Real c5_5;
  Real c5_6;
  Real c8_7;
  Real c8_8;
  Real c5_9;
  Real c5_10;
  Real c8_11;
  Real c8_12;
  Real c5_13;
  Real c5_14;
  Real c8_15;
  Real c8_16;
  Real c5_17;
  Real c5_18;
  Real c8_19;
  Real c8_20;
  Real c5_21;
  Real c5_22;
  Real c8_23;
  Real c8_24;
  Real c5_25;
  Real c5_26;
  Real c8_27;
  Real c8_28;
  Real c5_29;
  Real c5_30;
  Real c8_31;
  Real c8_32;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c8_3 \exists c8_4 \exists c5_5 \exists c5_6 \exists c8_7 \exists c8_8 \exists c5_9 \exists c5_10 \exists c8_11 \exists c8_12 \exists c5_13 \exists c5_14 \exists c8_15 \exists c8_16 \exists c5_17 \exists c5_18 \exists c8_19 \exists c8_20 \exists c5_21 \exists c5_22 \exists c8_23 \exists c8_24 \exists c5_25 \exists c5_26 \exists c8_27 \exists c8_28 \exists c5_29 \exists c5_30 \exists c8_31 \exists c8_32 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c8_3 > 0 & c8_4 > 0 & c5_5 > 0 & c5_6 > 0 & c8_7 > 0 & c8_8 > 0 & c5_9 > 0 & c5_10 > 0 & c8_11 > 0 & c8_12 > 0 & c5_13 > 0 & c5_14 > 0 & c8_15 > 0 & c8_16 > 0 & c5_17 > 0 & c5_18 > 0 & c8_19 > 0 & c8_20 > 0 & c5_21 > 0 & c5_22 > 0 & c8_23 > 0 & c8_24 > 0 & c5_25 > 0 & c5_26 > 0 & c8_27 > 0 & c8_28 > 0 & c5_29 > 0 & c5_30 > 0 & c8_31 > 0 & c8_32 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c5_1 * v*dt ) + ( c5_2 * L ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c5_5 * v*dt ) + ( c5_6 * L ) = 0 )
            & ( ( c8_7 * N ) + ( c8_8 * V*n ) = 0 )
            & ( ( c5_9 * v*dt ) + ( c5_10 * L ) = 0 )
            & ( ( c8_11 * N ) + ( c8_12 * V*n ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c5_17 * v*dt ) + ( c5_18 * L ) = 0 )
            & ( ( c8_19 * N ) + ( c8_20 * V*n ) = 0 )
            & ( ( c5_21 * v*dt ) + ( c5_22 * L ) = 0 )
            & ( ( c8_23 * N ) + ( c8_24 * V*n ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
            & ( ( c5_29 * v*dt ) + ( c5_30 * L ) = 0 )
            & ( ( c8_31 * N ) + ( c8_32 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
