ArchiveEntry "hall_target1_combo4_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c8_3;
  Real c8_4;
  Real c4_5;
  Real c4_6;
  Real c8_7;
  Real c8_8;
  Real c4_9;
  Real c4_10;
  Real c8_11;
  Real c8_12;
  Real c8_13;
  Real c8_14;
  Real c4_15;
  Real c4_16;
  Real c8_17;
  Real c8_18;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c8_3 \exists c8_4 \exists c4_5 \exists c4_6 \exists c8_7 \exists c8_8 \exists c4_9 \exists c4_10 \exists c8_11 \exists c8_12 \exists c8_13 \exists c8_14 \exists c4_15 \exists c4_16 \exists c8_17 \exists c8_18 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c8_3 > 0 & c8_4 > 0 & c4_5 > 0 & c4_6 > 0 & c8_7 > 0 & c8_8 > 0 & c4_9 > 0 & c4_10 > 0 & c8_11 > 0 & c8_12 > 0 & c8_13 > 0 & c8_14 > 0 & c4_15 > 0 & c4_16 > 0 & c8_17 > 0 & c8_18 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c4_5 * E*h ) + ( c4_6 * UH ) = 0 )
            & ( ( c8_7 * N ) + ( c8_8 * V*n ) = 0 )
            & ( ( c4_9 * E*h ) + ( c4_10 * UH ) = 0 )
            & ( ( c8_11 * N ) + ( c8_12 * V*n ) = 0 )
            & ( ( c8_13 * N ) + ( c8_14 * V*n ) = 0 )
            & ( ( c4_15 * E*h ) + ( c4_16 * UH ) = 0 )
            & ( ( c8_17 * N ) + ( c8_18 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
