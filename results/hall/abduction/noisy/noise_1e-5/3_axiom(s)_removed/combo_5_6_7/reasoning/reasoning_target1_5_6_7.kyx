ArchiveEntry "hall_target1_combo5_6_7"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c5_1;
  Real c5_2;
  Real c6_3;
  Real c6_4;
  Real c7_5;
  Real c7_6;
  Real c5_7;
  Real c5_8;
  Real c6_9;
  Real c6_10;
  Real c7_11;
  Real c7_12;
  Real c5_13;
  Real c5_14;
  Real c6_15;
  Real c6_16;
  Real c7_17;
  Real c7_18;
  Real c5_19;
  Real c5_20;
  Real c6_21;
  Real c6_22;
  Real c7_23;
  Real c7_24;
  Real c5_25;
  Real c5_26;
  Real c6_27;
  Real c6_28;
  Real c7_29;
  Real c7_30;
  Real c5_31;
  Real c5_32;
  Real c6_33;
  Real c6_34;
  Real c7_35;
  Real c7_36;
  Real c5_37;
  Real c5_38;
  Real c6_39;
  Real c6_40;
  Real c7_41;
  Real c7_42;
  Real c5_43;
  Real c5_44;
  Real c6_45;
  Real c6_46;
  Real c7_47;
  Real c7_48;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c6_3 \exists c6_4 \exists c7_5 \exists c7_6 \exists c5_7 \exists c5_8 \exists c6_9 \exists c6_10 \exists c7_11 \exists c7_12 \exists c5_13 \exists c5_14 \exists c6_15 \exists c6_16 \exists c7_17 \exists c7_18 \exists c5_19 \exists c5_20 \exists c6_21 \exists c6_22 \exists c7_23 \exists c7_24 \exists c5_25 \exists c5_26 \exists c6_27 \exists c6_28 \exists c7_29 \exists c7_30 \exists c5_31 \exists c5_32 \exists c6_33 \exists c6_34 \exists c7_35 \exists c7_36 \exists c5_37 \exists c5_38 \exists c6_39 \exists c6_40 \exists c7_41 \exists c7_42 \exists c5_43 \exists c5_44 \exists c6_45 \exists c6_46 \exists c7_47 \exists c7_48 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c6_3 > 0 & c6_4 > 0 & c7_5 > 0 & c7_6 > 0 & c5_7 > 0 & c5_8 > 0 & c6_9 > 0 & c6_10 > 0 & c7_11 > 0 & c7_12 > 0 & c5_13 > 0 & c5_14 > 0 & c6_15 > 0 & c6_16 > 0 & c7_17 > 0 & c7_18 > 0 & c5_19 > 0 & c5_20 > 0 & c6_21 > 0 & c6_22 > 0 & c7_23 > 0 & c7_24 > 0 & c5_25 > 0 & c5_26 > 0 & c6_27 > 0 & c6_28 > 0 & c7_29 > 0 & c7_30 > 0 & c5_31 > 0 & c5_32 > 0 & c6_33 > 0 & c6_34 > 0 & c7_35 > 0 & c7_36 > 0 & c5_37 > 0 & c5_38 > 0 & c6_39 > 0 & c6_40 > 0 & c7_41 > 0 & c7_42 > 0 & c5_43 > 0 & c5_44 > 0 & c6_45 > 0 & c6_46 > 0 & c7_47 > 0 & c7_48 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c5_1 * v*dt ) + ( c5_2 * L ) = 0 )
            & ( ( c6_3 * dt*i ) + ( c6_4 * Q ) = 0 )
            & ( ( c7_5 * Q ) + ( c7_6 * N*qe ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c6_9 * dt*i ) + ( c6_10 * Q ) = 0 )
            & ( ( c7_11 * Q ) + ( c7_12 * N*qe ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c6_15 * dt*i ) + ( c6_16 * Q ) = 0 )
            & ( ( c7_17 * Q ) + ( c7_18 * N*qe ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c6_21 * dt*i ) + ( c6_22 * Q ) = 0 )
            & ( ( c7_23 * Q ) + ( c7_24 * N*qe ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c6_27 * dt*i ) + ( c6_28 * Q ) = 0 )
            & ( ( c7_29 * Q ) + ( c7_30 * N*qe ) = 0 )
            & ( ( c5_31 * v*dt ) + ( c5_32 * L ) = 0 )
            & ( ( c6_33 * dt*i ) + ( c6_34 * Q ) = 0 )
            & ( ( c7_35 * Q ) + ( c7_36 * N*qe ) = 0 )
            & ( ( c5_37 * v*dt ) + ( c5_38 * L ) = 0 )
            & ( ( c6_39 * dt*i ) + ( c6_40 * Q ) = 0 )
            & ( ( c7_41 * Q ) + ( c7_42 * N*qe ) = 0 )
            & ( ( c5_43 * v*dt ) + ( c5_44 * L ) = 0 )
            & ( ( c6_45 * dt*i ) + ( c6_46 * Q ) = 0 )
            & ( ( c7_47 * Q ) + ( c7_48 * N*qe ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
