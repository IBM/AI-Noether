ArchiveEntry "hall_target1_combo1_3_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c3_3;
  Real c3_4;
  Real c4_5;
  Real c4_6;
  Real c1_7;
  Real c1_8;
  Real c3_9;
  Real c3_10;
  Real c1_11;
  Real c1_12;
  Real c3_13;
  Real c3_14;
  Real c4_15;
  Real c4_16;
  Real c1_17;
  Real c1_18;
  Real c4_19;
  Real c4_20;
  Real c1_21;
  Real c1_22;
  Real c4_23;
  Real c4_24;
  Real c1_25;
  Real c1_26;
  Real c3_27;
  Real c3_28;
  Real c4_29;
  Real c4_30;
  Real c1_31;
  Real c1_32;
  Real c3_33;
  Real c3_34;
  Real c4_35;
  Real c4_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c3_3 \exists c3_4 \exists c4_5 \exists c4_6 \exists c1_7 \exists c1_8 \exists c3_9 \exists c3_10 \exists c1_11 \exists c1_12 \exists c3_13 \exists c3_14 \exists c4_15 \exists c4_16 \exists c1_17 \exists c1_18 \exists c4_19 \exists c4_20 \exists c1_21 \exists c1_22 \exists c4_23 \exists c4_24 \exists c1_25 \exists c1_26 \exists c3_27 \exists c3_28 \exists c4_29 \exists c4_30 \exists c1_31 \exists c1_32 \exists c3_33 \exists c3_34 \exists c4_35 \exists c4_36 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c3_3 > 0 & c3_4 > 0 & c4_5 > 0 & c4_6 > 0 & c1_7 > 0 & c1_8 > 0 & c3_9 > 0 & c3_10 > 0 & c1_11 > 0 & c1_12 > 0 & c3_13 > 0 & c3_14 > 0 & c4_15 > 0 & c4_16 > 0 & c1_17 > 0 & c1_18 > 0 & c4_19 > 0 & c4_20 > 0 & c1_21 > 0 & c1_22 > 0 & c4_23 > 0 & c4_24 > 0 & c1_25 > 0 & c1_26 > 0 & c3_27 > 0 & c3_28 > 0 & c4_29 > 0 & c4_30 > 0 & c1_31 > 0 & c1_32 > 0 & c3_33 > 0 & c3_34 > 0 & c4_35 > 0 & c4_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fe - qe*E = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c3_3 * Fm ) + ( c3_4 * Fe ) = 0 )
            & ( ( c4_5 * E*h ) + ( c4_6 * UH ) = 0 )
            & ( ( c1_7 * Fm ) + ( c1_8 * v*qe*B ) = 0 )
            & ( ( c3_9 * Fm ) + ( c3_10 * Fe ) = 0 )
            & ( ( c1_11 * Fm ) + ( c1_12 * v*qe*B ) = 0 )
            & ( ( c3_13 * Fm ) + ( c3_14 * Fe ) = 0 )
            & ( ( c4_15 * E*h ) + ( c4_16 * UH ) = 0 )
            & ( ( c1_17 * Fm ) + ( c1_18 * v*qe*B ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c1_21 * Fm ) + ( c1_22 * v*qe*B ) = 0 )
            & ( ( c4_23 * E*h ) + ( c4_24 * UH ) = 0 )
            & ( ( c1_25 * Fm ) + ( c1_26 * v*qe*B ) = 0 )
            & ( ( c3_27 * Fm ) + ( c3_28 * Fe ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c1_31 * Fm ) + ( c1_32 * v*qe*B ) = 0 )
            & ( ( c3_33 * Fm ) + ( c3_34 * Fe ) = 0 )
            & ( ( c4_35 * E*h ) + ( c4_36 * UH ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
