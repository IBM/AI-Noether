ArchiveEntry "hall_target1_combo1_2_3"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c2_3;
  Real c2_4;
  Real c1_5;
  Real c1_6;
  Real c1_7;
  Real c1_8;
  Real c1_9;
  Real c1_10;
  Real c2_11;
  Real c2_12;
  Real c2_13;
  Real c2_14;
  Real c1_15;
  Real c1_16;
  Real c1_17;
  Real c1_18;
  Real c2_19;
  Real c2_20;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c2_3 \exists c2_4 \exists c1_5 \exists c1_6 \exists c1_7 \exists c1_8 \exists c1_9 \exists c1_10 \exists c2_11 \exists c2_12 \exists c2_13 \exists c2_14 \exists c1_15 \exists c1_16 \exists c1_17 \exists c1_18 \exists c2_19 \exists c2_20 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c2_3 > 0 & c2_4 > 0 & c1_5 > 0 & c1_6 > 0 & c1_7 > 0 & c1_8 > 0 & c1_9 > 0 & c1_10 > 0 & c2_11 > 0 & c2_12 > 0 & c2_13 > 0 & c2_14 > 0 & c1_15 > 0 & c1_16 > 0 & c1_17 > 0 & c1_18 > 0 & c2_19 > 0 & c2_20 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c2_3 * Fe ) + ( c2_4 * E*qe ) = 0 )
            & ( ( c1_5 * Fm ) + ( c1_6 * v*qe*B ) = 0 )
            & ( ( c1_7 * Fm ) + ( c1_8 * v*qe*B ) = 0 )
            & ( ( c1_9 * Fm ) + ( c1_10 * v*qe*B ) = 0 )
            & ( ( c2_11 * Fe ) + ( c2_12 * E*qe ) = 0 )
            & ( ( c2_13 * Fe ) + ( c2_14 * E*qe ) = 0 )
            & ( ( c1_15 * Fm ) + ( c1_16 * v*qe*B ) = 0 )
            & ( ( c1_17 * Fm ) + ( c1_18 * v*qe*B ) = 0 )
            & ( ( c2_19 * Fe ) + ( c2_20 * E*qe ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
