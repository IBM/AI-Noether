ArchiveEntry "hall_target1_combo2_3_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c3_1;
  Real c3_2;
  Real c8_3;
  Real c8_4;
  Real c2_5;
  Real c2_6;
  Real c3_7;
  Real c3_8;
  Real c8_9;
  Real c8_10;
  Real c2_11;
  Real c2_12;
  Real c3_13;
  Real c3_14;
  Real c8_15;
  Real c8_16;
  Real c2_17;
  Real c2_18;
  Real c3_19;
  Real c3_20;
  Real c8_21;
  Real c8_22;
  Real c2_23;
  Real c2_24;
  Real c3_25;
  Real c3_26;
  Real c8_27;
  Real c8_28;
  Real c2_29;
  Real c2_30;
  Real c3_31;
  Real c3_32;
  Real c8_33;
  Real c8_34;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c8_3 \exists c8_4 \exists c2_5 \exists c2_6 \exists c3_7 \exists c3_8 \exists c8_9 \exists c8_10 \exists c2_11 \exists c2_12 \exists c3_13 \exists c3_14 \exists c8_15 \exists c8_16 \exists c2_17 \exists c2_18 \exists c3_19 \exists c3_20 \exists c8_21 \exists c8_22 \exists c2_23 \exists c2_24 \exists c3_25 \exists c3_26 \exists c8_27 \exists c8_28 \exists c2_29 \exists c2_30 \exists c3_31 \exists c3_32 \exists c8_33 \exists c8_34 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c8_3 > 0 & c8_4 > 0 & c2_5 > 0 & c2_6 > 0 & c3_7 > 0 & c3_8 > 0 & c8_9 > 0 & c8_10 > 0 & c2_11 > 0 & c2_12 > 0 & c3_13 > 0 & c3_14 > 0 & c8_15 > 0 & c8_16 > 0 & c2_17 > 0 & c2_18 > 0 & c3_19 > 0 & c3_20 > 0 & c8_21 > 0 & c8_22 > 0 & c2_23 > 0 & c2_24 > 0 & c3_25 > 0 & c3_26 > 0 & c8_27 > 0 & c8_28 > 0 & c2_29 > 0 & c2_30 > 0 & c3_31 > 0 & c3_32 > 0 & c8_33 > 0 & c8_34 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c3_1 * Fm ) + ( c3_2 * Fe ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c2_5 * Fe ) + ( c2_6 * E*qe ) = 0 )
            & ( ( c3_7 * Fm ) + ( c3_8 * Fe ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c2_11 * Fe ) + ( c2_12 * E*qe ) = 0 )
            & ( ( c3_13 * Fm ) + ( c3_14 * Fe ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c2_17 * Fe ) + ( c2_18 * E*qe ) = 0 )
            & ( ( c3_19 * Fm ) + ( c3_20 * Fe ) = 0 )
            & ( ( c8_21 * N ) + ( c8_22 * V*n ) = 0 )
            & ( ( c2_23 * Fe ) + ( c2_24 * E*qe ) = 0 )
            & ( ( c3_25 * Fm ) + ( c3_26 * Fe ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
            & ( ( c2_29 * Fe ) + ( c2_30 * E*qe ) = 0 )
            & ( ( c3_31 * Fm ) + ( c3_32 * Fe ) = 0 )
            & ( ( c8_33 * N ) + ( c8_34 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
