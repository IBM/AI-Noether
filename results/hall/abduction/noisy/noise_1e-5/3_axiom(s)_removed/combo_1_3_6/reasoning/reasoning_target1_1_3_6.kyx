ArchiveEntry "hall_target1_combo1_3_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c3_3;
  Real c3_4;
  Real c6_5;
  Real c6_6;
  Real c1_7;
  Real c1_8;
  Real c6_9;
  Real c6_10;
  Real c1_11;
  Real c1_12;
  Real c3_13;
  Real c3_14;
  Real c6_15;
  Real c6_16;
  Real c1_17;
  Real c1_18;
  Real c3_19;
  Real c3_20;
  Real c6_21;
  Real c6_22;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c3_3 \exists c3_4 \exists c6_5 \exists c6_6 \exists c1_7 \exists c1_8 \exists c6_9 \exists c6_10 \exists c1_11 \exists c1_12 \exists c3_13 \exists c3_14 \exists c6_15 \exists c6_16 \exists c1_17 \exists c1_18 \exists c3_19 \exists c3_20 \exists c6_21 \exists c6_22 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c3_3 > 0 & c3_4 > 0 & c6_5 > 0 & c6_6 > 0 & c1_7 > 0 & c1_8 > 0 & c6_9 > 0 & c6_10 > 0 & c1_11 > 0 & c1_12 > 0 & c3_13 > 0 & c3_14 > 0 & c6_15 > 0 & c6_16 > 0 & c1_17 > 0 & c1_18 > 0 & c3_19 > 0 & c3_20 > 0 & c6_21 > 0 & c6_22 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fe - qe*E = 0 )
            & ( E*h - UH = 0 )
            & ( v*dt - L = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c3_3 * Fm ) + ( c3_4 * Fe ) = 0 )
            & ( ( c6_5 * dt*i ) + ( c6_6 * Q ) = 0 )
            & ( ( c1_7 * Fm ) + ( c1_8 * v*qe*B ) = 0 )
            & ( ( c6_9 * dt*i ) + ( c6_10 * Q ) = 0 )
            & ( ( c1_11 * Fm ) + ( c1_12 * v*qe*B ) = 0 )
            & ( ( c3_13 * Fm ) + ( c3_14 * Fe ) = 0 )
            & ( ( c6_15 * dt*i ) + ( c6_16 * Q ) = 0 )
            & ( ( c1_17 * Fm ) + ( c1_18 * v*qe*B ) = 0 )
            & ( ( c3_19 * Fm ) + ( c3_20 * Fe ) = 0 )
            & ( ( c6_21 * dt*i ) + ( c6_22 * Q ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
