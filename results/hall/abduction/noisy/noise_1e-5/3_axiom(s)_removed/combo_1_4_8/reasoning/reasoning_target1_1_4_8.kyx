ArchiveEntry "hall_target1_combo1_4_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c4_3;
  Real c4_4;
  Real c8_5;
  Real c8_6;
  Real c1_7;
  Real c1_8;
  Real c4_9;
  Real c4_10;
  Real c8_11;
  Real c8_12;
  Real c1_13;
  Real c1_14;
  Real c8_15;
  Real c8_16;
  Real c1_17;
  Real c1_18;
  Real c4_19;
  Real c4_20;
  Real c8_21;
  Real c8_22;
  Real c1_23;
  Real c1_24;
  Real c4_25;
  Real c4_26;
  Real c8_27;
  Real c8_28;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c4_3 \exists c4_4 \exists c8_5 \exists c8_6 \exists c1_7 \exists c1_8 \exists c4_9 \exists c4_10 \exists c8_11 \exists c8_12 \exists c1_13 \exists c1_14 \exists c8_15 \exists c8_16 \exists c1_17 \exists c1_18 \exists c4_19 \exists c4_20 \exists c8_21 \exists c8_22 \exists c1_23 \exists c1_24 \exists c4_25 \exists c4_26 \exists c8_27 \exists c8_28 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c4_3 > 0 & c4_4 > 0 & c8_5 > 0 & c8_6 > 0 & c1_7 > 0 & c1_8 > 0 & c4_9 > 0 & c4_10 > 0 & c8_11 > 0 & c8_12 > 0 & c1_13 > 0 & c1_14 > 0 & c8_15 > 0 & c8_16 > 0 & c1_17 > 0 & c1_18 > 0 & c4_19 > 0 & c4_20 > 0 & c8_21 > 0 & c8_22 > 0 & c1_23 > 0 & c1_24 > 0 & c4_25 > 0 & c4_26 > 0 & c8_27 > 0 & c8_28 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c4_3 * E*h ) + ( c4_4 * UH ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c1_7 * Fm ) + ( c1_8 * v*qe*B ) = 0 )
            & ( ( c4_9 * E*h ) + ( c4_10 * UH ) = 0 )
            & ( ( c8_11 * N ) + ( c8_12 * V*n ) = 0 )
            & ( ( c1_13 * Fm ) + ( c1_14 * v*qe*B ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c1_17 * Fm ) + ( c1_18 * v*qe*B ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c8_21 * N ) + ( c8_22 * V*n ) = 0 )
            & ( ( c1_23 * Fm ) + ( c1_24 * v*qe*B ) = 0 )
            & ( ( c4_25 * E*h ) + ( c4_26 * UH ) = 0 )
            & ( ( c8_27 * N ) + ( c8_28 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
