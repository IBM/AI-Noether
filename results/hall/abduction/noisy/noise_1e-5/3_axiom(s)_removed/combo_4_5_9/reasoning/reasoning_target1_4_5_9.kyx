ArchiveEntry "hall_target1_combo4_5_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c5_3;
  Real c5_4;
  Real c9_5;
  Real c9_6;
  Real c4_7;
  Real c4_8;
  Real c5_9;
  Real c5_10;
  Real c9_11;
  Real c9_12;
  Real c4_13;
  Real c4_14;
  Real c5_15;
  Real c5_16;
  Real c9_17;
  Real c9_18;
  Real c4_19;
  Real c4_20;
  Real c5_21;
  Real c5_22;
  Real c9_23;
  Real c9_24;
  Real c5_25;
  Real c5_26;
  Real c9_27;
  Real c9_28;
  Real c4_29;
  Real c4_30;
  Real c5_31;
  Real c5_32;
  Real c9_33;
  Real c9_34;
  Real c4_35;
  Real c4_36;
  Real c5_37;
  Real c5_38;
  Real c9_39;
  Real c9_40;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c5_3 \exists c5_4 \exists c9_5 \exists c9_6 \exists c4_7 \exists c4_8 \exists c5_9 \exists c5_10 \exists c9_11 \exists c9_12 \exists c4_13 \exists c4_14 \exists c5_15 \exists c5_16 \exists c9_17 \exists c9_18 \exists c4_19 \exists c4_20 \exists c5_21 \exists c5_22 \exists c9_23 \exists c9_24 \exists c5_25 \exists c5_26 \exists c9_27 \exists c9_28 \exists c4_29 \exists c4_30 \exists c5_31 \exists c5_32 \exists c9_33 \exists c9_34 \exists c4_35 \exists c4_36 \exists c5_37 \exists c5_38 \exists c9_39 \exists c9_40 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c5_3 > 0 & c5_4 > 0 & c9_5 > 0 & c9_6 > 0 & c4_7 > 0 & c4_8 > 0 & c5_9 > 0 & c5_10 > 0 & c9_11 > 0 & c9_12 > 0 & c4_13 > 0 & c4_14 > 0 & c5_15 > 0 & c5_16 > 0 & c9_17 > 0 & c9_18 > 0 & c4_19 > 0 & c4_20 > 0 & c5_21 > 0 & c5_22 > 0 & c9_23 > 0 & c9_24 > 0 & c5_25 > 0 & c5_26 > 0 & c9_27 > 0 & c9_28 > 0 & c4_29 > 0 & c4_30 > 0 & c5_31 > 0 & c5_32 > 0 & c9_33 > 0 & c9_34 > 0 & c4_35 > 0 & c4_36 > 0 & c5_37 > 0 & c5_38 > 0 & c9_39 > 0 & c9_40 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c5_3 * v*dt ) + ( c5_4 * L ) = 0 )
            & ( ( c9_5 * d*h*L ) + ( c9_6 * V ) = 0 )
            & ( ( c4_7 * E*h ) + ( c4_8 * UH ) = 0 )
            & ( ( c5_9 * v*dt ) + ( c5_10 * L ) = 0 )
            & ( ( c9_11 * d*h*L ) + ( c9_12 * V ) = 0 )
            & ( ( c4_13 * E*h ) + ( c4_14 * UH ) = 0 )
            & ( ( c5_15 * v*dt ) + ( c5_16 * L ) = 0 )
            & ( ( c9_17 * d*h*L ) + ( c9_18 * V ) = 0 )
            & ( ( c4_19 * E*h ) + ( c4_20 * UH ) = 0 )
            & ( ( c5_21 * v*dt ) + ( c5_22 * L ) = 0 )
            & ( ( c9_23 * d*h*L ) + ( c9_24 * V ) = 0 )
            & ( ( c5_25 * v*dt ) + ( c5_26 * L ) = 0 )
            & ( ( c9_27 * d*h*L ) + ( c9_28 * V ) = 0 )
            & ( ( c4_29 * E*h ) + ( c4_30 * UH ) = 0 )
            & ( ( c5_31 * v*dt ) + ( c5_32 * L ) = 0 )
            & ( ( c9_33 * d*h*L ) + ( c9_34 * V ) = 0 )
            & ( ( c4_35 * E*h ) + ( c4_36 * UH ) = 0 )
            & ( ( c5_37 * v*dt ) + ( c5_38 * L ) = 0 )
            & ( ( c9_39 * d*h*L ) + ( c9_40 * V ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
