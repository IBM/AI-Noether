ArchiveEntry "hall_target1_combo5_7_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c7_1;
  Real c7_2;
  Real c8_3;
  Real c8_4;
  Real c5_5;
  Real c5_6;
  Real c7_7;
  Real c7_8;
  Real c8_9;
  Real c8_10;
  Real c5_11;
  Real c5_12;
  Real c7_13;
  Real c7_14;
  Real c8_15;
  Real c8_16;
  Real c5_17;
  Real c5_18;
  Real c8_19;
  Real c8_20;
  Real c5_21;
  Real c5_22;
  Real c7_23;
  Real c7_24;
  Real c8_25;
  Real c8_26;
  Real c5_27;
  Real c5_28;
  Real c7_29;
  Real c7_30;
  Real c8_31;
  Real c8_32;
  Real c5_33;
  Real c5_34;
  Real c7_35;
  Real c7_36;
  Real c8_37;
  Real c8_38;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c7_1 \exists c7_2 \exists c8_3 \exists c8_4 \exists c5_5 \exists c5_6 \exists c7_7 \exists c7_8 \exists c8_9 \exists c8_10 \exists c5_11 \exists c5_12 \exists c7_13 \exists c7_14 \exists c8_15 \exists c8_16 \exists c5_17 \exists c5_18 \exists c8_19 \exists c8_20 \exists c5_21 \exists c5_22 \exists c7_23 \exists c7_24 \exists c8_25 \exists c8_26 \exists c5_27 \exists c5_28 \exists c7_29 \exists c7_30 \exists c8_31 \exists c8_32 \exists c5_33 \exists c5_34 \exists c7_35 \exists c7_36 \exists c8_37 \exists c8_38 \exists d1 \exists d2
    (
      c7_1 > 0 & c7_2 > 0 & c8_3 > 0 & c8_4 > 0 & c5_5 > 0 & c5_6 > 0 & c7_7 > 0 & c7_8 > 0 & c8_9 > 0 & c8_10 > 0 & c5_11 > 0 & c5_12 > 0 & c7_13 > 0 & c7_14 > 0 & c8_15 > 0 & c8_16 > 0 & c5_17 > 0 & c5_18 > 0 & c8_19 > 0 & c8_20 > 0 & c5_21 > 0 & c5_22 > 0 & c7_23 > 0 & c7_24 > 0 & c8_25 > 0 & c8_26 > 0 & c5_27 > 0 & c5_28 > 0 & c7_29 > 0 & c7_30 > 0 & c8_31 > 0 & c8_32 > 0 & c5_33 > 0 & c5_34 > 0 & c7_35 > 0 & c7_36 > 0 & c8_37 > 0 & c8_38 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c7_1 * Q ) + ( c7_2 * N*qe ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c5_5 * v*dt ) + ( c5_6 * L ) = 0 )
            & ( ( c7_7 * Q ) + ( c7_8 * N*qe ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c5_11 * v*dt ) + ( c5_12 * L ) = 0 )
            & ( ( c7_13 * Q ) + ( c7_14 * N*qe ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c5_17 * v*dt ) + ( c5_18 * L ) = 0 )
            & ( ( c8_19 * N ) + ( c8_20 * V*n ) = 0 )
            & ( ( c5_21 * v*dt ) + ( c5_22 * L ) = 0 )
            & ( ( c7_23 * Q ) + ( c7_24 * N*qe ) = 0 )
            & ( ( c8_25 * N ) + ( c8_26 * V*n ) = 0 )
            & ( ( c5_27 * v*dt ) + ( c5_28 * L ) = 0 )
            & ( ( c7_29 * Q ) + ( c7_30 * N*qe ) = 0 )
            & ( ( c8_31 * N ) + ( c8_32 * V*n ) = 0 )
            & ( ( c5_33 * v*dt ) + ( c5_34 * L ) = 0 )
            & ( ( c7_35 * Q ) + ( c7_36 * N*qe ) = 0 )
            & ( ( c8_37 * N ) + ( c8_38 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
