ArchiveEntry "hall_target1_combo1_2_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c1_1;
  Real c1_2;
  Real c4_3;
  Real c4_4;
  Real c1_5;
  Real c1_6;
  Real c2_7;
  Real c2_8;
  Real c4_9;
  Real c4_10;
  Real c1_11;
  Real c1_12;
  Real c2_13;
  Real c2_14;
  Real c4_15;
  Real c4_16;
  Real c1_17;
  Real c1_18;
  Real c2_19;
  Real c2_20;
  Real c4_21;
  Real c4_22;
  Real c1_23;
  Real c1_24;
  Real c2_25;
  Real c2_26;
  Real c4_27;
  Real c4_28;
  Real c1_29;
  Real c1_30;
  Real c2_31;
  Real c2_32;
  Real c4_33;
  Real c4_34;
  Real c1_35;
  Real c1_36;
  Real c4_37;
  Real c4_38;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c4_3 \exists c4_4 \exists c1_5 \exists c1_6 \exists c2_7 \exists c2_8 \exists c4_9 \exists c4_10 \exists c1_11 \exists c1_12 \exists c2_13 \exists c2_14 \exists c4_15 \exists c4_16 \exists c1_17 \exists c1_18 \exists c2_19 \exists c2_20 \exists c4_21 \exists c4_22 \exists c1_23 \exists c1_24 \exists c2_25 \exists c2_26 \exists c4_27 \exists c4_28 \exists c1_29 \exists c1_30 \exists c2_31 \exists c2_32 \exists c4_33 \exists c4_34 \exists c1_35 \exists c1_36 \exists c4_37 \exists c4_38 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c4_3 > 0 & c4_4 > 0 & c1_5 > 0 & c1_6 > 0 & c2_7 > 0 & c2_8 > 0 & c4_9 > 0 & c4_10 > 0 & c1_11 > 0 & c1_12 > 0 & c2_13 > 0 & c2_14 > 0 & c4_15 > 0 & c4_16 > 0 & c1_17 > 0 & c1_18 > 0 & c2_19 > 0 & c2_20 > 0 & c4_21 > 0 & c4_22 > 0 & c1_23 > 0 & c1_24 > 0 & c2_25 > 0 & c2_26 > 0 & c4_27 > 0 & c4_28 > 0 & c1_29 > 0 & c1_30 > 0 & c2_31 > 0 & c2_32 > 0 & c4_33 > 0 & c4_34 > 0 & c1_35 > 0 & c1_36 > 0 & c4_37 > 0 & c4_38 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - Fe = 0 )
            & ( v*dt - L = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( n*V - N = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c1_1 * Fm ) + ( c1_2 * v*qe*B ) = 0 )
            & ( ( c4_3 * E*h ) + ( c4_4 * UH ) = 0 )
            & ( ( c1_5 * Fm ) + ( c1_6 * v*qe*B ) = 0 )
            & ( ( c2_7 * Fe ) + ( c2_8 * E*qe ) = 0 )
            & ( ( c4_9 * E*h ) + ( c4_10 * UH ) = 0 )
            & ( ( c1_11 * Fm ) + ( c1_12 * v*qe*B ) = 0 )
            & ( ( c2_13 * Fe ) + ( c2_14 * E*qe ) = 0 )
            & ( ( c4_15 * E*h ) + ( c4_16 * UH ) = 0 )
            & ( ( c1_17 * Fm ) + ( c1_18 * v*qe*B ) = 0 )
            & ( ( c2_19 * Fe ) + ( c2_20 * E*qe ) = 0 )
            & ( ( c4_21 * E*h ) + ( c4_22 * UH ) = 0 )
            & ( ( c1_23 * Fm ) + ( c1_24 * v*qe*B ) = 0 )
            & ( ( c2_25 * Fe ) + ( c2_26 * E*qe ) = 0 )
            & ( ( c4_27 * E*h ) + ( c4_28 * UH ) = 0 )
            & ( ( c1_29 * Fm ) + ( c1_30 * v*qe*B ) = 0 )
            & ( ( c2_31 * Fe ) + ( c2_32 * E*qe ) = 0 )
            & ( ( c4_33 * E*h ) + ( c4_34 * UH ) = 0 )
            & ( ( c1_35 * Fm ) + ( c1_36 * v*qe*B ) = 0 )
            & ( ( c4_37 * E*h ) + ( c4_38 * UH ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
