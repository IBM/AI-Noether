ArchiveEntry "hall_target1_combo3_5_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c5_1;
  Real c5_2;
  Real c8_3;
  Real c8_4;
  Real c3_5;
  Real c3_6;
  Real c5_7;
  Real c5_8;
  Real c8_9;
  Real c8_10;
  Real c3_11;
  Real c3_12;
  Real c5_13;
  Real c5_14;
  Real c3_15;
  Real c3_16;
  Real c5_17;
  Real c5_18;
  Real c8_19;
  Real c8_20;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c8_3 \exists c8_4 \exists c3_5 \exists c3_6 \exists c5_7 \exists c5_8 \exists c8_9 \exists c8_10 \exists c3_11 \exists c3_12 \exists c5_13 \exists c5_14 \exists c3_15 \exists c3_16 \exists c5_17 \exists c5_18 \exists c8_19 \exists c8_20 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c8_3 > 0 & c8_4 > 0 & c3_5 > 0 & c3_6 > 0 & c5_7 > 0 & c5_8 > 0 & c8_9 > 0 & c8_10 > 0 & c3_11 > 0 & c3_12 > 0 & c5_13 > 0 & c5_14 > 0 & c3_15 > 0 & c3_16 > 0 & c5_17 > 0 & c5_18 > 0 & c8_19 > 0 & c8_20 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( E*h - UH = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c5_1 * v*dt ) + ( c5_2 * L ) = 0 )
            & ( ( c8_3 * N ) + ( c8_4 * V*n ) = 0 )
            & ( ( c3_5 * Fm ) + ( c3_6 * Fe ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c3_11 * Fm ) + ( c3_12 * Fe ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c3_15 * Fm ) + ( c3_16 * Fe ) = 0 )
            & ( ( c5_17 * v*dt ) + ( c5_18 * L ) = 0 )
            & ( ( c8_19 * N ) + ( c8_20 * V*n ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
