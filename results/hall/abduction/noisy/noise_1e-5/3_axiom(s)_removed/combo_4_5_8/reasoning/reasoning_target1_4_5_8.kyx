ArchiveEntry "hall_target1_combo4_5_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Fm;
  Real d;
  Real v;
  Real Fe;
  Real E;
  Real dt;
  Real Q;
  Real N;
  Real V;
  Real i;
  Real n;
  Real qe;
  Real B;
  Real h;
  Real L;
  Real UH;
  Real c4_1;
  Real c4_2;
  Real c5_3;
  Real c5_4;
  Real c8_5;
  Real c8_6;
  Real c5_7;
  Real c5_8;
  Real c8_9;
  Real c8_10;
  Real c4_11;
  Real c4_12;
  Real c5_13;
  Real c5_14;
  Real c8_15;
  Real c8_16;
  Real c4_17;
  Real c4_18;
  Real c5_19;
  Real c5_20;
  Real c4_21;
  Real c4_22;
  Real c5_23;
  Real c5_24;
  Real c8_25;
  Real c8_26;
  Real c4_27;
  Real c4_28;
  Real c5_29;
  Real c5_30;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c5_3 \exists c5_4 \exists c8_5 \exists c8_6 \exists c5_7 \exists c5_8 \exists c8_9 \exists c8_10 \exists c4_11 \exists c4_12 \exists c5_13 \exists c5_14 \exists c8_15 \exists c8_16 \exists c4_17 \exists c4_18 \exists c5_19 \exists c5_20 \exists c4_21 \exists c4_22 \exists c5_23 \exists c5_24 \exists c8_25 \exists c8_26 \exists c4_27 \exists c4_28 \exists c5_29 \exists c5_30 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c5_3 > 0 & c5_4 > 0 & c8_5 > 0 & c8_6 > 0 & c5_7 > 0 & c5_8 > 0 & c8_9 > 0 & c8_10 > 0 & c4_11 > 0 & c4_12 > 0 & c5_13 > 0 & c5_14 > 0 & c8_15 > 0 & c8_16 > 0 & c4_17 > 0 & c4_18 > 0 & c5_19 > 0 & c5_20 > 0 & c4_21 > 0 & c4_22 > 0 & c5_23 > 0 & c5_24 > 0 & c8_25 > 0 & c8_26 > 0 & c4_27 > 0 & c4_28 > 0 & c5_29 > 0 & c5_30 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Fm \forall d \forall v \forall Fe \forall E \forall dt \forall Q \forall N \forall V \forall i \forall n \forall qe \forall B \forall h \forall L \forall UH
        (
          (
            (Fm > 0 & d > 0 & v > 0 & Fe > 0 & E > 0 & dt > 0 & Q > 0 & N > 0 & V > 0 & i > 0 & n > 0 & qe > 0 & B > 0 & h > 0 & L > 0 & UH > 0) &
            & ( Fm - qe*v*B = 0 )
            & ( Fe - qe*E = 0 )
            & ( Fm - Fe = 0 )
            & ( i*dt - Q = 0 )
            & ( Q - N*qe = 0 )
            & ( V - L*h*d = 0 )
            & ( ( c4_1 * E*h ) + ( c4_2 * UH ) = 0 )
            & ( ( c5_3 * v*dt ) + ( c5_4 * L ) = 0 )
            & ( ( c8_5 * N ) + ( c8_6 * V*n ) = 0 )
            & ( ( c5_7 * v*dt ) + ( c5_8 * L ) = 0 )
            & ( ( c8_9 * N ) + ( c8_10 * V*n ) = 0 )
            & ( ( c4_11 * E*h ) + ( c4_12 * UH ) = 0 )
            & ( ( c5_13 * v*dt ) + ( c5_14 * L ) = 0 )
            & ( ( c8_15 * N ) + ( c8_16 * V*n ) = 0 )
            & ( ( c4_17 * E*h ) + ( c4_18 * UH ) = 0 )
            & ( ( c5_19 * v*dt ) + ( c5_20 * L ) = 0 )
            & ( ( c4_21 * E*h ) + ( c4_22 * UH ) = 0 )
            & ( ( c5_23 * v*dt ) + ( c5_24 * L ) = 0 )
            & ( ( c8_25 * N ) + ( c8_26 * V*n ) = 0 )
            & ( ( c4_27 * E*h ) + ( c4_28 * UH ) = 0 )
            & ( ( c5_29 * v*dt ) + ( c5_30 * L ) = 0 )
          )
          ->
          (
            ( d1 * N*qe*UH ) + ( d2 * i*B*h*L ) = 0
          )
        )
      )
    )
  )
End.

End.
