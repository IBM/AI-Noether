ArchiveEntry "pendulum_target1_combo6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pii;
  Real Tj;
  Real c6_1;
  Real c6_2;
  Real c6_3;
  Real c6_4;
  Real c6_5;
  Real c6_6;
  Real c6_7;
  Real c6_8;
  Real c6_9;
  Real c6_10;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c6_1 \exists c6_2 \exists c6_3 \exists c6_4 \exists c6_5 \exists c6_6 \exists c6_7 \exists c6_8 \exists c6_9 \exists c6_10 \exists d1 \exists d2
    (
      c6_1 > 0 & c6_2 > 0 & c6_3 > 0 & c6_4 > 0 & c6_5 > 0 & c6_6 > 0 & c6_7 > 0 & c6_8 > 0 & c6_9 > 0 & c6_10 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pii \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pii > 0 & Tj > 0) &
            & ( ad-g*sintheta = 0 )
            & ( d-L*theta = 0 )
            & ( T*omega-2*Pii = 0 )
            & ( d*omega^2-ad = 0 )
            & ( Tj-j*T = 0 )
            & ( ( c6_1 * theta ) + ( c6_2 * sintheta ) = 0 )
            & ( ( c6_3 * theta ) + ( c6_4 * sintheta ) = 0 )
            & ( ( c6_5 * theta ) + ( c6_6 * sintheta ) = 0 )
            & ( ( c6_7 * theta ) + ( c6_8 * sintheta ) = 0 )
            & ( ( c6_9 * theta ) + ( c6_10 * sintheta ) = 0 )
          )
          ->
          (
            ( d1 * g*Tj^2 ) + ( d2 * L*j^2*Pii^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
