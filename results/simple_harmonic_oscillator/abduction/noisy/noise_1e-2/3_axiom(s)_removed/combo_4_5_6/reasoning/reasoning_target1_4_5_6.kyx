ArchiveEntry "pendulum_target1_combo4_5_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pi;
  Real Tj;
  Real c4_1;
  Real c4_2;
  Real c5_3;
  Real c5_4;
  Real c6_5;
  Real c6_6;
  Real c4_7;
  Real c4_8;
  Real c5_9;
  Real c5_10;
  Real c6_11;
  Real c6_12;
  Real c4_13;
  Real c4_14;
  Real c5_15;
  Real c5_16;
  Real c6_17;
  Real c6_18;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c5_3 \exists c5_4 \exists c6_5 \exists c6_6 \exists c4_7 \exists c4_8 \exists c5_9 \exists c5_10 \exists c6_11 \exists c6_12 \exists c4_13 \exists c4_14 \exists c5_15 \exists c5_16 \exists c6_17 \exists c6_18 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c5_3 > 0 & c5_4 > 0 & c6_5 > 0 & c6_6 > 0 & c4_7 > 0 & c4_8 > 0 & c5_9 > 0 & c5_10 > 0 & c6_11 > 0 & c6_12 > 0 & c4_13 > 0 & c4_14 > 0 & c5_15 > 0 & c5_16 > 0 & c6_17 > 0 & c6_18 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pi \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pi > 0 & Tj > 0) &
            & ( ad-g*sintheta = 0 )
            & ( d-L*theta = 0 )
            & ( T*omega-2*Pi = 0 )
            & ( ( c4_1 * ad ) + ( c4_2 * omega^2*d ) = 0 )
            & ( ( c5_3 * T*j ) + ( c5_4 * Tj ) = 0 )
            & ( ( c6_5 * theta ) + ( c6_6 * sintheta ) = 0 )
            & ( ( c4_7 * ad ) + ( c4_8 * omega^2*d ) = 0 )
            & ( ( c5_9 * T*j ) + ( c5_10 * Tj ) = 0 )
            & ( ( c6_11 * theta ) + ( c6_12 * sintheta ) = 0 )
            & ( ( c4_13 * ad ) + ( c4_14 * omega^2*d ) = 0 )
            & ( ( c5_15 * T*j ) + ( c5_16 * Tj ) = 0 )
            & ( ( c6_17 * theta ) + ( c6_18 * sintheta ) = 0 )
          )
          ->
          (
            ( d1 * d*g*Tj^2 ) + ( d2 * d*L*j^2*Pi^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
