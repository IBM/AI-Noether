ArchiveEntry "pendulum_target1_combo1_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pi;
  Real Tj;
  Real c1_1;
  Real c1_2;
  Real c4_3;
  Real c4_4;
  Real c5_5;
  Real c5_6;
  Real c1_7;
  Real c1_8;
  Real c4_9;
  Real c4_10;
  Real c5_11;
  Real c5_12;
  Real c1_13;
  Real c1_14;
  Real c4_15;
  Real c4_16;
  Real c5_17;
  Real c5_18;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c4_3 \exists c4_4 \exists c5_5 \exists c5_6 \exists c1_7 \exists c1_8 \exists c4_9 \exists c4_10 \exists c5_11 \exists c5_12 \exists c1_13 \exists c1_14 \exists c4_15 \exists c4_16 \exists c5_17 \exists c5_18 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c4_3 > 0 & c4_4 > 0 & c5_5 > 0 & c5_6 > 0 & c1_7 > 0 & c1_8 > 0 & c4_9 > 0 & c4_10 > 0 & c5_11 > 0 & c5_12 > 0 & c1_13 > 0 & c1_14 > 0 & c4_15 > 0 & c4_16 > 0 & c5_17 > 0 & c5_18 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pi \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pi > 0 & Tj > 0) &
            & ( d-L*theta = 0 )
            & ( T*omega-2*Pi = 0 )
            & ( sintheta - theta = 0 )
            & ( ( c1_1 * ad ) + ( c1_2 * sintheta*g ) = 0 )
            & ( ( c4_3 * ad ) + ( c4_4 * omega^2*d ) = 0 )
            & ( ( c5_5 * T*j ) + ( c5_6 * Tj ) = 0 )
            & ( ( c1_7 * ad ) + ( c1_8 * sintheta*g ) = 0 )
            & ( ( c4_9 * ad ) + ( c4_10 * omega^2*d ) = 0 )
            & ( ( c5_11 * T*j ) + ( c5_12 * Tj ) = 0 )
            & ( ( c1_13 * ad ) + ( c1_14 * sintheta*g ) = 0 )
            & ( ( c4_15 * ad ) + ( c4_16 * omega^2*d ) = 0 )
            & ( ( c5_17 * T*j ) + ( c5_18 * Tj ) = 0 )
          )
          ->
          (
            ( d1 * d*g*Tj^2 ) + ( d2 * d*L*j^2*Pi^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
