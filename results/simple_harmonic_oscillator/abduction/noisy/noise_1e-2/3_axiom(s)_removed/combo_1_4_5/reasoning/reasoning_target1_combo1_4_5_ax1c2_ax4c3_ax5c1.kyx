ArchiveEntry "simple_harmonic_oscillator_target1_combo1_4_5_ax1c2_ax4c3_ax5c1"

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pi;
  Real Tj;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0
      &
      (
      \forall ad
      \forall T
      \forall omega
      \forall theta
      \forall sintheta
      \forall d
      \forall g
      \forall L
      \forall j
      \forall Pi
      \forall Tj
          (
          (
            ad>0 & T>0 & omega>0 & theta>0 & sintheta>0 & d>0 & g>0 & L>0 & j>0 & Pi>0 & Tj>0
            & ( d-L*theta = 0 )
            & ( T*omega-2*Pi = 0 )
            & ( sintheta - theta = 0 )
            & ( c1 * sintheta*g ) = 0
            & ( c2 * ad ) = ( c3 * omega^2*d )
            & ( c4 * T*j ) = ( c5 * Tj )
            )
        ->
          (
            ( c6 * d*g*Tj^2 ) = ( c7 * d*L*j^2*Pi^2 )
          )
          )
      )
    )
  )
End.

End.