ArchiveEntry "pendulum_target1_combo2_4_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pi;
  Real Tj;
  Real c2_1;
  Real c2_2;
  Real c4_3;
  Real c4_4;
  Real c6_5;
  Real c6_6;
  Real c2_7;
  Real c2_8;
  Real c4_9;
  Real c4_10;
  Real c6_11;
  Real c6_12;
  Real c4_13;
  Real c4_14;
  Real c6_15;
  Real c6_16;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c4_3 \exists c4_4 \exists c6_5 \exists c6_6 \exists c2_7 \exists c2_8 \exists c4_9 \exists c4_10 \exists c6_11 \exists c6_12 \exists c4_13 \exists c4_14 \exists c6_15 \exists c6_16 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c4_3 > 0 & c4_4 > 0 & c6_5 > 0 & c6_6 > 0 & c2_7 > 0 & c2_8 > 0 & c4_9 > 0 & c4_10 > 0 & c6_11 > 0 & c6_12 > 0 & c4_13 > 0 & c4_14 > 0 & c6_15 > 0 & c6_16 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pi \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pi > 0 & Tj > 0) &
            & ( ad-g*sintheta = 0 )
            & ( T*omega-2*Pi = 0 )
            & ( Tj-j*T = 0 )
            & ( ( c2_1 * theta*L ) + ( c2_2 * d ) = 0 )
            & ( ( c4_3 * ad ) + ( c4_4 * omega^2*d ) = 0 )
            & ( ( c6_5 * theta ) + ( c6_6 * sintheta ) = 0 )
            & ( ( c2_7 * theta*L ) + ( c2_8 * d ) = 0 )
            & ( ( c4_9 * ad ) + ( c4_10 * omega^2*d ) = 0 )
            & ( ( c6_11 * theta ) + ( c6_12 * sintheta ) = 0 )
            & ( ( c4_13 * ad ) + ( c4_14 * omega^2*d ) = 0 )
            & ( ( c6_15 * theta ) + ( c6_16 * sintheta ) = 0 )
          )
          ->
          (
            ( d1 * d*g*Tj^2 ) + ( d2 * d*L*j^2*Pi^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
