ArchiveEntry "pendulum_target1_combo2_3_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pi;
  Real Tj;
  Real c2_1;
  Real c2_2;
  Real c3_3;
  Real c3_4;
  Real c5_5;
  Real c5_6;
  Real c2_7;
  Real c2_8;
  Real c5_9;
  Real c5_10;
  Real c2_11;
  Real c2_12;
  Real c3_13;
  Real c3_14;
  Real c5_15;
  Real c5_16;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c3_3 \exists c3_4 \exists c5_5 \exists c5_6 \exists c2_7 \exists c2_8 \exists c5_9 \exists c5_10 \exists c2_11 \exists c2_12 \exists c3_13 \exists c3_14 \exists c5_15 \exists c5_16 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c3_3 > 0 & c3_4 > 0 & c5_5 > 0 & c5_6 > 0 & c2_7 > 0 & c2_8 > 0 & c5_9 > 0 & c5_10 > 0 & c2_11 > 0 & c2_12 > 0 & c3_13 > 0 & c3_14 > 0 & c5_15 > 0 & c5_16 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pi \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pi > 0 & Tj > 0) &
            & ( ad-g*sintheta = 0 )
            & ( d*omega^2-ad = 0 )
            & ( sintheta - theta = 0 )
            & ( ( c2_1 * theta*L ) + ( c2_2 * d ) = 0 )
            & ( ( c3_3 * T*omega ) + ( c3_4 * Pi ) = 0 )
            & ( ( c5_5 * T*j ) + ( c5_6 * Tj ) = 0 )
            & ( ( c2_7 * theta*L ) + ( c2_8 * d ) = 0 )
            & ( ( c5_9 * T*j ) + ( c5_10 * Tj ) = 0 )
            & ( ( c2_11 * theta*L ) + ( c2_12 * d ) = 0 )
            & ( ( c3_13 * T*omega ) + ( c3_14 * Pi ) = 0 )
            & ( ( c5_15 * T*j ) + ( c5_16 * Tj ) = 0 )
          )
          ->
          (
            ( d1 * d*g*Tj^2 ) + ( d2 * d*L*j^2*Pi^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
