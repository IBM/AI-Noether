ArchiveEntry "pendulum_target1_combo1_4_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pii;
  Real Tj;
  Real c1_1;
  Real c1_2;
  Real c4_3;
  Real c4_4;
  Real c6_5;
  Real c6_6;
  Real c4_7;
  Real c4_8;
  Real c6_9;
  Real c6_10;
  Real c1_11;
  Real c1_12;
  Real c4_13;
  Real c4_14;
  Real c6_15;
  Real c6_16;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c4_3 \exists c4_4 \exists c6_5 \exists c6_6 \exists c4_7 \exists c4_8 \exists c6_9 \exists c6_10 \exists c1_11 \exists c1_12 \exists c4_13 \exists c4_14 \exists c6_15 \exists c6_16 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c4_3 > 0 & c4_4 > 0 & c6_5 > 0 & c6_6 > 0 & c4_7 > 0 & c4_8 > 0 & c6_9 > 0 & c6_10 > 0 & c1_11 > 0 & c1_12 > 0 & c4_13 > 0 & c4_14 > 0 & c6_15 > 0 & c6_16 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pii \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pii > 0 & Tj > 0) &
            & ( d-L*theta = 0 )
            & ( T*omega-2*Pii = 0 )
            & ( Tj-j*T = 0 )
            & ( ( c1_1 * ad ) + ( c1_2 * sintheta*g ) = 0 )
            & ( ( c4_3 * ad ) + ( c4_4 * omega^2*d ) = 0 )
            & ( ( c6_5 * theta ) + ( c6_6 * sintheta ) = 0 )
            & ( ( c4_7 * ad ) + ( c4_8 * omega^2*d ) = 0 )
            & ( ( c6_9 * theta ) + ( c6_10 * sintheta ) = 0 )
            & ( ( c1_11 * ad ) + ( c1_12 * sintheta*g ) = 0 )
            & ( ( c4_13 * ad ) + ( c4_14 * omega^2*d ) = 0 )
            & ( ( c6_15 * theta ) + ( c6_16 * sintheta ) = 0 )
          )
          ->
          (
            ( d1 * g*Tj^2 ) + ( d2 * L*j^2*Pii^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
