ArchiveEntry "pendulum_target1_combo1_2_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pii;
  Real Tj;
  Real c1_1;
  Real c1_2;
  Real c2_3;
  Real c2_4;
  Real c4_5;
  Real c4_6;
  Real c1_7;
  Real c1_8;
  Real c2_9;
  Real c2_10;
  Real c4_11;
  Real c4_12;
  Real c1_13;
  Real c1_14;
  Real c2_15;
  Real c2_16;
  Real c4_17;
  Real c4_18;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c2_3 \exists c2_4 \exists c4_5 \exists c4_6 \exists c1_7 \exists c1_8 \exists c2_9 \exists c2_10 \exists c4_11 \exists c4_12 \exists c1_13 \exists c1_14 \exists c2_15 \exists c2_16 \exists c4_17 \exists c4_18 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c2_3 > 0 & c2_4 > 0 & c4_5 > 0 & c4_6 > 0 & c1_7 > 0 & c1_8 > 0 & c2_9 > 0 & c2_10 > 0 & c4_11 > 0 & c4_12 > 0 & c1_13 > 0 & c1_14 > 0 & c2_15 > 0 & c2_16 > 0 & c4_17 > 0 & c4_18 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pii \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pii > 0 & Tj > 0) &
            & ( T*omega-2*Pii = 0 )
            & ( Tj-j*T = 0 )
            & ( sintheta - theta = 0 )
            & ( ( c1_1 * ad ) + ( c1_2 * sintheta*g ) = 0 )
            & ( ( c2_3 * theta*L ) + ( c2_4 * d ) = 0 )
            & ( ( c4_5 * ad ) + ( c4_6 * omega^2*d ) = 0 )
            & ( ( c1_7 * ad ) + ( c1_8 * sintheta*g ) = 0 )
            & ( ( c2_9 * theta*L ) + ( c2_10 * d ) = 0 )
            & ( ( c4_11 * ad ) + ( c4_12 * omega^2*d ) = 0 )
            & ( ( c1_13 * ad ) + ( c1_14 * sintheta*g ) = 0 )
            & ( ( c2_15 * theta*L ) + ( c2_16 * d ) = 0 )
            & ( ( c4_17 * ad ) + ( c4_18 * omega^2*d ) = 0 )
          )
          ->
          (
            ( d1 * g*Tj^2 ) + ( d2 * L*j^2*Pii^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
