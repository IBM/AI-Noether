ArchiveEntry "pendulum_target1_combo3_5_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pii;
  Real Tj;
  Real c3_1;
  Real c3_2;
  Real c5_3;
  Real c5_4;
  Real c3_5;
  Real c3_6;
  Real c5_7;
  Real c5_8;
  Real c6_9;
  Real c6_10;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c5_3 \exists c5_4 \exists c3_5 \exists c3_6 \exists c5_7 \exists c5_8 \exists c6_9 \exists c6_10 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c5_3 > 0 & c5_4 > 0 & c3_5 > 0 & c3_6 > 0 & c5_7 > 0 & c5_8 > 0 & c6_9 > 0 & c6_10 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pii \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pii > 0 & Tj > 0) &
            & ( ad-g*sintheta = 0 )
            & ( d-L*theta = 0 )
            & ( d*omega^2-ad = 0 )
            & ( ( c3_1 * T*omega ) + ( c3_2 * Pii ) = 0 )
            & ( ( c5_3 * T*j ) + ( c5_4 * Tj ) = 0 )
            & ( ( c3_5 * T*omega ) + ( c3_6 * Pii ) = 0 )
            & ( ( c5_7 * T*j ) + ( c5_8 * Tj ) = 0 )
            & ( ( c6_9 * theta ) + ( c6_10 * sintheta ) = 0 )
          )
          ->
          (
            ( d1 * g*Tj^2 ) + ( d2 * L*j^2*Pii^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
