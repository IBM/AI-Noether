ArchiveEntry "pendulum_target1_combo1"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ad;
  Real T;
  Real omega;
  Real theta;
  Real sintheta;
  Real d;
  Real g;
  Real L;
  Real j;
  Real Pii;
  Real Tj;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c1_4;
  Real c1_5;
  Real c1_6;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c1_4 \exists c1_5 \exists c1_6 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c1_4 > 0 & c1_5 > 0 & c1_6 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall ad \forall T \forall omega \forall theta \forall sintheta \forall d \forall g \forall L \forall j \forall Pii \forall Tj
        (
          (
            (ad > 0 & T > 0 & omega > 0 & theta > 0 & sintheta > 0 & d > 0 & g > 0 & L > 0 & j > 0 & Pii > 0 & Tj > 0) &
            & ( d-L*theta = 0 )
            & ( T*omega-2*Pii = 0 )
            & ( d*omega^2-ad = 0 )
            & ( Tj-j*T = 0 )
            & ( sintheta - theta = 0 )
            & ( ( c1_1 * ad ) + ( c1_2 * sintheta*g ) = 0 )
            & ( ( c1_3 * ad ) + ( c1_4 * sintheta*g ) = 0 )
            & ( ( c1_5 * ad ) + ( c1_6 * sintheta*g ) = 0 )
          )
          ->
          (
            ( d1 * g*Tj^2 ) + ( d2 * L*j^2*Pii^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
