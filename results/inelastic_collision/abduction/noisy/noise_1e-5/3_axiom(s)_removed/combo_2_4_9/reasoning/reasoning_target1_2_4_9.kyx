ArchiveEntry "inelastic_collision_target1_combo2_4_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c4_4;
  Real c4_5;
  Real c4_6;
  Real c9_7;
  Real c9_8;
  Real c9_9;
  Real c2_10;
  Real c2_11;
  Real c2_12;
  Real c4_13;
  Real c4_14;
  Real c4_15;
  Real c9_16;
  Real c9_17;
  Real c9_18;
  Real c2_19;
  Real c2_20;
  Real c2_21;
  Real c4_22;
  Real c4_23;
  Real c4_24;
  Real c9_25;
  Real c9_26;
  Real c9_27;
  Real c2_28;
  Real c2_29;
  Real c2_30;
  Real c4_31;
  Real c4_32;
  Real c4_33;
  Real c9_34;
  Real c9_35;
  Real c9_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c4_4 \exists c4_5 \exists c4_6 \exists c9_7 \exists c9_8 \exists c9_9 \exists c2_10 \exists c2_11 \exists c2_12 \exists c4_13 \exists c4_14 \exists c4_15 \exists c9_16 \exists c9_17 \exists c9_18 \exists c2_19 \exists c2_20 \exists c2_21 \exists c4_22 \exists c4_23 \exists c4_24 \exists c9_25 \exists c9_26 \exists c9_27 \exists c2_28 \exists c2_29 \exists c2_30 \exists c4_31 \exists c4_32 \exists c4_33 \exists c9_34 \exists c9_35 \exists c9_36 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c4_4 > 0 & c4_5 > 0 & c4_6 > 0 & c9_7 > 0 & c9_8 > 0 & c9_9 > 0 & c2_10 > 0 & c2_11 > 0 & c2_12 > 0 & c4_13 > 0 & c4_14 > 0 & c4_15 > 0 & c9_16 > 0 & c9_17 > 0 & c9_18 > 0 & c2_19 > 0 & c2_20 > 0 & c2_21 > 0 & c4_22 > 0 & c4_23 > 0 & c4_24 > 0 & c9_25 > 0 & c9_26 > 0 & c9_27 > 0 & c2_28 > 0 & c2_29 > 0 & c2_30 > 0 & c4_31 > 0 & c4_32 > 0 & c4_33 > 0 & c9_34 > 0 & c9_35 > 0 & c9_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c4_4 * pc^2*c^2 ) + ( c4_5 * Ec^2 ) + ( c4_6 * mc^2*c^2 ) = 0 )
            & ( ( c9_7 * vc^2*pc^2 ) + ( c9_8 * vc^2*mc^2*c^2 ) + ( c9_9 * pc^2*c^2 ) = 0 )
            & ( ( c2_10 * Em^2 ) + ( c2_11 * mm^2*c^4 ) + ( c2_12 * pm^2*c^2 ) = 0 )
            & ( ( c4_13 * pc^2*c^2 ) + ( c4_14 * Ec^2 ) + ( c4_15 * mc^2*c^2 ) = 0 )
            & ( ( c9_16 * vc^2*pc^2 ) + ( c9_17 * vc^2*mc^2*c^2 ) + ( c9_18 * pc^2*c^2 ) = 0 )
            & ( ( c2_19 * Em^2 ) + ( c2_20 * mm^2*c^4 ) + ( c2_21 * pm^2*c^2 ) = 0 )
            & ( ( c4_22 * pc^2*c^2 ) + ( c4_23 * Ec^2 ) + ( c4_24 * mc^2*c^2 ) = 0 )
            & ( ( c9_25 * vc^2*pc^2 ) + ( c9_26 * vc^2*mc^2*c^2 ) + ( c9_27 * pc^2*c^2 ) = 0 )
            & ( ( c2_28 * Em^2 ) + ( c2_29 * mm^2*c^4 ) + ( c2_30 * pm^2*c^2 ) = 0 )
            & ( ( c4_31 * pc^2*c^2 ) + ( c4_32 * Ec^2 ) + ( c4_33 * mc^2*c^2 ) = 0 )
            & ( ( c9_34 * vc^2*pc^2 ) + ( c9_35 * vc^2*mc^2*c^2 ) + ( c9_36 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
