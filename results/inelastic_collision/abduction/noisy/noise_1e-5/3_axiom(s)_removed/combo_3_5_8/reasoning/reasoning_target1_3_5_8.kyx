ArchiveEntry "inelastic_collision_target1_combo3_5_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c5_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c8_7;
  Real c8_8;
  Real c3_9;
  Real c3_10;
  Real c5_11;
  Real c5_12;
  Real c5_13;
  Real c5_14;
  Real c8_15;
  Real c8_16;
  Real c3_17;
  Real c3_18;
  Real c5_19;
  Real c5_20;
  Real c5_21;
  Real c5_22;
  Real c8_23;
  Real c8_24;
  Real c3_25;
  Real c3_26;
  Real c5_27;
  Real c5_28;
  Real c5_29;
  Real c5_30;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c5_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c8_7 \exists c8_8 \exists c3_9 \exists c3_10 \exists c5_11 \exists c5_12 \exists c5_13 \exists c5_14 \exists c8_15 \exists c8_16 \exists c3_17 \exists c3_18 \exists c5_19 \exists c5_20 \exists c5_21 \exists c5_22 \exists c8_23 \exists c8_24 \exists c3_25 \exists c3_26 \exists c5_27 \exists c5_28 \exists c5_29 \exists c5_30 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c5_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c8_7 > 0 & c8_8 > 0 & c3_9 > 0 & c3_10 > 0 & c5_11 > 0 & c5_12 > 0 & c5_13 > 0 & c5_14 > 0 & c8_15 > 0 & c8_16 > 0 & c3_17 > 0 & c3_18 > 0 & c5_19 > 0 & c5_20 > 0 & c5_21 > 0 & c5_22 > 0 & c8_23 > 0 & c8_24 > 0 & c3_25 > 0 & c3_26 > 0 & c5_27 > 0 & c5_28 > 0 & c5_29 > 0 & c5_30 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c5_3 * Em^2 ) + ( c5_4 * Em*Er ) + ( c5_5 * Er^2 ) + ( c5_6 * Ec^2 ) = 0 )
            & ( ( c8_7 * mr ) + ( c8_8 * mm ) = 0 )
            & ( ( c3_9 * mr*c^2 ) + ( c3_10 * Er ) = 0 )
            & ( ( c5_11 * Em^2 ) + ( c5_12 * Em*Er ) + ( c5_13 * Er^2 ) + ( c5_14 * Ec^2 ) = 0 )
            & ( ( c8_15 * mr ) + ( c8_16 * mm ) = 0 )
            & ( ( c3_17 * mr*c^2 ) + ( c3_18 * Er ) = 0 )
            & ( ( c5_19 * Em^2 ) + ( c5_20 * Em*Er ) + ( c5_21 * Er^2 ) + ( c5_22 * Ec^2 ) = 0 )
            & ( ( c8_23 * mr ) + ( c8_24 * mm ) = 0 )
            & ( ( c3_25 * mr*c^2 ) + ( c3_26 * Er ) = 0 )
            & ( ( c5_27 * Em^2 ) + ( c5_28 * Em*Er ) + ( c5_29 * Er^2 ) + ( c5_30 * Ec^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
