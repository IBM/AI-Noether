ArchiveEntry "inelastic_collision_target1_combo1_3_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c3_4;
  Real c3_5;
  Real c5_6;
  Real c5_7;
  Real c5_8;
  Real c5_9;
  Real c1_10;
  Real c1_11;
  Real c1_12;
  Real c3_13;
  Real c3_14;
  Real c5_15;
  Real c5_16;
  Real c5_17;
  Real c5_18;
  Real c1_19;
  Real c1_20;
  Real c1_21;
  Real c3_22;
  Real c3_23;
  Real c5_24;
  Real c5_25;
  Real c5_26;
  Real c5_27;
  Real c1_28;
  Real c1_29;
  Real c1_30;
  Real c3_31;
  Real c3_32;
  Real c5_33;
  Real c5_34;
  Real c5_35;
  Real c5_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c3_4 \exists c3_5 \exists c5_6 \exists c5_7 \exists c5_8 \exists c5_9 \exists c1_10 \exists c1_11 \exists c1_12 \exists c3_13 \exists c3_14 \exists c5_15 \exists c5_16 \exists c5_17 \exists c5_18 \exists c1_19 \exists c1_20 \exists c1_21 \exists c3_22 \exists c3_23 \exists c5_24 \exists c5_25 \exists c5_26 \exists c5_27 \exists c1_28 \exists c1_29 \exists c1_30 \exists c3_31 \exists c3_32 \exists c5_33 \exists c5_34 \exists c5_35 \exists c5_36 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c3_4 > 0 & c3_5 > 0 & c5_6 > 0 & c5_7 > 0 & c5_8 > 0 & c5_9 > 0 & c1_10 > 0 & c1_11 > 0 & c1_12 > 0 & c3_13 > 0 & c3_14 > 0 & c5_15 > 0 & c5_16 > 0 & c5_17 > 0 & c5_18 > 0 & c1_19 > 0 & c1_20 > 0 & c1_21 > 0 & c3_22 > 0 & c3_23 > 0 & c5_24 > 0 & c5_25 > 0 & c5_26 > 0 & c5_27 > 0 & c1_28 > 0 & c1_29 > 0 & c1_30 > 0 & c3_31 > 0 & c3_32 > 0 & c5_33 > 0 & c5_34 > 0 & c5_35 > 0 & c5_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c3_4 * mr*c^2 ) + ( c3_5 * Er ) = 0 )
            & ( ( c5_6 * Em^2 ) + ( c5_7 * Em*Er ) + ( c5_8 * Er^2 ) + ( c5_9 * Ec^2 ) = 0 )
            & ( ( c1_10 * vm^2*mm^2*c^2 ) + ( c1_11 * vm^2*pm^2 ) + ( c1_12 * pm^2*c^2 ) = 0 )
            & ( ( c3_13 * mr*c^2 ) + ( c3_14 * Er ) = 0 )
            & ( ( c5_15 * Em^2 ) + ( c5_16 * Em*Er ) + ( c5_17 * Er^2 ) + ( c5_18 * Ec^2 ) = 0 )
            & ( ( c1_19 * vm^2*mm^2*c^2 ) + ( c1_20 * vm^2*pm^2 ) + ( c1_21 * pm^2*c^2 ) = 0 )
            & ( ( c3_22 * mr*c^2 ) + ( c3_23 * Er ) = 0 )
            & ( ( c5_24 * Em^2 ) + ( c5_25 * Em*Er ) + ( c5_26 * Er^2 ) + ( c5_27 * Ec^2 ) = 0 )
            & ( ( c1_28 * vm^2*mm^2*c^2 ) + ( c1_29 * vm^2*pm^2 ) + ( c1_30 * pm^2*c^2 ) = 0 )
            & ( ( c3_31 * mr*c^2 ) + ( c3_32 * Er ) = 0 )
            & ( ( c5_33 * Em^2 ) + ( c5_34 * Em*Er ) + ( c5_35 * Er^2 ) + ( c5_36 * Ec^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
