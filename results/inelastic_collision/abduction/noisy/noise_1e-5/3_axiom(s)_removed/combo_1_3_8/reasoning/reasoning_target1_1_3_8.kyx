ArchiveEntry "inelastic_collision_target1_combo1_3_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c3_4;
  Real c3_5;
  Real c1_6;
  Real c1_7;
  Real c1_8;
  Real c3_9;
  Real c3_10;
  Real c1_11;
  Real c1_12;
  Real c1_13;
  Real c3_14;
  Real c3_15;
  Real c8_16;
  Real c8_17;
  Real c1_18;
  Real c1_19;
  Real c1_20;
  Real c3_21;
  Real c3_22;
  Real c8_23;
  Real c8_24;
  Real c1_25;
  Real c1_26;
  Real c1_27;
  Real c3_28;
  Real c3_29;
  Real c8_30;
  Real c8_31;
  Real c1_32;
  Real c1_33;
  Real c1_34;
  Real c3_35;
  Real c3_36;
  Real c8_37;
  Real c8_38;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c3_4 \exists c3_5 \exists c1_6 \exists c1_7 \exists c1_8 \exists c3_9 \exists c3_10 \exists c1_11 \exists c1_12 \exists c1_13 \exists c3_14 \exists c3_15 \exists c8_16 \exists c8_17 \exists c1_18 \exists c1_19 \exists c1_20 \exists c3_21 \exists c3_22 \exists c8_23 \exists c8_24 \exists c1_25 \exists c1_26 \exists c1_27 \exists c3_28 \exists c3_29 \exists c8_30 \exists c8_31 \exists c1_32 \exists c1_33 \exists c1_34 \exists c3_35 \exists c3_36 \exists c8_37 \exists c8_38 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c3_4 > 0 & c3_5 > 0 & c1_6 > 0 & c1_7 > 0 & c1_8 > 0 & c3_9 > 0 & c3_10 > 0 & c1_11 > 0 & c1_12 > 0 & c1_13 > 0 & c3_14 > 0 & c3_15 > 0 & c8_16 > 0 & c8_17 > 0 & c1_18 > 0 & c1_19 > 0 & c1_20 > 0 & c3_21 > 0 & c3_22 > 0 & c8_23 > 0 & c8_24 > 0 & c1_25 > 0 & c1_26 > 0 & c1_27 > 0 & c3_28 > 0 & c3_29 > 0 & c8_30 > 0 & c8_31 > 0 & c1_32 > 0 & c1_33 > 0 & c1_34 > 0 & c3_35 > 0 & c3_36 > 0 & c8_37 > 0 & c8_38 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c3_4 * mr*c^2 ) + ( c3_5 * Er ) = 0 )
            & ( ( c1_6 * vm^2*mm^2*c^2 ) + ( c1_7 * vm^2*pm^2 ) + ( c1_8 * pm^2*c^2 ) = 0 )
            & ( ( c3_9 * mr*c^2 ) + ( c3_10 * Er ) = 0 )
            & ( ( c1_11 * vm^2*mm^2*c^2 ) + ( c1_12 * vm^2*pm^2 ) + ( c1_13 * pm^2*c^2 ) = 0 )
            & ( ( c3_14 * mr*c^2 ) + ( c3_15 * Er ) = 0 )
            & ( ( c8_16 * mr ) + ( c8_17 * mm ) = 0 )
            & ( ( c1_18 * vm^2*mm^2*c^2 ) + ( c1_19 * vm^2*pm^2 ) + ( c1_20 * pm^2*c^2 ) = 0 )
            & ( ( c3_21 * mr*c^2 ) + ( c3_22 * Er ) = 0 )
            & ( ( c8_23 * mr ) + ( c8_24 * mm ) = 0 )
            & ( ( c1_25 * vm^2*mm^2*c^2 ) + ( c1_26 * vm^2*pm^2 ) + ( c1_27 * pm^2*c^2 ) = 0 )
            & ( ( c3_28 * mr*c^2 ) + ( c3_29 * Er ) = 0 )
            & ( ( c8_30 * mr ) + ( c8_31 * mm ) = 0 )
            & ( ( c1_32 * vm^2*mm^2*c^2 ) + ( c1_33 * vm^2*pm^2 ) + ( c1_34 * pm^2*c^2 ) = 0 )
            & ( ( c3_35 * mr*c^2 ) + ( c3_36 * Er ) = 0 )
            & ( ( c8_37 * mr ) + ( c8_38 * mm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
