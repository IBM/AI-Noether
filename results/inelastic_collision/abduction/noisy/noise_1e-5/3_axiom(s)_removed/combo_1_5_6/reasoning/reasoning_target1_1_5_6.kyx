ArchiveEntry "inelastic_collision_target1_combo1_5_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c5_7;
  Real c1_8;
  Real c1_9;
  Real c1_10;
  Real c5_11;
  Real c5_12;
  Real c5_13;
  Real c5_14;
  Real c6_15;
  Real c6_16;
  Real c1_17;
  Real c1_18;
  Real c1_19;
  Real c5_20;
  Real c5_21;
  Real c5_22;
  Real c5_23;
  Real c6_24;
  Real c6_25;
  Real c1_26;
  Real c1_27;
  Real c1_28;
  Real c5_29;
  Real c5_30;
  Real c5_31;
  Real c5_32;
  Real c6_33;
  Real c6_34;
  Real c1_35;
  Real c1_36;
  Real c1_37;
  Real c5_38;
  Real c5_39;
  Real c5_40;
  Real c5_41;
  Real c6_42;
  Real c6_43;
  Real c1_44;
  Real c1_45;
  Real c1_46;
  Real c5_47;
  Real c5_48;
  Real c5_49;
  Real c5_50;
  Real c6_51;
  Real c6_52;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c5_7 \exists c1_8 \exists c1_9 \exists c1_10 \exists c5_11 \exists c5_12 \exists c5_13 \exists c5_14 \exists c6_15 \exists c6_16 \exists c1_17 \exists c1_18 \exists c1_19 \exists c5_20 \exists c5_21 \exists c5_22 \exists c5_23 \exists c6_24 \exists c6_25 \exists c1_26 \exists c1_27 \exists c1_28 \exists c5_29 \exists c5_30 \exists c5_31 \exists c5_32 \exists c6_33 \exists c6_34 \exists c1_35 \exists c1_36 \exists c1_37 \exists c5_38 \exists c5_39 \exists c5_40 \exists c5_41 \exists c6_42 \exists c6_43 \exists c1_44 \exists c1_45 \exists c1_46 \exists c5_47 \exists c5_48 \exists c5_49 \exists c5_50 \exists c6_51 \exists c6_52 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c5_7 > 0 & c1_8 > 0 & c1_9 > 0 & c1_10 > 0 & c5_11 > 0 & c5_12 > 0 & c5_13 > 0 & c5_14 > 0 & c6_15 > 0 & c6_16 > 0 & c1_17 > 0 & c1_18 > 0 & c1_19 > 0 & c5_20 > 0 & c5_21 > 0 & c5_22 > 0 & c5_23 > 0 & c6_24 > 0 & c6_25 > 0 & c1_26 > 0 & c1_27 > 0 & c1_28 > 0 & c5_29 > 0 & c5_30 > 0 & c5_31 > 0 & c5_32 > 0 & c6_33 > 0 & c6_34 > 0 & c1_35 > 0 & c1_36 > 0 & c1_37 > 0 & c5_38 > 0 & c5_39 > 0 & c5_40 > 0 & c5_41 > 0 & c6_42 > 0 & c6_43 > 0 & c1_44 > 0 & c1_45 > 0 & c1_46 > 0 & c5_47 > 0 & c5_48 > 0 & c5_49 > 0 & c5_50 > 0 & c6_51 > 0 & c6_52 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c5_4 * Em^2 ) + ( c5_5 * Em*Er ) + ( c5_6 * Er^2 ) + ( c5_7 * Ec^2 ) = 0 )
            & ( ( c1_8 * vm^2*mm^2*c^2 ) + ( c1_9 * vm^2*pm^2 ) + ( c1_10 * pm^2*c^2 ) = 0 )
            & ( ( c5_11 * Em^2 ) + ( c5_12 * Em*Er ) + ( c5_13 * Er^2 ) + ( c5_14 * Ec^2 ) = 0 )
            & ( ( c6_15 * pc ) + ( c6_16 * pm ) = 0 )
            & ( ( c1_17 * vm^2*mm^2*c^2 ) + ( c1_18 * vm^2*pm^2 ) + ( c1_19 * pm^2*c^2 ) = 0 )
            & ( ( c5_20 * Em^2 ) + ( c5_21 * Em*Er ) + ( c5_22 * Er^2 ) + ( c5_23 * Ec^2 ) = 0 )
            & ( ( c6_24 * pc ) + ( c6_25 * pm ) = 0 )
            & ( ( c1_26 * vm^2*mm^2*c^2 ) + ( c1_27 * vm^2*pm^2 ) + ( c1_28 * pm^2*c^2 ) = 0 )
            & ( ( c5_29 * Em^2 ) + ( c5_30 * Em*Er ) + ( c5_31 * Er^2 ) + ( c5_32 * Ec^2 ) = 0 )
            & ( ( c6_33 * pc ) + ( c6_34 * pm ) = 0 )
            & ( ( c1_35 * vm^2*mm^2*c^2 ) + ( c1_36 * vm^2*pm^2 ) + ( c1_37 * pm^2*c^2 ) = 0 )
            & ( ( c5_38 * Em^2 ) + ( c5_39 * Em*Er ) + ( c5_40 * Er^2 ) + ( c5_41 * Ec^2 ) = 0 )
            & ( ( c6_42 * pc ) + ( c6_43 * pm ) = 0 )
            & ( ( c1_44 * vm^2*mm^2*c^2 ) + ( c1_45 * vm^2*pm^2 ) + ( c1_46 * pm^2*c^2 ) = 0 )
            & ( ( c5_47 * Em^2 ) + ( c5_48 * Em*Er ) + ( c5_49 * Er^2 ) + ( c5_50 * Ec^2 ) = 0 )
            & ( ( c6_51 * pc ) + ( c6_52 * pm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
