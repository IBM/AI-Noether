ArchiveEntry "inelastic_collision_target1_combo3_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c5_6;
  Real c5_7;
  Real c5_8;
  Real c5_9;
  Real c3_10;
  Real c3_11;
  Real c4_12;
  Real c4_13;
  Real c4_14;
  Real c5_15;
  Real c5_16;
  Real c5_17;
  Real c5_18;
  Real c3_19;
  Real c3_20;
  Real c4_21;
  Real c4_22;
  Real c4_23;
  Real c5_24;
  Real c5_25;
  Real c5_26;
  Real c5_27;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c5_6 \exists c5_7 \exists c5_8 \exists c5_9 \exists c3_10 \exists c3_11 \exists c4_12 \exists c4_13 \exists c4_14 \exists c5_15 \exists c5_16 \exists c5_17 \exists c5_18 \exists c3_19 \exists c3_20 \exists c4_21 \exists c4_22 \exists c4_23 \exists c5_24 \exists c5_25 \exists c5_26 \exists c5_27 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c5_6 > 0 & c5_7 > 0 & c5_8 > 0 & c5_9 > 0 & c3_10 > 0 & c3_11 > 0 & c4_12 > 0 & c4_13 > 0 & c4_14 > 0 & c5_15 > 0 & c5_16 > 0 & c5_17 > 0 & c5_18 > 0 & c3_19 > 0 & c3_20 > 0 & c4_21 > 0 & c4_22 > 0 & c4_23 > 0 & c5_24 > 0 & c5_25 > 0 & c5_26 > 0 & c5_27 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c4_3 * pc^2*c^2 ) + ( c4_4 * Ec^2 ) + ( c4_5 * mc^2*c^2 ) = 0 )
            & ( ( c5_6 * Em^2 ) + ( c5_7 * Em*Er ) + ( c5_8 * Er^2 ) + ( c5_9 * Ec^2 ) = 0 )
            & ( ( c3_10 * mr*c^2 ) + ( c3_11 * Er ) = 0 )
            & ( ( c4_12 * pc^2*c^2 ) + ( c4_13 * Ec^2 ) + ( c4_14 * mc^2*c^2 ) = 0 )
            & ( ( c5_15 * Em^2 ) + ( c5_16 * Em*Er ) + ( c5_17 * Er^2 ) + ( c5_18 * Ec^2 ) = 0 )
            & ( ( c3_19 * mr*c^2 ) + ( c3_20 * Er ) = 0 )
            & ( ( c4_21 * pc^2*c^2 ) + ( c4_22 * Ec^2 ) + ( c4_23 * mc^2*c^2 ) = 0 )
            & ( ( c5_24 * Em^2 ) + ( c5_25 * Em*Er ) + ( c5_26 * Er^2 ) + ( c5_27 * Ec^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
