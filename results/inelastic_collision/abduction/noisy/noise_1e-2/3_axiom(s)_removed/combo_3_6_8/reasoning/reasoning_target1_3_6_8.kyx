ArchiveEntry "inelastic_collision_target1_combo3_6_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c6_3;
  Real c6_4;
  Real c8_5;
  Real c8_6;
  Real c3_7;
  Real c3_8;
  Real c6_9;
  Real c6_10;
  Real c8_11;
  Real c8_12;
  Real c3_13;
  Real c3_14;
  Real c6_15;
  Real c6_16;
  Real c8_17;
  Real c8_18;
  Real c3_19;
  Real c3_20;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c6_3 \exists c6_4 \exists c8_5 \exists c8_6 \exists c3_7 \exists c3_8 \exists c6_9 \exists c6_10 \exists c8_11 \exists c8_12 \exists c3_13 \exists c3_14 \exists c6_15 \exists c6_16 \exists c8_17 \exists c8_18 \exists c3_19 \exists c3_20 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c6_3 > 0 & c6_4 > 0 & c8_5 > 0 & c8_6 > 0 & c3_7 > 0 & c3_8 > 0 & c6_9 > 0 & c6_10 > 0 & c8_11 > 0 & c8_12 > 0 & c3_13 > 0 & c3_14 > 0 & c6_15 > 0 & c6_16 > 0 & c8_17 > 0 & c8_18 > 0 & c3_19 > 0 & c3_20 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c6_3 * pc ) + ( c6_4 * pm ) = 0 )
            & ( ( c8_5 * mr ) + ( c8_6 * mm ) = 0 )
            & ( ( c3_7 * mr*c^2 ) + ( c3_8 * Er ) = 0 )
            & ( ( c6_9 * pc ) + ( c6_10 * pm ) = 0 )
            & ( ( c8_11 * mr ) + ( c8_12 * mm ) = 0 )
            & ( ( c3_13 * mr*c^2 ) + ( c3_14 * Er ) = 0 )
            & ( ( c6_15 * pc ) + ( c6_16 * pm ) = 0 )
            & ( ( c8_17 * mr ) + ( c8_18 * mm ) = 0 )
            & ( ( c3_19 * mr*c^2 ) + ( c3_20 * Er ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
