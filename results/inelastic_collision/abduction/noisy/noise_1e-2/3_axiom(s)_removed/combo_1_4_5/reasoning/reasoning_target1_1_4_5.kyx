End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c4_4 \exists c4_5 \exists c4_6 \exists c5_7 \exists c5_8 \exists c5_9 \exists c5_10 \exists c1_11 \exists c1_12 \exists c1_13 \exists c4_14 \exists c4_15 \exists c4_16 \exists c5_17 \exists c5_18 \exists c5_19 \exists c5_20 \exists c1_21 \exists c1_22 \exists c1_23 \exists c4_24 \exists c4_25 \exists c4_26 \exists c5_27 \exists c5_28 \exists c5_29 \exists c5_30 \exists c1_31 \exists c1_32 \exists c1_33 \exists c4_34 \exists c4_35 \exists c4_36 \exists c5_37 \exists c5_38 \exists c5_39 \exists c5_40 \exists c1_41 \exists c1_42 \exists c1_43 \exists c4_44 \exists c4_45 \exists c4_46 \exists c5_47 \exists c5_48 \exists c5_49 \exists c5_50 \exists c1_51 \exists c1_52 \exists c1_53 \exists c4_54 \exists c4_55 \exists c4_56 \exists c5_57 \exists c5_58 \exists c5_59 \exists c5_60 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c4_4 > 0 & c4_5 > 0 & c4_6 > 0 & c5_7 > 0 & c5_8 > 0 & c5_9 > 0 & c5_10 > 0 & c1_11 > 0 & c1_12 > 0 & c1_13 > 0 & c4_14 > 0 & c4_15 > 0 & c4_16 > 0 & c5_17 > 0 & c5_18 > 0 & c5_19 > 0 & c5_20 > 0 & c1_21 > 0 & c1_22 > 0 & c1_23 > 0 & c4_24 > 0 & c4_25 > 0 & c4_26 > 0 & c5_27 > 0 & c5_28 > 0 & c5_29 > 0 & c5_30 > 0 & c1_31 > 0 & c1_32 > 0 & c1_33 > 0 & c4_34 > 0 & c4_35 > 0 & c4_36 > 0 & c5_37 > 0 & c5_38 > 0 & c5_39 > 0 & c5_40 > 0 & c1_41 > 0 & c1_42 > 0 & c1_43 > 0 & c4_44 > 0 & c4_45 > 0 & c4_46 > 0 & c5_47 > 0 & c5_48 > 0 & c5_49 > 0 & c5_50 > 0 & c1_51 > 0 & c1_52 > 0 & c1_53 > 0 & c4_54 > 0 & c4_55 > 0 & c4_56 > 0 & c5_57 > 0 & c5_58 > 0 & c5_59 > 0 & c5_60 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c4_4 * pc^2*c^2 ) + ( c4_5 * Ec^2 ) + ( c4_6 * mc^2*c^2 ) = 0 )
            & ( ( c5_7 * Em^2 ) + ( c5_8 * Em*Er ) + ( c5_9 * Er^2 ) + ( c5_10 * Ec^2 ) = 0 )
            & ( ( c1_11 * vm^2*mm^2*c^2 ) + ( c1_12 * vm^2*pm^2 ) + ( c1_13 * pm^2*c^2 ) = 0 )
            & ( ( c4_14 * pc^2*c^2 ) + ( c4_15 * Ec^2 ) + ( c4_16 * mc^2*c^2 ) = 0 )
            & ( ( c5_17 * Em^2 ) + ( c5_18 * Em*Er ) + ( c5_19 * Er^2 ) + ( c5_20 * Ec^2 ) = 0 )
            & ( ( c1_21 * vm^2*mm^2*c^2 ) + ( c1_22 * vm^2*pm^2 ) + ( c1_23 * pm^2*c^2 ) = 0 )
            & ( ( c4_24 * pc^2*c^2 ) + ( c4_25 * Ec^2 ) + ( c4_26 * mc^2*c^2 ) = 0 )
            & ( ( c5_27 * Em^2 ) + ( c5_28 * Em*Er ) + ( c5_29 * Er^2 ) + ( c5_30 * Ec^2 ) = 0 )
            & ( ( c1_31 * vm^2*mm^2*c^2 ) + ( c1_32 * vm^2*pm^2 ) + ( c1_33 * pm^2*c^2 ) = 0 )
            & ( ( c4_34 * pc^2*c^2 ) + ( c4_35 * Ec^2 ) + ( c4_36 * mc^2*c^2 ) = 0 )
            & ( ( c5_37 * Em^2 ) + ( c5_38 * Em*Er ) + ( c5_39 * Er^2 ) + ( c5_40 * Ec^2 ) = 0 )
            & ( ( c1_41 * vm^2*mm^2*c^2 ) + ( c1_42 * vm^2*pm^2 ) + ( c1_43 * pm^2*c^2 ) = 0 )
            & ( ( c4_44 * pc^2*c^2 ) + ( c4_45 * Ec^2 ) + ( c4_46 * mc^2*c^2 ) = 0 )
            & ( ( c5_47 * Em^2 ) + ( c5_48 * Em*Er ) + ( c5_49 * Er^2 ) + ( c5_50 * Ec^2 ) = 0 )
            & ( ( c1_51 * vm^2*mm^2*c^2 ) + ( c1_52 * vm^2*pm^2 ) + ( c1_53 * pm^2*c^2 ) = 0 )
            & ( ( c4_54 * pc^2*c^2 ) + ( c4_55 * Ec^2 ) + ( c4_56 * mc^2*c^2 ) = 0 )
            & ( ( c5_57 * Em^2 ) + ( c5_58 * Em*Er ) + ( c5_59 * Er^2 ) + ( c5_60 * Ec^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
