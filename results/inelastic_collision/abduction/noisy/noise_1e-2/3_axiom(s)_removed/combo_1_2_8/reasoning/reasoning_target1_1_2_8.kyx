ArchiveEntry "inelastic_collision_target1_combo1_2_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c2_4;
  Real c2_5;
  Real c2_6;
  Real c1_7;
  Real c1_8;
  Real c1_9;
  Real c2_10;
  Real c2_11;
  Real c2_12;
  Real c1_13;
  Real c1_14;
  Real c1_15;
  Real c2_16;
  Real c2_17;
  Real c2_18;
  Real c8_19;
  Real c8_20;
  Real c1_21;
  Real c1_22;
  Real c1_23;
  Real c2_24;
  Real c2_25;
  Real c2_26;
  Real c8_27;
  Real c8_28;
  Real c1_29;
  Real c1_30;
  Real c1_31;
  Real c2_32;
  Real c2_33;
  Real c2_34;
  Real c8_35;
  Real c8_36;
  Real c1_37;
  Real c1_38;
  Real c1_39;
  Real c2_40;
  Real c2_41;
  Real c2_42;
  Real c8_43;
  Real c8_44;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c2_4 \exists c2_5 \exists c2_6 \exists c1_7 \exists c1_8 \exists c1_9 \exists c2_10 \exists c2_11 \exists c2_12 \exists c1_13 \exists c1_14 \exists c1_15 \exists c2_16 \exists c2_17 \exists c2_18 \exists c8_19 \exists c8_20 \exists c1_21 \exists c1_22 \exists c1_23 \exists c2_24 \exists c2_25 \exists c2_26 \exists c8_27 \exists c8_28 \exists c1_29 \exists c1_30 \exists c1_31 \exists c2_32 \exists c2_33 \exists c2_34 \exists c8_35 \exists c8_36 \exists c1_37 \exists c1_38 \exists c1_39 \exists c2_40 \exists c2_41 \exists c2_42 \exists c8_43 \exists c8_44 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c1_7 > 0 & c1_8 > 0 & c1_9 > 0 & c2_10 > 0 & c2_11 > 0 & c2_12 > 0 & c1_13 > 0 & c1_14 > 0 & c1_15 > 0 & c2_16 > 0 & c2_17 > 0 & c2_18 > 0 & c8_19 > 0 & c8_20 > 0 & c1_21 > 0 & c1_22 > 0 & c1_23 > 0 & c2_24 > 0 & c2_25 > 0 & c2_26 > 0 & c8_27 > 0 & c8_28 > 0 & c1_29 > 0 & c1_30 > 0 & c1_31 > 0 & c2_32 > 0 & c2_33 > 0 & c2_34 > 0 & c8_35 > 0 & c8_36 > 0 & c1_37 > 0 & c1_38 > 0 & c1_39 > 0 & c2_40 > 0 & c2_41 > 0 & c2_42 > 0 & c8_43 > 0 & c8_44 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
            & ( ( c1_7 * vm^2*mm^2*c^2 ) + ( c1_8 * vm^2*pm^2 ) + ( c1_9 * pm^2*c^2 ) = 0 )
            & ( ( c2_10 * Em^2 ) + ( c2_11 * mm^2*c^4 ) + ( c2_12 * pm^2*c^2 ) = 0 )
            & ( ( c1_13 * vm^2*mm^2*c^2 ) + ( c1_14 * vm^2*pm^2 ) + ( c1_15 * pm^2*c^2 ) = 0 )
            & ( ( c2_16 * Em^2 ) + ( c2_17 * mm^2*c^4 ) + ( c2_18 * pm^2*c^2 ) = 0 )
            & ( ( c8_19 * mr ) + ( c8_20 * mm ) = 0 )
            & ( ( c1_21 * vm^2*mm^2*c^2 ) + ( c1_22 * vm^2*pm^2 ) + ( c1_23 * pm^2*c^2 ) = 0 )
            & ( ( c2_24 * Em^2 ) + ( c2_25 * mm^2*c^4 ) + ( c2_26 * pm^2*c^2 ) = 0 )
            & ( ( c8_27 * mr ) + ( c8_28 * mm ) = 0 )
            & ( ( c1_29 * vm^2*mm^2*c^2 ) + ( c1_30 * vm^2*pm^2 ) + ( c1_31 * pm^2*c^2 ) = 0 )
            & ( ( c2_32 * Em^2 ) + ( c2_33 * mm^2*c^4 ) + ( c2_34 * pm^2*c^2 ) = 0 )
            & ( ( c8_35 * mr ) + ( c8_36 * mm ) = 0 )
            & ( ( c1_37 * vm^2*mm^2*c^2 ) + ( c1_38 * vm^2*pm^2 ) + ( c1_39 * pm^2*c^2 ) = 0 )
            & ( ( c2_40 * Em^2 ) + ( c2_41 * mm^2*c^4 ) + ( c2_42 * pm^2*c^2 ) = 0 )
            & ( ( c8_43 * mr ) + ( c8_44 * mm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
