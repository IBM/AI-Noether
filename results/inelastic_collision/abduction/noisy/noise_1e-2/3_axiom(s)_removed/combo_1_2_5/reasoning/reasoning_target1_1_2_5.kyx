ArchiveEntry "inelastic_collision_target1_combo1_2_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c2_4;
  Real c2_5;
  Real c2_6;
  Real c5_7;
  Real c5_8;
  Real c5_9;
  Real c5_10;
  Real c1_11;
  Real c1_12;
  Real c1_13;
  Real c2_14;
  Real c2_15;
  Real c2_16;
  Real c5_17;
  Real c5_18;
  Real c5_19;
  Real c5_20;
  Real c1_21;
  Real c1_22;
  Real c1_23;
  Real c2_24;
  Real c2_25;
  Real c2_26;
  Real c5_27;
  Real c5_28;
  Real c5_29;
  Real c5_30;
  Real c1_31;
  Real c1_32;
  Real c1_33;
  Real c2_34;
  Real c2_35;
  Real c2_36;
  Real c5_37;
  Real c5_38;
  Real c5_39;
  Real c5_40;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c2_4 \exists c2_5 \exists c2_6 \exists c5_7 \exists c5_8 \exists c5_9 \exists c5_10 \exists c1_11 \exists c1_12 \exists c1_13 \exists c2_14 \exists c2_15 \exists c2_16 \exists c5_17 \exists c5_18 \exists c5_19 \exists c5_20 \exists c1_21 \exists c1_22 \exists c1_23 \exists c2_24 \exists c2_25 \exists c2_26 \exists c5_27 \exists c5_28 \exists c5_29 \exists c5_30 \exists c1_31 \exists c1_32 \exists c1_33 \exists c2_34 \exists c2_35 \exists c2_36 \exists c5_37 \exists c5_38 \exists c5_39 \exists c5_40 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c5_7 > 0 & c5_8 > 0 & c5_9 > 0 & c5_10 > 0 & c1_11 > 0 & c1_12 > 0 & c1_13 > 0 & c2_14 > 0 & c2_15 > 0 & c2_16 > 0 & c5_17 > 0 & c5_18 > 0 & c5_19 > 0 & c5_20 > 0 & c1_21 > 0 & c1_22 > 0 & c1_23 > 0 & c2_24 > 0 & c2_25 > 0 & c2_26 > 0 & c5_27 > 0 & c5_28 > 0 & c5_29 > 0 & c5_30 > 0 & c1_31 > 0 & c1_32 > 0 & c1_33 > 0 & c2_34 > 0 & c2_35 > 0 & c2_36 > 0 & c5_37 > 0 & c5_38 > 0 & c5_39 > 0 & c5_40 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
            & ( ( c5_7 * Em^2 ) + ( c5_8 * Em*Er ) + ( c5_9 * Er^2 ) + ( c5_10 * Ec^2 ) = 0 )
            & ( ( c1_11 * vm^2*mm^2*c^2 ) + ( c1_12 * vm^2*pm^2 ) + ( c1_13 * pm^2*c^2 ) = 0 )
            & ( ( c2_14 * Em^2 ) + ( c2_15 * mm^2*c^4 ) + ( c2_16 * pm^2*c^2 ) = 0 )
            & ( ( c5_17 * Em^2 ) + ( c5_18 * Em*Er ) + ( c5_19 * Er^2 ) + ( c5_20 * Ec^2 ) = 0 )
            & ( ( c1_21 * vm^2*mm^2*c^2 ) + ( c1_22 * vm^2*pm^2 ) + ( c1_23 * pm^2*c^2 ) = 0 )
            & ( ( c2_24 * Em^2 ) + ( c2_25 * mm^2*c^4 ) + ( c2_26 * pm^2*c^2 ) = 0 )
            & ( ( c5_27 * Em^2 ) + ( c5_28 * Em*Er ) + ( c5_29 * Er^2 ) + ( c5_30 * Ec^2 ) = 0 )
            & ( ( c1_31 * vm^2*mm^2*c^2 ) + ( c1_32 * vm^2*pm^2 ) + ( c1_33 * pm^2*c^2 ) = 0 )
            & ( ( c2_34 * Em^2 ) + ( c2_35 * mm^2*c^4 ) + ( c2_36 * pm^2*c^2 ) = 0 )
            & ( ( c5_37 * Em^2 ) + ( c5_38 * Em*Er ) + ( c5_39 * Er^2 ) + ( c5_40 * Ec^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
