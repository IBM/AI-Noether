ArchiveEntry "inelastic_collision_target1_combo1_2_3"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c2_4;
  Real c2_5;
  Real c2_6;
  Real c3_7;
  Real c3_8;
  Real c1_9;
  Real c1_10;
  Real c1_11;
  Real c2_12;
  Real c2_13;
  Real c2_14;
  Real c3_15;
  Real c3_16;
  Real c1_17;
  Real c1_18;
  Real c1_19;
  Real c2_20;
  Real c2_21;
  Real c2_22;
  Real c3_23;
  Real c3_24;
  Real c1_25;
  Real c1_26;
  Real c1_27;
  Real c2_28;
  Real c2_29;
  Real c2_30;
  Real c3_31;
  Real c3_32;
  Real c1_33;
  Real c1_34;
  Real c1_35;
  Real c2_36;
  Real c2_37;
  Real c2_38;
  Real c3_39;
  Real c3_40;
  Real c1_41;
  Real c1_42;
  Real c1_43;
  Real c2_44;
  Real c2_45;
  Real c2_46;
  Real c3_47;
  Real c3_48;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c2_4 \exists c2_5 \exists c2_6 \exists c3_7 \exists c3_8 \exists c1_9 \exists c1_10 \exists c1_11 \exists c2_12 \exists c2_13 \exists c2_14 \exists c3_15 \exists c3_16 \exists c1_17 \exists c1_18 \exists c1_19 \exists c2_20 \exists c2_21 \exists c2_22 \exists c3_23 \exists c3_24 \exists c1_25 \exists c1_26 \exists c1_27 \exists c2_28 \exists c2_29 \exists c2_30 \exists c3_31 \exists c3_32 \exists c1_33 \exists c1_34 \exists c1_35 \exists c2_36 \exists c2_37 \exists c2_38 \exists c3_39 \exists c3_40 \exists c1_41 \exists c1_42 \exists c1_43 \exists c2_44 \exists c2_45 \exists c2_46 \exists c3_47 \exists c3_48 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c3_7 > 0 & c3_8 > 0 & c1_9 > 0 & c1_10 > 0 & c1_11 > 0 & c2_12 > 0 & c2_13 > 0 & c2_14 > 0 & c3_15 > 0 & c3_16 > 0 & c1_17 > 0 & c1_18 > 0 & c1_19 > 0 & c2_20 > 0 & c2_21 > 0 & c2_22 > 0 & c3_23 > 0 & c3_24 > 0 & c1_25 > 0 & c1_26 > 0 & c1_27 > 0 & c2_28 > 0 & c2_29 > 0 & c2_30 > 0 & c3_31 > 0 & c3_32 > 0 & c1_33 > 0 & c1_34 > 0 & c1_35 > 0 & c2_36 > 0 & c2_37 > 0 & c2_38 > 0 & c3_39 > 0 & c3_40 > 0 & c1_41 > 0 & c1_42 > 0 & c1_43 > 0 & c2_44 > 0 & c2_45 > 0 & c2_46 > 0 & c3_47 > 0 & c3_48 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
            & ( ( c3_7 * mr*c^2 ) + ( c3_8 * Er ) = 0 )
            & ( ( c1_9 * vm^2*mm^2*c^2 ) + ( c1_10 * vm^2*pm^2 ) + ( c1_11 * pm^2*c^2 ) = 0 )
            & ( ( c2_12 * Em^2 ) + ( c2_13 * mm^2*c^4 ) + ( c2_14 * pm^2*c^2 ) = 0 )
            & ( ( c3_15 * mr*c^2 ) + ( c3_16 * Er ) = 0 )
            & ( ( c1_17 * vm^2*mm^2*c^2 ) + ( c1_18 * vm^2*pm^2 ) + ( c1_19 * pm^2*c^2 ) = 0 )
            & ( ( c2_20 * Em^2 ) + ( c2_21 * mm^2*c^4 ) + ( c2_22 * pm^2*c^2 ) = 0 )
            & ( ( c3_23 * mr*c^2 ) + ( c3_24 * Er ) = 0 )
            & ( ( c1_25 * vm^2*mm^2*c^2 ) + ( c1_26 * vm^2*pm^2 ) + ( c1_27 * pm^2*c^2 ) = 0 )
            & ( ( c2_28 * Em^2 ) + ( c2_29 * mm^2*c^4 ) + ( c2_30 * pm^2*c^2 ) = 0 )
            & ( ( c3_31 * mr*c^2 ) + ( c3_32 * Er ) = 0 )
            & ( ( c1_33 * vm^2*mm^2*c^2 ) + ( c1_34 * vm^2*pm^2 ) + ( c1_35 * pm^2*c^2 ) = 0 )
            & ( ( c2_36 * Em^2 ) + ( c2_37 * mm^2*c^4 ) + ( c2_38 * pm^2*c^2 ) = 0 )
            & ( ( c3_39 * mr*c^2 ) + ( c3_40 * Er ) = 0 )
            & ( ( c1_41 * vm^2*mm^2*c^2 ) + ( c1_42 * vm^2*pm^2 ) + ( c1_43 * pm^2*c^2 ) = 0 )
            & ( ( c2_44 * Em^2 ) + ( c2_45 * mm^2*c^4 ) + ( c2_46 * pm^2*c^2 ) = 0 )
            & ( ( c3_47 * mr*c^2 ) + ( c3_48 * Er ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
