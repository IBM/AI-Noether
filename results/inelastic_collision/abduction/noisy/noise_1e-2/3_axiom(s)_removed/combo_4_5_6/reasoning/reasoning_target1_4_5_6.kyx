ArchiveEntry "inelastic_collision_target1_combo4_5_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c4_1;
  Real c4_2;
  Real c4_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c5_7;
  Real c6_8;
  Real c6_9;
  Real c4_10;
  Real c4_11;
  Real c4_12;
  Real c5_13;
  Real c5_14;
  Real c5_15;
  Real c5_16;
  Real c4_17;
  Real c4_18;
  Real c4_19;
  Real c5_20;
  Real c5_21;
  Real c5_22;
  Real c5_23;
  Real c6_24;
  Real c6_25;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c4_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c5_7 \exists c6_8 \exists c6_9 \exists c4_10 \exists c4_11 \exists c4_12 \exists c5_13 \exists c5_14 \exists c5_15 \exists c5_16 \exists c4_17 \exists c4_18 \exists c4_19 \exists c5_20 \exists c5_21 \exists c5_22 \exists c5_23 \exists c6_24 \exists c6_25 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c4_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c5_7 > 0 & c6_8 > 0 & c6_9 > 0 & c4_10 > 0 & c4_11 > 0 & c4_12 > 0 & c5_13 > 0 & c5_14 > 0 & c5_15 > 0 & c5_16 > 0 & c4_17 > 0 & c4_18 > 0 & c4_19 > 0 & c5_20 > 0 & c5_21 > 0 & c5_22 > 0 & c5_23 > 0 & c6_24 > 0 & c6_25 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c4_1 * pc^2*c^2 ) + ( c4_2 * Ec^2 ) + ( c4_3 * mc^2*c^2 ) = 0 )
            & ( ( c5_4 * Em^2 ) + ( c5_5 * Em*Er ) + ( c5_6 * Er^2 ) + ( c5_7 * Ec^2 ) = 0 )
            & ( ( c6_8 * pc ) + ( c6_9 * pm ) = 0 )
            & ( ( c4_10 * pc^2*c^2 ) + ( c4_11 * Ec^2 ) + ( c4_12 * mc^2*c^2 ) = 0 )
            & ( ( c5_13 * Em^2 ) + ( c5_14 * Em*Er ) + ( c5_15 * Er^2 ) + ( c5_16 * Ec^2 ) = 0 )
            & ( ( c4_17 * pc^2*c^2 ) + ( c4_18 * Ec^2 ) + ( c4_19 * mc^2*c^2 ) = 0 )
            & ( ( c5_20 * Em^2 ) + ( c5_21 * Em*Er ) + ( c5_22 * Er^2 ) + ( c5_23 * Ec^2 ) = 0 )
            & ( ( c6_24 * pc ) + ( c6_25 * pm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
