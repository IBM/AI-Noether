End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c4_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c5_7 \exists c7_8 \exists c7_9 \exists c4_10 \exists c4_11 \exists c4_12 \exists c5_13 \exists c5_14 \exists c5_15 \exists c5_16 \exists c7_17 \exists c7_18 \exists c4_19 \exists c4_20 \exists c4_21 \exists c5_22 \exists c5_23 \exists c5_24 \exists c5_25 \exists c7_26 \exists c7_27 \exists c4_28 \exists c4_29 \exists c4_30 \exists c5_31 \exists c5_32 \exists c5_33 \exists c5_34 \exists c7_35 \exists c7_36 \exists c4_37 \exists c4_38 \exists c4_39 \exists c5_40 \exists c5_41 \exists c5_42 \exists c5_43 \exists c7_44 \exists c7_45 \exists c4_46 \exists c4_47 \exists c4_48 \exists c5_49 \exists c5_50 \exists c5_51 \exists c5_52 \exists c7_53 \exists c7_54 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c4_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c5_7 > 0 & c7_8 > 0 & c7_9 > 0 & c4_10 > 0 & c4_11 > 0 & c4_12 > 0 & c5_13 > 0 & c5_14 > 0 & c5_15 > 0 & c5_16 > 0 & c7_17 > 0 & c7_18 > 0 & c4_19 > 0 & c4_20 > 0 & c4_21 > 0 & c5_22 > 0 & c5_23 > 0 & c5_24 > 0 & c5_25 > 0 & c7_26 > 0 & c7_27 > 0 & c4_28 > 0 & c4_29 > 0 & c4_30 > 0 & c5_31 > 0 & c5_32 > 0 & c5_33 > 0 & c5_34 > 0 & c7_35 > 0 & c7_36 > 0 & c4_37 > 0 & c4_38 > 0 & c4_39 > 0 & c5_40 > 0 & c5_41 > 0 & c5_42 > 0 & c5_43 > 0 & c7_44 > 0 & c7_45 > 0 & c4_46 > 0 & c4_47 > 0 & c4_48 > 0 & c5_49 > 0 & c5_50 > 0 & c5_51 > 0 & c5_52 > 0 & c7_53 > 0 & c7_54 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( pc - pm = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c4_1 * pc^2*c^2 ) + ( c4_2 * Ec^2 ) + ( c4_3 * mc^2*c^2 ) = 0 )
            & ( ( c5_4 * Em^2 ) + ( c5_5 * Em*Er ) + ( c5_6 * Er^2 ) + ( c5_7 * Ec^2 ) = 0 )
            & ( ( c7_8 * vm ) + ( c7_9 * c ) = 0 )
            & ( ( c4_10 * pc^2*c^2 ) + ( c4_11 * Ec^2 ) + ( c4_12 * mc^2*c^2 ) = 0 )
            & ( ( c5_13 * Em^2 ) + ( c5_14 * Em*Er ) + ( c5_15 * Er^2 ) + ( c5_16 * Ec^2 ) = 0 )
            & ( ( c7_17 * vm ) + ( c7_18 * c ) = 0 )
            & ( ( c4_19 * pc^2*c^2 ) + ( c4_20 * Ec^2 ) + ( c4_21 * mc^2*c^2 ) = 0 )
            & ( ( c5_22 * Em^2 ) + ( c5_23 * Em*Er ) + ( c5_24 * Er^2 ) + ( c5_25 * Ec^2 ) = 0 )
            & ( ( c7_26 * vm ) + ( c7_27 * c ) = 0 )
            & ( ( c4_28 * pc^2*c^2 ) + ( c4_29 * Ec^2 ) + ( c4_30 * mc^2*c^2 ) = 0 )
            & ( ( c5_31 * Em^2 ) + ( c5_32 * Em*Er ) + ( c5_33 * Er^2 ) + ( c5_34 * Ec^2 ) = 0 )
            & ( ( c7_35 * vm ) + ( c7_36 * c ) = 0 )
            & ( ( c4_37 * pc^2*c^2 ) + ( c4_38 * Ec^2 ) + ( c4_39 * mc^2*c^2 ) = 0 )
            & ( ( c5_40 * Em^2 ) + ( c5_41 * Em*Er ) + ( c5_42 * Er^2 ) + ( c5_43 * Ec^2 ) = 0 )
            & ( ( c7_44 * vm ) + ( c7_45 * c ) = 0 )
            & ( ( c4_46 * pc^2*c^2 ) + ( c4_47 * Ec^2 ) + ( c4_48 * mc^2*c^2 ) = 0 )
            & ( ( c5_49 * Em^2 ) + ( c5_50 * Em*Er ) + ( c5_51 * Er^2 ) + ( c5_52 * Ec^2 ) = 0 )
            & ( ( c7_53 * vm ) + ( c7_54 * c ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
