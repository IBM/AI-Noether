  Real c1_49;
  Real c1_50;
  Real c7_51;
  Real c7_52;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c6_4 \exists c6_5 \exists c7_6 \exists c7_7 \exists c1_8 \exists c1_9 \exists c1_10 \exists c6_11 \exists c6_12 \exists c7_13 \exists c7_14 \exists c1_15 \exists c1_16 \exists c1_17 \exists c6_18 \exists c6_19 \exists c1_20 \exists c1_21 \exists c1_22 \exists c6_23 \exists c6_24 \exists c7_25 \exists c7_26 \exists c1_27 \exists c1_28 \exists c1_29 \exists c6_30 \exists c6_31 \exists c7_32 \exists c7_33 \exists c1_34 \exists c1_35 \exists c1_36 \exists c6_37 \exists c6_38 \exists c7_39 \exists c7_40 \exists c1_41 \exists c1_42 \exists c1_43 \exists c6_44 \exists c6_45 \exists c7_46 \exists c7_47 \exists c1_48 \exists c1_49 \exists c1_50 \exists c7_51 \exists c7_52 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c6_4 > 0 & c6_5 > 0 & c7_6 > 0 & c7_7 > 0 & c1_8 > 0 & c1_9 > 0 & c1_10 > 0 & c6_11 > 0 & c6_12 > 0 & c7_13 > 0 & c7_14 > 0 & c1_15 > 0 & c1_16 > 0 & c1_17 > 0 & c6_18 > 0 & c6_19 > 0 & c1_20 > 0 & c1_21 > 0 & c1_22 > 0 & c6_23 > 0 & c6_24 > 0 & c7_25 > 0 & c7_26 > 0 & c1_27 > 0 & c1_28 > 0 & c1_29 > 0 & c6_30 > 0 & c6_31 > 0 & c7_32 > 0 & c7_33 > 0 & c1_34 > 0 & c1_35 > 0 & c1_36 > 0 & c6_37 > 0 & c6_38 > 0 & c7_39 > 0 & c7_40 > 0 & c1_41 > 0 & c1_42 > 0 & c1_43 > 0 & c6_44 > 0 & c6_45 > 0 & c7_46 > 0 & c7_47 > 0 & c1_48 > 0 & c1_49 > 0 & c1_50 > 0 & c7_51 > 0 & c7_52 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c6_4 * pc ) + ( c6_5 * pm ) = 0 )
            & ( ( c7_6 * vm ) + ( c7_7 * c ) = 0 )
            & ( ( c1_8 * vm^2*mm^2*c^2 ) + ( c1_9 * vm^2*pm^2 ) + ( c1_10 * pm^2*c^2 ) = 0 )
            & ( ( c6_11 * pc ) + ( c6_12 * pm ) = 0 )
            & ( ( c7_13 * vm ) + ( c7_14 * c ) = 0 )
            & ( ( c1_15 * vm^2*mm^2*c^2 ) + ( c1_16 * vm^2*pm^2 ) + ( c1_17 * pm^2*c^2 ) = 0 )
            & ( ( c6_18 * pc ) + ( c6_19 * pm ) = 0 )
            & ( ( c1_20 * vm^2*mm^2*c^2 ) + ( c1_21 * vm^2*pm^2 ) + ( c1_22 * pm^2*c^2 ) = 0 )
            & ( ( c6_23 * pc ) + ( c6_24 * pm ) = 0 )
            & ( ( c7_25 * vm ) + ( c7_26 * c ) = 0 )
            & ( ( c1_27 * vm^2*mm^2*c^2 ) + ( c1_28 * vm^2*pm^2 ) + ( c1_29 * pm^2*c^2 ) = 0 )
            & ( ( c6_30 * pc ) + ( c6_31 * pm ) = 0 )
            & ( ( c7_32 * vm ) + ( c7_33 * c ) = 0 )
            & ( ( c1_34 * vm^2*mm^2*c^2 ) + ( c1_35 * vm^2*pm^2 ) + ( c1_36 * pm^2*c^2 ) = 0 )
            & ( ( c6_37 * pc ) + ( c6_38 * pm ) = 0 )
            & ( ( c7_39 * vm ) + ( c7_40 * c ) = 0 )
            & ( ( c1_41 * vm^2*mm^2*c^2 ) + ( c1_42 * vm^2*pm^2 ) + ( c1_43 * pm^2*c^2 ) = 0 )
            & ( ( c6_44 * pc ) + ( c6_45 * pm ) = 0 )
            & ( ( c7_46 * vm ) + ( c7_47 * c ) = 0 )
            & ( ( c1_48 * vm^2*mm^2*c^2 ) + ( c1_49 * vm^2*pm^2 ) + ( c1_50 * pm^2*c^2 ) = 0 )
            & ( ( c7_51 * vm ) + ( c7_52 * c ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
