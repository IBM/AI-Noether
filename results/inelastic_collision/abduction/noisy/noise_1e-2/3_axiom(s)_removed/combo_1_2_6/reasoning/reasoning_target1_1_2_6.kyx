ArchiveEntry "inelastic_collision_target1_combo1_2_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c2_4;
  Real c2_5;
  Real c2_6;
  Real c6_7;
  Real c6_8;
  Real c1_9;
  Real c1_10;
  Real c1_11;
  Real c2_12;
  Real c2_13;
  Real c2_14;
  Real c1_15;
  Real c1_16;
  Real c1_17;
  Real c2_18;
  Real c2_19;
  Real c2_20;
  Real c6_21;
  Real c6_22;
  Real c1_23;
  Real c1_24;
  Real c1_25;
  Real c2_26;
  Real c2_27;
  Real c2_28;
  Real c6_29;
  Real c6_30;
  Real c1_31;
  Real c1_32;
  Real c1_33;
  Real c2_34;
  Real c2_35;
  Real c2_36;
  Real c6_37;
  Real c6_38;
  Real c1_39;
  Real c1_40;
  Real c1_41;
  Real c2_42;
  Real c2_43;
  Real c2_44;
  Real c6_45;
  Real c6_46;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c2_4 \exists c2_5 \exists c2_6 \exists c6_7 \exists c6_8 \exists c1_9 \exists c1_10 \exists c1_11 \exists c2_12 \exists c2_13 \exists c2_14 \exists c1_15 \exists c1_16 \exists c1_17 \exists c2_18 \exists c2_19 \exists c2_20 \exists c6_21 \exists c6_22 \exists c1_23 \exists c1_24 \exists c1_25 \exists c2_26 \exists c2_27 \exists c2_28 \exists c6_29 \exists c6_30 \exists c1_31 \exists c1_32 \exists c1_33 \exists c2_34 \exists c2_35 \exists c2_36 \exists c6_37 \exists c6_38 \exists c1_39 \exists c1_40 \exists c1_41 \exists c2_42 \exists c2_43 \exists c2_44 \exists c6_45 \exists c6_46 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c6_7 > 0 & c6_8 > 0 & c1_9 > 0 & c1_10 > 0 & c1_11 > 0 & c2_12 > 0 & c2_13 > 0 & c2_14 > 0 & c1_15 > 0 & c1_16 > 0 & c1_17 > 0 & c2_18 > 0 & c2_19 > 0 & c2_20 > 0 & c6_21 > 0 & c6_22 > 0 & c1_23 > 0 & c1_24 > 0 & c1_25 > 0 & c2_26 > 0 & c2_27 > 0 & c2_28 > 0 & c6_29 > 0 & c6_30 > 0 & c1_31 > 0 & c1_32 > 0 & c1_33 > 0 & c2_34 > 0 & c2_35 > 0 & c2_36 > 0 & c6_37 > 0 & c6_38 > 0 & c1_39 > 0 & c1_40 > 0 & c1_41 > 0 & c2_42 > 0 & c2_43 > 0 & c2_44 > 0 & c6_45 > 0 & c6_46 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
            & ( ( c6_7 * pc ) + ( c6_8 * pm ) = 0 )
            & ( ( c1_9 * vm^2*mm^2*c^2 ) + ( c1_10 * vm^2*pm^2 ) + ( c1_11 * pm^2*c^2 ) = 0 )
            & ( ( c2_12 * Em^2 ) + ( c2_13 * mm^2*c^4 ) + ( c2_14 * pm^2*c^2 ) = 0 )
            & ( ( c1_15 * vm^2*mm^2*c^2 ) + ( c1_16 * vm^2*pm^2 ) + ( c1_17 * pm^2*c^2 ) = 0 )
            & ( ( c2_18 * Em^2 ) + ( c2_19 * mm^2*c^4 ) + ( c2_20 * pm^2*c^2 ) = 0 )
            & ( ( c6_21 * pc ) + ( c6_22 * pm ) = 0 )
            & ( ( c1_23 * vm^2*mm^2*c^2 ) + ( c1_24 * vm^2*pm^2 ) + ( c1_25 * pm^2*c^2 ) = 0 )
            & ( ( c2_26 * Em^2 ) + ( c2_27 * mm^2*c^4 ) + ( c2_28 * pm^2*c^2 ) = 0 )
            & ( ( c6_29 * pc ) + ( c6_30 * pm ) = 0 )
            & ( ( c1_31 * vm^2*mm^2*c^2 ) + ( c1_32 * vm^2*pm^2 ) + ( c1_33 * pm^2*c^2 ) = 0 )
            & ( ( c2_34 * Em^2 ) + ( c2_35 * mm^2*c^4 ) + ( c2_36 * pm^2*c^2 ) = 0 )
            & ( ( c6_37 * pc ) + ( c6_38 * pm ) = 0 )
            & ( ( c1_39 * vm^2*mm^2*c^2 ) + ( c1_40 * vm^2*pm^2 ) + ( c1_41 * pm^2*c^2 ) = 0 )
            & ( ( c2_42 * Em^2 ) + ( c2_43 * mm^2*c^4 ) + ( c2_44 * pm^2*c^2 ) = 0 )
            & ( ( c6_45 * pc ) + ( c6_46 * pm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
