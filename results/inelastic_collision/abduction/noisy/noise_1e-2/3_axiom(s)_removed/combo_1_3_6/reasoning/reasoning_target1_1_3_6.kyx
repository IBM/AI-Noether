ArchiveEntry "inelastic_collision_target1_combo1_3_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c3_4;
  Real c3_5;
  Real c1_6;
  Real c1_7;
  Real c1_8;
  Real c3_9;
  Real c3_10;
  Real c6_11;
  Real c6_12;
  Real c1_13;
  Real c1_14;
  Real c1_15;
  Real c3_16;
  Real c3_17;
  Real c6_18;
  Real c6_19;
  Real c1_20;
  Real c1_21;
  Real c1_22;
  Real c3_23;
  Real c3_24;
  Real c6_25;
  Real c6_26;
  Real c1_27;
  Real c1_28;
  Real c1_29;
  Real c3_30;
  Real c3_31;
  Real c6_32;
  Real c6_33;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c3_4 \exists c3_5 \exists c1_6 \exists c1_7 \exists c1_8 \exists c3_9 \exists c3_10 \exists c6_11 \exists c6_12 \exists c1_13 \exists c1_14 \exists c1_15 \exists c3_16 \exists c3_17 \exists c6_18 \exists c6_19 \exists c1_20 \exists c1_21 \exists c1_22 \exists c3_23 \exists c3_24 \exists c6_25 \exists c6_26 \exists c1_27 \exists c1_28 \exists c1_29 \exists c3_30 \exists c3_31 \exists c6_32 \exists c6_33 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c3_4 > 0 & c3_5 > 0 & c1_6 > 0 & c1_7 > 0 & c1_8 > 0 & c3_9 > 0 & c3_10 > 0 & c6_11 > 0 & c6_12 > 0 & c1_13 > 0 & c1_14 > 0 & c1_15 > 0 & c3_16 > 0 & c3_17 > 0 & c6_18 > 0 & c6_19 > 0 & c1_20 > 0 & c1_21 > 0 & c1_22 > 0 & c3_23 > 0 & c3_24 > 0 & c6_25 > 0 & c6_26 > 0 & c1_27 > 0 & c1_28 > 0 & c1_29 > 0 & c3_30 > 0 & c3_31 > 0 & c6_32 > 0 & c6_33 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c3_4 * mr*c^2 ) + ( c3_5 * Er ) = 0 )
            & ( ( c1_6 * vm^2*mm^2*c^2 ) + ( c1_7 * vm^2*pm^2 ) + ( c1_8 * pm^2*c^2 ) = 0 )
            & ( ( c3_9 * mr*c^2 ) + ( c3_10 * Er ) = 0 )
            & ( ( c6_11 * pc ) + ( c6_12 * pm ) = 0 )
            & ( ( c1_13 * vm^2*mm^2*c^2 ) + ( c1_14 * vm^2*pm^2 ) + ( c1_15 * pm^2*c^2 ) = 0 )
            & ( ( c3_16 * mr*c^2 ) + ( c3_17 * Er ) = 0 )
            & ( ( c6_18 * pc ) + ( c6_19 * pm ) = 0 )
            & ( ( c1_20 * vm^2*mm^2*c^2 ) + ( c1_21 * vm^2*pm^2 ) + ( c1_22 * pm^2*c^2 ) = 0 )
            & ( ( c3_23 * mr*c^2 ) + ( c3_24 * Er ) = 0 )
            & ( ( c6_25 * pc ) + ( c6_26 * pm ) = 0 )
            & ( ( c1_27 * vm^2*mm^2*c^2 ) + ( c1_28 * vm^2*pm^2 ) + ( c1_29 * pm^2*c^2 ) = 0 )
            & ( ( c3_30 * mr*c^2 ) + ( c3_31 * Er ) = 0 )
            & ( ( c6_32 * pc ) + ( c6_33 * pm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
