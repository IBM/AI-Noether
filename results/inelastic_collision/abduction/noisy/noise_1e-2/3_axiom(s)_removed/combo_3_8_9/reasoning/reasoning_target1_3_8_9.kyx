ArchiveEntry "inelastic_collision_target1_combo3_8_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c8_3;
  Real c8_4;
  Real c9_5;
  Real c9_6;
  Real c9_7;
  Real c3_8;
  Real c3_9;
  Real c8_10;
  Real c8_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c3_15;
  Real c3_16;
  Real c8_17;
  Real c8_18;
  Real c9_19;
  Real c9_20;
  Real c9_21;
  Real c3_22;
  Real c3_23;
  Real c8_24;
  Real c8_25;
  Real c9_26;
  Real c9_27;
  Real c9_28;
  Real c3_29;
  Real c3_30;
  Real c9_31;
  Real c9_32;
  Real c9_33;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c8_3 \exists c8_4 \exists c9_5 \exists c9_6 \exists c9_7 \exists c3_8 \exists c3_9 \exists c8_10 \exists c8_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c3_15 \exists c3_16 \exists c8_17 \exists c8_18 \exists c9_19 \exists c9_20 \exists c9_21 \exists c3_22 \exists c3_23 \exists c8_24 \exists c8_25 \exists c9_26 \exists c9_27 \exists c9_28 \exists c3_29 \exists c3_30 \exists c9_31 \exists c9_32 \exists c9_33 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c8_3 > 0 & c8_4 > 0 & c9_5 > 0 & c9_6 > 0 & c9_7 > 0 & c3_8 > 0 & c3_9 > 0 & c8_10 > 0 & c8_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c3_15 > 0 & c3_16 > 0 & c8_17 > 0 & c8_18 > 0 & c9_19 > 0 & c9_20 > 0 & c9_21 > 0 & c3_22 > 0 & c3_23 > 0 & c8_24 > 0 & c8_25 > 0 & c9_26 > 0 & c9_27 > 0 & c9_28 > 0 & c3_29 > 0 & c3_30 > 0 & c9_31 > 0 & c9_32 > 0 & c9_33 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c8_3 * mr ) + ( c8_4 * mm ) = 0 )
            & ( ( c9_5 * vc^2*pc^2 ) + ( c9_6 * vc^2*mc^2*c^2 ) + ( c9_7 * pc^2*c^2 ) = 0 )
            & ( ( c3_8 * mr*c^2 ) + ( c3_9 * Er ) = 0 )
            & ( ( c8_10 * mr ) + ( c8_11 * mm ) = 0 )
            & ( ( c9_12 * vc^2*pc^2 ) + ( c9_13 * vc^2*mc^2*c^2 ) + ( c9_14 * pc^2*c^2 ) = 0 )
            & ( ( c3_15 * mr*c^2 ) + ( c3_16 * Er ) = 0 )
            & ( ( c8_17 * mr ) + ( c8_18 * mm ) = 0 )
            & ( ( c9_19 * vc^2*pc^2 ) + ( c9_20 * vc^2*mc^2*c^2 ) + ( c9_21 * pc^2*c^2 ) = 0 )
            & ( ( c3_22 * mr*c^2 ) + ( c3_23 * Er ) = 0 )
            & ( ( c8_24 * mr ) + ( c8_25 * mm ) = 0 )
            & ( ( c9_26 * vc^2*pc^2 ) + ( c9_27 * vc^2*mc^2*c^2 ) + ( c9_28 * pc^2*c^2 ) = 0 )
            & ( ( c3_29 * mr*c^2 ) + ( c3_30 * Er ) = 0 )
            & ( ( c9_31 * vc^2*pc^2 ) + ( c9_32 * vc^2*mc^2*c^2 ) + ( c9_33 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
