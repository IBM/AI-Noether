ArchiveEntry "photoHall_target1_combo2_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ph;
  Real dp;
  Real mu;
  Real muN;
  Real muH;
  Real n;
  Real dsigma2dn;
  Real e;
  Real mup;
  Real p0;
  Real dn;
  Real beta;
  Real r;
  Real sigma;
  Real H;
  Real c2_1;
  Real c2_2;
  Real c4_3;
  Real c4_4;
  Real c5_5;
  Real c5_6;
  Real c2_7;
  Real c2_8;
  Real c4_9;
  Real c4_10;
  Real c5_11;
  Real c5_12;
  Real c2_13;
  Real c2_14;
  Real c4_15;
  Real c4_16;
  Real c5_17;
  Real c5_18;
  Real c2_19;
  Real c2_20;
  Real c4_21;
  Real c4_22;
  Real c5_23;
  Real c5_24;
  Real c2_25;
  Real c2_26;
  Real c4_27;
  Real c4_28;
  Real c5_29;
  Real c5_30;
  Real c2_31;
  Real c2_32;
  Real c4_33;
  Real c4_34;
  Real c5_35;
  Real c5_36;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
  Real d5;
  Real d6;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c4_3 \exists c4_4 \exists c5_5 \exists c5_6 \exists c2_7 \exists c2_8 \exists c4_9 \exists c4_10 \exists c5_11 \exists c5_12 \exists c2_13 \exists c2_14 \exists c4_15 \exists c4_16 \exists c5_17 \exists c5_18 \exists c2_19 \exists c2_20 \exists c4_21 \exists c4_22 \exists c5_23 \exists c5_24 \exists c2_25 \exists c2_26 \exists c4_27 \exists c4_28 \exists c5_29 \exists c5_30 \exists c2_31 \exists c2_32 \exists c4_33 \exists c4_34 \exists c5_35 \exists c5_36 \exists d1 \exists d2 \exists d3 \exists d4 \exists d5 \exists d6
    (
      c2_1 > 0 & c2_2 > 0 & c4_3 > 0 & c4_4 > 0 & c5_5 > 0 & c5_6 > 0 & c2_7 > 0 & c2_8 > 0 & c4_9 > 0 & c4_10 > 0 & c5_11 > 0 & c5_12 > 0 & c2_13 > 0 & c2_14 > 0 & c4_15 > 0 & c4_16 > 0 & c5_17 > 0 & c5_18 > 0 & c2_19 > 0 & c2_20 > 0 & c4_21 > 0 & c4_22 > 0 & c5_23 > 0 & c5_24 > 0 & c2_25 > 0 & c2_26 > 0 & c4_27 > 0 & c4_28 > 0 & c5_29 > 0 & c5_30 > 0 & c2_31 > 0 & c2_32 > 0 & c4_33 > 0 & c4_34 > 0 & c5_35 > 0 & c5_36 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0 & d5 > 0 & d6 > 0
      &
      (
        \forall ph \forall dp \forall mu \forall muN \forall muH \forall n \forall dsigma2dn \forall e \forall mup \forall p0 \forall dn \forall beta \forall r \forall sigma \forall H
        (
          (
            (ph > 0 & dp > 0 & mu > 0 & muN > 0 & muH > 0 & n > 0 & dsigma2dn > 0 & e > 0 & mup > 0 & p0 > 0 & dn > 0 & beta > 0 & r > 0 & sigma > 0 & H > 0) &
            & ( beta * mup - muN = 0 )
            & ( ph - p0 - dp = 0 )
            & ( sigma - e * ph * mup - e * n * muN = 0 )
            & ( H * (ph + beta * n)^2 * e - r * ph + r * beta^2 * n = 0 )
            & ( ( c2_1 * mu*r ) + ( c2_2 * muH ) = 0 )
            & ( ( c4_3 * n ) + ( c4_4 * dn ) = 0 )
            & ( ( c5_5 * dp ) + ( c5_6 * dn ) = 0 )
            & ( ( c2_7 * mu*r ) + ( c2_8 * muH ) = 0 )
            & ( ( c4_9 * n ) + ( c4_10 * dn ) = 0 )
            & ( ( c5_11 * dp ) + ( c5_12 * dn ) = 0 )
            & ( ( c2_13 * mu*r ) + ( c2_14 * muH ) = 0 )
            & ( ( c4_15 * n ) + ( c4_16 * dn ) = 0 )
            & ( ( c5_17 * dp ) + ( c5_18 * dn ) = 0 )
            & ( ( c2_19 * mu*r ) + ( c2_20 * muH ) = 0 )
            & ( ( c4_21 * n ) + ( c4_22 * dn ) = 0 )
            & ( ( c5_23 * dp ) + ( c5_24 * dn ) = 0 )
            & ( ( c2_25 * mu*r ) + ( c2_26 * muH ) = 0 )
            & ( ( c4_27 * n ) + ( c4_28 * dn ) = 0 )
            & ( ( c5_29 * dp ) + ( c5_30 * dn ) = 0 )
            & ( ( c2_31 * mu*r ) + ( c2_32 * muH ) = 0 )
            & ( ( c4_33 * n ) + ( c4_34 * dn ) = 0 )
            & ( ( c5_35 * dp ) + ( c5_36 * dn ) = 0 )
          )
          ->
          (
            ( d1 * e*mup*dn*beta^2*r ) + ( d2 * e*mup*dn*beta*r ) + ( d3 * e*p0*sigma*H ) + ( d4 * e*dn*beta*sigma*H ) + ( d5 * e*dn*sigma*H ) + ( d6 * r*sigma ) = 0
          )
        )
      )
    )
  )
End.

End.
