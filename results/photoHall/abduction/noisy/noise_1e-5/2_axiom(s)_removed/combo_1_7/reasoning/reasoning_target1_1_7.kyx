ArchiveEntry "photoHall_target1_combo1_7"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ph;
  Real dp;
  Real mu;
  Real muN;
  Real muH;
  Real n;
  Real dsigma2dn;
  Real e;
  Real mup;
  Real p0;
  Real dn;
  Real beta;
  Real r;
  Real sigma;
  Real H;
  Real c1_1;
  Real c1_2;
  Real c7_3;
  Real c7_4;
  Real c7_5;
  Real c7_6;
  Real c7_7;
  Real c1_8;
  Real c1_9;
  Real c7_10;
  Real c7_11;
  Real c7_12;
  Real c7_13;
  Real c7_14;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
  Real d5;
  Real d6;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c7_3 \exists c7_4 \exists c7_5 \exists c7_6 \exists c7_7 \exists c1_8 \exists c1_9 \exists c7_10 \exists c7_11 \exists c7_12 \exists c7_13 \exists c7_14 \exists d1 \exists d2 \exists d3 \exists d4 \exists d5 \exists d6
    (
      c1_1 > 0 & c1_2 > 0 & c7_3 > 0 & c7_4 > 0 & c7_5 > 0 & c7_6 > 0 & c7_7 > 0 & c1_8 > 0 & c1_9 > 0 & c7_10 > 0 & c7_11 > 0 & c7_12 > 0 & c7_13 > 0 & c7_14 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0 & d5 > 0 & d6 > 0
      &
      (
        \forall ph \forall dp \forall mu \forall muN \forall muH \forall n \forall dsigma2dn \forall e \forall mup \forall p0 \forall dn \forall beta \forall r \forall sigma \forall H
        (
          (
            (ph > 0 & dp > 0 & mu > 0 & muN > 0 & muH > 0 & n > 0 & dsigma2dn > 0 & e > 0 & mup > 0 & p0 > 0 & dn > 0 & beta > 0 & r > 0 & sigma > 0 & H > 0) &
            & ( muH - r * mu = 0 )
            & ( ph - p0 - dp = 0 )
            & ( n - dn = 0 )
            & ( dp - dn = 0 )
            & ( sigma - e * ph * mup - e * n * muN = 0 )
            & ( ( c1_1 * muN ) + ( c1_2 * mup*beta ) = 0 )
            & ( ( c7_3 * ph^2*e*H ) + ( c7_4 * ph*n*e*beta*H ) + ( c7_5 * ph*r ) + ( c7_6 * n^2*e*beta^2*H ) + ( c7_7 * n*beta^2*r ) = 0 )
            & ( ( c1_8 * muN ) + ( c1_9 * mup*beta ) = 0 )
            & ( ( c7_10 * ph^2*e*H ) + ( c7_11 * ph*n*e*beta*H ) + ( c7_12 * ph*r ) + ( c7_13 * n^2*e*beta^2*H ) + ( c7_14 * n*beta^2*r ) = 0 )
          )
          ->
          (
            ( d1 * e*mup*dn*beta^2*r ) + ( d2 * e*mup*dn*beta*r ) + ( d3 * e*p0*sigma*H ) + ( d4 * e*dn*beta*sigma*H ) + ( d5 * e*dn*sigma*H ) + ( d6 * r*sigma ) = 0
          )
        )
      )
    )
  )
End.

End.
