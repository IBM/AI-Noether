ArchiveEntry "photoHall_target1_combo3_4_7_ax3c1_ax4c1_ax7c2"

ProgramVariables
  Real ph;
  Real dp;
  Real mu;
  Real muN;
  Real muH;
  Real n;
  Real dsigma2dn;
  Real e;
  Real mup;
  Real p0;
  Real dn;
  Real beta;
  Real r;
  Real sigma;
  Real H;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    \exists c9
    \exists c10
    \exists c11
    \exists c12
    \exists c13
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0 & c9>0 & c10>0 & c11>0 & c12>0 & c13>0
      &
      (
      \forall ph
      \forall dp
      \forall mu
      \forall muN
      \forall muH
      \forall n
      \forall dsigma2dn
      \forall e
      \forall mup
      \forall p0
      \forall dn
      \forall beta
      \forall r
      \forall sigma
      \forall H
          (
          (
            ph>0 & dp>0 & mu>0 & muN>0 & muH>0 & n>0 & dsigma2dn>0 & e>0 & mup>0 & p0>0 & dn>0 & beta>0 & r>0 & sigma>0 & H>0
            & ( beta * mup - muN = 0 )
            & ( muH - r * mu = 0 )
            & ( dp - dn = 0 )
            & ( sigma - e * ph * mup - e * n * muN = 0 )
            & ( c1 * ph ) = ( c2 * dp ) + ( c3 * p0 )
            & ( c4 * n ) = ( c5 * dn )
            & ( c6 * ph^2*e*H ) = ( c7 * n^2*e*beta^2*H )
            )
        ->
          (
            ( c8 * r*e*mup*dn*beta^2 ) = ( c9 * r*e*mup*dn*beta ) + ( c10 * r*sigma ) + ( c11 * e*p0*sigma*H ) + ( c12 * e*dn*beta*sigma*H ) + ( c13 * e*dn*sigma*H )
          )
          )
      )
    )
  )
End.

End.