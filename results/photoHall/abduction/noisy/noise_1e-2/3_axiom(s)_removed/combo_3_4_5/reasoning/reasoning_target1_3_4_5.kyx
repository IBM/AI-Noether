  Real c5_41;
  Real c5_42;
  Real c3_43;
  Real c3_44;
  Real c3_45;
  Real c4_46;
  Real c4_47;
  Real c5_48;
  Real c5_49;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
  Real d5;
  Real d6;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c3_3 \exists c4_4 \exists c4_5 \exists c5_6 \exists c5_7 \exists c3_8 \exists c3_9 \exists c3_10 \exists c4_11 \exists c4_12 \exists c5_13 \exists c5_14 \exists c3_15 \exists c3_16 \exists c3_17 \exists c4_18 \exists c4_19 \exists c5_20 \exists c5_21 \exists c3_22 \exists c3_23 \exists c3_24 \exists c4_25 \exists c4_26 \exists c5_27 \exists c5_28 \exists c3_29 \exists c3_30 \exists c3_31 \exists c4_32 \exists c4_33 \exists c5_34 \exists c5_35 \exists c3_36 \exists c3_37 \exists c3_38 \exists c4_39 \exists c4_40 \exists c5_41 \exists c5_42 \exists c3_43 \exists c3_44 \exists c3_45 \exists c4_46 \exists c4_47 \exists c5_48 \exists c5_49 \exists d1 \exists d2 \exists d3 \exists d4 \exists d5 \exists d6
    (
      c3_1 > 0 & c3_2 > 0 & c3_3 > 0 & c4_4 > 0 & c4_5 > 0 & c5_6 > 0 & c5_7 > 0 & c3_8 > 0 & c3_9 > 0 & c3_10 > 0 & c4_11 > 0 & c4_12 > 0 & c5_13 > 0 & c5_14 > 0 & c3_15 > 0 & c3_16 > 0 & c3_17 > 0 & c4_18 > 0 & c4_19 > 0 & c5_20 > 0 & c5_21 > 0 & c3_22 > 0 & c3_23 > 0 & c3_24 > 0 & c4_25 > 0 & c4_26 > 0 & c5_27 > 0 & c5_28 > 0 & c3_29 > 0 & c3_30 > 0 & c3_31 > 0 & c4_32 > 0 & c4_33 > 0 & c5_34 > 0 & c5_35 > 0 & c3_36 > 0 & c3_37 > 0 & c3_38 > 0 & c4_39 > 0 & c4_40 > 0 & c5_41 > 0 & c5_42 > 0 & c3_43 > 0 & c3_44 > 0 & c3_45 > 0 & c4_46 > 0 & c4_47 > 0 & c5_48 > 0 & c5_49 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0 & d5 > 0 & d6 > 0
      &
      (
        \forall ph \forall dp \forall mu \forall muN \forall muH \forall n \forall dsigma2dn \forall e \forall mup \forall p0 \forall dn \forall beta \forall r \forall sigma \forall H
        (
          (
            (ph > 0 & dp > 0 & mu > 0 & muN > 0 & muH > 0 & n > 0 & dsigma2dn > 0 & e > 0 & mup > 0 & p0 > 0 & dn > 0 & beta > 0 & r > 0 & sigma > 0 & H > 0) &
            & ( beta * mup - muN = 0 )
            & ( muH - r * mu = 0 )
            & ( sigma - e * ph * mup - e * n * muN = 0 )
            & ( H * (ph + beta * n)^2 * e - r * ph + r * beta^2 * n = 0 )
            & ( ( c3_1 * ph ) + ( c3_2 * dp ) + ( c3_3 * p0 ) = 0 )
            & ( ( c4_4 * n ) + ( c4_5 * dn ) = 0 )
            & ( ( c5_6 * dp ) + ( c5_7 * dn ) = 0 )
            & ( ( c3_8 * ph ) + ( c3_9 * dp ) + ( c3_10 * p0 ) = 0 )
            & ( ( c4_11 * n ) + ( c4_12 * dn ) = 0 )
            & ( ( c5_13 * dp ) + ( c5_14 * dn ) = 0 )
            & ( ( c3_15 * ph ) + ( c3_16 * dp ) + ( c3_17 * p0 ) = 0 )
            & ( ( c4_18 * n ) + ( c4_19 * dn ) = 0 )
            & ( ( c5_20 * dp ) + ( c5_21 * dn ) = 0 )
            & ( ( c3_22 * ph ) + ( c3_23 * dp ) + ( c3_24 * p0 ) = 0 )
            & ( ( c4_25 * n ) + ( c4_26 * dn ) = 0 )
            & ( ( c5_27 * dp ) + ( c5_28 * dn ) = 0 )
            & ( ( c3_29 * ph ) + ( c3_30 * dp ) + ( c3_31 * p0 ) = 0 )
            & ( ( c4_32 * n ) + ( c4_33 * dn ) = 0 )
            & ( ( c5_34 * dp ) + ( c5_35 * dn ) = 0 )
            & ( ( c3_36 * ph ) + ( c3_37 * dp ) + ( c3_38 * p0 ) = 0 )
            & ( ( c4_39 * n ) + ( c4_40 * dn ) = 0 )
            & ( ( c5_41 * dp ) + ( c5_42 * dn ) = 0 )
            & ( ( c3_43 * ph ) + ( c3_44 * dp ) + ( c3_45 * p0 ) = 0 )
            & ( ( c4_46 * n ) + ( c4_47 * dn ) = 0 )
            & ( ( c5_48 * dp ) + ( c5_49 * dn ) = 0 )
          )
          ->
          (
            ( d1 * e*mup*dn*beta^2*r ) + ( d2 * e*mup*dn*beta*r ) + ( d3 * e*p0*sigma*H ) + ( d4 * e*dn*beta*sigma*H ) + ( d5 * e*dn*sigma*H ) + ( d6 * r*sigma ) = 0
          )
        )
      )
    )
  )
End.

End.
