ArchiveEntry "photoHall_target1_combo1_2_3"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ph;
  Real dp;
  Real mu;
  Real muN;
  Real muH;
  Real n;
  Real dsigma2dn;
  Real e;
  Real mup;
  Real p0;
  Real dn;
  Real beta;
  Real r;
  Real sigma;
  Real H;
  Real c1_1;
  Real c1_2;
  Real c2_3;
  Real c2_4;
  Real c3_5;
  Real c3_6;
  Real c3_7;
  Real c1_8;
  Real c1_9;
  Real c2_10;
  Real c2_11;
  Real c3_12;
  Real c3_13;
  Real c3_14;
  Real c1_15;
  Real c1_16;
  Real c2_17;
  Real c2_18;
  Real c3_19;
  Real c3_20;
  Real c3_21;
  Real c1_22;
  Real c1_23;
  Real c2_24;
  Real c2_25;
  Real c3_26;
  Real c3_27;
  Real c3_28;
  Real c1_29;
  Real c1_30;
  Real c2_31;
  Real c2_32;
  Real c3_33;
  Real c3_34;
  Real c3_35;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
  Real d5;
  Real d6;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c2_3 \exists c2_4 \exists c3_5 \exists c3_6 \exists c3_7 \exists c1_8 \exists c1_9 \exists c2_10 \exists c2_11 \exists c3_12 \exists c3_13 \exists c3_14 \exists c1_15 \exists c1_16 \exists c2_17 \exists c2_18 \exists c3_19 \exists c3_20 \exists c3_21 \exists c1_22 \exists c1_23 \exists c2_24 \exists c2_25 \exists c3_26 \exists c3_27 \exists c3_28 \exists c1_29 \exists c1_30 \exists c2_31 \exists c2_32 \exists c3_33 \exists c3_34 \exists c3_35 \exists d1 \exists d2 \exists d3 \exists d4 \exists d5 \exists d6
    (
      c1_1 > 0 & c1_2 > 0 & c2_3 > 0 & c2_4 > 0 & c3_5 > 0 & c3_6 > 0 & c3_7 > 0 & c1_8 > 0 & c1_9 > 0 & c2_10 > 0 & c2_11 > 0 & c3_12 > 0 & c3_13 > 0 & c3_14 > 0 & c1_15 > 0 & c1_16 > 0 & c2_17 > 0 & c2_18 > 0 & c3_19 > 0 & c3_20 > 0 & c3_21 > 0 & c1_22 > 0 & c1_23 > 0 & c2_24 > 0 & c2_25 > 0 & c3_26 > 0 & c3_27 > 0 & c3_28 > 0 & c1_29 > 0 & c1_30 > 0 & c2_31 > 0 & c2_32 > 0 & c3_33 > 0 & c3_34 > 0 & c3_35 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0 & d5 > 0 & d6 > 0
      &
      (
        \forall ph \forall dp \forall mu \forall muN \forall muH \forall n \forall dsigma2dn \forall e \forall mup \forall p0 \forall dn \forall beta \forall r \forall sigma \forall H
        (
          (
            (ph > 0 & dp > 0 & mu > 0 & muN > 0 & muH > 0 & n > 0 & dsigma2dn > 0 & e > 0 & mup > 0 & p0 > 0 & dn > 0 & beta > 0 & r > 0 & sigma > 0 & H > 0) &
            & ( n - dn = 0 )
            & ( dp - dn = 0 )
            & ( sigma - e * ph * mup - e * n * muN = 0 )
            & ( H * (ph + beta * n)^2 * e - r * ph + r * beta^2 * n = 0 )
            & ( ( c1_1 * muN ) + ( c1_2 * mup*beta ) = 0 )
            & ( ( c2_3 * mu*r ) + ( c2_4 * muH ) = 0 )
            & ( ( c3_5 * ph ) + ( c3_6 * dp ) + ( c3_7 * p0 ) = 0 )
            & ( ( c1_8 * muN ) + ( c1_9 * mup*beta ) = 0 )
            & ( ( c2_10 * mu*r ) + ( c2_11 * muH ) = 0 )
            & ( ( c3_12 * ph ) + ( c3_13 * dp ) + ( c3_14 * p0 ) = 0 )
            & ( ( c1_15 * muN ) + ( c1_16 * mup*beta ) = 0 )
            & ( ( c2_17 * mu*r ) + ( c2_18 * muH ) = 0 )
            & ( ( c3_19 * ph ) + ( c3_20 * dp ) + ( c3_21 * p0 ) = 0 )
            & ( ( c1_22 * muN ) + ( c1_23 * mup*beta ) = 0 )
            & ( ( c2_24 * mu*r ) + ( c2_25 * muH ) = 0 )
            & ( ( c3_26 * ph ) + ( c3_27 * dp ) + ( c3_28 * p0 ) = 0 )
            & ( ( c1_29 * muN ) + ( c1_30 * mup*beta ) = 0 )
            & ( ( c2_31 * mu*r ) + ( c2_32 * muH ) = 0 )
            & ( ( c3_33 * ph ) + ( c3_34 * dp ) + ( c3_35 * p0 ) = 0 )
          )
          ->
          (
            ( d1 * e*mup*dn*beta^2*r ) + ( d2 * e*mup*dn*beta*r ) + ( d3 * e*p0*sigma*H ) + ( d4 * e*dn*beta*sigma*H ) + ( d5 * e*dn*sigma*H ) + ( d6 * r*sigma ) = 0
          )
        )
      )
    )
  )
End.

End.
