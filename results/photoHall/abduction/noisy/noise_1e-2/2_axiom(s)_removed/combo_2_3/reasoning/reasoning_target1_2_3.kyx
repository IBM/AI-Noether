ArchiveEntry "photoHall_target1_combo2_3"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real ph;
  Real dp;
  Real mu;
  Real muN;
  Real muH;
  Real n;
  Real dsigma2dn;
  Real e;
  Real mup;
  Real p0;
  Real dn;
  Real beta;
  Real r;
  Real sigma;
  Real H;
  Real c2_1;
  Real c2_2;
  Real c3_3;
  Real c3_4;
  Real c3_5;
  Real c2_6;
  Real c2_7;
  Real c3_8;
  Real c3_9;
  Real c3_10;
  Real c2_11;
  Real c2_12;
  Real c3_13;
  Real c3_14;
  Real c3_15;
  Real c2_16;
  Real c2_17;
  Real c3_18;
  Real c3_19;
  Real c3_20;
  Real c2_21;
  Real c2_22;
  Real c3_23;
  Real c3_24;
  Real c3_25;
  Real c2_26;
  Real c2_27;
  Real c3_28;
  Real c3_29;
  Real c3_30;
  Real c2_31;
  Real c2_32;
  Real c3_33;
  Real c3_34;
  Real c3_35;
  Real c2_36;
  Real c2_37;
  Real c3_38;
  Real c3_39;
  Real c3_40;
  Real d1;
  Real d2;
  Real d3;
  Real d4;
  Real d5;
  Real d6;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c3_3 \exists c3_4 \exists c3_5 \exists c2_6 \exists c2_7 \exists c3_8 \exists c3_9 \exists c3_10 \exists c2_11 \exists c2_12 \exists c3_13 \exists c3_14 \exists c3_15 \exists c2_16 \exists c2_17 \exists c3_18 \exists c3_19 \exists c3_20 \exists c2_21 \exists c2_22 \exists c3_23 \exists c3_24 \exists c3_25 \exists c2_26 \exists c2_27 \exists c3_28 \exists c3_29 \exists c3_30 \exists c2_31 \exists c2_32 \exists c3_33 \exists c3_34 \exists c3_35 \exists c2_36 \exists c2_37 \exists c3_38 \exists c3_39 \exists c3_40 \exists d1 \exists d2 \exists d3 \exists d4 \exists d5 \exists d6
    (
      c2_1 > 0 & c2_2 > 0 & c3_3 > 0 & c3_4 > 0 & c3_5 > 0 & c2_6 > 0 & c2_7 > 0 & c3_8 > 0 & c3_9 > 0 & c3_10 > 0 & c2_11 > 0 & c2_12 > 0 & c3_13 > 0 & c3_14 > 0 & c3_15 > 0 & c2_16 > 0 & c2_17 > 0 & c3_18 > 0 & c3_19 > 0 & c3_20 > 0 & c2_21 > 0 & c2_22 > 0 & c3_23 > 0 & c3_24 > 0 & c3_25 > 0 & c2_26 > 0 & c2_27 > 0 & c3_28 > 0 & c3_29 > 0 & c3_30 > 0 & c2_31 > 0 & c2_32 > 0 & c3_33 > 0 & c3_34 > 0 & c3_35 > 0 & c2_36 > 0 & c2_37 > 0 & c3_38 > 0 & c3_39 > 0 & c3_40 > 0 & d1 > 0 & d2 > 0 & d3 > 0 & d4 > 0 & d5 > 0 & d6 > 0
      &
      (
        \forall ph \forall dp \forall mu \forall muN \forall muH \forall n \forall dsigma2dn \forall e \forall mup \forall p0 \forall dn \forall beta \forall r \forall sigma \forall H
        (
          (
            (ph > 0 & dp > 0 & mu > 0 & muN > 0 & muH > 0 & n > 0 & dsigma2dn > 0 & e > 0 & mup > 0 & p0 > 0 & dn > 0 & beta > 0 & r > 0 & sigma > 0 & H > 0) &
            & ( beta * mup - muN = 0 )
            & ( n - dn = 0 )
            & ( dp - dn = 0 )
            & ( sigma - e * ph * mup - e * n * muN = 0 )
            & ( H * (ph + beta * n)^2 * e - r * ph + r * beta^2 * n = 0 )
            & ( ( c2_1 * mu*r ) + ( c2_2 * muH ) = 0 )
            & ( ( c3_3 * ph ) + ( c3_4 * dp ) + ( c3_5 * p0 ) = 0 )
            & ( ( c2_6 * mu*r ) + ( c2_7 * muH ) = 0 )
            & ( ( c3_8 * ph ) + ( c3_9 * dp ) + ( c3_10 * p0 ) = 0 )
            & ( ( c2_11 * mu*r ) + ( c2_12 * muH ) = 0 )
            & ( ( c3_13 * ph ) + ( c3_14 * dp ) + ( c3_15 * p0 ) = 0 )
            & ( ( c2_16 * mu*r ) + ( c2_17 * muH ) = 0 )
            & ( ( c3_18 * ph ) + ( c3_19 * dp ) + ( c3_20 * p0 ) = 0 )
            & ( ( c2_21 * mu*r ) + ( c2_22 * muH ) = 0 )
            & ( ( c3_23 * ph ) + ( c3_24 * dp ) + ( c3_25 * p0 ) = 0 )
            & ( ( c2_26 * mu*r ) + ( c2_27 * muH ) = 0 )
            & ( ( c3_28 * ph ) + ( c3_29 * dp ) + ( c3_30 * p0 ) = 0 )
            & ( ( c2_31 * mu*r ) + ( c2_32 * muH ) = 0 )
            & ( ( c3_33 * ph ) + ( c3_34 * dp ) + ( c3_35 * p0 ) = 0 )
            & ( ( c2_36 * mu*r ) + ( c2_37 * muH ) = 0 )
            & ( ( c3_38 * ph ) + ( c3_39 * dp ) + ( c3_40 * p0 ) = 0 )
          )
          ->
          (
            ( d1 * e*mup*dn*beta^2*r ) + ( d2 * e*mup*dn*beta*r ) + ( d3 * e*p0*sigma*H ) + ( d4 * e*dn*beta*sigma*H ) + ( d5 * e*dn*sigma*H ) + ( d6 * r*sigma ) = 0
          )
        )
      )
    )
  )
End.

End.
