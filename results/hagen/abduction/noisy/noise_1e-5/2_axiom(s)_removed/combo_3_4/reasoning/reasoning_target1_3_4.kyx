ArchiveEntry "hagen_target1_combo3_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real c0;
  Real c2;
  Real dp;
  Real r;
  Real Rad;
  Real u;
  Real L;
  Real mu;
  Real delP;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c3_6;
  Real c3_7;
  Real c4_8;
  Real c4_9;
  Real c4_10;
  Real c3_11;
  Real c3_12;
  Real c4_13;
  Real c4_14;
  Real c4_15;
  Real c3_16;
  Real c3_17;
  Real c4_18;
  Real c4_19;
  Real c4_20;
  Real d1;
  Real d2;
  Real d3;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c3_6 \exists c3_7 \exists c4_8 \exists c4_9 \exists c4_10 \exists c3_11 \exists c3_12 \exists c4_13 \exists c4_14 \exists c4_15 \exists c3_16 \exists c3_17 \exists c4_18 \exists c4_19 \exists c4_20 \exists d1 \exists d2 \exists d3
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c3_6 > 0 & c3_7 > 0 & c4_8 > 0 & c4_9 > 0 & c4_10 > 0 & c3_11 > 0 & c3_12 > 0 & c4_13 > 0 & c4_14 > 0 & c4_15 > 0 & c3_16 > 0 & c3_17 > 0 & c4_18 > 0 & c4_19 > 0 & c4_20 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c0 \forall c2 \forall dp \forall r \forall Rad \forall u \forall L \forall mu \forall delP
        (
          (
            (c0 > 0 & c2 > 0 & dp > 0 & r > 0 & Rad > 0 & u > 0 & L > 0 & mu > 0 & delP > 0) &
            & ( 4*r*c2*mu - r*dp = 0 )
            & ( delP + L*dp = 0 )
            & ( ( c3_1 * c0 ) + ( c3_2 * c2*Rad^2 ) = 0 )
            & ( ( c4_3 * c0 ) + ( c4_4 * c2*r^2 ) + ( c4_5 * u ) = 0 )
            & ( ( c3_6 * c0 ) + ( c3_7 * c2*Rad^2 ) = 0 )
            & ( ( c4_8 * c0 ) + ( c4_9 * c2*r^2 ) + ( c4_10 * u ) = 0 )
            & ( ( c3_11 * c0 ) + ( c3_12 * c2*Rad^2 ) = 0 )
            & ( ( c4_13 * c0 ) + ( c4_14 * c2*r^2 ) + ( c4_15 * u ) = 0 )
            & ( ( c3_16 * c0 ) + ( c3_17 * c2*Rad^2 ) = 0 )
            & ( ( c4_18 * c0 ) + ( c4_19 * c2*r^2 ) + ( c4_20 * u ) = 0 )
          )
          ->
          (
            ( d1 * r^3*delP ) + ( d2 * r*Rad^2*delP ) + ( d3 * r*u*L*mu ) = 0
          )
        )
      )
    )
  )
End.

End.
