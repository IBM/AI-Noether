ArchiveEntry "hagen_target1_combo1_3_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real c0;
  Real c2;
  Real dp;
  Real r;
  Real Rad;
  Real u;
  Real L;
  Real mu;
  Real delP;
  Real c1_1;
  Real c1_2;
  Real c3_3;
  Real c3_4;
  Real c4_5;
  Real c4_6;
  Real c4_7;
  Real c1_8;
  Real c1_9;
  Real c3_10;
  Real c3_11;
  Real c4_12;
  Real c4_13;
  Real c4_14;
  Real c1_15;
  Real c1_16;
  Real c3_17;
  Real c3_18;
  Real c4_19;
  Real c4_20;
  Real c4_21;
  Real d1;
  Real d2;
  Real d3;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c3_3 \exists c3_4 \exists c4_5 \exists c4_6 \exists c4_7 \exists c1_8 \exists c1_9 \exists c3_10 \exists c3_11 \exists c4_12 \exists c4_13 \exists c4_14 \exists c1_15 \exists c1_16 \exists c3_17 \exists c3_18 \exists c4_19 \exists c4_20 \exists c4_21 \exists d1 \exists d2 \exists d3
    (
      c1_1 > 0 & c1_2 > 0 & c3_3 > 0 & c3_4 > 0 & c4_5 > 0 & c4_6 > 0 & c4_7 > 0 & c1_8 > 0 & c1_9 > 0 & c3_10 > 0 & c3_11 > 0 & c4_12 > 0 & c4_13 > 0 & c4_14 > 0 & c1_15 > 0 & c1_16 > 0 & c3_17 > 0 & c3_18 > 0 & c4_19 > 0 & c4_20 > 0 & c4_21 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c0 \forall c2 \forall dp \forall r \forall Rad \forall u \forall L \forall mu \forall delP
        (
          (
            (c0 > 0 & c2 > 0 & dp > 0 & r > 0 & Rad > 0 & u > 0 & L > 0 & mu > 0 & delP > 0) &
            & ( delP + L*dp = 0 )
            & ( ( c1_1 * c2*r*mu ) + ( c1_2 * dp*r ) = 0 )
            & ( ( c3_3 * c0 ) + ( c3_4 * c2*Rad^2 ) = 0 )
            & ( ( c4_5 * c0 ) + ( c4_6 * c2*r^2 ) + ( c4_7 * u ) = 0 )
            & ( ( c1_8 * c2*r*mu ) + ( c1_9 * dp*r ) = 0 )
            & ( ( c3_10 * c0 ) + ( c3_11 * c2*Rad^2 ) = 0 )
            & ( ( c4_12 * c0 ) + ( c4_13 * c2*r^2 ) + ( c4_14 * u ) = 0 )
            & ( ( c1_15 * c2*r*mu ) + ( c1_16 * dp*r ) = 0 )
            & ( ( c3_17 * c0 ) + ( c3_18 * c2*Rad^2 ) = 0 )
            & ( ( c4_19 * c0 ) + ( c4_20 * c2*r^2 ) + ( c4_21 * u ) = 0 )
          )
          ->
          (
            ( d1 * r^3*delP ) + ( d2 * r*Rad^2*delP ) + ( d3 * r*u*L*mu ) = 0
          )
        )
      )
    )
  )
End.

End.
