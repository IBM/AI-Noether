ArchiveEntry "inelastic_collision_target1_combo2_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c4_4;
  Real c4_5;
  Real c4_6;
  Real c2_7;
  Real c2_8;
  Real c2_9;
  Real c4_10;
  Real c4_11;
  Real c4_12;
  Real c2_13;
  Real c2_14;
  Real c2_15;
  Real c4_16;
  Real c4_17;
  Real c4_18;
  Real c2_19;
  Real c2_20;
  Real c2_21;
  Real c4_22;
  Real c4_23;
  Real c4_24;
  Real c2_25;
  Real c2_26;
  Real c2_27;
  Real c4_28;
  Real c4_29;
  Real c4_30;
  Real c2_31;
  Real c2_32;
  Real c2_33;
  Real c4_34;
  Real c4_35;
  Real c4_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c4_4 \exists c4_5 \exists c4_6 \exists c2_7 \exists c2_8 \exists c2_9 \exists c4_10 \exists c4_11 \exists c4_12 \exists c2_13 \exists c2_14 \exists c2_15 \exists c4_16 \exists c4_17 \exists c4_18 \exists c2_19 \exists c2_20 \exists c2_21 \exists c4_22 \exists c4_23 \exists c4_24 \exists c2_25 \exists c2_26 \exists c2_27 \exists c4_28 \exists c4_29 \exists c4_30 \exists c2_31 \exists c2_32 \exists c2_33 \exists c4_34 \exists c4_35 \exists c4_36 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c4_4 > 0 & c4_5 > 0 & c4_6 > 0 & c2_7 > 0 & c2_8 > 0 & c2_9 > 0 & c4_10 > 0 & c4_11 > 0 & c4_12 > 0 & c2_13 > 0 & c2_14 > 0 & c2_15 > 0 & c4_16 > 0 & c4_17 > 0 & c4_18 > 0 & c2_19 > 0 & c2_20 > 0 & c2_21 > 0 & c4_22 > 0 & c4_23 > 0 & c4_24 > 0 & c2_25 > 0 & c2_26 > 0 & c2_27 > 0 & c4_28 > 0 & c4_29 > 0 & c4_30 > 0 & c2_31 > 0 & c2_32 > 0 & c2_33 > 0 & c4_34 > 0 & c4_35 > 0 & c4_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c4_4 * pc^2*c^2 ) + ( c4_5 * Ec^2 ) + ( c4_6 * mc^2*c^2 ) = 0 )
            & ( ( c2_7 * Em^2 ) + ( c2_8 * mm^2*c^4 ) + ( c2_9 * pm^2*c^2 ) = 0 )
            & ( ( c4_10 * pc^2*c^2 ) + ( c4_11 * Ec^2 ) + ( c4_12 * mc^2*c^2 ) = 0 )
            & ( ( c2_13 * Em^2 ) + ( c2_14 * mm^2*c^4 ) + ( c2_15 * pm^2*c^2 ) = 0 )
            & ( ( c4_16 * pc^2*c^2 ) + ( c4_17 * Ec^2 ) + ( c4_18 * mc^2*c^2 ) = 0 )
            & ( ( c2_19 * Em^2 ) + ( c2_20 * mm^2*c^4 ) + ( c2_21 * pm^2*c^2 ) = 0 )
            & ( ( c4_22 * pc^2*c^2 ) + ( c4_23 * Ec^2 ) + ( c4_24 * mc^2*c^2 ) = 0 )
            & ( ( c2_25 * Em^2 ) + ( c2_26 * mm^2*c^4 ) + ( c2_27 * pm^2*c^2 ) = 0 )
            & ( ( c4_28 * pc^2*c^2 ) + ( c4_29 * Ec^2 ) + ( c4_30 * mc^2*c^2 ) = 0 )
            & ( ( c2_31 * Em^2 ) + ( c2_32 * mm^2*c^4 ) + ( c2_33 * pm^2*c^2 ) = 0 )
            & ( ( c4_34 * pc^2*c^2 ) + ( c4_35 * Ec^2 ) + ( c4_36 * mc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
