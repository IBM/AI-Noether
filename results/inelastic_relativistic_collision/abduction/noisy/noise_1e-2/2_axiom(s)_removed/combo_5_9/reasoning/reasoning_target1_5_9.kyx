ArchiveEntry "inelastic_collision_target1_combo5_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c5_1;
  Real c5_2;
  Real c5_3;
  Real c5_4;
  Real c9_5;
  Real c9_6;
  Real c9_7;
  Real c5_8;
  Real c5_9;
  Real c5_10;
  Real c5_11;
  Real c9_12;
  Real c9_13;
  Real c9_14;
  Real c5_15;
  Real c5_16;
  Real c5_17;
  Real c5_18;
  Real c9_19;
  Real c9_20;
  Real c9_21;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c5_1 \exists c5_2 \exists c5_3 \exists c5_4 \exists c9_5 \exists c9_6 \exists c9_7 \exists c5_8 \exists c5_9 \exists c5_10 \exists c5_11 \exists c9_12 \exists c9_13 \exists c9_14 \exists c5_15 \exists c5_16 \exists c5_17 \exists c5_18 \exists c9_19 \exists c9_20 \exists c9_21 \exists d1 \exists d2
    (
      c5_1 > 0 & c5_2 > 0 & c5_3 > 0 & c5_4 > 0 & c9_5 > 0 & c9_6 > 0 & c9_7 > 0 & c5_8 > 0 & c5_9 > 0 & c5_10 > 0 & c5_11 > 0 & c9_12 > 0 & c9_13 > 0 & c9_14 > 0 & c5_15 > 0 & c5_16 > 0 & c5_17 > 0 & c5_18 > 0 & c9_19 > 0 & c9_20 > 0 & c9_21 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c5_1 * Em^2 ) + ( c5_2 * Em*Er ) + ( c5_3 * Er^2 ) + ( c5_4 * Ec^2 ) = 0 )
            & ( ( c9_5 * vc^2*pc^2 ) + ( c9_6 * vc^2*mc^2*c^2 ) + ( c9_7 * pc^2*c^2 ) = 0 )
            & ( ( c5_8 * Em^2 ) + ( c5_9 * Em*Er ) + ( c5_10 * Er^2 ) + ( c5_11 * Ec^2 ) = 0 )
            & ( ( c9_12 * vc^2*pc^2 ) + ( c9_13 * vc^2*mc^2*c^2 ) + ( c9_14 * pc^2*c^2 ) = 0 )
            & ( ( c5_15 * Em^2 ) + ( c5_16 * Em*Er ) + ( c5_17 * Er^2 ) + ( c5_18 * Ec^2 ) = 0 )
            & ( ( c9_19 * vc^2*pc^2 ) + ( c9_20 * vc^2*mc^2*c^2 ) + ( c9_21 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
