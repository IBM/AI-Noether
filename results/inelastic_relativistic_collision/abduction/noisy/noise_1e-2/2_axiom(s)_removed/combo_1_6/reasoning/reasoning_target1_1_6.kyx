ArchiveEntry "inelastic_collision_target1_combo1_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c6_4;
  Real c6_5;
  Real c1_6;
  Real c1_7;
  Real c1_8;
  Real c6_9;
  Real c6_10;
  Real c1_11;
  Real c1_12;
  Real c1_13;
  Real c6_14;
  Real c6_15;
  Real c1_16;
  Real c1_17;
  Real c1_18;
  Real c6_19;
  Real c6_20;
  Real c1_21;
  Real c1_22;
  Real c1_23;
  Real c6_24;
  Real c6_25;
  Real c1_26;
  Real c1_27;
  Real c1_28;
  Real c6_29;
  Real c6_30;
  Real c1_31;
  Real c1_32;
  Real c1_33;
  Real c6_34;
  Real c6_35;
  Real c1_36;
  Real c1_37;
  Real c1_38;
  Real c6_39;
  Real c6_40;
  Real c1_41;
  Real c1_42;
  Real c1_43;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c6_4 \exists c6_5 \exists c1_6 \exists c1_7 \exists c1_8 \exists c6_9 \exists c6_10 \exists c1_11 \exists c1_12 \exists c1_13 \exists c6_14 \exists c6_15 \exists c1_16 \exists c1_17 \exists c1_18 \exists c6_19 \exists c6_20 \exists c1_21 \exists c1_22 \exists c1_23 \exists c6_24 \exists c6_25 \exists c1_26 \exists c1_27 \exists c1_28 \exists c6_29 \exists c6_30 \exists c1_31 \exists c1_32 \exists c1_33 \exists c6_34 \exists c6_35 \exists c1_36 \exists c1_37 \exists c1_38 \exists c6_39 \exists c6_40 \exists c1_41 \exists c1_42 \exists c1_43 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c6_4 > 0 & c6_5 > 0 & c1_6 > 0 & c1_7 > 0 & c1_8 > 0 & c6_9 > 0 & c6_10 > 0 & c1_11 > 0 & c1_12 > 0 & c1_13 > 0 & c6_14 > 0 & c6_15 > 0 & c1_16 > 0 & c1_17 > 0 & c1_18 > 0 & c6_19 > 0 & c6_20 > 0 & c1_21 > 0 & c1_22 > 0 & c1_23 > 0 & c6_24 > 0 & c6_25 > 0 & c1_26 > 0 & c1_27 > 0 & c1_28 > 0 & c6_29 > 0 & c6_30 > 0 & c1_31 > 0 & c1_32 > 0 & c1_33 > 0 & c6_34 > 0 & c6_35 > 0 & c1_36 > 0 & c1_37 > 0 & c1_38 > 0 & c6_39 > 0 & c6_40 > 0 & c1_41 > 0 & c1_42 > 0 & c1_43 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c6_4 * pc ) + ( c6_5 * pm ) = 0 )
            & ( ( c1_6 * vm^2*mm^2*c^2 ) + ( c1_7 * vm^2*pm^2 ) + ( c1_8 * pm^2*c^2 ) = 0 )
            & ( ( c6_9 * pc ) + ( c6_10 * pm ) = 0 )
            & ( ( c1_11 * vm^2*mm^2*c^2 ) + ( c1_12 * vm^2*pm^2 ) + ( c1_13 * pm^2*c^2 ) = 0 )
            & ( ( c6_14 * pc ) + ( c6_15 * pm ) = 0 )
            & ( ( c1_16 * vm^2*mm^2*c^2 ) + ( c1_17 * vm^2*pm^2 ) + ( c1_18 * pm^2*c^2 ) = 0 )
            & ( ( c6_19 * pc ) + ( c6_20 * pm ) = 0 )
            & ( ( c1_21 * vm^2*mm^2*c^2 ) + ( c1_22 * vm^2*pm^2 ) + ( c1_23 * pm^2*c^2 ) = 0 )
            & ( ( c6_24 * pc ) + ( c6_25 * pm ) = 0 )
            & ( ( c1_26 * vm^2*mm^2*c^2 ) + ( c1_27 * vm^2*pm^2 ) + ( c1_28 * pm^2*c^2 ) = 0 )
            & ( ( c6_29 * pc ) + ( c6_30 * pm ) = 0 )
            & ( ( c1_31 * vm^2*mm^2*c^2 ) + ( c1_32 * vm^2*pm^2 ) + ( c1_33 * pm^2*c^2 ) = 0 )
            & ( ( c6_34 * pc ) + ( c6_35 * pm ) = 0 )
            & ( ( c1_36 * vm^2*mm^2*c^2 ) + ( c1_37 * vm^2*pm^2 ) + ( c1_38 * pm^2*c^2 ) = 0 )
            & ( ( c6_39 * pc ) + ( c6_40 * pm ) = 0 )
            & ( ( c1_41 * vm^2*mm^2*c^2 ) + ( c1_42 * vm^2*pm^2 ) + ( c1_43 * pm^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
