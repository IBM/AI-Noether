ArchiveEntry "inelastic_collision_target1_combo3_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c9_3;
  Real c9_4;
  Real c9_5;
  Real c3_6;
  Real c3_7;
  Real c9_8;
  Real c9_9;
  Real c9_10;
  Real c3_11;
  Real c3_12;
  Real c9_13;
  Real c9_14;
  Real c9_15;
  Real c3_16;
  Real c3_17;
  Real c9_18;
  Real c9_19;
  Real c9_20;
  Real c3_21;
  Real c3_22;
  Real c9_23;
  Real c9_24;
  Real c9_25;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c9_3 \exists c9_4 \exists c9_5 \exists c3_6 \exists c3_7 \exists c9_8 \exists c9_9 \exists c9_10 \exists c3_11 \exists c3_12 \exists c9_13 \exists c9_14 \exists c9_15 \exists c3_16 \exists c3_17 \exists c9_18 \exists c9_19 \exists c9_20 \exists c3_21 \exists c3_22 \exists c9_23 \exists c9_24 \exists c9_25 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c9_3 > 0 & c9_4 > 0 & c9_5 > 0 & c3_6 > 0 & c3_7 > 0 & c9_8 > 0 & c9_9 > 0 & c9_10 > 0 & c3_11 > 0 & c3_12 > 0 & c9_13 > 0 & c9_14 > 0 & c9_15 > 0 & c3_16 > 0 & c3_17 > 0 & c9_18 > 0 & c9_19 > 0 & c9_20 > 0 & c3_21 > 0 & c3_22 > 0 & c9_23 > 0 & c9_24 > 0 & c9_25 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c9_3 * vc^2*pc^2 ) + ( c9_4 * vc^2*mc^2*c^2 ) + ( c9_5 * pc^2*c^2 ) = 0 )
            & ( ( c3_6 * mr*c^2 ) + ( c3_7 * Er ) = 0 )
            & ( ( c9_8 * vc^2*pc^2 ) + ( c9_9 * vc^2*mc^2*c^2 ) + ( c9_10 * pc^2*c^2 ) = 0 )
            & ( ( c3_11 * mr*c^2 ) + ( c3_12 * Er ) = 0 )
            & ( ( c9_13 * vc^2*pc^2 ) + ( c9_14 * vc^2*mc^2*c^2 ) + ( c9_15 * pc^2*c^2 ) = 0 )
            & ( ( c3_16 * mr*c^2 ) + ( c3_17 * Er ) = 0 )
            & ( ( c9_18 * vc^2*pc^2 ) + ( c9_19 * vc^2*mc^2*c^2 ) + ( c9_20 * pc^2*c^2 ) = 0 )
            & ( ( c3_21 * mr*c^2 ) + ( c3_22 * Er ) = 0 )
            & ( ( c9_23 * vc^2*pc^2 ) + ( c9_24 * vc^2*mc^2*c^2 ) + ( c9_25 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
