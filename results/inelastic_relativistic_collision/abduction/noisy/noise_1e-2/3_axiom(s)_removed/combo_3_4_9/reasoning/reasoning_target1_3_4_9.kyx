ArchiveEntry "inelastic_collision_target1_combo3_4_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c9_6;
  Real c9_7;
  Real c9_8;
  Real c3_9;
  Real c3_10;
  Real c4_11;
  Real c4_12;
  Real c4_13;
  Real c9_14;
  Real c9_15;
  Real c9_16;
  Real c3_17;
  Real c3_18;
  Real c4_19;
  Real c4_20;
  Real c4_21;
  Real c9_22;
  Real c9_23;
  Real c9_24;
  Real c3_25;
  Real c3_26;
  Real c4_27;
  Real c4_28;
  Real c4_29;
  Real c9_30;
  Real c9_31;
  Real c9_32;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c9_6 \exists c9_7 \exists c9_8 \exists c3_9 \exists c3_10 \exists c4_11 \exists c4_12 \exists c4_13 \exists c9_14 \exists c9_15 \exists c9_16 \exists c3_17 \exists c3_18 \exists c4_19 \exists c4_20 \exists c4_21 \exists c9_22 \exists c9_23 \exists c9_24 \exists c3_25 \exists c3_26 \exists c4_27 \exists c4_28 \exists c4_29 \exists c9_30 \exists c9_31 \exists c9_32 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c9_6 > 0 & c9_7 > 0 & c9_8 > 0 & c3_9 > 0 & c3_10 > 0 & c4_11 > 0 & c4_12 > 0 & c4_13 > 0 & c9_14 > 0 & c9_15 > 0 & c9_16 > 0 & c3_17 > 0 & c3_18 > 0 & c4_19 > 0 & c4_20 > 0 & c4_21 > 0 & c9_22 > 0 & c9_23 > 0 & c9_24 > 0 & c3_25 > 0 & c3_26 > 0 & c4_27 > 0 & c4_28 > 0 & c4_29 > 0 & c9_30 > 0 & c9_31 > 0 & c9_32 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c4_3 * pc^2*c^2 ) + ( c4_4 * Ec^2 ) + ( c4_5 * mc^2*c^2 ) = 0 )
            & ( ( c9_6 * vc^2*pc^2 ) + ( c9_7 * vc^2*mc^2*c^2 ) + ( c9_8 * pc^2*c^2 ) = 0 )
            & ( ( c3_9 * mr*c^2 ) + ( c3_10 * Er ) = 0 )
            & ( ( c4_11 * pc^2*c^2 ) + ( c4_12 * Ec^2 ) + ( c4_13 * mc^2*c^2 ) = 0 )
            & ( ( c9_14 * vc^2*pc^2 ) + ( c9_15 * vc^2*mc^2*c^2 ) + ( c9_16 * pc^2*c^2 ) = 0 )
            & ( ( c3_17 * mr*c^2 ) + ( c3_18 * Er ) = 0 )
            & ( ( c4_19 * pc^2*c^2 ) + ( c4_20 * Ec^2 ) + ( c4_21 * mc^2*c^2 ) = 0 )
            & ( ( c9_22 * vc^2*pc^2 ) + ( c9_23 * vc^2*mc^2*c^2 ) + ( c9_24 * pc^2*c^2 ) = 0 )
            & ( ( c3_25 * mr*c^2 ) + ( c3_26 * Er ) = 0 )
            & ( ( c4_27 * pc^2*c^2 ) + ( c4_28 * Ec^2 ) + ( c4_29 * mc^2*c^2 ) = 0 )
            & ( ( c9_30 * vc^2*pc^2 ) + ( c9_31 * vc^2*mc^2*c^2 ) + ( c9_32 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
