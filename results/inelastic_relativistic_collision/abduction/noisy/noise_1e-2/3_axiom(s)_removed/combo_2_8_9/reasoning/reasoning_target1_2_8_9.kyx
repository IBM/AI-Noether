ArchiveEntry "inelastic_collision_target1_combo2_8_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c8_4;
  Real c8_5;
  Real c9_6;
  Real c9_7;
  Real c9_8;
  Real c2_9;
  Real c2_10;
  Real c2_11;
  Real c8_12;
  Real c8_13;
  Real c9_14;
  Real c9_15;
  Real c9_16;
  Real c2_17;
  Real c2_18;
  Real c2_19;
  Real c8_20;
  Real c8_21;
  Real c9_22;
  Real c9_23;
  Real c9_24;
  Real c2_25;
  Real c2_26;
  Real c2_27;
  Real c8_28;
  Real c8_29;
  Real c9_30;
  Real c9_31;
  Real c9_32;
  Real c2_33;
  Real c2_34;
  Real c2_35;
  Real c8_36;
  Real c8_37;
  Real c9_38;
  Real c9_39;
  Real c9_40;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c8_4 \exists c8_5 \exists c9_6 \exists c9_7 \exists c9_8 \exists c2_9 \exists c2_10 \exists c2_11 \exists c8_12 \exists c8_13 \exists c9_14 \exists c9_15 \exists c9_16 \exists c2_17 \exists c2_18 \exists c2_19 \exists c8_20 \exists c8_21 \exists c9_22 \exists c9_23 \exists c9_24 \exists c2_25 \exists c2_26 \exists c2_27 \exists c8_28 \exists c8_29 \exists c9_30 \exists c9_31 \exists c9_32 \exists c2_33 \exists c2_34 \exists c2_35 \exists c8_36 \exists c8_37 \exists c9_38 \exists c9_39 \exists c9_40 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c8_4 > 0 & c8_5 > 0 & c9_6 > 0 & c9_7 > 0 & c9_8 > 0 & c2_9 > 0 & c2_10 > 0 & c2_11 > 0 & c8_12 > 0 & c8_13 > 0 & c9_14 > 0 & c9_15 > 0 & c9_16 > 0 & c2_17 > 0 & c2_18 > 0 & c2_19 > 0 & c8_20 > 0 & c8_21 > 0 & c9_22 > 0 & c9_23 > 0 & c9_24 > 0 & c2_25 > 0 & c2_26 > 0 & c2_27 > 0 & c8_28 > 0 & c8_29 > 0 & c9_30 > 0 & c9_31 > 0 & c9_32 > 0 & c2_33 > 0 & c2_34 > 0 & c2_35 > 0 & c8_36 > 0 & c8_37 > 0 & c9_38 > 0 & c9_39 > 0 & c9_40 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c8_4 * mr ) + ( c8_5 * mm ) = 0 )
            & ( ( c9_6 * vc^2*pc^2 ) + ( c9_7 * vc^2*mc^2*c^2 ) + ( c9_8 * pc^2*c^2 ) = 0 )
            & ( ( c2_9 * Em^2 ) + ( c2_10 * mm^2*c^4 ) + ( c2_11 * pm^2*c^2 ) = 0 )
            & ( ( c8_12 * mr ) + ( c8_13 * mm ) = 0 )
            & ( ( c9_14 * vc^2*pc^2 ) + ( c9_15 * vc^2*mc^2*c^2 ) + ( c9_16 * pc^2*c^2 ) = 0 )
            & ( ( c2_17 * Em^2 ) + ( c2_18 * mm^2*c^4 ) + ( c2_19 * pm^2*c^2 ) = 0 )
            & ( ( c8_20 * mr ) + ( c8_21 * mm ) = 0 )
            & ( ( c9_22 * vc^2*pc^2 ) + ( c9_23 * vc^2*mc^2*c^2 ) + ( c9_24 * pc^2*c^2 ) = 0 )
            & ( ( c2_25 * Em^2 ) + ( c2_26 * mm^2*c^4 ) + ( c2_27 * pm^2*c^2 ) = 0 )
            & ( ( c8_28 * mr ) + ( c8_29 * mm ) = 0 )
            & ( ( c9_30 * vc^2*pc^2 ) + ( c9_31 * vc^2*mc^2*c^2 ) + ( c9_32 * pc^2*c^2 ) = 0 )
            & ( ( c2_33 * Em^2 ) + ( c2_34 * mm^2*c^4 ) + ( c2_35 * pm^2*c^2 ) = 0 )
            & ( ( c8_36 * mr ) + ( c8_37 * mm ) = 0 )
            & ( ( c9_38 * vc^2*pc^2 ) + ( c9_39 * vc^2*mc^2*c^2 ) + ( c9_40 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
