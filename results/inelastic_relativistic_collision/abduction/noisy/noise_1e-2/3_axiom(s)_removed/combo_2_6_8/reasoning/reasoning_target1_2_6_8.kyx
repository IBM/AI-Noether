ArchiveEntry "inelastic_collision_target1_combo2_6_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c6_4;
  Real c6_5;
  Real c8_6;
  Real c8_7;
  Real c2_8;
  Real c2_9;
  Real c2_10;
  Real c6_11;
  Real c6_12;
  Real c8_13;
  Real c8_14;
  Real c2_15;
  Real c2_16;
  Real c2_17;
  Real c6_18;
  Real c6_19;
  Real c8_20;
  Real c8_21;
  Real c2_22;
  Real c2_23;
  Real c2_24;
  Real c6_25;
  Real c6_26;
  Real c8_27;
  Real c8_28;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c6_4 \exists c6_5 \exists c8_6 \exists c8_7 \exists c2_8 \exists c2_9 \exists c2_10 \exists c6_11 \exists c6_12 \exists c8_13 \exists c8_14 \exists c2_15 \exists c2_16 \exists c2_17 \exists c6_18 \exists c6_19 \exists c8_20 \exists c8_21 \exists c2_22 \exists c2_23 \exists c2_24 \exists c6_25 \exists c6_26 \exists c8_27 \exists c8_28 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c6_4 > 0 & c6_5 > 0 & c8_6 > 0 & c8_7 > 0 & c2_8 > 0 & c2_9 > 0 & c2_10 > 0 & c6_11 > 0 & c6_12 > 0 & c8_13 > 0 & c8_14 > 0 & c2_15 > 0 & c2_16 > 0 & c2_17 > 0 & c6_18 > 0 & c6_19 > 0 & c8_20 > 0 & c8_21 > 0 & c2_22 > 0 & c2_23 > 0 & c2_24 > 0 & c6_25 > 0 & c6_26 > 0 & c8_27 > 0 & c8_28 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c6_4 * pc ) + ( c6_5 * pm ) = 0 )
            & ( ( c8_6 * mr ) + ( c8_7 * mm ) = 0 )
            & ( ( c2_8 * Em^2 ) + ( c2_9 * mm^2*c^4 ) + ( c2_10 * pm^2*c^2 ) = 0 )
            & ( ( c6_11 * pc ) + ( c6_12 * pm ) = 0 )
            & ( ( c8_13 * mr ) + ( c8_14 * mm ) = 0 )
            & ( ( c2_15 * Em^2 ) + ( c2_16 * mm^2*c^4 ) + ( c2_17 * pm^2*c^2 ) = 0 )
            & ( ( c6_18 * pc ) + ( c6_19 * pm ) = 0 )
            & ( ( c8_20 * mr ) + ( c8_21 * mm ) = 0 )
            & ( ( c2_22 * Em^2 ) + ( c2_23 * mm^2*c^4 ) + ( c2_24 * pm^2*c^2 ) = 0 )
            & ( ( c6_25 * pc ) + ( c6_26 * pm ) = 0 )
            & ( ( c8_27 * mr ) + ( c8_28 * mm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
