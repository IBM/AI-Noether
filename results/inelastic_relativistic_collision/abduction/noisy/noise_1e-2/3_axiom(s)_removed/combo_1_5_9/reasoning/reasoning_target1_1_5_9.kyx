  Real c9_40;
  Real c1_41;
  Real c1_42;
  Real c1_43;
  Real c5_44;
  Real c5_45;
  Real c5_46;
  Real c5_47;
  Real c9_48;
  Real c9_49;
  Real c9_50;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c5_7 \exists c9_8 \exists c9_9 \exists c9_10 \exists c1_11 \exists c1_12 \exists c1_13 \exists c5_14 \exists c5_15 \exists c5_16 \exists c5_17 \exists c9_18 \exists c9_19 \exists c9_20 \exists c1_21 \exists c1_22 \exists c1_23 \exists c5_24 \exists c5_25 \exists c5_26 \exists c5_27 \exists c9_28 \exists c9_29 \exists c9_30 \exists c1_31 \exists c1_32 \exists c1_33 \exists c5_34 \exists c5_35 \exists c5_36 \exists c5_37 \exists c9_38 \exists c9_39 \exists c9_40 \exists c1_41 \exists c1_42 \exists c1_43 \exists c5_44 \exists c5_45 \exists c5_46 \exists c5_47 \exists c9_48 \exists c9_49 \exists c9_50 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c5_7 > 0 & c9_8 > 0 & c9_9 > 0 & c9_10 > 0 & c1_11 > 0 & c1_12 > 0 & c1_13 > 0 & c5_14 > 0 & c5_15 > 0 & c5_16 > 0 & c5_17 > 0 & c9_18 > 0 & c9_19 > 0 & c9_20 > 0 & c1_21 > 0 & c1_22 > 0 & c1_23 > 0 & c5_24 > 0 & c5_25 > 0 & c5_26 > 0 & c5_27 > 0 & c9_28 > 0 & c9_29 > 0 & c9_30 > 0 & c1_31 > 0 & c1_32 > 0 & c1_33 > 0 & c5_34 > 0 & c5_35 > 0 & c5_36 > 0 & c5_37 > 0 & c9_38 > 0 & c9_39 > 0 & c9_40 > 0 & c1_41 > 0 & c1_42 > 0 & c1_43 > 0 & c5_44 > 0 & c5_45 > 0 & c5_46 > 0 & c5_47 > 0 & c9_48 > 0 & c9_49 > 0 & c9_50 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c5_4 * Em^2 ) + ( c5_5 * Em*Er ) + ( c5_6 * Er^2 ) + ( c5_7 * Ec^2 ) = 0 )
            & ( ( c9_8 * vc^2*pc^2 ) + ( c9_9 * vc^2*mc^2*c^2 ) + ( c9_10 * pc^2*c^2 ) = 0 )
            & ( ( c1_11 * vm^2*mm^2*c^2 ) + ( c1_12 * vm^2*pm^2 ) + ( c1_13 * pm^2*c^2 ) = 0 )
            & ( ( c5_14 * Em^2 ) + ( c5_15 * Em*Er ) + ( c5_16 * Er^2 ) + ( c5_17 * Ec^2 ) = 0 )
            & ( ( c9_18 * vc^2*pc^2 ) + ( c9_19 * vc^2*mc^2*c^2 ) + ( c9_20 * pc^2*c^2 ) = 0 )
            & ( ( c1_21 * vm^2*mm^2*c^2 ) + ( c1_22 * vm^2*pm^2 ) + ( c1_23 * pm^2*c^2 ) = 0 )
            & ( ( c5_24 * Em^2 ) + ( c5_25 * Em*Er ) + ( c5_26 * Er^2 ) + ( c5_27 * Ec^2 ) = 0 )
            & ( ( c9_28 * vc^2*pc^2 ) + ( c9_29 * vc^2*mc^2*c^2 ) + ( c9_30 * pc^2*c^2 ) = 0 )
            & ( ( c1_31 * vm^2*mm^2*c^2 ) + ( c1_32 * vm^2*pm^2 ) + ( c1_33 * pm^2*c^2 ) = 0 )
            & ( ( c5_34 * Em^2 ) + ( c5_35 * Em*Er ) + ( c5_36 * Er^2 ) + ( c5_37 * Ec^2 ) = 0 )
            & ( ( c9_38 * vc^2*pc^2 ) + ( c9_39 * vc^2*mc^2*c^2 ) + ( c9_40 * pc^2*c^2 ) = 0 )
            & ( ( c1_41 * vm^2*mm^2*c^2 ) + ( c1_42 * vm^2*pm^2 ) + ( c1_43 * pm^2*c^2 ) = 0 )
            & ( ( c5_44 * Em^2 ) + ( c5_45 * Em*Er ) + ( c5_46 * Er^2 ) + ( c5_47 * Ec^2 ) = 0 )
            & ( ( c9_48 * vc^2*pc^2 ) + ( c9_49 * vc^2*mc^2*c^2 ) + ( c9_50 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
