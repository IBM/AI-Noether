ArchiveEntry "inelastic_collision_target1_combo1_5_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c5_7;
  Real c9_8;
  Real c9_9;
  Real c9_10;
  Real c1_11;
  Real c1_12;
  Real c1_13;
  Real c5_14;
  Real c5_15;
  Real c5_16;
  Real c5_17;
  Real c9_18;
  Real c9_19;
  Real c9_20;
  Real c1_21;
  Real c1_22;
  Real c1_23;
  Real c5_24;
  Real c5_25;
  Real c5_26;
  Real c5_27;
  Real c9_28;
  Real c9_29;
  Real c9_30;
  Real c1_31;
  Real c1_32;
  Real c1_33;
  Real c5_34;
  Real c5_35;
  Real c5_36;
  Real c5_37;
  Real c9_38;
