ArchiveEntry "inelastic_collision_target1_combo4_8_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c4_1;
  Real c4_2;
  Real c4_3;
  Real c8_4;
  Real c8_5;
  Real c9_6;
  Real c9_7;
  Real c9_8;
  Real c4_9;
  Real c4_10;
  Real c4_11;
  Real c8_12;
  Real c8_13;
  Real c9_14;
  Real c9_15;
  Real c9_16;
  Real c4_17;
  Real c4_18;
  Real c4_19;
  Real c8_20;
  Real c8_21;
  Real c9_22;
  Real c9_23;
  Real c9_24;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c4_3 \exists c8_4 \exists c8_5 \exists c9_6 \exists c9_7 \exists c9_8 \exists c4_9 \exists c4_10 \exists c4_11 \exists c8_12 \exists c8_13 \exists c9_14 \exists c9_15 \exists c9_16 \exists c4_17 \exists c4_18 \exists c4_19 \exists c8_20 \exists c8_21 \exists c9_22 \exists c9_23 \exists c9_24 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c4_3 > 0 & c8_4 > 0 & c8_5 > 0 & c9_6 > 0 & c9_7 > 0 & c9_8 > 0 & c4_9 > 0 & c4_10 > 0 & c4_11 > 0 & c8_12 > 0 & c8_13 > 0 & c9_14 > 0 & c9_15 > 0 & c9_16 > 0 & c4_17 > 0 & c4_18 > 0 & c4_19 > 0 & c8_20 > 0 & c8_21 > 0 & c9_22 > 0 & c9_23 > 0 & c9_24 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( ( c4_1 * pc^2*c^2 ) + ( c4_2 * Ec^2 ) + ( c4_3 * mc^2*c^2 ) = 0 )
            & ( ( c8_4 * mr ) + ( c8_5 * mm ) = 0 )
            & ( ( c9_6 * vc^2*pc^2 ) + ( c9_7 * vc^2*mc^2*c^2 ) + ( c9_8 * pc^2*c^2 ) = 0 )
            & ( ( c4_9 * pc^2*c^2 ) + ( c4_10 * Ec^2 ) + ( c4_11 * mc^2*c^2 ) = 0 )
            & ( ( c8_12 * mr ) + ( c8_13 * mm ) = 0 )
            & ( ( c9_14 * vc^2*pc^2 ) + ( c9_15 * vc^2*mc^2*c^2 ) + ( c9_16 * pc^2*c^2 ) = 0 )
            & ( ( c4_17 * pc^2*c^2 ) + ( c4_18 * Ec^2 ) + ( c4_19 * mc^2*c^2 ) = 0 )
            & ( ( c8_20 * mr ) + ( c8_21 * mm ) = 0 )
            & ( ( c9_22 * vc^2*pc^2 ) + ( c9_23 * vc^2*mc^2*c^2 ) + ( c9_24 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
