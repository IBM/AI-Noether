ArchiveEntry "inelastic_collision_target1_combo4_6_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c4_1;
  Real c4_2;
  Real c4_3;
  Real c6_4;
  Real c6_5;
  Real c8_6;
  Real c8_7;
  Real c4_8;
  Real c4_9;
  Real c4_10;
  Real c6_11;
  Real c6_12;
  Real c8_13;
  Real c8_14;
  Real c4_15;
  Real c4_16;
  Real c4_17;
  Real c6_18;
  Real c6_19;
  Real c4_20;
  Real c4_21;
  Real c4_22;
  Real c6_23;
  Real c6_24;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c4_3 \exists c6_4 \exists c6_5 \exists c8_6 \exists c8_7 \exists c4_8 \exists c4_9 \exists c4_10 \exists c6_11 \exists c6_12 \exists c8_13 \exists c8_14 \exists c4_15 \exists c4_16 \exists c4_17 \exists c6_18 \exists c6_19 \exists c4_20 \exists c4_21 \exists c4_22 \exists c6_23 \exists c6_24 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c4_3 > 0 & c6_4 > 0 & c6_5 > 0 & c8_6 > 0 & c8_7 > 0 & c4_8 > 0 & c4_9 > 0 & c4_10 > 0 & c6_11 > 0 & c6_12 > 0 & c8_13 > 0 & c8_14 > 0 & c4_15 > 0 & c4_16 > 0 & c4_17 > 0 & c6_18 > 0 & c6_19 > 0 & c4_20 > 0 & c4_21 > 0 & c4_22 > 0 & c6_23 > 0 & c6_24 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c4_1 * pc^2*c^2 ) + ( c4_2 * Ec^2 ) + ( c4_3 * mc^2*c^2 ) = 0 )
            & ( ( c6_4 * pc ) + ( c6_5 * pm ) = 0 )
            & ( ( c8_6 * mr ) + ( c8_7 * mm ) = 0 )
            & ( ( c4_8 * pc^2*c^2 ) + ( c4_9 * Ec^2 ) + ( c4_10 * mc^2*c^2 ) = 0 )
            & ( ( c6_11 * pc ) + ( c6_12 * pm ) = 0 )
            & ( ( c8_13 * mr ) + ( c8_14 * mm ) = 0 )
            & ( ( c4_15 * pc^2*c^2 ) + ( c4_16 * Ec^2 ) + ( c4_17 * mc^2*c^2 ) = 0 )
            & ( ( c6_18 * pc ) + ( c6_19 * pm ) = 0 )
            & ( ( c4_20 * pc^2*c^2 ) + ( c4_21 * Ec^2 ) + ( c4_22 * mc^2*c^2 ) = 0 )
            & ( ( c6_23 * pc ) + ( c6_24 * pm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
