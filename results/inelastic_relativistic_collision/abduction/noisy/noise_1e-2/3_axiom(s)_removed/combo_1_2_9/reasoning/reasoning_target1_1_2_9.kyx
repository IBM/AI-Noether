ArchiveEntry "inelastic_collision_target1_combo1_2_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c2_4;
  Real c2_5;
  Real c2_6;
  Real c9_7;
  Real c9_8;
  Real c9_9;
  Real c1_10;
  Real c1_11;
  Real c1_12;
  Real c2_13;
  Real c2_14;
  Real c2_15;
  Real c9_16;
  Real c9_17;
  Real c9_18;
  Real c1_19;
  Real c1_20;
  Real c1_21;
  Real c2_22;
  Real c2_23;
  Real c2_24;
  Real c9_25;
  Real c9_26;
  Real c9_27;
  Real c1_28;
  Real c1_29;
  Real c1_30;
  Real c2_31;
  Real c2_32;
  Real c2_33;
  Real c9_34;
  Real c9_35;
  Real c9_36;
  Real c1_37;
  Real c1_38;
  Real c1_39;
  Real c2_40;
  Real c2_41;
  Real c2_42;
  Real c9_43;
  Real c9_44;
  Real c9_45;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c2_4 \exists c2_5 \exists c2_6 \exists c9_7 \exists c9_8 \exists c9_9 \exists c1_10 \exists c1_11 \exists c1_12 \exists c2_13 \exists c2_14 \exists c2_15 \exists c9_16 \exists c9_17 \exists c9_18 \exists c1_19 \exists c1_20 \exists c1_21 \exists c2_22 \exists c2_23 \exists c2_24 \exists c9_25 \exists c9_26 \exists c9_27 \exists c1_28 \exists c1_29 \exists c1_30 \exists c2_31 \exists c2_32 \exists c2_33 \exists c9_34 \exists c9_35 \exists c9_36 \exists c1_37 \exists c1_38 \exists c1_39 \exists c2_40 \exists c2_41 \exists c2_42 \exists c9_43 \exists c9_44 \exists c9_45 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c9_7 > 0 & c9_8 > 0 & c9_9 > 0 & c1_10 > 0 & c1_11 > 0 & c1_12 > 0 & c2_13 > 0 & c2_14 > 0 & c2_15 > 0 & c9_16 > 0 & c9_17 > 0 & c9_18 > 0 & c1_19 > 0 & c1_20 > 0 & c1_21 > 0 & c2_22 > 0 & c2_23 > 0 & c2_24 > 0 & c9_25 > 0 & c9_26 > 0 & c9_27 > 0 & c1_28 > 0 & c1_29 > 0 & c1_30 > 0 & c2_31 > 0 & c2_32 > 0 & c2_33 > 0 & c9_34 > 0 & c9_35 > 0 & c9_36 > 0 & c1_37 > 0 & c1_38 > 0 & c1_39 > 0 & c2_40 > 0 & c2_41 > 0 & c2_42 > 0 & c9_43 > 0 & c9_44 > 0 & c9_45 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
            & ( ( c9_7 * vc^2*pc^2 ) + ( c9_8 * vc^2*mc^2*c^2 ) + ( c9_9 * pc^2*c^2 ) = 0 )
            & ( ( c1_10 * vm^2*mm^2*c^2 ) + ( c1_11 * vm^2*pm^2 ) + ( c1_12 * pm^2*c^2 ) = 0 )
            & ( ( c2_13 * Em^2 ) + ( c2_14 * mm^2*c^4 ) + ( c2_15 * pm^2*c^2 ) = 0 )
            & ( ( c9_16 * vc^2*pc^2 ) + ( c9_17 * vc^2*mc^2*c^2 ) + ( c9_18 * pc^2*c^2 ) = 0 )
            & ( ( c1_19 * vm^2*mm^2*c^2 ) + ( c1_20 * vm^2*pm^2 ) + ( c1_21 * pm^2*c^2 ) = 0 )
            & ( ( c2_22 * Em^2 ) + ( c2_23 * mm^2*c^4 ) + ( c2_24 * pm^2*c^2 ) = 0 )
            & ( ( c9_25 * vc^2*pc^2 ) + ( c9_26 * vc^2*mc^2*c^2 ) + ( c9_27 * pc^2*c^2 ) = 0 )
            & ( ( c1_28 * vm^2*mm^2*c^2 ) + ( c1_29 * vm^2*pm^2 ) + ( c1_30 * pm^2*c^2 ) = 0 )
            & ( ( c2_31 * Em^2 ) + ( c2_32 * mm^2*c^4 ) + ( c2_33 * pm^2*c^2 ) = 0 )
            & ( ( c9_34 * vc^2*pc^2 ) + ( c9_35 * vc^2*mc^2*c^2 ) + ( c9_36 * pc^2*c^2 ) = 0 )
            & ( ( c1_37 * vm^2*mm^2*c^2 ) + ( c1_38 * vm^2*pm^2 ) + ( c1_39 * pm^2*c^2 ) = 0 )
            & ( ( c2_40 * Em^2 ) + ( c2_41 * mm^2*c^4 ) + ( c2_42 * pm^2*c^2 ) = 0 )
            & ( ( c9_43 * vc^2*pc^2 ) + ( c9_44 * vc^2*mc^2*c^2 ) + ( c9_45 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
