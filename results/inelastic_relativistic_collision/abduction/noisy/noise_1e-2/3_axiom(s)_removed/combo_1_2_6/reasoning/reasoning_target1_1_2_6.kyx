ArchiveEntry "inelastic_collision_target1_combo1_2_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c2_4;
  Real c2_5;
  Real c2_6;
  Real c6_7;
  Real c6_8;
  Real c1_9;
  Real c1_10;
  Real c1_11;
  Real c2_12;
  Real c2_13;
  Real c2_14;
  Real c6_15;
  Real c6_16;
  Real c1_17;
  Real c1_18;
  Real c1_19;
  Real c2_20;
  Real c2_21;
  Real c2_22;
  Real c6_23;
  Real c6_24;
  Real c1_25;
  Real c1_26;
  Real c1_27;
  Real c2_28;
  Real c2_29;
  Real c2_30;
  Real c6_31;
  Real c6_32;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c2_4 \exists c2_5 \exists c2_6 \exists c6_7 \exists c6_8 \exists c1_9 \exists c1_10 \exists c1_11 \exists c2_12 \exists c2_13 \exists c2_14 \exists c6_15 \exists c6_16 \exists c1_17 \exists c1_18 \exists c1_19 \exists c2_20 \exists c2_21 \exists c2_22 \exists c6_23 \exists c6_24 \exists c1_25 \exists c1_26 \exists c1_27 \exists c2_28 \exists c2_29 \exists c2_30 \exists c6_31 \exists c6_32 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c6_7 > 0 & c6_8 > 0 & c1_9 > 0 & c1_10 > 0 & c1_11 > 0 & c2_12 > 0 & c2_13 > 0 & c2_14 > 0 & c6_15 > 0 & c6_16 > 0 & c1_17 > 0 & c1_18 > 0 & c1_19 > 0 & c2_20 > 0 & c2_21 > 0 & c2_22 > 0 & c6_23 > 0 & c6_24 > 0 & c1_25 > 0 & c1_26 > 0 & c1_27 > 0 & c2_28 > 0 & c2_29 > 0 & c2_30 > 0 & c6_31 > 0 & c6_32 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
            & ( ( c6_7 * pc ) + ( c6_8 * pm ) = 0 )
            & ( ( c1_9 * vm^2*mm^2*c^2 ) + ( c1_10 * vm^2*pm^2 ) + ( c1_11 * pm^2*c^2 ) = 0 )
            & ( ( c2_12 * Em^2 ) + ( c2_13 * mm^2*c^4 ) + ( c2_14 * pm^2*c^2 ) = 0 )
            & ( ( c6_15 * pc ) + ( c6_16 * pm ) = 0 )
            & ( ( c1_17 * vm^2*mm^2*c^2 ) + ( c1_18 * vm^2*pm^2 ) + ( c1_19 * pm^2*c^2 ) = 0 )
            & ( ( c2_20 * Em^2 ) + ( c2_21 * mm^2*c^4 ) + ( c2_22 * pm^2*c^2 ) = 0 )
            & ( ( c6_23 * pc ) + ( c6_24 * pm ) = 0 )
            & ( ( c1_25 * vm^2*mm^2*c^2 ) + ( c1_26 * vm^2*pm^2 ) + ( c1_27 * pm^2*c^2 ) = 0 )
            & ( ( c2_28 * Em^2 ) + ( c2_29 * mm^2*c^4 ) + ( c2_30 * pm^2*c^2 ) = 0 )
            & ( ( c6_31 * pc ) + ( c6_32 * pm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
