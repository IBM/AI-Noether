Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c6_4 \exists c6_5 \exists c7_6 \exists c7_7 \exists c1_8 \exists c1_9 \exists c1_10 \exists c6_11 \exists c6_12 \exists c7_13 \exists c7_14 \exists c1_15 \exists c1_16 \exists c1_17 \exists c6_18 \exists c6_19 \exists c7_20 \exists c7_21 \exists c1_22 \exists c1_23 \exists c1_24 \exists c6_25 \exists c6_26 \exists c7_27 \exists c7_28 \exists c1_29 \exists c1_30 \exists c1_31 \exists c6_32 \exists c6_33 \exists c7_34 \exists c7_35 \exists c1_36 \exists c1_37 \exists c1_38 \exists c6_39 \exists c6_40 \exists c7_41 \exists c7_42 \exists c1_43 \exists c1_44 \exists c1_45 \exists c6_46 \exists c6_47 \exists c7_48 \exists c7_49 \exists c1_50 \exists c1_51 \exists c1_52 \exists c6_53 \exists c6_54 \exists c7_55 \exists c7_56 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c6_4 > 0 & c6_5 > 0 & c7_6 > 0 & c7_7 > 0 & c1_8 > 0 & c1_9 > 0 & c1_10 > 0 & c6_11 > 0 & c6_12 > 0 & c7_13 > 0 & c7_14 > 0 & c1_15 > 0 & c1_16 > 0 & c1_17 > 0 & c6_18 > 0 & c6_19 > 0 & c7_20 > 0 & c7_21 > 0 & c1_22 > 0 & c1_23 > 0 & c1_24 > 0 & c6_25 > 0 & c6_26 > 0 & c7_27 > 0 & c7_28 > 0 & c1_29 > 0 & c1_30 > 0 & c1_31 > 0 & c6_32 > 0 & c6_33 > 0 & c7_34 > 0 & c7_35 > 0 & c1_36 > 0 & c1_37 > 0 & c1_38 > 0 & c6_39 > 0 & c6_40 > 0 & c7_41 > 0 & c7_42 > 0 & c1_43 > 0 & c1_44 > 0 & c1_45 > 0 & c6_46 > 0 & c6_47 > 0 & c7_48 > 0 & c7_49 > 0 & c1_50 > 0 & c1_51 > 0 & c1_52 > 0 & c6_53 > 0 & c6_54 > 0 & c7_55 > 0 & c7_56 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
