            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c6_4 * pc ) + ( c6_5 * pm ) = 0 )
            & ( ( c7_6 * vm ) + ( c7_7 * c ) = 0 )
            & ( ( c1_8 * vm^2*mm^2*c^2 ) + ( c1_9 * vm^2*pm^2 ) + ( c1_10 * pm^2*c^2 ) = 0 )
            & ( ( c6_11 * pc ) + ( c6_12 * pm ) = 0 )
            & ( ( c7_13 * vm ) + ( c7_14 * c ) = 0 )
            & ( ( c1_15 * vm^2*mm^2*c^2 ) + ( c1_16 * vm^2*pm^2 ) + ( c1_17 * pm^2*c^2 ) = 0 )
            & ( ( c6_18 * pc ) + ( c6_19 * pm ) = 0 )
            & ( ( c7_20 * vm ) + ( c7_21 * c ) = 0 )
            & ( ( c1_22 * vm^2*mm^2*c^2 ) + ( c1_23 * vm^2*pm^2 ) + ( c1_24 * pm^2*c^2 ) = 0 )
            & ( ( c6_25 * pc ) + ( c6_26 * pm ) = 0 )
            & ( ( c7_27 * vm ) + ( c7_28 * c ) = 0 )
            & ( ( c1_29 * vm^2*mm^2*c^2 ) + ( c1_30 * vm^2*pm^2 ) + ( c1_31 * pm^2*c^2 ) = 0 )
            & ( ( c6_32 * pc ) + ( c6_33 * pm ) = 0 )
            & ( ( c7_34 * vm ) + ( c7_35 * c ) = 0 )
            & ( ( c1_36 * vm^2*mm^2*c^2 ) + ( c1_37 * vm^2*pm^2 ) + ( c1_38 * pm^2*c^2 ) = 0 )
            & ( ( c6_39 * pc ) + ( c6_40 * pm ) = 0 )
            & ( ( c7_41 * vm ) + ( c7_42 * c ) = 0 )
            & ( ( c1_43 * vm^2*mm^2*c^2 ) + ( c1_44 * vm^2*pm^2 ) + ( c1_45 * pm^2*c^2 ) = 0 )
            & ( ( c6_46 * pc ) + ( c6_47 * pm ) = 0 )
            & ( ( c7_48 * vm ) + ( c7_49 * c ) = 0 )
            & ( ( c1_50 * vm^2*mm^2*c^2 ) + ( c1_51 * vm^2*pm^2 ) + ( c1_52 * pm^2*c^2 ) = 0 )
            & ( ( c6_53 * pc ) + ( c6_54 * pm ) = 0 )
            & ( ( c7_55 * vm ) + ( c7_56 * c ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

