ArchiveEntry "inelastic_collision_target1_combo3_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c3_6;
  Real c3_7;
  Real c4_8;
  Real c4_9;
  Real c4_10;
  Real c3_11;
  Real c3_12;
  Real c4_13;
  Real c4_14;
  Real c4_15;
  Real c3_16;
  Real c3_17;
  Real c4_18;
  Real c4_19;
  Real c4_20;
  Real c3_21;
  Real c3_22;
  Real c4_23;
  Real c4_24;
  Real c4_25;
  Real c3_26;
  Real c3_27;
  Real c4_28;
  Real c4_29;
  Real c4_30;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c3_6 \exists c3_7 \exists c4_8 \exists c4_9 \exists c4_10 \exists c3_11 \exists c3_12 \exists c4_13 \exists c4_14 \exists c4_15 \exists c3_16 \exists c3_17 \exists c4_18 \exists c4_19 \exists c4_20 \exists c3_21 \exists c3_22 \exists c4_23 \exists c4_24 \exists c4_25 \exists c3_26 \exists c3_27 \exists c4_28 \exists c4_29 \exists c4_30 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c3_6 > 0 & c3_7 > 0 & c4_8 > 0 & c4_9 > 0 & c4_10 > 0 & c3_11 > 0 & c3_12 > 0 & c4_13 > 0 & c4_14 > 0 & c4_15 > 0 & c3_16 > 0 & c3_17 > 0 & c4_18 > 0 & c4_19 > 0 & c4_20 > 0 & c3_21 > 0 & c3_22 > 0 & c4_23 > 0 & c4_24 > 0 & c4_25 > 0 & c3_26 > 0 & c3_27 > 0 & c4_28 > 0 & c4_29 > 0 & c4_30 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c4_3 * pc^2*c^2 ) + ( c4_4 * Ec^2 ) + ( c4_5 * mc^2*c^2 ) = 0 )
            & ( ( c3_6 * mr*c^2 ) + ( c3_7 * Er ) = 0 )
            & ( ( c4_8 * pc^2*c^2 ) + ( c4_9 * Ec^2 ) + ( c4_10 * mc^2*c^2 ) = 0 )
            & ( ( c3_11 * mr*c^2 ) + ( c3_12 * Er ) = 0 )
            & ( ( c4_13 * pc^2*c^2 ) + ( c4_14 * Ec^2 ) + ( c4_15 * mc^2*c^2 ) = 0 )
            & ( ( c3_16 * mr*c^2 ) + ( c3_17 * Er ) = 0 )
            & ( ( c4_18 * pc^2*c^2 ) + ( c4_19 * Ec^2 ) + ( c4_20 * mc^2*c^2 ) = 0 )
            & ( ( c3_21 * mr*c^2 ) + ( c3_22 * Er ) = 0 )
            & ( ( c4_23 * pc^2*c^2 ) + ( c4_24 * Ec^2 ) + ( c4_25 * mc^2*c^2 ) = 0 )
            & ( ( c3_26 * mr*c^2 ) + ( c3_27 * Er ) = 0 )
            & ( ( c4_28 * pc^2*c^2 ) + ( c4_29 * Ec^2 ) + ( c4_30 * mc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
