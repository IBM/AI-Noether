ArchiveEntry "inelastic_collision_target1_combo2_7"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c7_4;
  Real c7_5;
  Real c2_6;
  Real c2_7;
  Real c2_8;
  Real c7_9;
  Real c7_10;
  Real c2_11;
  Real c2_12;
  Real c2_13;
  Real c7_14;
  Real c7_15;
  Real c2_16;
  Real c2_17;
  Real c2_18;
  Real c7_19;
  Real c7_20;
  Real c2_21;
  Real c2_22;
  Real c2_23;
  Real c7_24;
  Real c7_25;
  Real c2_26;
  Real c2_27;
  Real c2_28;
  Real c7_29;
  Real c7_30;
  Real c2_31;
  Real c2_32;
  Real c2_33;
  Real c7_34;
  Real c7_35;
  Real c2_36;
  Real c2_37;
  Real c2_38;
  Real c7_39;
  Real c7_40;
  Real c2_41;
  Real c2_42;
  Real c2_43;
  Real c7_44;
  Real c7_45;
  Real c2_46;
  Real c2_47;
  Real c2_48;
  Real c7_49;
  Real c7_50;
  Real c2_51;
  Real c2_52;
  Real c2_53;
  Real c7_54;
  Real c7_55;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c7_4 \exists c7_5 \exists c2_6 \exists c2_7 \exists c2_8 \exists c7_9 \exists c7_10 \exists c2_11 \exists c2_12 \exists c2_13 \exists c7_14 \exists c7_15 \exists c2_16 \exists c2_17 \exists c2_18 \exists c7_19 \exists c7_20 \exists c2_21 \exists c2_22 \exists c2_23 \exists c7_24 \exists c7_25 \exists c2_26 \exists c2_27 \exists c2_28 \exists c7_29 \exists c7_30 \exists c2_31 \exists c2_32 \exists c2_33 \exists c7_34 \exists c7_35 \exists c2_36 \exists c2_37 \exists c2_38 \exists c7_39 \exists c7_40 \exists c2_41 \exists c2_42 \exists c2_43 \exists c7_44 \exists c7_45 \exists c2_46 \exists c2_47 \exists c2_48 \exists c7_49 \exists c7_50 \exists c2_51 \exists c2_52 \exists c2_53 \exists c7_54 \exists c7_55 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c7_4 > 0 & c7_5 > 0 & c2_6 > 0 & c2_7 > 0 & c2_8 > 0 & c7_9 > 0 & c7_10 > 0 & c2_11 > 0 & c2_12 > 0 & c2_13 > 0 & c7_14 > 0 & c7_15 > 0 & c2_16 > 0 & c2_17 > 0 & c2_18 > 0 & c7_19 > 0 & c7_20 > 0 & c2_21 > 0 & c2_22 > 0 & c2_23 > 0 & c7_24 > 0 & c7_25 > 0 & c2_26 > 0 & c2_27 > 0 & c2_28 > 0 & c7_29 > 0 & c7_30 > 0 & c2_31 > 0 & c2_32 > 0 & c2_33 > 0 & c7_34 > 0 & c7_35 > 0 & c2_36 > 0 & c2_37 > 0 & c2_38 > 0 & c7_39 > 0 & c7_40 > 0 & c2_41 > 0 & c2_42 > 0 & c2_43 > 0 & c7_44 > 0 & c7_45 > 0 & c2_46 > 0 & c2_47 > 0 & c2_48 > 0 & c7_49 > 0 & c7_50 > 0 & c2_51 > 0 & c2_52 > 0 & c2_53 > 0 & c7_54 > 0 & c7_55 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c7_4 * vm ) + ( c7_5 * c ) = 0 )
            & ( ( c2_6 * Em^2 ) + ( c2_7 * mm^2*c^4 ) + ( c2_8 * pm^2*c^2 ) = 0 )
            & ( ( c7_9 * vm ) + ( c7_10 * c ) = 0 )
            & ( ( c2_11 * Em^2 ) + ( c2_12 * mm^2*c^4 ) + ( c2_13 * pm^2*c^2 ) = 0 )
            & ( ( c7_14 * vm ) + ( c7_15 * c ) = 0 )
            & ( ( c2_16 * Em^2 ) + ( c2_17 * mm^2*c^4 ) + ( c2_18 * pm^2*c^2 ) = 0 )
            & ( ( c7_19 * vm ) + ( c7_20 * c ) = 0 )
            & ( ( c2_21 * Em^2 ) + ( c2_22 * mm^2*c^4 ) + ( c2_23 * pm^2*c^2 ) = 0 )
            & ( ( c7_24 * vm ) + ( c7_25 * c ) = 0 )
            & ( ( c2_26 * Em^2 ) + ( c2_27 * mm^2*c^4 ) + ( c2_28 * pm^2*c^2 ) = 0 )
            & ( ( c7_29 * vm ) + ( c7_30 * c ) = 0 )
            & ( ( c2_31 * Em^2 ) + ( c2_32 * mm^2*c^4 ) + ( c2_33 * pm^2*c^2 ) = 0 )
            & ( ( c7_34 * vm ) + ( c7_35 * c ) = 0 )
            & ( ( c2_36 * Em^2 ) + ( c2_37 * mm^2*c^4 ) + ( c2_38 * pm^2*c^2 ) = 0 )
            & ( ( c7_39 * vm ) + ( c7_40 * c ) = 0 )
            & ( ( c2_41 * Em^2 ) + ( c2_42 * mm^2*c^4 ) + ( c2_43 * pm^2*c^2 ) = 0 )
            & ( ( c7_44 * vm ) + ( c7_45 * c ) = 0 )
            & ( ( c2_46 * Em^2 ) + ( c2_47 * mm^2*c^4 ) + ( c2_48 * pm^2*c^2 ) = 0 )
            & ( ( c7_49 * vm ) + ( c7_50 * c ) = 0 )
            & ( ( c2_51 * Em^2 ) + ( c2_52 * mm^2*c^4 ) + ( c2_53 * pm^2*c^2 ) = 0 )
            & ( ( c7_54 * vm ) + ( c7_55 * c ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
