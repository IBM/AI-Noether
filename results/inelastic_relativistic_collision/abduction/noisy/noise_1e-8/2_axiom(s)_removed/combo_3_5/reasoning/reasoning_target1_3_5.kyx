ArchiveEntry "inelastic_collision_target1_combo3_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c5_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c3_7;
  Real c3_8;
  Real c5_9;
  Real c5_10;
  Real c5_11;
  Real c5_12;
  Real c3_13;
  Real c3_14;
  Real c5_15;
  Real c5_16;
  Real c5_17;
  Real c5_18;
  Real c3_19;
  Real c3_20;
  Real c5_21;
  Real c5_22;
  Real c5_23;
  Real c5_24;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c5_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c3_7 \exists c3_8 \exists c5_9 \exists c5_10 \exists c5_11 \exists c5_12 \exists c3_13 \exists c3_14 \exists c5_15 \exists c5_16 \exists c5_17 \exists c5_18 \exists c3_19 \exists c3_20 \exists c5_21 \exists c5_22 \exists c5_23 \exists c5_24 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c5_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c3_7 > 0 & c3_8 > 0 & c5_9 > 0 & c5_10 > 0 & c5_11 > 0 & c5_12 > 0 & c3_13 > 0 & c3_14 > 0 & c5_15 > 0 & c5_16 > 0 & c5_17 > 0 & c5_18 > 0 & c3_19 > 0 & c3_20 > 0 & c5_21 > 0 & c5_22 > 0 & c5_23 > 0 & c5_24 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c5_3 * Em^2 ) + ( c5_4 * Em*Er ) + ( c5_5 * Er^2 ) + ( c5_6 * Ec^2 ) = 0 )
            & ( ( c3_7 * mr*c^2 ) + ( c3_8 * Er ) = 0 )
            & ( ( c5_9 * Em^2 ) + ( c5_10 * Em*Er ) + ( c5_11 * Er^2 ) + ( c5_12 * Ec^2 ) = 0 )
            & ( ( c3_13 * mr*c^2 ) + ( c3_14 * Er ) = 0 )
            & ( ( c5_15 * Em^2 ) + ( c5_16 * Em*Er ) + ( c5_17 * Er^2 ) + ( c5_18 * Ec^2 ) = 0 )
            & ( ( c3_19 * mr*c^2 ) + ( c3_20 * Er ) = 0 )
            & ( ( c5_21 * Em^2 ) + ( c5_22 * Em*Er ) + ( c5_23 * Er^2 ) + ( c5_24 * Ec^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
