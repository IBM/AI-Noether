ArchiveEntry "inelastic_collision_target1_combo2_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c9_4;
  Real c9_5;
  Real c9_6;
  Real c2_7;
  Real c2_8;
  Real c2_9;
  Real c9_10;
  Real c9_11;
  Real c9_12;
  Real c2_13;
  Real c2_14;
  Real c2_15;
  Real c9_16;
  Real c9_17;
  Real c9_18;
  Real c2_19;
  Real c2_20;
  Real c2_21;
  Real c9_22;
  Real c9_23;
  Real c9_24;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c9_4 \exists c9_5 \exists c9_6 \exists c2_7 \exists c2_8 \exists c2_9 \exists c9_10 \exists c9_11 \exists c9_12 \exists c2_13 \exists c2_14 \exists c2_15 \exists c9_16 \exists c9_17 \exists c9_18 \exists c2_19 \exists c2_20 \exists c2_21 \exists c9_22 \exists c9_23 \exists c9_24 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c9_4 > 0 & c9_5 > 0 & c9_6 > 0 & c2_7 > 0 & c2_8 > 0 & c2_9 > 0 & c9_10 > 0 & c9_11 > 0 & c9_12 > 0 & c2_13 > 0 & c2_14 > 0 & c2_15 > 0 & c9_16 > 0 & c9_17 > 0 & c9_18 > 0 & c2_19 > 0 & c2_20 > 0 & c2_21 > 0 & c9_22 > 0 & c9_23 > 0 & c9_24 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c9_4 * vc^2*pc^2 ) + ( c9_5 * vc^2*mc^2*c^2 ) + ( c9_6 * pc^2*c^2 ) = 0 )
            & ( ( c2_7 * Em^2 ) + ( c2_8 * mm^2*c^4 ) + ( c2_9 * pm^2*c^2 ) = 0 )
            & ( ( c9_10 * vc^2*pc^2 ) + ( c9_11 * vc^2*mc^2*c^2 ) + ( c9_12 * pc^2*c^2 ) = 0 )
            & ( ( c2_13 * Em^2 ) + ( c2_14 * mm^2*c^4 ) + ( c2_15 * pm^2*c^2 ) = 0 )
            & ( ( c9_16 * vc^2*pc^2 ) + ( c9_17 * vc^2*mc^2*c^2 ) + ( c9_18 * pc^2*c^2 ) = 0 )
            & ( ( c2_19 * Em^2 ) + ( c2_20 * mm^2*c^4 ) + ( c2_21 * pm^2*c^2 ) = 0 )
            & ( ( c9_22 * vc^2*pc^2 ) + ( c9_23 * vc^2*mc^2*c^2 ) + ( c9_24 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
