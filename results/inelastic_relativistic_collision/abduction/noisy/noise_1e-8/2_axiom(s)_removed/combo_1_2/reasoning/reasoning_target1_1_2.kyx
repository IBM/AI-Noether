ArchiveEntry "inelastic_collision_target1_combo1_2"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c2_4;
  Real c2_5;
  Real c2_6;
  Real c1_7;
  Real c1_8;
  Real c1_9;
  Real c2_10;
  Real c2_11;
  Real c2_12;
  Real c1_13;
  Real c1_14;
  Real c1_15;
  Real c2_16;
  Real c2_17;
  Real c2_18;
  Real c1_19;
  Real c1_20;
  Real c1_21;
  Real c2_22;
  Real c2_23;
  Real c2_24;
  Real c1_25;
  Real c1_26;
  Real c1_27;
  Real c2_28;
  Real c2_29;
  Real c2_30;
  Real c1_31;
  Real c1_32;
  Real c1_33;
  Real c2_34;
  Real c2_35;
  Real c2_36;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c2_4 \exists c2_5 \exists c2_6 \exists c1_7 \exists c1_8 \exists c1_9 \exists c2_10 \exists c2_11 \exists c2_12 \exists c1_13 \exists c1_14 \exists c1_15 \exists c2_16 \exists c2_17 \exists c2_18 \exists c1_19 \exists c1_20 \exists c1_21 \exists c2_22 \exists c2_23 \exists c2_24 \exists c1_25 \exists c1_26 \exists c1_27 \exists c2_28 \exists c2_29 \exists c2_30 \exists c1_31 \exists c1_32 \exists c1_33 \exists c2_34 \exists c2_35 \exists c2_36 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c1_7 > 0 & c1_8 > 0 & c1_9 > 0 & c2_10 > 0 & c2_11 > 0 & c2_12 > 0 & c1_13 > 0 & c1_14 > 0 & c1_15 > 0 & c2_16 > 0 & c2_17 > 0 & c2_18 > 0 & c1_19 > 0 & c1_20 > 0 & c1_21 > 0 & c2_22 > 0 & c2_23 > 0 & c2_24 > 0 & c1_25 > 0 & c1_26 > 0 & c1_27 > 0 & c2_28 > 0 & c2_29 > 0 & c2_30 > 0 & c1_31 > 0 & c1_32 > 0 & c1_33 > 0 & c2_34 > 0 & c2_35 > 0 & c2_36 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
            & ( ( c1_7 * vm^2*mm^2*c^2 ) + ( c1_8 * vm^2*pm^2 ) + ( c1_9 * pm^2*c^2 ) = 0 )
            & ( ( c2_10 * Em^2 ) + ( c2_11 * mm^2*c^4 ) + ( c2_12 * pm^2*c^2 ) = 0 )
            & ( ( c1_13 * vm^2*mm^2*c^2 ) + ( c1_14 * vm^2*pm^2 ) + ( c1_15 * pm^2*c^2 ) = 0 )
            & ( ( c2_16 * Em^2 ) + ( c2_17 * mm^2*c^4 ) + ( c2_18 * pm^2*c^2 ) = 0 )
            & ( ( c1_19 * vm^2*mm^2*c^2 ) + ( c1_20 * vm^2*pm^2 ) + ( c1_21 * pm^2*c^2 ) = 0 )
            & ( ( c2_22 * Em^2 ) + ( c2_23 * mm^2*c^4 ) + ( c2_24 * pm^2*c^2 ) = 0 )
            & ( ( c1_25 * vm^2*mm^2*c^2 ) + ( c1_26 * vm^2*pm^2 ) + ( c1_27 * pm^2*c^2 ) = 0 )
            & ( ( c2_28 * Em^2 ) + ( c2_29 * mm^2*c^4 ) + ( c2_30 * pm^2*c^2 ) = 0 )
            & ( ( c1_31 * vm^2*mm^2*c^2 ) + ( c1_32 * vm^2*pm^2 ) + ( c1_33 * pm^2*c^2 ) = 0 )
            & ( ( c2_34 * Em^2 ) + ( c2_35 * mm^2*c^4 ) + ( c2_36 * pm^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
