ArchiveEntry "inelastic_relativistic_collision_target1_combo2_6_7_ax2c6_ax6c1_ax7c4"

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    \exists c9
    \exists c10
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0 & c9>0 & c10>0
      &
      (
      \forall mr
      \forall vm
      \forall vc
      \forall pc
      \forall Em
      \forall Er
      \forall Ec
      \forall mc
      \forall mm
      \forall pm
      \forall c
          (
          (
            mr>0 & vm>0 & vc>0 & pc>0 & Em>0 & Er>0 & Ec>0 & mc>0 & mm>0 & pm>0 & c>0
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( c1 * 1.26258e ) = ( c2 * Em^2 ) + ( c3 * mm^2*c^4 ) + ( c4 * pm^2*c^2 )
            & ( c5 * pm ) = 0
            & ( c6 * 1.52325e ) = ( c7 * vm ) + ( c8 * c )
            )
        ->
          (
            ( c9 * mm^2*c^4 ) = ( c10 * 9*pm^2*c^2 )
          )
          )
      )
    )
  )
End.

End.