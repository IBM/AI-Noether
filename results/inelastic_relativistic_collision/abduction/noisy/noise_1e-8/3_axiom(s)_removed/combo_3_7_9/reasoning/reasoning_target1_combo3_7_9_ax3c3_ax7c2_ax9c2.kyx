ArchiveEntry "inelastic_relativistic_collision_target1_combo3_7_9_ax3c3_ax7c2_ax9c2"

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0
      &
      (
      \forall mr
      \forall vm
      \forall vc
      \forall pc
      \forall Em
      \forall Er
      \forall Ec
      \forall mc
      \forall mm
      \forall pm
      \forall c
          (
          (
            mr>0 & vm>0 & vc>0 & pc>0 & Em>0 & Er>0 & Ec>0 & mc>0 & mm>0 & pm>0 & c>0
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( mr - mm = 0 )
            & ( c1 * mr*c^2 ) = ( c2 * Er )
            & ( c3 * c ) = 0
            & ( c4 * pc^2*c^2 ) = 0
            )
        ->
          (
            ( c5 * mm^2*c^4 ) = ( c6 * 9*pm^2*c^2 )
          )
          )
      )
    )
  )
End.

End.