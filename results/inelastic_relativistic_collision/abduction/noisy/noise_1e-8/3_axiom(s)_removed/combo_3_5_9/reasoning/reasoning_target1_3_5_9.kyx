ArchiveEntry "inelastic_collision_target1_combo3_5_9"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c5_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c9_7;
  Real c9_8;
  Real c9_9;
  Real c3_10;
  Real c3_11;
  Real c5_12;
  Real c5_13;
  Real c5_14;
  Real c5_15;
  Real c9_16;
  Real c9_17;
  Real c9_18;
  Real c3_19;
  Real c3_20;
  Real c5_21;
  Real c5_22;
  Real c5_23;
  Real c5_24;
  Real c9_25;
  Real c9_26;
  Real c9_27;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c5_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c9_7 \exists c9_8 \exists c9_9 \exists c3_10 \exists c3_11 \exists c5_12 \exists c5_13 \exists c5_14 \exists c5_15 \exists c9_16 \exists c9_17 \exists c9_18 \exists c3_19 \exists c3_20 \exists c5_21 \exists c5_22 \exists c5_23 \exists c5_24 \exists c9_25 \exists c9_26 \exists c9_27 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c5_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c9_7 > 0 & c9_8 > 0 & c9_9 > 0 & c3_10 > 0 & c3_11 > 0 & c5_12 > 0 & c5_13 > 0 & c5_14 > 0 & c5_15 > 0 & c9_16 > 0 & c9_17 > 0 & c9_18 > 0 & c3_19 > 0 & c3_20 > 0 & c5_21 > 0 & c5_22 > 0 & c5_23 > 0 & c5_24 > 0 & c9_25 > 0 & c9_26 > 0 & c9_27 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c5_3 * Em^2 ) + ( c5_4 * Em*Er ) + ( c5_5 * Er^2 ) + ( c5_6 * Ec^2 ) = 0 )
            & ( ( c9_7 * vc^2*pc^2 ) + ( c9_8 * vc^2*mc^2*c^2 ) + ( c9_9 * pc^2*c^2 ) = 0 )
            & ( ( c3_10 * mr*c^2 ) + ( c3_11 * Er ) = 0 )
            & ( ( c5_12 * Em^2 ) + ( c5_13 * Em*Er ) + ( c5_14 * Er^2 ) + ( c5_15 * Ec^2 ) = 0 )
            & ( ( c9_16 * vc^2*pc^2 ) + ( c9_17 * vc^2*mc^2*c^2 ) + ( c9_18 * pc^2*c^2 ) = 0 )
            & ( ( c3_19 * mr*c^2 ) + ( c3_20 * Er ) = 0 )
            & ( ( c5_21 * Em^2 ) + ( c5_22 * Em*Er ) + ( c5_23 * Er^2 ) + ( c5_24 * Ec^2 ) = 0 )
            & ( ( c9_25 * vc^2*pc^2 ) + ( c9_26 * vc^2*mc^2*c^2 ) + ( c9_27 * pc^2*c^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
