ArchiveEntry "inelastic_collision_target1_combo1_3_7"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c1_1;
  Real c1_2;
  Real c1_3;
  Real c3_4;
  Real c3_5;
  Real c7_6;
  Real c7_7;
  Real c1_8;
  Real c1_9;
  Real c1_10;
  Real c3_11;
  Real c3_12;
  Real c7_13;
  Real c7_14;
  Real c1_15;
  Real c1_16;
  Real c1_17;
  Real c3_18;
  Real c3_19;
  Real c7_20;
  Real c7_21;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c1_3 \exists c3_4 \exists c3_5 \exists c7_6 \exists c7_7 \exists c1_8 \exists c1_9 \exists c1_10 \exists c3_11 \exists c3_12 \exists c7_13 \exists c7_14 \exists c1_15 \exists c1_16 \exists c1_17 \exists c3_18 \exists c3_19 \exists c7_20 \exists c7_21 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c3_4 > 0 & c3_5 > 0 & c7_6 > 0 & c7_7 > 0 & c1_8 > 0 & c1_9 > 0 & c1_10 > 0 & c3_11 > 0 & c3_12 > 0 & c7_13 > 0 & c7_14 > 0 & c1_15 > 0 & c1_16 > 0 & c1_17 > 0 & c3_18 > 0 & c3_19 > 0 & c7_20 > 0 & c7_21 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Ec^2 - (mc*c)^2 - (pc*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c3_4 * mr*c^2 ) + ( c3_5 * Er ) = 0 )
            & ( ( c7_6 * vm ) + ( c7_7 * c ) = 0 )
            & ( ( c1_8 * vm^2*mm^2*c^2 ) + ( c1_9 * vm^2*pm^2 ) + ( c1_10 * pm^2*c^2 ) = 0 )
            & ( ( c3_11 * mr*c^2 ) + ( c3_12 * Er ) = 0 )
            & ( ( c7_13 * vm ) + ( c7_14 * c ) = 0 )
            & ( ( c1_15 * vm^2*mm^2*c^2 ) + ( c1_16 * vm^2*pm^2 ) + ( c1_17 * pm^2*c^2 ) = 0 )
            & ( ( c3_18 * mr*c^2 ) + ( c3_19 * Er ) = 0 )
            & ( ( c7_20 * vm ) + ( c7_21 * c ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
