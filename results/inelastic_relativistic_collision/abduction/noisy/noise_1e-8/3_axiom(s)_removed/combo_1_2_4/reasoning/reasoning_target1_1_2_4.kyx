            & ( ( c2_13 * Em^2 ) + ( c2_14 * mm^2*c^4 ) + ( c2_15 * pm^2*c^2 ) = 0 )
            & ( ( c4_16 * pc^2*c^2 ) + ( c4_17 * Ec^2 ) + ( c4_18 * mc^2*c^2 ) = 0 )
            & ( ( c1_19 * vm^2*mm^2*c^2 ) + ( c1_20 * vm^2*pm^2 ) + ( c1_21 * pm^2*c^2 ) = 0 )
            & ( ( c2_22 * Em^2 ) + ( c2_23 * mm^2*c^4 ) + ( c2_24 * pm^2*c^2 ) = 0 )
            & ( ( c4_25 * pc^2*c^2 ) + ( c4_26 * Ec^2 ) + ( c4_27 * mc^2*c^2 ) = 0 )
            & ( ( c1_28 * vm^2*mm^2*c^2 ) + ( c1_29 * vm^2*pm^2 ) + ( c1_30 * pm^2*c^2 ) = 0 )
            & ( ( c2_31 * Em^2 ) + ( c2_32 * mm^2*c^4 ) + ( c2_33 * pm^2*c^2 ) = 0 )
            & ( ( c4_34 * pc^2*c^2 ) + ( c4_35 * Ec^2 ) + ( c4_36 * mc^2*c^2 ) = 0 )
            & ( ( c1_37 * vm^2*mm^2*c^2 ) + ( c1_38 * vm^2*pm^2 ) + ( c1_39 * pm^2*c^2 ) = 0 )
            & ( ( c2_40 * Em^2 ) + ( c2_41 * mm^2*c^4 ) + ( c2_42 * pm^2*c^2 ) = 0 )
            & ( ( c4_43 * pc^2*c^2 ) + ( c4_44 * Ec^2 ) + ( c4_45 * mc^2*c^2 ) = 0 )
            & ( ( c1_46 * vm^2*mm^2*c^2 ) + ( c1_47 * vm^2*pm^2 ) + ( c1_48 * pm^2*c^2 ) = 0 )
            & ( ( c2_49 * Em^2 ) + ( c2_50 * mm^2*c^4 ) + ( c2_51 * pm^2*c^2 ) = 0 )
            & ( ( c4_52 * pc^2*c^2 ) + ( c4_53 * Ec^2 ) + ( c4_54 * mc^2*c^2 ) = 0 )
            & ( ( c1_55 * vm^2*mm^2*c^2 ) + ( c1_56 * vm^2*pm^2 ) + ( c1_57 * pm^2*c^2 ) = 0 )
            & ( ( c2_58 * Em^2 ) + ( c2_59 * mm^2*c^4 ) + ( c2_60 * pm^2*c^2 ) = 0 )
            & ( ( c4_61 * pc^2*c^2 ) + ( c4_62 * Ec^2 ) + ( c4_63 * mc^2*c^2 ) = 0 )
            & ( ( c1_64 * vm^2*mm^2*c^2 ) + ( c1_65 * vm^2*pm^2 ) + ( c1_66 * pm^2*c^2 ) = 0 )
            & ( ( c2_67 * Em^2 ) + ( c2_68 * mm^2*c^4 ) + ( c2_69 * pm^2*c^2 ) = 0 )
            & ( ( c4_70 * pc^2*c^2 ) + ( c4_71 * Ec^2 ) + ( c4_72 * mc^2*c^2 ) = 0 )
          )
          ->
