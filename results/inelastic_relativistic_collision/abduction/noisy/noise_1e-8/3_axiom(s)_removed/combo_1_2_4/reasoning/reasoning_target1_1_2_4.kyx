    (
      c1_1 > 0 & c1_2 > 0 & c1_3 > 0 & c2_4 > 0 & c2_5 > 0 & c2_6 > 0 & c4_7 > 0 & c4_8 > 0 & c4_9 > 0 & c1_10 > 0 & c1_11 > 0 & c1_12 > 0 & c2_13 > 0 & c2_14 > 0 & c2_15 > 0 & c4_16 > 0 & c4_17 > 0 & c4_18 > 0 & c1_19 > 0 & c1_20 > 0 & c1_21 > 0 & c2_22 > 0 & c2_23 > 0 & c2_24 > 0 & c4_25 > 0 & c4_26 > 0 & c4_27 > 0 & c1_28 > 0 & c1_29 > 0 & c1_30 > 0 & c2_31 > 0 & c2_32 > 0 & c2_33 > 0 & c4_34 > 0 & c4_35 > 0 & c4_36 > 0 & c1_37 > 0 & c1_38 > 0 & c1_39 > 0 & c2_40 > 0 & c2_41 > 0 & c2_42 > 0 & c4_43 > 0 & c4_44 > 0 & c4_45 > 0 & c1_46 > 0 & c1_47 > 0 & c1_48 > 0 & c2_49 > 0 & c2_50 > 0 & c2_51 > 0 & c4_52 > 0 & c4_53 > 0 & c4_54 > 0 & c1_55 > 0 & c1_56 > 0 & c1_57 > 0 & c2_58 > 0 & c2_59 > 0 & c2_60 > 0 & c4_61 > 0 & c4_62 > 0 & c4_63 > 0 & c1_64 > 0 & c1_65 > 0 & c1_66 > 0 & c2_67 > 0 & c2_68 > 0 & c2_69 > 0 & c4_70 > 0 & c4_71 > 0 & c4_72 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( Er - mr*c^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c1_1 * vm^2*mm^2*c^2 ) + ( c1_2 * vm^2*pm^2 ) + ( c1_3 * pm^2*c^2 ) = 0 )
            & ( ( c2_4 * Em^2 ) + ( c2_5 * mm^2*c^4 ) + ( c2_6 * pm^2*c^2 ) = 0 )
