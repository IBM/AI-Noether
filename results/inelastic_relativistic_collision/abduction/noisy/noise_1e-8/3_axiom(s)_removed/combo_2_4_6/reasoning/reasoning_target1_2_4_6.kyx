ArchiveEntry "inelastic_collision_target1_combo2_4_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c4_4;
  Real c4_5;
  Real c4_6;
  Real c6_7;
  Real c6_8;
  Real c2_9;
  Real c2_10;
  Real c2_11;
  Real c4_12;
  Real c4_13;
  Real c4_14;
  Real c6_15;
  Real c6_16;
  Real c2_17;
  Real c2_18;
  Real c2_19;
  Real c4_20;
  Real c4_21;
  Real c4_22;
  Real c6_23;
  Real c6_24;
  Real c2_25;
  Real c2_26;
  Real c2_27;
  Real c4_28;
  Real c4_29;
  Real c4_30;
  Real c6_31;
  Real c6_32;
  Real c2_33;
  Real c2_34;
  Real c2_35;
  Real c4_36;
  Real c4_37;
  Real c4_38;
  Real c6_39;
  Real c6_40;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c4_4 \exists c4_5 \exists c4_6 \exists c6_7 \exists c6_8 \exists c2_9 \exists c2_10 \exists c2_11 \exists c4_12 \exists c4_13 \exists c4_14 \exists c6_15 \exists c6_16 \exists c2_17 \exists c2_18 \exists c2_19 \exists c4_20 \exists c4_21 \exists c4_22 \exists c6_23 \exists c6_24 \exists c2_25 \exists c2_26 \exists c2_27 \exists c4_28 \exists c4_29 \exists c4_30 \exists c6_31 \exists c6_32 \exists c2_33 \exists c2_34 \exists c2_35 \exists c4_36 \exists c4_37 \exists c4_38 \exists c6_39 \exists c6_40 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c4_4 > 0 & c4_5 > 0 & c4_6 > 0 & c6_7 > 0 & c6_8 > 0 & c2_9 > 0 & c2_10 > 0 & c2_11 > 0 & c4_12 > 0 & c4_13 > 0 & c4_14 > 0 & c6_15 > 0 & c6_16 > 0 & c2_17 > 0 & c2_18 > 0 & c2_19 > 0 & c4_20 > 0 & c4_21 > 0 & c4_22 > 0 & c6_23 > 0 & c6_24 > 0 & c2_25 > 0 & c2_26 > 0 & c2_27 > 0 & c4_28 > 0 & c4_29 > 0 & c4_30 > 0 & c6_31 > 0 & c6_32 > 0 & c2_33 > 0 & c2_34 > 0 & c2_35 > 0 & c4_36 > 0 & c4_37 > 0 & c4_38 > 0 & c6_39 > 0 & c6_40 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c4_4 * pc^2*c^2 ) + ( c4_5 * Ec^2 ) + ( c4_6 * mc^2*c^2 ) = 0 )
            & ( ( c6_7 * pc ) + ( c6_8 * pm ) = 0 )
            & ( ( c2_9 * Em^2 ) + ( c2_10 * mm^2*c^4 ) + ( c2_11 * pm^2*c^2 ) = 0 )
            & ( ( c4_12 * pc^2*c^2 ) + ( c4_13 * Ec^2 ) + ( c4_14 * mc^2*c^2 ) = 0 )
            & ( ( c6_15 * pc ) + ( c6_16 * pm ) = 0 )
            & ( ( c2_17 * Em^2 ) + ( c2_18 * mm^2*c^4 ) + ( c2_19 * pm^2*c^2 ) = 0 )
            & ( ( c4_20 * pc^2*c^2 ) + ( c4_21 * Ec^2 ) + ( c4_22 * mc^2*c^2 ) = 0 )
            & ( ( c6_23 * pc ) + ( c6_24 * pm ) = 0 )
            & ( ( c2_25 * Em^2 ) + ( c2_26 * mm^2*c^4 ) + ( c2_27 * pm^2*c^2 ) = 0 )
            & ( ( c4_28 * pc^2*c^2 ) + ( c4_29 * Ec^2 ) + ( c4_30 * mc^2*c^2 ) = 0 )
            & ( ( c6_31 * pc ) + ( c6_32 * pm ) = 0 )
            & ( ( c2_33 * Em^2 ) + ( c2_34 * mm^2*c^4 ) + ( c2_35 * pm^2*c^2 ) = 0 )
            & ( ( c4_36 * pc^2*c^2 ) + ( c4_37 * Ec^2 ) + ( c4_38 * mc^2*c^2 ) = 0 )
            & ( ( c6_39 * pc ) + ( c6_40 * pm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
