ArchiveEntry "inelastic_collision_target1_combo3_4_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c8_6;
  Real c8_7;
  Real c3_8;
  Real c3_9;
  Real c4_10;
  Real c4_11;
  Real c4_12;
  Real c8_13;
  Real c8_14;
  Real c3_15;
  Real c3_16;
  Real c4_17;
  Real c4_18;
  Real c4_19;
  Real c8_20;
  Real c8_21;
  Real c3_22;
  Real c3_23;
  Real c4_24;
  Real c4_25;
  Real c4_26;
  Real c8_27;
  Real c8_28;
  Real c3_29;
  Real c3_30;
  Real c4_31;
  Real c4_32;
  Real c4_33;
  Real c8_34;
  Real c8_35;
  Real c3_36;
  Real c3_37;
  Real c4_38;
  Real c4_39;
  Real c4_40;
  Real c8_41;
  Real c8_42;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c8_6 \exists c8_7 \exists c3_8 \exists c3_9 \exists c4_10 \exists c4_11 \exists c4_12 \exists c8_13 \exists c8_14 \exists c3_15 \exists c3_16 \exists c4_17 \exists c4_18 \exists c4_19 \exists c8_20 \exists c8_21 \exists c3_22 \exists c3_23 \exists c4_24 \exists c4_25 \exists c4_26 \exists c8_27 \exists c8_28 \exists c3_29 \exists c3_30 \exists c4_31 \exists c4_32 \exists c4_33 \exists c8_34 \exists c8_35 \exists c3_36 \exists c3_37 \exists c4_38 \exists c4_39 \exists c4_40 \exists c8_41 \exists c8_42 \exists d1 \exists d2
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c8_6 > 0 & c8_7 > 0 & c3_8 > 0 & c3_9 > 0 & c4_10 > 0 & c4_11 > 0 & c4_12 > 0 & c8_13 > 0 & c8_14 > 0 & c3_15 > 0 & c3_16 > 0 & c4_17 > 0 & c4_18 > 0 & c4_19 > 0 & c8_20 > 0 & c8_21 > 0 & c3_22 > 0 & c3_23 > 0 & c4_24 > 0 & c4_25 > 0 & c4_26 > 0 & c8_27 > 0 & c8_28 > 0 & c3_29 > 0 & c3_30 > 0 & c4_31 > 0 & c4_32 > 0 & c4_33 > 0 & c8_34 > 0 & c8_35 > 0 & c3_36 > 0 & c3_37 > 0 & c4_38 > 0 & c4_39 > 0 & c4_40 > 0 & c8_41 > 0 & c8_42 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c3_1 * mr*c^2 ) + ( c3_2 * Er ) = 0 )
            & ( ( c4_3 * pc^2*c^2 ) + ( c4_4 * Ec^2 ) + ( c4_5 * mc^2*c^2 ) = 0 )
            & ( ( c8_6 * mr ) + ( c8_7 * mm ) = 0 )
            & ( ( c3_8 * mr*c^2 ) + ( c3_9 * Er ) = 0 )
            & ( ( c4_10 * pc^2*c^2 ) + ( c4_11 * Ec^2 ) + ( c4_12 * mc^2*c^2 ) = 0 )
            & ( ( c8_13 * mr ) + ( c8_14 * mm ) = 0 )
            & ( ( c3_15 * mr*c^2 ) + ( c3_16 * Er ) = 0 )
            & ( ( c4_17 * pc^2*c^2 ) + ( c4_18 * Ec^2 ) + ( c4_19 * mc^2*c^2 ) = 0 )
            & ( ( c8_20 * mr ) + ( c8_21 * mm ) = 0 )
            & ( ( c3_22 * mr*c^2 ) + ( c3_23 * Er ) = 0 )
            & ( ( c4_24 * pc^2*c^2 ) + ( c4_25 * Ec^2 ) + ( c4_26 * mc^2*c^2 ) = 0 )
            & ( ( c8_27 * mr ) + ( c8_28 * mm ) = 0 )
            & ( ( c3_29 * mr*c^2 ) + ( c3_30 * Er ) = 0 )
            & ( ( c4_31 * pc^2*c^2 ) + ( c4_32 * Ec^2 ) + ( c4_33 * mc^2*c^2 ) = 0 )
            & ( ( c8_34 * mr ) + ( c8_35 * mm ) = 0 )
            & ( ( c3_36 * mr*c^2 ) + ( c3_37 * Er ) = 0 )
            & ( ( c4_38 * pc^2*c^2 ) + ( c4_39 * Ec^2 ) + ( c4_40 * mc^2*c^2 ) = 0 )
            & ( ( c8_41 * mr ) + ( c8_42 * mm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
