ArchiveEntry "inelastic_collision_target1_combo4_8"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c4_1;
  Real c4_2;
  Real c4_3;
  Real c8_4;
  Real c8_5;
  Real c4_6;
  Real c4_7;
  Real c4_8;
  Real c8_9;
  Real c8_10;
  Real c4_11;
  Real c4_12;
  Real c4_13;
  Real c8_14;
  Real c8_15;
  Real c4_16;
  Real c4_17;
  Real c4_18;
  Real c8_19;
  Real c8_20;
  Real c4_21;
  Real c4_22;
  Real c4_23;
  Real c8_24;
  Real c8_25;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c4_3 \exists c8_4 \exists c8_5 \exists c4_6 \exists c4_7 \exists c4_8 \exists c8_9 \exists c8_10 \exists c4_11 \exists c4_12 \exists c4_13 \exists c8_14 \exists c8_15 \exists c4_16 \exists c4_17 \exists c4_18 \exists c8_19 \exists c8_20 \exists c4_21 \exists c4_22 \exists c4_23 \exists c8_24 \exists c8_25 \exists d1 \exists d2
    (
      c4_1 > 0 & c4_2 > 0 & c4_3 > 0 & c8_4 > 0 & c8_5 > 0 & c4_6 > 0 & c4_7 > 0 & c4_8 > 0 & c8_9 > 0 & c8_10 > 0 & c4_11 > 0 & c4_12 > 0 & c4_13 > 0 & c8_14 > 0 & c8_15 > 0 & c4_16 > 0 & c4_17 > 0 & c4_18 > 0 & c8_19 > 0 & c8_20 > 0 & c4_21 > 0 & c4_22 > 0 & c4_23 > 0 & c8_24 > 0 & c8_25 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Em^2 - (mm*c^2)^2 - (pm*c)^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( 2*Em*Er - Ec^2 + Em^2 + Er^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c4_1 * pc^2*c^2 ) + ( c4_2 * Ec^2 ) + ( c4_3 * mc^2*c^2 ) = 0 )
            & ( ( c8_4 * mr ) + ( c8_5 * mm ) = 0 )
            & ( ( c4_6 * pc^2*c^2 ) + ( c4_7 * Ec^2 ) + ( c4_8 * mc^2*c^2 ) = 0 )
            & ( ( c8_9 * mr ) + ( c8_10 * mm ) = 0 )
            & ( ( c4_11 * pc^2*c^2 ) + ( c4_12 * Ec^2 ) + ( c4_13 * mc^2*c^2 ) = 0 )
            & ( ( c8_14 * mr ) + ( c8_15 * mm ) = 0 )
            & ( ( c4_16 * pc^2*c^2 ) + ( c4_17 * Ec^2 ) + ( c4_18 * mc^2*c^2 ) = 0 )
            & ( ( c8_19 * mr ) + ( c8_20 * mm ) = 0 )
            & ( ( c4_21 * pc^2*c^2 ) + ( c4_22 * Ec^2 ) + ( c4_23 * mc^2*c^2 ) = 0 )
            & ( ( c8_24 * mr ) + ( c8_25 * mm ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
