ArchiveEntry "inelastic_collision_target1_combo2_4_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real mr;
  Real vm;
  Real vc;
  Real pc;
  Real Em;
  Real Er;
  Real Ec;
  Real mc;
  Real mm;
  Real pm;
  Real c;
  Real c2_1;
  Real c2_2;
  Real c2_3;
  Real c4_4;
  Real c4_5;
  Real c4_6;
  Real c5_7;
  Real c5_8;
  Real c5_9;
  Real c5_10;
  Real c2_11;
  Real c2_12;
  Real c2_13;
  Real c4_14;
  Real c4_15;
  Real c4_16;
  Real c5_17;
  Real c5_18;
  Real c5_19;
  Real c5_20;
  Real c2_21;
  Real c2_22;
  Real c2_23;
  Real c4_24;
  Real c4_25;
  Real c4_26;
  Real c5_27;
  Real c5_28;
  Real c5_29;
  Real c5_30;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c2_3 \exists c4_4 \exists c4_5 \exists c4_6 \exists c5_7 \exists c5_8 \exists c5_9 \exists c5_10 \exists c2_11 \exists c2_12 \exists c2_13 \exists c4_14 \exists c4_15 \exists c4_16 \exists c5_17 \exists c5_18 \exists c5_19 \exists c5_20 \exists c2_21 \exists c2_22 \exists c2_23 \exists c4_24 \exists c4_25 \exists c4_26 \exists c5_27 \exists c5_28 \exists c5_29 \exists c5_30 \exists d1 \exists d2
    (
      c2_1 > 0 & c2_2 > 0 & c2_3 > 0 & c4_4 > 0 & c4_5 > 0 & c4_6 > 0 & c5_7 > 0 & c5_8 > 0 & c5_9 > 0 & c5_10 > 0 & c2_11 > 0 & c2_12 > 0 & c2_13 > 0 & c4_14 > 0 & c4_15 > 0 & c4_16 > 0 & c5_17 > 0 & c5_18 > 0 & c5_19 > 0 & c5_20 > 0 & c2_21 > 0 & c2_22 > 0 & c2_23 > 0 & c4_24 > 0 & c4_25 > 0 & c4_26 > 0 & c5_27 > 0 & c5_28 > 0 & c5_29 > 0 & c5_30 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall mr \forall vm \forall vc \forall pc \forall Em \forall Er \forall Ec \forall mc \forall mm \forall pm \forall c
        (
          (
            (mr > 0 & vm > 0 & vc > 0 & pc > 0 & Em > 0 & Er > 0 & Ec > 0 & mc > 0 & mm > 0 & pm > 0 & c > 0) &
            & ( pm^2*(c^2 - vm^2) - mm^2*vm^2*c^2 = 0 )
            & ( Er - mr*c^2 = 0 )
            & ( pc - pm = 0 )
            & ( vm - 4/5*c = 0 )
            & ( mr - mm = 0 )
            & ( pc^2*(c^2 - vc^2) - mc^2*vc^2*c^2 = 0 )
            & ( ( c2_1 * Em^2 ) + ( c2_2 * mm^2*c^4 ) + ( c2_3 * pm^2*c^2 ) = 0 )
            & ( ( c4_4 * pc^2*c^2 ) + ( c4_5 * Ec^2 ) + ( c4_6 * mc^2*c^2 ) = 0 )
            & ( ( c5_7 * Em^2 ) + ( c5_8 * Em*Er ) + ( c5_9 * Er^2 ) + ( c5_10 * Ec^2 ) = 0 )
            & ( ( c2_11 * Em^2 ) + ( c2_12 * mm^2*c^4 ) + ( c2_13 * pm^2*c^2 ) = 0 )
            & ( ( c4_14 * pc^2*c^2 ) + ( c4_15 * Ec^2 ) + ( c4_16 * mc^2*c^2 ) = 0 )
            & ( ( c5_17 * Em^2 ) + ( c5_18 * Em*Er ) + ( c5_19 * Er^2 ) + ( c5_20 * Ec^2 ) = 0 )
            & ( ( c2_21 * Em^2 ) + ( c2_22 * mm^2*c^4 ) + ( c2_23 * pm^2*c^2 ) = 0 )
            & ( ( c4_24 * pc^2*c^2 ) + ( c4_25 * Ec^2 ) + ( c4_26 * mc^2*c^2 ) = 0 )
            & ( ( c5_27 * Em^2 ) + ( c5_28 * Em*Er ) + ( c5_29 * Er^2 ) + ( c5_30 * Ec^2 ) = 0 )
          )
          ->
          (
            ( d1 * mm^2*c^4 ) + ( d2 * pm^2*c^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
