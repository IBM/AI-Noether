            & ( ( c4_196 * c^2*dt^2 ) + ( c4_197 * dt^2*v^2 ) + ( c4_198 * L0^2 ) = 0 )
            & ( ( c6_199 * dt*u ) + ( c6_200 * dt0*u0 ) = 0 )
            & ( ( c4_201 * c^2*dt^2 ) + ( c4_202 * dt^2*v^2 ) + ( c4_203 * L0^2 ) = 0 )
            & ( ( c6_204 * dt*u ) + ( c6_205 * dt0*u0 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*F0^2 ) + ( d2 * c^2*F^2 ) + ( d3 * v^2*F0^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
