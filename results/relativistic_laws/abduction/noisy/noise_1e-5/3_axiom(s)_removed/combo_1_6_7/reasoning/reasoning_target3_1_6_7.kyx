/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real c;
  Real dt;
  Real v;
  Real F0;
  Real F;
  Real dt0;
  Real L0;
  Real L;
  Real m0;
  Real u0;
  Real m;
  Real u;
  Real c6_1;
  Real c6_2;
  Real c7_3;
  Real c7_4;
  Real c7_5;
  Real c1_6;
  Real c1_7;
  Real c6_8;
  Real c6_9;
  Real c7_10;
  Real c7_11;
  Real c7_12;
  Real c1_13;
  Real c1_14;
  Real c6_15;
  Real c6_16;
  Real c7_17;
  Real c7_18;
  Real c7_19;
  Real c6_20;
  Real c6_21;
  Real c7_22;
  Real c7_23;
  Real c7_24;
  Real c6_25;
  Real c6_26;
  Real c7_27;
  Real c7_28;
  Real c7_29;
  Real d1;
  Real d2;
  Real d3;
End.

Problem
  (
    \exists c6_1 \exists c6_2 \exists c7_3 \exists c7_4 \exists c7_5 \exists c1_6 \exists c1_7 \exists c6_8 \exists c6_9 \exists c7_10 \exists c7_11 \exists c7_12 \exists c1_13 \exists c1_14 \exists c6_15 \exists c6_16 \exists c7_17 \exists c7_18 \exists c7_19 \exists c6_20 \exists c6_21 \exists c7_22 \exists c7_23 \exists c7_24 \exists c6_25 \exists c6_26 \exists c7_27 \exists c7_28 \exists c7_29 \exists d1 \exists d2 \exists d3
    (
      c6_1 > 0 & c6_2 > 0 & c7_3 > 0 & c7_4 > 0 & c7_5 > 0 & c1_6 > 0 & c1_7 > 0 & c6_8 > 0 & c6_9 > 0 & c7_10 > 0 & c7_11 > 0 & c7_12 > 0 & c1_13 > 0 & c1_14 > 0 & c6_15 > 0 & c6_16 > 0 & c7_17 > 0 & c7_18 > 0 & c7_19 > 0 & c6_20 > 0 & c6_21 > 0 & c7_22 > 0 & c7_23 > 0 & c7_24 > 0 & c6_25 > 0 & c6_26 > 0 & c7_27 > 0 & c7_28 > 0 & c7_29 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c \forall dt \forall v \forall F0 \forall F \forall dt0 \forall L0 \forall L \forall m0 \forall u0 \forall m \forall u
        (
          (
            (c > 0 & dt > 0 & v > 0 & F0 > 0 & F > 0 & dt0 > 0 & L0 > 0 & L > 0 & m0 > 0 & u0 > 0 & m > 0 & u > 0) &
            & ( F*dt - 1 = 0 )
            & ( c*dt0 - 2*L0 = 0 )
            & ( c^2*dt^2 - 4*L0^2 - v^2*dt^2 = 0 )
            & ( m0*u0 - m*u = 0 )
            & ( ( c6_1 * dt*u ) + ( c6_2 * dt0*u0 ) = 0 )
            & ( ( c7_3 * c^2*dt ) + ( c7_4 * c*L ) + ( c7_5 * dt*v^2 ) = 0 )
            & ( ( c1_6 * F0*dt0 ) + ( c1_7 * 1 ) = 0 )
            & ( ( c6_8 * dt*u ) + ( c6_9 * dt0*u0 ) = 0 )
            & ( ( c7_10 * c^2*dt ) + ( c7_11 * c*L ) + ( c7_12 * dt*v^2 ) = 0 )
            & ( ( c1_13 * F0*dt0 ) + ( c1_14 * 1 ) = 0 )
            & ( ( c6_15 * dt*u ) + ( c6_16 * dt0*u0 ) = 0 )
            & ( ( c7_17 * c^2*dt ) + ( c7_18 * c*L ) + ( c7_19 * dt*v^2 ) = 0 )
            & ( ( c6_20 * dt*u ) + ( c6_21 * dt0*u0 ) = 0 )
            & ( ( c7_22 * c^2*dt ) + ( c7_23 * c*L ) + ( c7_24 * dt*v^2 ) = 0 )
            & ( ( c6_25 * dt*u ) + ( c6_26 * dt0*u0 ) = 0 )
            & ( ( c7_27 * c^2*dt ) + ( c7_28 * c*L ) + ( c7_29 * dt*v^2 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*L0^2 ) + ( d2 * c^2*L^2 ) + ( d3 * v^2*L0^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
