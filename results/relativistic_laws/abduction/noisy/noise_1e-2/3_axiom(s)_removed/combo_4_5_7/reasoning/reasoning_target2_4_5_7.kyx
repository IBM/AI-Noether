/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real c;
  Real dt;
  Real v;
  Real F0;
  Real F;
  Real dt0;
  Real L0;
  Real L;
  Real m0;
  Real u0;
  Real m;
  Real u;
  Real c4_1;
  Real c4_2;
  Real c4_3;
  Real c5_4;
  Real c5_5;
  Real c7_6;
  Real c7_7;
  Real c7_8;
  Real c4_9;
  Real c4_10;
  Real c4_11;
  Real c5_12;
  Real c5_13;
  Real c7_14;
  Real c7_15;
  Real c7_16;
  Real c4_17;
  Real c4_18;
  Real c4_19;
  Real c5_20;
  Real c5_21;
  Real c7_22;
  Real c7_23;
  Real c7_24;
  Real c4_25;
  Real c4_26;
  Real c4_27;
  Real c5_28;
  Real c5_29;
  Real c7_30;
  Real c7_31;
  Real c7_32;
  Real d1;
  Real d2;
  Real d3;
End.

Problem
  (
    \exists c4_1 \exists c4_2 \exists c4_3 \exists c5_4 \exists c5_5 \exists c7_6 \exists c7_7 \exists c7_8 \exists c4_9 \exists c4_10 \exists c4_11 \exists c5_12 \exists c5_13 \exists c7_14 \exists c7_15 \exists c7_16 \exists c4_17 \exists c4_18 \exists c4_19 \exists c5_20 \exists c5_21 \exists c7_22 \exists c7_23 \exists c7_24 \exists c4_25 \exists c4_26 \exists c4_27 \exists c5_28 \exists c5_29 \exists c7_30 \exists c7_31 \exists c7_32 \exists d1 \exists d2 \exists d3
    (
      c4_1 > 0 & c4_2 > 0 & c4_3 > 0 & c5_4 > 0 & c5_5 > 0 & c7_6 > 0 & c7_7 > 0 & c7_8 > 0 & c4_9 > 0 & c4_10 > 0 & c4_11 > 0 & c5_12 > 0 & c5_13 > 0 & c7_14 > 0 & c7_15 > 0 & c7_16 > 0 & c4_17 > 0 & c4_18 > 0 & c4_19 > 0 & c5_20 > 0 & c5_21 > 0 & c7_22 > 0 & c7_23 > 0 & c7_24 > 0 & c4_25 > 0 & c4_26 > 0 & c4_27 > 0 & c5_28 > 0 & c5_29 > 0 & c7_30 > 0 & c7_31 > 0 & c7_32 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c \forall dt \forall v \forall F0 \forall F \forall dt0 \forall L0 \forall L \forall m0 \forall u0 \forall m \forall u
        (
          (
            (c > 0 & dt > 0 & v > 0 & F0 > 0 & F > 0 & dt0 > 0 & L0 > 0 & L > 0 & m0 > 0 & u0 > 0 & m > 0 & u > 0) &
            & ( F0*dt0 - 1 = 0 )
            & ( F*dt - 1 = 0 )
            & ( c*dt0 - 2*L0 = 0 )
            & ( u0*dt0 - u*dt = 0 )
            & ( ( c4_1 * c^2*dt^2 ) + ( c4_2 * dt^2*v^2 ) + ( c4_3 * L0^2 ) = 0 )
            & ( ( c5_4 * m0*u0 ) + ( c5_5 * m*u ) = 0 )
            & ( ( c7_6 * c^2*dt ) + ( c7_7 * c*L ) + ( c7_8 * dt*v^2 ) = 0 )
            & ( ( c4_9 * c^2*dt^2 ) + ( c4_10 * dt^2*v^2 ) + ( c4_11 * L0^2 ) = 0 )
            & ( ( c5_12 * m0*u0 ) + ( c5_13 * m*u ) = 0 )
            & ( ( c7_14 * c^2*dt ) + ( c7_15 * c*L ) + ( c7_16 * dt*v^2 ) = 0 )
            & ( ( c4_17 * c^2*dt^2 ) + ( c4_18 * dt^2*v^2 ) + ( c4_19 * L0^2 ) = 0 )
            & ( ( c5_20 * m0*u0 ) + ( c5_21 * m*u ) = 0 )
            & ( ( c7_22 * c^2*dt ) + ( c7_23 * c*L ) + ( c7_24 * dt*v^2 ) = 0 )
            & ( ( c4_25 * c^2*dt^2 ) + ( c4_26 * dt^2*v^2 ) + ( c4_27 * L0^2 ) = 0 )
            & ( ( c5_28 * m0*u0 ) + ( c5_29 * m*u ) = 0 )
            & ( ( c7_30 * c^2*dt ) + ( c7_31 * c*L ) + ( c7_32 * dt*v^2 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*m0^2*u0 ) + ( d2 * c^2*u0*m^2 ) + ( d3 * v^2*u0*m^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
