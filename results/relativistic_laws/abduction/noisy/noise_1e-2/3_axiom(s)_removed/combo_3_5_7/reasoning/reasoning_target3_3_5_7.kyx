Problem
  (
    \exists c3_1 \exists c3_2 \exists c5_3 \exists c5_4 \exists c7_5 \exists c7_6 \exists c7_7 \exists c3_8 \exists c3_9 \exists c5_10 \exists c5_11 \exists c7_12 \exists c7_13 \exists c7_14 \exists c3_15 \exists c3_16 \exists c5_17 \exists c5_18 \exists c7_19 \exists c7_20 \exists c7_21 \exists c3_22 \exists c3_23 \exists c5_24 \exists c5_25 \exists c7_26 \exists c7_27 \exists c7_28 \exists c3_29 \exists c3_30 \exists c5_31 \exists c5_32 \exists c7_33 \exists c7_34 \exists c7_35 \exists c3_36 \exists c3_37 \exists c5_38 \exists c5_39 \exists c7_40 \exists c7_41 \exists c7_42 \exists d1 \exists d2 \exists d3
    (
      c3_1 > 0 & c3_2 > 0 & c5_3 > 0 & c5_4 > 0 & c7_5 > 0 & c7_6 > 0 & c7_7 > 0 & c3_8 > 0 & c3_9 > 0 & c5_10 > 0 & c5_11 > 0 & c7_12 > 0 & c7_13 > 0 & c7_14 > 0 & c3_15 > 0 & c3_16 > 0 & c5_17 > 0 & c5_18 > 0 & c7_19 > 0 & c7_20 > 0 & c7_21 > 0 & c3_22 > 0 & c3_23 > 0 & c5_24 > 0 & c5_25 > 0 & c7_26 > 0 & c7_27 > 0 & c7_28 > 0 & c3_29 > 0 & c3_30 > 0 & c5_31 > 0 & c5_32 > 0 & c7_33 > 0 & c7_34 > 0 & c7_35 > 0 & c3_36 > 0 & c3_37 > 0 & c5_38 > 0 & c5_39 > 0 & c7_40 > 0 & c7_41 > 0 & c7_42 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c \forall dt \forall v \forall F0 \forall F \forall dt0 \forall L0 \forall L \forall m0 \forall u0 \forall m \forall u
        (
          (
