            & ( ( c2_201 * dt*F ) + ( c2_202 * 1 ) = 0 )
            & ( ( c3_203 * c*dt0 ) + ( c3_204 * L0 ) = 0 )
            & ( ( c3_205 * c*dt0 ) + ( c3_206 * L0 ) = 0 )
            & ( ( c2_207 * dt*F ) + ( c2_208 * 1 ) = 0 )
            & ( ( c3_209 * c*dt0 ) + ( c3_210 * L0 ) = 0 )
            & ( ( c2_211 * dt*F ) + ( c2_212 * 1 ) = 0 )
            & ( ( c3_213 * c*dt0 ) + ( c3_214 * L0 ) = 0 )
            & ( ( c1_215 * F0*dt0 ) + ( c1_216 * 1 ) = 0 )
            & ( ( c3_217 * c*dt0 ) + ( c3_218 * L0 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*m0^2*u0 ) + ( d2 * c^2*u0*m^2 ) + ( d3 * v^2*u0*m^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
