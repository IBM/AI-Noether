ArchiveEntry "relativistic_laws_target1_combo1_3_4_ax1c2_ax3c5_ax4c1"

ProgramVariables
  Real c;
  Real dt;
  Real v;
  Real F0;
  Real F;
  Real dt0;
  Real L0;
  Real L;
  Real m0;
  Real u0;
  Real m;
  Real u;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    \exists c9
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0 & c9>0
      &
      (
      \forall c
      \forall dt
      \forall v
      \forall F0
      \forall F
      \forall dt0
      \forall L0
      \forall L
      \forall m0
      \forall u0
      \forall m
      \forall u
          (
          (
            c>0 & dt>0 & v>0 & F0>0 & F>0 & dt0>0 & L0>0 & L>0 & m0>0 & u0>0 & m>0 & u>0
            & ( F*dt - 1 = 0 )
            & ( m0*u0 - m*u = 0 )
            & ( u0*dt0 - u*dt = 0 )
            & ( dt*(c^2 - v^2) - 2*L*c = 0 )
            & ( c1 * F0*dt0 ) = ( c2 * 1 )
            & ( c3 * c*dt0 ) = 0
            & ( c4 * c^2*dt^2 ) = ( c5 * dt^2*v^2 ) + ( c6 * L0^2 )
            )
        ->
          (
            ( c7 * c^2*F0^2 ) = ( c8 * c^2*F^2 ) + ( c9 * F0^2*v^2 )
          )
          )
      )
    )
  )
End.

End.