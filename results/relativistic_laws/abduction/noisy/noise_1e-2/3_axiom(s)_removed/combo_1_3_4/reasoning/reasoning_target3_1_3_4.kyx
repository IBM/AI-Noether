ArchiveEntry "relativistic_laws_updated_target3_combo1_3_4"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real c;
  Real dt;
  Real v;
  Real F0;
  Real F;
  Real dt0;
  Real L0;
  Real L;
  Real m0;
  Real u0;
  Real m;
  Real u;
  Real c3_1;
  Real c3_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c1_6;
  Real c1_7;
  Real c3_8;
  Real c3_9;
  Real c4_10;
  Real c4_11;
  Real c4_12;
  Real c1_13;
  Real c1_14;
  Real c3_15;
  Real c3_16;
  Real c4_17;
  Real c4_18;
  Real c4_19;
  Real c1_20;
  Real c1_21;
  Real c3_22;
  Real c3_23;
  Real c4_24;
  Real c4_25;
  Real c4_26;
  Real c1_27;
  Real c1_28;
  Real c3_29;
  Real c3_30;
  Real c4_31;
  Real c4_32;
  Real c4_33;
  Real c3_34;
  Real c3_35;
  Real c4_36;
  Real c4_37;
  Real c4_38;
  Real d1;
  Real d2;
  Real d3;
End.

Problem
  (
    \exists c3_1 \exists c3_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c1_6 \exists c1_7 \exists c3_8 \exists c3_9 \exists c4_10 \exists c4_11 \exists c4_12 \exists c1_13 \exists c1_14 \exists c3_15 \exists c3_16 \exists c4_17 \exists c4_18 \exists c4_19 \exists c1_20 \exists c1_21 \exists c3_22 \exists c3_23 \exists c4_24 \exists c4_25 \exists c4_26 \exists c1_27 \exists c1_28 \exists c3_29 \exists c3_30 \exists c4_31 \exists c4_32 \exists c4_33 \exists c3_34 \exists c3_35 \exists c4_36 \exists c4_37 \exists c4_38 \exists d1 \exists d2 \exists d3
    (
      c3_1 > 0 & c3_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c1_6 > 0 & c1_7 > 0 & c3_8 > 0 & c3_9 > 0 & c4_10 > 0 & c4_11 > 0 & c4_12 > 0 & c1_13 > 0 & c1_14 > 0 & c3_15 > 0 & c3_16 > 0 & c4_17 > 0 & c4_18 > 0 & c4_19 > 0 & c1_20 > 0 & c1_21 > 0 & c3_22 > 0 & c3_23 > 0 & c4_24 > 0 & c4_25 > 0 & c4_26 > 0 & c1_27 > 0 & c1_28 > 0 & c3_29 > 0 & c3_30 > 0 & c4_31 > 0 & c4_32 > 0 & c4_33 > 0 & c3_34 > 0 & c3_35 > 0 & c4_36 > 0 & c4_37 > 0 & c4_38 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c \forall dt \forall v \forall F0 \forall F \forall dt0 \forall L0 \forall L \forall m0 \forall u0 \forall m \forall u
        (
          (
            (c > 0 & dt > 0 & v > 0 & F0 > 0 & F > 0 & dt0 > 0 & L0 > 0 & L > 0 & m0 > 0 & u0 > 0 & m > 0 & u > 0) &
            & ( F*dt - 1 = 0 )
            & ( m0*u0 - m*u = 0 )
            & ( u0*dt0 - u*dt = 0 )
            & ( dt*(c^2 - v^2) - 2*L*c = 0 )
            & ( ( c3_1 * c*dt0 ) + ( c3_2 * L0 ) = 0 )
            & ( ( c4_3 * c^2*dt^2 ) + ( c4_4 * dt^2*v^2 ) + ( c4_5 * L0^2 ) = 0 )
            & ( ( c1_6 * F0*dt0 ) + ( c1_7 * 1 ) = 0 )
            & ( ( c3_8 * c*dt0 ) + ( c3_9 * L0 ) = 0 )
            & ( ( c4_10 * c^2*dt^2 ) + ( c4_11 * dt^2*v^2 ) + ( c4_12 * L0^2 ) = 0 )
            & ( ( c1_13 * F0*dt0 ) + ( c1_14 * 1 ) = 0 )
            & ( ( c3_15 * c*dt0 ) + ( c3_16 * L0 ) = 0 )
            & ( ( c4_17 * c^2*dt^2 ) + ( c4_18 * dt^2*v^2 ) + ( c4_19 * L0^2 ) = 0 )
            & ( ( c1_20 * F0*dt0 ) + ( c1_21 * 1 ) = 0 )
            & ( ( c3_22 * c*dt0 ) + ( c3_23 * L0 ) = 0 )
            & ( ( c4_24 * c^2*dt^2 ) + ( c4_25 * dt^2*v^2 ) + ( c4_26 * L0^2 ) = 0 )
            & ( ( c1_27 * F0*dt0 ) + ( c1_28 * 1 ) = 0 )
            & ( ( c3_29 * c*dt0 ) + ( c3_30 * L0 ) = 0 )
            & ( ( c4_31 * c^2*dt^2 ) + ( c4_32 * dt^2*v^2 ) + ( c4_33 * L0^2 ) = 0 )
            & ( ( c3_34 * c*dt0 ) + ( c3_35 * L0 ) = 0 )
            & ( ( c4_36 * c^2*dt^2 ) + ( c4_37 * dt^2*v^2 ) + ( c4_38 * L0^2 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*L0^2 ) + ( d2 * c^2*L^2 ) + ( d3 * v^2*L0^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
