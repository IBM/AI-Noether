Problem
  (
    \exists c2_1 \exists c2_2 \exists c3_3 \exists c3_4 \exists c4_5 \exists c4_6 \exists c4_7 \exists c2_8 \exists c2_9 \exists c3_10 \exists c3_11 \exists c4_12 \exists c4_13 \exists c4_14 \exists c2_15 \exists c2_16 \exists c4_17 \exists c4_18 \exists c4_19 \exists c2_20 \exists c2_21 \exists c3_22 \exists c3_23 \exists c4_24 \exists c4_25 \exists c4_26 \exists c2_27 \exists c2_28 \exists c3_29 \exists c3_30 \exists c4_31 \exists c4_32 \exists c4_33 \exists c2_34 \exists c2_35 \exists c3_36 \exists c3_37 \exists c4_38 \exists c4_39 \exists c4_40 \exists c3_41 \exists c3_42 \exists c4_43 \exists c4_44 \exists c4_45 \exists c2_46 \exists c2_47 \exists c3_48 \exists c3_49 \exists c4_50 \exists c4_51 \exists c4_52 \exists c2_53 \exists c2_54 \exists c3_55 \exists c3_56 \exists c4_57 \exists c4_58 \exists c4_59 \exists d1 \exists d2 \exists d3
    (
      c2_1 > 0 & c2_2 > 0 & c3_3 > 0 & c3_4 > 0 & c4_5 > 0 & c4_6 > 0 & c4_7 > 0 & c2_8 > 0 & c2_9 > 0 & c3_10 > 0 & c3_11 > 0 & c4_12 > 0 & c4_13 > 0 & c4_14 > 0 & c2_15 > 0 & c2_16 > 0 & c4_17 > 0 & c4_18 > 0 & c4_19 > 0 & c2_20 > 0 & c2_21 > 0 & c3_22 > 0 & c3_23 > 0 & c4_24 > 0 & c4_25 > 0 & c4_26 > 0 & c2_27 > 0 & c2_28 > 0 & c3_29 > 0 & c3_30 > 0 & c4_31 > 0 & c4_32 > 0 & c4_33 > 0 & c2_34 > 0 & c2_35 > 0 & c3_36 > 0 & c3_37 > 0 & c4_38 > 0 & c4_39 > 0 & c4_40 > 0 & c3_41 > 0 & c3_42 > 0 & c4_43 > 0 & c4_44 > 0 & c4_45 > 0 & c2_46 > 0 & c2_47 > 0 & c3_48 > 0 & c3_49 > 0 & c4_50 > 0 & c4_51 > 0 & c4_52 > 0 & c2_53 > 0 & c2_54 > 0 & c3_55 > 0 & c3_56 > 0 & c4_57 > 0 & c4_58 > 0 & c4_59 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c \forall dt \forall v \forall F0 \forall F \forall dt0 \forall L0 \forall L \forall m0 \forall u0 \forall m \forall u
        (
          (
            (c > 0 & dt > 0 & v > 0 & F0 > 0 & F > 0 & dt0 > 0 & L0 > 0 & L > 0 & m0 > 0 & u0 > 0 & m > 0 & u > 0) &
            & ( F0*dt0 - 1 = 0 )
            & ( m0*u0 - m*u = 0 )
            & ( u0*dt0 - u*dt = 0 )
            & ( dt*(c^2 - v^2) - 2*L*c = 0 )
            & ( ( c2_1 * dt*F ) + ( c2_2 * 1 ) = 0 )
            & ( ( c3_3 * c*dt0 ) + ( c3_4 * L0 ) = 0 )
            & ( ( c4_5 * c^2*dt^2 ) + ( c4_6 * dt^2*v^2 ) + ( c4_7 * L0^2 ) = 0 )
            & ( ( c2_8 * dt*F ) + ( c2_9 * 1 ) = 0 )
            & ( ( c3_10 * c*dt0 ) + ( c3_11 * L0 ) = 0 )
            & ( ( c4_12 * c^2*dt^2 ) + ( c4_13 * dt^2*v^2 ) + ( c4_14 * L0^2 ) = 0 )
            & ( ( c2_15 * dt*F ) + ( c2_16 * 1 ) = 0 )
            & ( ( c4_17 * c^2*dt^2 ) + ( c4_18 * dt^2*v^2 ) + ( c4_19 * L0^2 ) = 0 )
            & ( ( c2_20 * dt*F ) + ( c2_21 * 1 ) = 0 )
            & ( ( c3_22 * c*dt0 ) + ( c3_23 * L0 ) = 0 )
            & ( ( c4_24 * c^2*dt^2 ) + ( c4_25 * dt^2*v^2 ) + ( c4_26 * L0^2 ) = 0 )
            & ( ( c2_27 * dt*F ) + ( c2_28 * 1 ) = 0 )
            & ( ( c3_29 * c*dt0 ) + ( c3_30 * L0 ) = 0 )
            & ( ( c4_31 * c^2*dt^2 ) + ( c4_32 * dt^2*v^2 ) + ( c4_33 * L0^2 ) = 0 )
            & ( ( c2_34 * dt*F ) + ( c2_35 * 1 ) = 0 )
            & ( ( c3_36 * c*dt0 ) + ( c3_37 * L0 ) = 0 )
            & ( ( c4_38 * c^2*dt^2 ) + ( c4_39 * dt^2*v^2 ) + ( c4_40 * L0^2 ) = 0 )
            & ( ( c3_41 * c*dt0 ) + ( c3_42 * L0 ) = 0 )
            & ( ( c4_43 * c^2*dt^2 ) + ( c4_44 * dt^2*v^2 ) + ( c4_45 * L0^2 ) = 0 )
            & ( ( c2_46 * dt*F ) + ( c2_47 * 1 ) = 0 )
            & ( ( c3_48 * c*dt0 ) + ( c3_49 * L0 ) = 0 )
            & ( ( c4_50 * c^2*dt^2 ) + ( c4_51 * dt^2*v^2 ) + ( c4_52 * L0^2 ) = 0 )
            & ( ( c2_53 * dt*F ) + ( c2_54 * 1 ) = 0 )
            & ( ( c3_55 * c*dt0 ) + ( c3_56 * L0 ) = 0 )
            & ( ( c4_57 * c^2*dt^2 ) + ( c4_58 * dt^2*v^2 ) + ( c4_59 * L0^2 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*m0^2*u0 ) + ( d2 * c^2*u0*m^2 ) + ( d3 * v^2*u0*m^2 ) = 0
          )
        )
      )
    )
  )
End.

