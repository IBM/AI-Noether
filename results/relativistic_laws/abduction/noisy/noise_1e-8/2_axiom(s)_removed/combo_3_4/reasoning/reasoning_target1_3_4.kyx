            & ( ( c4_28 * c^2*dt^2 ) + ( c4_29 * dt^2*v^2 ) + ( c4_30 * L0^2 ) = 0 )
            & ( ( c3_31 * c*dt0 ) + ( c3_32 * L0 ) = 0 )
            & ( ( c4_33 * c^2*dt^2 ) + ( c4_34 * dt^2*v^2 ) + ( c4_35 * L0^2 ) = 0 )
