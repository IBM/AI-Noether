ArchiveEntry "relativistic_laws_updated_target1_combo2_4_6"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real c;
  Real dt;
  Real v;
  Real F0;
  Real F;
  Real dt0;
  Real L0;
  Real L;
  Real m0;
  Real u0;
  Real m;
  Real u;
  Real c2_1;
  Real c2_2;
  Real c4_3;
  Real c4_4;
  Real c4_5;
  Real c6_6;
  Real c6_7;
  Real c2_8;
  Real c2_9;
  Real c4_10;
  Real c4_11;
  Real c4_12;
  Real c6_13;
  Real c6_14;
  Real c2_15;
  Real c2_16;
  Real c4_17;
  Real c4_18;
  Real c4_19;
  Real c6_20;
  Real c6_21;
  Real c4_22;
  Real c4_23;
  Real c4_24;
  Real c6_25;
  Real c6_26;
  Real d1;
  Real d2;
  Real d3;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c4_3 \exists c4_4 \exists c4_5 \exists c6_6 \exists c6_7 \exists c2_8 \exists c2_9 \exists c4_10 \exists c4_11 \exists c4_12 \exists c6_13 \exists c6_14 \exists c2_15 \exists c2_16 \exists c4_17 \exists c4_18 \exists c4_19 \exists c6_20 \exists c6_21 \exists c4_22 \exists c4_23 \exists c4_24 \exists c6_25 \exists c6_26 \exists d1 \exists d2 \exists d3
    (
      c2_1 > 0 & c2_2 > 0 & c4_3 > 0 & c4_4 > 0 & c4_5 > 0 & c6_6 > 0 & c6_7 > 0 & c2_8 > 0 & c2_9 > 0 & c4_10 > 0 & c4_11 > 0 & c4_12 > 0 & c6_13 > 0 & c6_14 > 0 & c2_15 > 0 & c2_16 > 0 & c4_17 > 0 & c4_18 > 0 & c4_19 > 0 & c6_20 > 0 & c6_21 > 0 & c4_22 > 0 & c4_23 > 0 & c4_24 > 0 & c6_25 > 0 & c6_26 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c \forall dt \forall v \forall F0 \forall F \forall dt0 \forall L0 \forall L \forall m0 \forall u0 \forall m \forall u
        (
          (
            (c > 0 & dt > 0 & v > 0 & F0 > 0 & F > 0 & dt0 > 0 & L0 > 0 & L > 0 & m0 > 0 & u0 > 0 & m > 0 & u > 0) &
            & ( F0*dt0 - 1 = 0 )
            & ( c*dt0 - 2*L0 = 0 )
            & ( m0*u0 - m*u = 0 )
            & ( dt*(c^2 - v^2) - 2*L*c = 0 )
            & ( ( c2_1 * dt*F ) + ( c2_2 * 1 ) = 0 )
            & ( ( c4_3 * c^2*dt^2 ) + ( c4_4 * dt^2*v^2 ) + ( c4_5 * L0^2 ) = 0 )
            & ( ( c6_6 * dt*u ) + ( c6_7 * dt0*u0 ) = 0 )
            & ( ( c2_8 * dt*F ) + ( c2_9 * 1 ) = 0 )
            & ( ( c4_10 * c^2*dt^2 ) + ( c4_11 * dt^2*v^2 ) + ( c4_12 * L0^2 ) = 0 )
            & ( ( c6_13 * dt*u ) + ( c6_14 * dt0*u0 ) = 0 )
            & ( ( c2_15 * dt*F ) + ( c2_16 * 1 ) = 0 )
            & ( ( c4_17 * c^2*dt^2 ) + ( c4_18 * dt^2*v^2 ) + ( c4_19 * L0^2 ) = 0 )
            & ( ( c6_20 * dt*u ) + ( c6_21 * dt0*u0 ) = 0 )
            & ( ( c4_22 * c^2*dt^2 ) + ( c4_23 * dt^2*v^2 ) + ( c4_24 * L0^2 ) = 0 )
            & ( ( c6_25 * dt*u ) + ( c6_26 * dt0*u0 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*F0^2 ) + ( d2 * c^2*F^2 ) + ( d3 * v^2*F0^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
