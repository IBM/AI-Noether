/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real c;
  Real dt;
  Real v;
  Real F0;
  Real F;
  Real dt0;
  Real L0;
  Real L;
  Real m0;
  Real u0;
  Real m;
  Real u;
  Real c2_1;
  Real c2_2;
  Real c3_3;
  Real c3_4;
  Real c7_5;
  Real c7_6;
  Real c7_7;
  Real c3_8;
  Real c3_9;
  Real c7_10;
  Real c7_11;
  Real c7_12;
  Real c3_13;
  Real c3_14;
  Real c7_15;
  Real c7_16;
  Real c7_17;
  Real c2_18;
  Real c2_19;
  Real c3_20;
  Real c3_21;
  Real c7_22;
  Real c7_23;
  Real c7_24;
  Real c2_25;
  Real c2_26;
  Real c3_27;
  Real c3_28;
  Real c7_29;
  Real c7_30;
  Real c7_31;
  Real c2_32;
  Real c2_33;
  Real c3_34;
  Real c3_35;
  Real c7_36;
  Real c7_37;
  Real c7_38;
  Real d1;
  Real d2;
  Real d3;
End.

Problem
  (
    \exists c2_1 \exists c2_2 \exists c3_3 \exists c3_4 \exists c7_5 \exists c7_6 \exists c7_7 \exists c3_8 \exists c3_9 \exists c7_10 \exists c7_11 \exists c7_12 \exists c3_13 \exists c3_14 \exists c7_15 \exists c7_16 \exists c7_17 \exists c2_18 \exists c2_19 \exists c3_20 \exists c3_21 \exists c7_22 \exists c7_23 \exists c7_24 \exists c2_25 \exists c2_26 \exists c3_27 \exists c3_28 \exists c7_29 \exists c7_30 \exists c7_31 \exists c2_32 \exists c2_33 \exists c3_34 \exists c3_35 \exists c7_36 \exists c7_37 \exists c7_38 \exists d1 \exists d2 \exists d3
    (
      c2_1 > 0 & c2_2 > 0 & c3_3 > 0 & c3_4 > 0 & c7_5 > 0 & c7_6 > 0 & c7_7 > 0 & c3_8 > 0 & c3_9 > 0 & c7_10 > 0 & c7_11 > 0 & c7_12 > 0 & c3_13 > 0 & c3_14 > 0 & c7_15 > 0 & c7_16 > 0 & c7_17 > 0 & c2_18 > 0 & c2_19 > 0 & c3_20 > 0 & c3_21 > 0 & c7_22 > 0 & c7_23 > 0 & c7_24 > 0 & c2_25 > 0 & c2_26 > 0 & c3_27 > 0 & c3_28 > 0 & c7_29 > 0 & c7_30 > 0 & c7_31 > 0 & c2_32 > 0 & c2_33 > 0 & c3_34 > 0 & c3_35 > 0 & c7_36 > 0 & c7_37 > 0 & c7_38 > 0 & d1 > 0 & d2 > 0 & d3 > 0
      &
      (
        \forall c \forall dt \forall v \forall F0 \forall F \forall dt0 \forall L0 \forall L \forall m0 \forall u0 \forall m \forall u
        (
          (
            (c > 0 & dt > 0 & v > 0 & F0 > 0 & F > 0 & dt0 > 0 & L0 > 0 & L > 0 & m0 > 0 & u0 > 0 & m > 0 & u > 0) &
            & ( F0*dt0 - 1 = 0 )
            & ( c^2*dt^2 - 4*L0^2 - v^2*dt^2 = 0 )
            & ( m0*u0 - m*u = 0 )
            & ( u0*dt0 - u*dt = 0 )
            & ( ( c2_1 * dt*F ) + ( c2_2 * 1 ) = 0 )
            & ( ( c3_3 * c*dt0 ) + ( c3_4 * L0 ) = 0 )
            & ( ( c7_5 * c^2*dt ) + ( c7_6 * c*L ) + ( c7_7 * dt*v^2 ) = 0 )
            & ( ( c3_8 * c*dt0 ) + ( c3_9 * L0 ) = 0 )
            & ( ( c7_10 * c^2*dt ) + ( c7_11 * c*L ) + ( c7_12 * dt*v^2 ) = 0 )
            & ( ( c3_13 * c*dt0 ) + ( c3_14 * L0 ) = 0 )
            & ( ( c7_15 * c^2*dt ) + ( c7_16 * c*L ) + ( c7_17 * dt*v^2 ) = 0 )
            & ( ( c2_18 * dt*F ) + ( c2_19 * 1 ) = 0 )
            & ( ( c3_20 * c*dt0 ) + ( c3_21 * L0 ) = 0 )
            & ( ( c7_22 * c^2*dt ) + ( c7_23 * c*L ) + ( c7_24 * dt*v^2 ) = 0 )
            & ( ( c2_25 * dt*F ) + ( c2_26 * 1 ) = 0 )
            & ( ( c3_27 * c*dt0 ) + ( c3_28 * L0 ) = 0 )
            & ( ( c7_29 * c^2*dt ) + ( c7_30 * c*L ) + ( c7_31 * dt*v^2 ) = 0 )
            & ( ( c2_32 * dt*F ) + ( c2_33 * 1 ) = 0 )
            & ( ( c3_34 * c*dt0 ) + ( c3_35 * L0 ) = 0 )
            & ( ( c7_36 * c^2*dt ) + ( c7_37 * c*L ) + ( c7_38 * dt*v^2 ) = 0 )
          )
          ->
          (
            ( d1 * c^2*L0^2 ) + ( d2 * c^2*L^2 ) + ( d3 * v^2*L0^2 ) = 0
          )
        )
      )
    )
  )
End.

End.
