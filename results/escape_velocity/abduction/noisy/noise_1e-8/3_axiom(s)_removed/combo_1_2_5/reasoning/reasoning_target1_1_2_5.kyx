ArchiveEntry "escape_velocity_target1_combo1_2_5"

/* AI-Noether: KeyMaera Reasoning Template (Noisy Case)
 * 
 * This template verifies that the abducted axioms (with existentially quantified
 * coefficients) can derive the noisy consequence (also with existentially 
 * quantified coefficients).
 *
 * Structure:
 * - Variables are universally quantified (forall)
 * - Monomial coefficients are existentially quantified (exists)
 * - Known axioms appear as exact equations
 * - Abducted axioms have coefficients c1, c2, ... for each monomial
 * - Consequence has coefficients d1, d2, ... for each monomial
 */

ProgramVariables
  Real Eki;
  Real Ekf;
  Real Ugi;
  Real Ugf;
  Real G;
  Real M;
  Real m;
  Real ve;
  Real r;
  Real c1_1;
  Real c1_2;
  Real c2_3;
  Real c5_4;
  Real c5_5;
  Real c5_6;
  Real c5_7;
  Real c1_8;
  Real c1_9;
  Real c2_10;
  Real c5_11;
  Real c5_12;
  Real c5_13;
  Real c5_14;
  Real c1_15;
  Real c1_16;
  Real c2_17;
  Real c5_18;
  Real c5_19;
  Real c5_20;
  Real c5_21;
  Real c1_22;
  Real c1_23;
  Real c2_24;
  Real c5_25;
  Real c5_26;
  Real c5_27;
  Real c5_28;
  Real c1_29;
  Real c1_30;
  Real c2_31;
  Real c5_32;
  Real c5_33;
  Real c5_34;
  Real c5_35;
  Real d1;
  Real d2;
End.

Problem
  (
    \exists c1_1 \exists c1_2 \exists c2_3 \exists c5_4 \exists c5_5 \exists c5_6 \exists c5_7 \exists c1_8 \exists c1_9 \exists c2_10 \exists c5_11 \exists c5_12 \exists c5_13 \exists c5_14 \exists c1_15 \exists c1_16 \exists c2_17 \exists c5_18 \exists c5_19 \exists c5_20 \exists c5_21 \exists c1_22 \exists c1_23 \exists c2_24 \exists c5_25 \exists c5_26 \exists c5_27 \exists c5_28 \exists c1_29 \exists c1_30 \exists c2_31 \exists c5_32 \exists c5_33 \exists c5_34 \exists c5_35 \exists d1 \exists d2
    (
      c1_1 > 0 & c1_2 > 0 & c2_3 > 0 & c5_4 > 0 & c5_5 > 0 & c5_6 > 0 & c5_7 > 0 & c1_8 > 0 & c1_9 > 0 & c2_10 > 0 & c5_11 > 0 & c5_12 > 0 & c5_13 > 0 & c5_14 > 0 & c1_15 > 0 & c1_16 > 0 & c2_17 > 0 & c5_18 > 0 & c5_19 > 0 & c5_20 > 0 & c5_21 > 0 & c1_22 > 0 & c1_23 > 0 & c2_24 > 0 & c5_25 > 0 & c5_26 > 0 & c5_27 > 0 & c5_28 > 0 & c1_29 > 0 & c1_30 > 0 & c2_31 > 0 & c5_32 > 0 & c5_33 > 0 & c5_34 > 0 & c5_35 > 0 & d1 > 0 & d2 > 0
      &
      (
        \forall Eki \forall Ekf \forall Ugi \forall Ugf \forall G \forall M \forall m \forall ve \forall r
        (
          (
            (Eki > 0 & Ekf > 0 & Ugi > 0 & Ugf > 0 & G > 0 & M > 0 & m > 0 & ve > 0 & r > 0) &
            & ( Ugi * r + G * M * m = 0 )
            & ( Ugf - 0 = 0 )
            & ( ( c1_1 * Eki ) + ( c1_2 * m*ve^2 ) = 0 )
            & ( ( c2_3 * Ekf ) = 0 )
            & ( ( c5_4 * Eki ) + ( c5_5 * Ekf ) + ( c5_6 * Ugi ) + ( c5_7 * Ugf ) = 0 )
            & ( ( c1_8 * Eki ) + ( c1_9 * m*ve^2 ) = 0 )
            & ( ( c2_10 * Ekf ) = 0 )
            & ( ( c5_11 * Eki ) + ( c5_12 * Ekf ) + ( c5_13 * Ugi ) + ( c5_14 * Ugf ) = 0 )
            & ( ( c1_15 * Eki ) + ( c1_16 * m*ve^2 ) = 0 )
            & ( ( c2_17 * Ekf ) = 0 )
            & ( ( c5_18 * Eki ) + ( c5_19 * Ekf ) + ( c5_20 * Ugi ) + ( c5_21 * Ugf ) = 0 )
            & ( ( c1_22 * Eki ) + ( c1_23 * m*ve^2 ) = 0 )
            & ( ( c2_24 * Ekf ) = 0 )
            & ( ( c5_25 * Eki ) + ( c5_26 * Ekf ) + ( c5_27 * Ugi ) + ( c5_28 * Ugf ) = 0 )
            & ( ( c1_29 * Eki ) + ( c1_30 * m*ve^2 ) = 0 )
            & ( ( c2_31 * Ekf ) = 0 )
            & ( ( c5_32 * Eki ) + ( c5_33 * Ekf ) + ( c5_34 * Ugi ) + ( c5_35 * Ugf ) = 0 )
          )
          ->
          (
            ( d1 * G*M*m ) + ( d2 * m*ve^2*r ) = 0
          )
        )
      )
    )
  )
End.

End.
