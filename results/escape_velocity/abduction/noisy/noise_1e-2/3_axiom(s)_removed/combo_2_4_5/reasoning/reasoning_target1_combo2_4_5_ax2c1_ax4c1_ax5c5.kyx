ArchiveEntry "escape_velocity_target1_combo2_4_5_ax2c1_ax4c1_ax5c5"

ProgramVariables
  Real Eki;
  Real Ekf;
  Real Ugi;
  Real Ugf;
  Real G;
  Real M;
  Real m;
  Real ve;
  Real r;
End.

Problem
  (
    \exists c1
    \exists c2
    \exists c3
    \exists c4
    \exists c5
    \exists c6
    \exists c7
    \exists c8
    \exists c9
    \exists c10
    (
      c1>0 & c2>0 & c3>0 & c4>0 & c5>0 & c6>0 & c7>0 & c8>0 & c9>0 & c10>0
      &
      (
      \forall Eki
      \forall Ekf
      \forall Ugi
      \forall Ugf
      \forall G
      \forall M
      \forall m
      \forall ve
      \forall r
          (
          (
            Eki>0 & Ekf>0 & Ugi>0 & Ugf>0 & G>0 & M>0 & m>0 & ve>0 & r>0
            & ( Eki - 1/2 * m * ve^2 = 0 )
            & ( Ugi * r + G * M * m = 0 )
            & ( c1 * Ekf ) = 0
            & ( c2 * Ugf ) = 0
            & ( c3 * Eki ) = ( c4 * 8.84257e ) + ( c5 * Ekf ) + ( c6 * Ugi ) + ( c7 * 8.43824e ) + ( c8 * Ugf )
            )
        ->
          (
            ( c9 * G*M*m ) = ( c10 * m*ve^2*r )
          )
          )
      )
    )
  )
End.

End.